# Copia este archivo a .env y rellénalo. .env NO se sube al repositorio.
# Claves: openssl rand -base64 48   (cada una distinta)

# --- Base de datos (Postgres 18 externo, fuera del compose) -------------------------------------------------------
# Producción:  Host=<servidor-o-red-interna>;Port=5432;Database=gsm;Username=gsm;Password=...;SSL Mode=Require
# Local:       Host=host.docker.internal;Port=5432;Database=gsm;Username=gsm;Password=gsm
DB_CONNECTION=

# --- URLs públicas ------------------------------------------------------------------------------------------------
PUBLIC_API_URL=https://api.midominio.com
PUBLIC_WEB_URL=https://app.midominio.com

# --- Claves (obligatorias, >= 32 caracteres, todas distintas) -------------------------------------------------------
JWT_SIGNING_KEY=
CHECKIN_SIGNING_KEY=
UNSUBSCRIBE_SIGNING_KEY=
JOBS_SECRET=

# --- Primer SuperAdmin (solo para: docker compose run --rm api --seed-superadmin) --------------------------------
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Super Admin

# --- Opcionales: sin ellos las subidas fallan, los correos van al log y no hay push ---------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_WEB_API_KEY=
FCM_WEB_APP_ID=
FCM_WEB_SENDER_ID=
FCM_WEB_VAPID_KEY=

# --- Otros ---------------------------------------------------------------------------------------------------------
# JOBS_INTERVAL_SECONDS=300
# GSM_TAG=latest

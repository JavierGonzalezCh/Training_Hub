@* Cáscara para las pantallas públicas de la app del miembro (registro). Espejo ligero del
   AuthLayout del panel — vive aquí porque GSM.Member.UI no depende de GSM.Web. *@
@inherits LayoutComponentBase

<GsmThemeProvider />
<MudPopoverProvider />
<MudSnackbarProvider />

<div class="gsm-auth-backdrop">
    <MudPaper Class="gsm-auth-card" Elevation="0">
        @Body
    </MudPaper>
</div>

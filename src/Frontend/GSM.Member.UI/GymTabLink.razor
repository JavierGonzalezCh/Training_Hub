@* Quinto lugar de la barra inferior del miembro, adaptable: «Clases» si el gym las tiene activas; si no, «Mi gym» (horario,
   ubicación, aforo y novedades), para que nunca haya una pestaña vacía. Con clases, «Mi gimnasio» se abre desde el menú de la cuenta. *@
@inject NavigationManager Navigation
@implements IDisposable

<a href="@Href" class="@CssClass" aria-label="@Title" aria-current="@(IsActive ? "page" : null)" data-testid="tab-gym">
    <span class="gsm-tabbar-icon">
        <MudIcon Icon="@(ShowClasses ? Icons.Material.Outlined.Event : Icons.Material.Filled.Storefront)" Size="Size.Small" />
    </span>
    <span class="@LabelClass">@Title</span>
</a>

@code {
    /// <summary>Clase del enlace (<c>gsm-nav-link</c> en el menú lateral); se le suma <c>active</c>.</summary>
    [Parameter] public string? LinkClass { get; set; }

    /// <summary>Clase del rótulo (<c>gsm-tabbar-label</c> en la barra inferior).</summary>
    [Parameter] public string LabelClass { get; set; } = "gsm-tabbar-label";

    /// <summary>El gym tiene las clases activas: el destino es Clases; si no, Mi gym.</summary>
    [Parameter] public bool ShowClasses { get; set; } = true;

    private string Href => ShowClasses ? "/app/clases" : "/app/gimnasio";

    private string Title => ShowClasses ? "Clases" : "Mi gym";

    private bool IsActive
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
            var own = Href.TrimStart('/');
            return path.Equals(own, StringComparison.OrdinalIgnoreCase)
                || path.StartsWith(own + "/", StringComparison.OrdinalIgnoreCase);
        }
    }

    private string CssClass => string.Join(' ', new[] { LinkClass, IsActive ? "active" : null }.Where(c => c is not null));

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}

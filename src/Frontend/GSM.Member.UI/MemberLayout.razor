@inherits LayoutComponentBase
@inject GymContext GymCtx
@inject GSM.UI.Shared.Components.ViewportState Viewport
@inject MemberContext MemberCtx
@inject SessionService Session
@inject MemberBootstrapService Bootstrap
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState
@inject IDialogService Dialogs
@inject GSM.UI.Shared.Push.PushRegistrationService PushRegistration
@implements IDisposable

<GsmThemeProvider Gym="@GymCtx.Gym" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="@(Viewport.IsNarrow ? null : "gsm-m-desktop")">
    <MudAppBar Elevation="0" Class="gsm-m-bar">
        @if (GymCtx.Gym is { } gym)
        {
            <div class="gsm-m-brand">
                @if (!string.IsNullOrWhiteSpace(gym.LogoUrl))
                {
                    <img class="gsm-m-brand__logo" src="@gym.LogoUrl" alt="@gym.Name" />
                }
                else
                {
                    <span class="gsm-m-brand__mark" aria-hidden="true">@GymBrand.Initial(gym.Name)</span>
                }
                <span class="gsm-m-brand__name">@gym.Name</span>
            </div>
        }
        else
        {
            <span class="gsm-wordmark" style="font-size:1.3rem">TRAINING<span class="accent">HUB</span><span class="gsm-wordmark__tag">GO</span></span>
        }
        <MudSpacer />
        <ModeSwitch Accesses="_accesses" Compact="true" />
        @if (_accesses.Count > 1)
        {
            <MudIconButton Icon="@Icons.Material.Filled.SwapHoriz" Color="Color.Inherit" OnClick="SwitchGymAsync" aria-label="Cambiar de gimnasio" />
        }
        <MudIconButton Icon="@Icons.Material.Filled.Person" Color="Color.Inherit" Href="/app/perfil" aria-label="Mi perfil" />
        <MudIconButton Icon="@Icons.Material.Filled.Storefront"Color="Color.Inherit" Href="/app/gimnasio" aria-label="Mi gimnasio" />
        <MudIconButton Icon="@Icons.Material.Filled.NotificationsActive" Color="Color.Inherit" Href="/app/avisos" aria-label="Preferencias de avisos" />
        <MudIconButton Icon="@Icons.Material.Filled.Lock" Color="Color.Inherit" Href="/app/cuenta/contrasena" aria-label="Cambiar contraseña" />
        <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="LogoutAsync" aria-label="Cerrar sesión" />
    </MudAppBar>

    @* Escritorio (>= 960 px): menú lateral en lugar de la barra inferior y contenido más ancho. *@
    @if (!Viewport.IsNarrow)
    {
        <MudDrawer Open="true" Variant="DrawerVariant.Persistent" Elevation="0" ClipMode="DrawerClipMode.Always" Class="gsm-m-drawer">
            <nav class="gsm-m-sidenav" aria-label="Navegación principal" data-testid="member-sidenav">
                @foreach (var item in Destinations)
                {
                    <NavLink class="gsm-nav-link" href="@item.Href" Match="@(item.MatchAll ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                        <MudIcon Icon="@item.Icon" Size="Size.Small" /><span>@item.Title</span>
                    </NavLink>
                }
                @if (!_loading && GymCtx.FeatureFlags?.ShowCommunity == true)
                {
                    <NavLink class="gsm-nav-link" href="/app/novedades">
                        <MudIcon Icon="@Icons.Material.Filled.Campaign" Size="Size.Small" /><span>Novedades</span>
                    </NavLink>
                }
            </nav>
        </MudDrawer>
    }

    <MudMainContent>
        <SubscriptionBanner />
        <MudContainer MaxWidth="@(Viewport.IsNarrow ? MaxWidth.Small : MaxWidth.ExtraLarge)" Class="mt-4 pb-16">
            @if (_loading)
            {
                <div class="d-flex justify-center mt-8">
                    <GsmLoader />
                </div>
            }
            else
            {
                <GSM.UI.Shared.Diagnostics.GsmErrorBoundary>
                    @Body
                </GSM.UI.Shared.Diagnostics.GsmErrorBoundary>
            }
        </MudContainer>
    </MudMainContent>

    @* NavLink de Blazor, no MudBottomNavigation: ese componente no existe en MudBlazor y
       Razor lo emitía como etiqueta HTML desconocida, así que los destinos salían como
       texto suelto y no navegaban. *@
    @if (Viewport.IsNarrow)
    {
    <nav class="gsm-tabbar" aria-label="Navegación principal">
        <NavLink href="/app" Match="NavLinkMatch.All">
            <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Small" />
            <span class="gsm-tabbar-label">Inicio</span>
        </NavLink>
        <NavLink href="/app/logros">
            <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Size="Size.Small" />
            <span class="gsm-tabbar-label">Progreso</span>
        </NavLink>
        <NavLink href="/app/rutina">
            <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Size="Size.Small" />
            <span class="gsm-tabbar-label">Rutina</span>
        </NavLink>
        <NavLink href="/app/clases">
            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" />
            <span class="gsm-tabbar-label">Clases</span>
        </NavLink>
        @if (!_loading && GymCtx.FeatureFlags?.ShowCommunity == true)
        {
            <NewsTabLink />
        }
    </nav>
    }
</MudLayout>

@code {
    private bool _loading = true;

    private sealed record Destination(string Href, string Title, string Icon, bool MatchAll = false);

    private static readonly Destination[] Destinations =
    [
        new("/app", "Inicio", Icons.Material.Filled.Home, true),
        new("/app/logros", "Mi progreso", Icons.Material.Filled.EmojiEvents),
        new("/app/rutina", "Rutina", Icons.Material.Filled.FitnessCenter),
        new("/app/progreso", "Mis récords", Icons.Material.Filled.TrendingUp),
        new("/app/clases", "Clases", Icons.Material.Filled.CalendarMonth),
        new("/app/ranking", "Ranking", Icons.Material.Filled.Leaderboard),
    ];
    private IReadOnlyList<GymAccessOption> _accesses = [];

    protected override async Task OnInitializedAsync()
    {
        GymCtx.Changed += OnChanged;
        MemberCtx.Changed += OnChanged;
        Viewport.Changed += OnChanged;

        try
        {
            if (!GymCtx.IsLoaded)
            {
                await Session.BootstrapAsync();
            }

            // /app/checkin tambien lo abre quien no es miembro (staff con el enlace del QR): ese caso
            // no tiene ficha de miembro que cargar y la propia pagina lo explica.
            var user = (await AuthState.GetAuthenticationStateAsync()).User;
            if (user.IsInRole(GsmRoles.Member) && !MemberCtx.IsLoaded)
            {
                await Bootstrap.LoadAsync();
            }

            _accesses = await Session.GetAccessesAsync();

            // Si la persona ya dio el permiso, el token de este dispositivo se registra al entrar (puede haber rotado).
            if (user.IsInRole(GsmRoles.Member))
            {
                _ = PushRegistration.SyncAsync(GSM.UI.Shared.Push.PushPlatforms.WebMember);
            }
        }
        catch (ApiErrorException ex) when (ex.Error.IsUnauthorized)
        {
            Navigation.NavigateTo("/app/entrar", replace: true);
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Viewport.EnsureStartedAsync();
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task SwitchGymAsync()
        => await Dialogs.ShowAsync<GymSwitchDialog>(
            "Cambiar de gimnasio",
            new DialogParameters<GymSwitchDialog> { { x => x.Accesses, _accesses } });

    private async Task LogoutAsync()
    {
        await PushRegistration.DisableAsync(); // da de baja el dispositivo mientras la sesión sigue válida
        await Session.LogoutAsync();
        MemberCtx.Clear();
        Navigation.NavigateTo("/app/entrar", replace: true);
    }

    public void Dispose()
    {
        GymCtx.Changed -= OnChanged;
        MemberCtx.Changed -= OnChanged;
        Viewport.Changed -= OnChanged;
    }
}

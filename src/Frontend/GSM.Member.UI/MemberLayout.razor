@inherits LayoutComponentBase
@inject GymContext GymCtx
@inject GSM.UI.Shared.Components.ViewportState Viewport
@inject MemberContext MemberCtx
@inject SessionService Session
@inject MemberBootstrapService Bootstrap
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState
@inject IDialogService Dialogs
@inject GSM.UI.Shared.Push.PushRegistrationService PushRegistration
@implements IDisposable

<GsmThemeProvider Gym="@GymCtx.Gym" />
<MudPopoverProvider />
<MudDialogProvider CloseOnEscapeKey="true" />
<MudSnackbarProvider />

<MudLayout Class="@(Viewport.IsNarrow ? "gsm-m-shell" : "gsm-m-shell gsm-m-desktop")">
    @* Primer elemento con foco: con teclado, salta la barra y el menú y va directo al contenido. *@
    <a href="#" class="gsm-skip-link" @onclick="SkipToContentAsync" @onclick:preventDefault>Saltar al contenido</a>
    <MudAppBar Elevation="0" Class="gsm-m-bar">
        @if (GymCtx.Gym is { } gym)
        {
            <div class="gsm-m-brand">
                @if (!string.IsNullOrWhiteSpace(gym.LogoUrl))
                {
                    <img class="gsm-m-brand__logo" src="@gym.LogoUrl" alt="@gym.Name" />
                }
                else
                {
                    <span class="gsm-m-brand__mark" aria-hidden="true">@GymBrand.Initial(gym.Name)</span>
                }
                <span class="gsm-m-brand__name">@gym.Name</span>
            </div>
        }
        else
        {
            <span class="gsm-wordmark" style="font-size:1.3rem">TRAINING<span class="accent">HUB</span><span class="gsm-wordmark__tag">GO</span></span>
        }
        <MudSpacer />
        <ModeSwitch Accesses="_accesses" Compact="true" />
        @if (_accesses.Count > 1)
        {
            <MudIconButton Icon="@Icons.Material.Filled.SwapHoriz" Color="Color.Inherit" OnClick="SwitchGymAsync" aria-label="Cambiar de gimnasio" />
        }
        <CheckinButton />
        @* Todo lo de la cuenta vive aquí: perfil, membresía, autorizaciones, avisos y contraseña. *@
        <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" AriaLabel="Mi cuenta"
                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" data-testid="member-account-menu">
            <MudMenuItem Icon="@Icons.Material.Filled.Person" Href="/app/perfil">Mi perfil</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.CardMembership" Href="/app/membresia">Mi membresía</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Outlined.Gavel" Href="/app/autorizaciones">Autorizaciones</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.NotificationsActive" Href="/app/avisos">Preferencias de avisos</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.Lock" Href="/app/cuenta/contrasena">Cambiar contraseña</MudMenuItem>
            <MudDivider />
            <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="LogoutAsync">Cerrar sesión</MudMenuItem>
        </MudMenu>
    </MudAppBar>

    @* Escritorio (>= 960 px): menú lateral en lugar de la barra inferior y contenido más ancho. *@
    @if (!Viewport.IsNarrow)
    {
        <MudDrawer Open="true" Variant="DrawerVariant.Persistent" Elevation="0" ClipMode="DrawerClipMode.Always" Class="gsm-m-drawer">
            <nav class="gsm-m-sidenav" aria-label="Navegación principal" data-testid="member-sidenav">
                @foreach (var item in Destinations)
                {
                    <NavLink class="gsm-nav-link" href="@item.Href" Match="@(item.MatchAll ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                        <MudIcon Icon="@item.Icon" Size="Size.Small" /><span>@item.Title</span>
                    </NavLink>
                }
                @if (!_loading)
                {
                    <GymTabLink LinkClass="gsm-nav-link" LabelClass="" Community="@(GymCtx.FeatureFlags?.ShowCommunity == true)" />
                }
            </nav>
        </MudDrawer>
    }

    <MudMainContent>
        <SubscriptionBanner />
        <MudContainer MaxWidth="@(Viewport.IsNarrow ? MaxWidth.Small : MaxWidth.ExtraLarge)" Class="mt-4 pb-16">
            <div @ref="_contentStart" tabindex="-1" class="gsm-visually-hidden" data-testid="content-start">Contenido principal</div>
            @if (_loading)
            {
                <div class="d-flex justify-center mt-8">
                    <GsmLoader />
                </div>
            }
            else
            {
                <GSM.UI.Shared.Diagnostics.GsmErrorBoundary>
                    @Body
                </GSM.UI.Shared.Diagnostics.GsmErrorBoundary>
            }
        </MudContainer>
    </MudMainContent>

    @* NavLink de Blazor, no MudBottomNavigation: ese componente no existe en MudBlazor y
       Razor lo emitía como etiqueta HTML desconocida, así que los destinos salían como
       texto suelto y no navegaban. *@
    @if (Viewport.IsNarrow)
    {
    <nav class="gsm-tabbar" aria-label="Navegación principal" data-testid="member-tabbar">
        @foreach (var item in Destinations)
        {
            <NavLink href="@item.Href" Match="@(item.MatchAll ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                <MudIcon Icon="@item.Icon" Size="Size.Small" />
                <span class="gsm-tabbar-label">@item.Title</span>
            </NavLink>
        }
        @if (!_loading)
        {
            <GymTabLink Community="@(GymCtx.FeatureFlags?.ShowCommunity == true)" />
        }
    </nav>
    }
</MudLayout>

@code {
    private ElementReference _contentStart;
    private bool _loading = true;

    // El siguiente Tab después de saltar cae en el primer control de la vista.
    private async Task SkipToContentAsync() => await _contentStart.FocusAsync();

    private sealed record Destination(string Href, string Title, string Icon, bool MatchAll = false);

    // Cuatro destinos, iguales en el celular y en escritorio: Hoy, Entrenar, Progreso y Gym (GymTabLink, que reúne
    // Mi gimnasio, Clases y Novedades). Entrenar no aparece si el gym no tiene rutinas.
    private IEnumerable<Destination> Destinations
    {
        get
        {
            yield return new("/app", "Hoy", Icons.Material.Filled.Home, true);
            if (GymCtx.FeatureFlags?.ShowRoutines != false)
            {
                yield return new("/app/rutina", "Entrenar", Icons.Material.Filled.FitnessCenter);
            }

            yield return new("/app/progreso", "Progreso", Icons.Material.Filled.TrendingUp);
        }
    }

    private IReadOnlyList<GymAccessOption> _accesses = [];

    protected override async Task OnInitializedAsync()
    {
        GymCtx.Changed += OnChanged;
        MemberCtx.Changed += OnChanged;
        Viewport.Changed += OnChanged;

        try
        {
            // FL1: entró con su documento y aún no crea su contraseña; la API no le deja hacer nada más.
            if (await Session.MustChangePasswordAsync())
            {
                Navigation.NavigateTo(SessionService.CreatePasswordPath, replace: true);
                return;
            }

            if (!GymCtx.IsLoaded)
            {
                await Session.BootstrapAsync();
            }

            // /app/checkin tambien lo abre quien no es miembro (staff con el enlace del QR): ese caso
            // no tiene ficha de miembro que cargar y la propia pagina lo explica.
            var user = (await AuthState.GetAuthenticationStateAsync()).User;
            if (user.IsInRole(GsmRoles.Member) && !MemberCtx.IsLoaded)
            {
                await Bootstrap.LoadAsync();
            }

            _accesses = await Session.GetAccessesAsync();

            // Si la persona ya dio el permiso, el token de este dispositivo se registra al entrar (puede haber rotado).
            if (user.IsInRole(GsmRoles.Member))
            {
                _ = PushRegistration.SyncAsync(GSM.UI.Shared.Push.PushPlatforms.WebMember);
            }
        }
        catch (ApiErrorException ex) when (ex.Error.IsUnauthorized)
        {
            Navigation.NavigateTo("/app/entrar", replace: true);
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Viewport.EnsureStartedAsync();
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task SwitchGymAsync()
        => await Dialogs.ShowAsync<GymSwitchDialog>(
            "Cambiar de gimnasio",
            new DialogParameters<GymSwitchDialog> { { x => x.Accesses, _accesses } });

    private async Task LogoutAsync()
    {
        await PushRegistration.DisableAsync(); // da de baja el dispositivo mientras la sesión sigue válida
        await Session.LogoutAsync();
        MemberCtx.Clear();
        Navigation.NavigateTo("/app/entrar", replace: true);
    }

    public void Dispose()
    {
        GymCtx.Changed -= OnChanged;
        MemberCtx.Changed -= OnChanged;
        Viewport.Changed -= OnChanged;
    }
}

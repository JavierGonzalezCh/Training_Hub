@page "/app/cuenta/contrasena"
@layout MemberLayout
@attribute [Authorize(Roles = GsmRoles.Member)]

<PageTitle>Cambiar contraseña — TrainingHub GO</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-2">Cambiar contraseña</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Al cambiarla cerramos tus otras sesiones, en todos tus gimnasios. Esta se queda abierta.
</MudText>

<ChangePasswordForm />

<MudText Typo="Typo.h5" HtmlTag="h2" Class="mt-8 mb-2">Cambiar correo</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Es el correo con el que entras. Lo confirmas con un código que mandamos al correo nuevo.
</MudText>

<ChangeEmailForm />

@page "/app/progreso"
@layout MemberLayout
@attribute [Authorize(Roles = GsmRoles.Member)]
@using GSM.UI.Shared.Routines
@inject GymContext GymCtx
@inject IMeClient Me

<PageTitle>Mis récords — TrainingHub GO</PageTitle>

<div class="d-flex align-center mb-4">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/app/rutina" aria-label="Volver a mi rutina" />
    <MudText Typo="Typo.h5" HtmlTag="h1">Mis récords</MudText>
</div>

@if (GymCtx.FeatureFlags?.ShowRoutines == false)
{
    <MudAlert Severity="Severity.Normal">Las rutinas no están activadas en este gimnasio.</MudAlert>
}
else
{
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
        Cómo has avanzado en cada ejercicio y tus récords. Cuentan los ejercicios que anotaste con peso, repeticiones, tiempo o distancia; el calentamiento no.
    </MudText>
    <ProgressPanel LoadSummaries="@(() => Me.GetMyProgressAsync())"
                   LoadDetail="@(id => Me.GetMyExerciseProgressAsync(id))"
                   EmptyText="Cuando anotes tus series en la rutina, aquí verás tu evolución y tus récords." />
}

@page "/app/rutina"
@layout MemberLayout
@attribute [Authorize(Roles = GsmRoles.Member)]
@using GSM.UI.Shared.Formatting
@using GSM.UI.Shared.Routines
@inject GymContext GymCtx
@inject IMeClient Me
@inject IRoutineExercisesClient RoutineExercises
@inject IExercisesClient ExercisesApi
@inject ISnackbar Snackbar

<PageTitle>Mi rutina — GSM</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-4">Mi rutina</MudText>

@if (GymCtx.FeatureFlags?.ShowRoutines == false)
{
    <MudAlert Severity="Severity.Normal">Las rutinas no están activadas en este gimnasio.</MudAlert>
}
else if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_response?.Routine is null)
{
    <div class="gsm-empty">
        <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Size="Size.Large" Class="gsm-empty-icon" />
        <div class="gsm-empty-title">Todavía no tienes una rutina</div>
        @if (_createError is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true">@_createError</MudAlert>
        }
        else if (GymCtx.FeatureFlags?.MembersCanCreateRoutines == true)
        {
            <MudText Typo="Typo.body2">Arma la tuya y llévala contigo a cada entrenamiento.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       Href="/app/rutina/nueva" Class="mt-2">
                Crear mi rutina
            </MudButton>
        }
        else
        {
            <MudText Typo="Typo.body2">Pídele una a tu entrenador y aparecerá aquí.</MudText>
        }
    </div>
}
else
{
    <MudText Typo="Typo.h6" Class="mb-1">@_response.Routine.Name</MudText>
    @if (_response.Routine.ScheduleMode == "weekly")
    {
        <ul class="gsm-routine-week" aria-label="Tu semana de entrenamiento">
            @foreach (var weekday in _response.Routine.Days.Where(d => d.DayOfWeek is not null).OrderBy(d => d.DayOfWeek))
            {
                <li><strong>@RoutineLabels.IsoWeekdayLabel(weekday.DayOfWeek!.Value)</strong> · @weekday.Name@(GroupsSuffix(weekday.MuscleGroups))</li>
            }
        </ul>
    }
    @if (_response.Today is { } today)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Hoy: @(_response.Routine.ScheduleMode == "weekly" ? $"{RoutineLabels.IsoWeekdayLabel(today.DayOfWeek)} · " : "")@today.DayName @(today.IsRest && today.DayName != "Descanso" ? "· descanso" : "")
        </MudText>
        @if (!today.IsRest && RoutineLabels.MuscleGroupsSummary(today.MuscleGroups) is { } todayGroups)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4 d-block" data-testid="today-groups">Hoy trabajas: @todayGroups</MudText>
        }

        @if (!today.IsRest)
        {
            var groupLabels = SetPlan.GroupLabels(today.Exercises);
            @foreach (var exercise in today.Exercises)
            {
                var state = StateOf(exercise);
                var fields = TrackingFields.Of(state.Replacement?.TrackingType ?? exercise.TrackingType);
                var unilateral = state.Replacement?.IsUnilateral ?? exercise.IsUnilateral == true;
                var targets = exercise.SetTargets.OrderBy(t => t.Number).ToList();
                var outcomes = OutcomesOf(exercise, state);
                var inGroup = groupLabels.TryGetValue(exercise.Id, out var groupLabel);
                <section class="gsm-m-ex @(state.Done ? "is-done" : null) @(inGroup ? "gsm-m-ex--grouped" : null)" data-testid="@($"ex-{exercise.Id}")">
                    <button type="button" class="gsm-m-ex__head" aria-expanded="@(state.Open ? "true" : "false")"
                            @onclick="() => state.Open = !state.Open">
                        <span class="gsm-m-ex__check" aria-hidden="true">
                            <MudIcon Icon="@(state.Done ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)" />
                        </span>
                        <span class="gsm-m-ex__title">
                            <span class="gsm-m-ex__name">@(state.Replacement?.Name ?? exercise.ExerciseName)@(inGroup ? $" · superserie {groupLabel}" : "")</span>
                            @if (state.Replacement is not null)
                            {
                                <span class="gsm-m-ex__target" data-testid="@($"replaced-{exercise.Id}")">Hoy en lugar de @exercise.ExerciseName</span>
                            }
                            <span class="gsm-m-ex__target">
                                Meta: @SetPlan.Summary(targets, exercise.IsUnilateral == true)@(exercise.RestSeconds is { } rest ? (inGroup ? $" · descanso por vuelta {rest} s" : $" · descanso {rest} s") : "")
                            </span>
                            @if (EquipmentNotice.Warning(exercise.Equipment) is { } headWarning)
                            {
                                <span class="gsm-m-ex__target" style="color:var(--mud-palette-warning)" data-testid="@($"unavailable-{exercise.Id}")">@headWarning</span>
                            }
                            @if (state.Done)
                            {
                                <span class="gsm-m-ex__target" data-testid="@($"progress-{exercise.Id}")">@SetPlan.ProgressText(outcomes)</span>
                            }
                        </span>
                        <MudIcon Icon="@(state.Open ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" />
                    </button>

                    @if (state.Open)
                    {
                        <div class="gsm-m-ex__body">
                            @if (exercise.Equipment is { } equipment)
                            {
                                var machine = EquipmentNotice.Primary(equipment);
                                <div class="gsm-m-equip" data-testid="@($"equipment-{exercise.Id}")">
                                    @if (machine is not null)
                                    {
                                        <div class="gsm-m-equip__row">
                                            @if (machine.PhotoUrl is { Length: > 0 } photo)
                                            {
                                                <img class="gsm-m-equip__photo" src="@photo" alt="@machine.Name" loading="lazy" />
                                            }
                                            else
                                            {
                                                <span class="gsm-m-equip__icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.FitnessCenter" /></span>
                                            }
                                            <div class="gsm-m-equip__text">
                                                <strong data-testid="equipment-name">@machine.Name</strong>
                                                @if (EquipmentNotice.Location(machine) is { } zone)
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block" data-testid="equipment-zone">@zone</MudText>
                                                }
                                                @if (machine.Instructions is { Length: > 0 } instructions)
                                                {
                                                    <p data-testid="equipment-instructions">@instructions</p>
                                                }
                                            </div>
                                        </div>
                                    }
                                    @if (EquipmentNotice.Warning(equipment) is { } warning)
                                    {
                                        <MudAlert Severity="Severity.Warning" Dense="true" data-testid="equipment-warning">@warning</MudAlert>
                                    }
                                    @if (equipment.Machines is { Count: > 0 } reportable)
                                    {
                                        <EquipmentReport Machines="reportable.ToList()" />
                                    }
                                </div>
                            }
                            <div class="gsm-m-ex__actions">
                                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.SwapHoriz"
                                           data-testid="@($"other-{exercise.Id}")"
                                           OnClick="() => state.Picking = !state.Picking">Hacer otro ejercicio hoy</MudButton>
                                @if (state.Replacement is not null)
                                {
                                    <MudButton Variant="Variant.Text" Size="Size.Small" data-testid="@($"undo-other-{exercise.Id}")"
                                               OnClick="() => ClearReplacement(exercise, state)">Volver al planeado</MudButton>
                                }
                            </div>
                            @if (state.Picking)
                            {
                                <AlternativePicker ExerciseId="exercise.ExerciseId" TestIdPrefix="@($"ex-{exercise.Id}-")"
                                                   OnPick="@(alt => ChooseReplacement(exercise, state, alt))" />
                            }
                            @for (var n = 0; n < state.Rows.Count; n++)
                            {
                                var row = state.Rows[n];
                                var index = n;
                                var target = index < targets.Count ? targets[index] : null;
                                <div class="gsm-m-setrow" data-testid="@($"setrow-{exercise.Id}-{index}")">
                                    <div class="gsm-m-setrow__head">
                                        <span class="gsm-m-set__num">@(index + 1)</span>
                                        <span class="gsm-m-setrow__plan">
                                            @(target is null ? "Serie extra" : $"{(target.SetType == "normal" ? "" : SetPlan.SetTypeLabel(target.SetType) + ": ")}{SetPlan.Describe(target, exercise.IsUnilateral == true)}")
                                        </span>
                                        @if (state.Done)
                                        {
                                            <span class="gsm-m-setrow__status is-@(outcomes[index].ToString().ToLowerInvariant())" data-testid="@($"outcome-{exercise.Id}-{index}")">@SetPlan.OutcomeLabel(outcomes[index])</span>
                                        }
                                        <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small"
                                                       Disabled="state.Rows.Count <= 1" aria-label="@($"Quitar la serie {index + 1}")"
                                                       OnClick="() => state.Rows.RemoveAt(index)" />
                                    </div>
                                    <div class="gsm-m-setrow__fields">
                                        @if (fields.Weight)
                                        {
                                            <MudNumericField T="double?" @bind-Value="row.Weight" Label="Peso (kg)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                             Min="0" Max="1000" Step="2.5" HideSpinButtons="true" Immediate="true"
                                                             aria-label="@($"Peso de la serie {index + 1}, en kilos")" />
                                        }
                                        @if (fields.Reps)
                                        {
                                            <MudNumericField T="int?" @bind-Value="row.Reps" Label="@(unilateral ? "Reps por lado" : "Reps")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                             Min="0" Max="1000" HideSpinButtons="true" Immediate="true"
                                                             aria-label="@($"Repeticiones de la serie {index + 1}")" />
                                        }
                                        @if (fields.Time)
                                        {
                                            <MudNumericField T="int?" @bind-Value="row.DurationSeconds" Label="Tiempo (s)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                             Min="0" Max="86400" HideSpinButtons="true" Immediate="true"
                                                             aria-label="@($"Tiempo de la serie {index + 1}, en segundos")" />
                                        }
                                        @if (fields.Distance)
                                        {
                                            <MudNumericField T="int?" @bind-Value="row.DistanceM" Label="Distancia (m)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                             Min="0" Max="1000000" HideSpinButtons="true" Immediate="true"
                                                             aria-label="@($"Distancia de la serie {index + 1}, en metros")" />
                                        }
                                        <MudNumericField T="int?" @bind-Value="row.Rir" Label="RIR" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                         Min="0" Max="10" HideSpinButtons="true" Immediate="true"
                                                         aria-label="@($"Repeticiones en reserva de la serie {index + 1}")" />
                                    </div>
                                </div>
                            }
                            <div class="gsm-m-ex__actions">
                                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="() => AddSet(state)">Serie</MudButton>
                                <span class="gsm-m-ex__spacer"></span>
                                @if (state.Done)
                                {
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" Disabled="state.Saving"
                                               OnClick="() => RemoveAsync(exercise, state)">Quitar registro</MudButton>
                                }
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="state.Saving"
                                           OnClick="() => SaveAsync(exercise, state)">
                                    @(state.Saving ? "Guardando..." : state.Done ? "Actualizar" : "Guardar")
                                </MudButton>
                            </div>
                        </div>
                    }
                </section>
            }
        }
    }

    @if (_response.Routine.Notes is { Length: > 0 } notes)
    {
        <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Class="mt-4">@notes</MudAlert>
    }
}

@code {
    private static string GroupsSuffix(IEnumerable<string>? groups)
        => RoutineLabels.MuscleGroupsSummary(groups) is { } summary ? $" ({summary})" : string.Empty;

    private MyRoutineResponse? _response;
    private readonly Dictionary<Guid, ExerciseState> _states = [];

    private sealed class SetRow
    {
        public string Type { get; set; } = "normal";
        public double? Weight { get; set; }
        public int? Reps { get; set; }
        public int? DurationSeconds { get; set; }
        public int? DistanceM { get; set; }
        public int? Rir { get; set; }
    }

    private sealed class ExerciseState
    {
        public List<SetRow> Rows { get; set; } = [];
        public bool Open { get; set; }
        public bool Done { get; set; }
        public bool Saving { get; set; }

        /// <summary>Alternativa elegida solo para hoy ("Hacer otro ejercicio hoy"); <c>null</c> = el ejercicio planeado.</summary>
        public ExerciseAlternativeResponse? Replacement { get; set; }
        public bool Picking { get; set; }
    }
    private bool _loading = true;
    private string? _createError;

    protected override async Task OnInitializedAsync()
    {
        if (GymCtx.FeatureFlags?.ShowRoutines == false)
        {
            _loading = false;
            return;
        }

        try
        {
            _response = await Me.RoutinesGETAsync();
            if (_response.Today is { IsRest: false } todayView)
            {
                await LoadTodayAsync(todayView);
            }
        }
        catch (GsmApiException ex) when (ex.StatusCode == 403)
        {
            // Sin rutina asignada y sin permiso de autoservicio: se queda vacío.
            _createError = "Pide a recepción que te asigne una rutina.";
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // Estado de cada ejercicio de hoy: una fila por serie planeada, con su objetivo como punto de partida.
    private ExerciseState StateOf(RoutineExerciseResponse exercise)
    {
        if (!_states.TryGetValue(exercise.Id, out var state))
        {
            var rows = exercise.SetTargets.OrderBy(t => t.Number).Select(t => new SetRow
            {
                Type = (t.SetType ?? "normal").ToLowerInvariant(),
                Weight = t.WeightKg,
                Reps = t.RepsMin,
                DurationSeconds = t.DurationSeconds,
                DistanceM = t.DistanceM,
            }).ToList();
            state = new ExerciseState { Rows = rows.Count > 0 ? rows : [new SetRow()] };
            _states[exercise.Id] = state;
        }

        return state;
    }

    // Planeado vs hecho, serie contra serie (las filas sobrantes son extras).
    private static IReadOnlyList<SetOutcome> OutcomesOf(RoutineExerciseResponse exercise, ExerciseState state)
        => SetPlan.CompareAll(
            exercise.SetTargets,
            state.Rows.Select(r => new DoneSet(r.Reps, r.Weight, r.DurationSeconds, r.DistanceM, r.Rir)).ToList());

    private static IEnumerable<SetRow> RowsFor(string? tracking)
        => DraftSet.DefaultsFor(tracking).Select(d => new SetRow
        {
            Reps = d.RepsMin,
            DurationSeconds = d.DurationSeconds,
            DistanceM = d.DistanceM,
        });

    // El reemplazo vale solo hoy: las series de partida son las del ejercicio elegido, no las del plan.
    private static Task ChooseReplacement(RoutineExerciseResponse exercise, ExerciseState state, ExerciseAlternativeResponse alt)
    {
        state.Replacement = alt;
        state.Picking = false;
        state.Rows = RowsFor(alt.TrackingType).ToList();
        return Task.CompletedTask;
    }

    private static void ClearReplacement(RoutineExerciseResponse exercise, ExerciseState state)
    {
        state.Replacement = null;
        state.Rows = exercise.SetTargets.OrderBy(t => t.Number).Select(t => new SetRow
        {
            Type = (t.SetType ?? "normal").ToLowerInvariant(),
            Weight = t.WeightKg,
            Reps = t.RepsMin,
            DurationSeconds = t.DurationSeconds,
            DistanceM = t.DistanceM,
        }).ToList();
    }

    private static void AddSet(ExerciseState state)
    {
        var last = state.Rows.LastOrDefault();
        state.Rows.Add(new SetRow
        {
            Type = last?.Type ?? "normal",
            Weight = last?.Weight,
            Reps = last?.Reps,
            DurationSeconds = last?.DurationSeconds,
            DistanceM = last?.DistanceM,
            Rir = last?.Rir,
        });
    }

    // Lo ya registrado hoy se carga al abrir la pantalla, para poder corregirlo y no perderlo al recargar.
    private async Task LoadTodayAsync(TodayView today)
    {
        try
        {
            var logged = await Me.HistoryAsync(today.Date, today.Date);
            foreach (var item in logged)
            {
                var exercise = today.Exercises.FirstOrDefault(e => e.Id == item.RoutineExerciseId);
                if (exercise is null)
                {
                    continue;
                }

                var state = StateOf(exercise);
                state.Done = true;
                if (item.PlannedExerciseId is not null && item.ExerciseId != exercise.ExerciseId)
                {
                    state.Replacement = await FindAlternativeAsync(exercise.ExerciseId, item.ExerciseId, item.ExerciseName);
                }

                if (item.Sets is { Count: > 0 } sets)
                {
                    state.Rows = sets.OrderBy(x => x.Number).Select(x => new SetRow
                    {
                        Type = (x.SetType ?? "normal").ToLowerInvariant(),
                        Weight = x.WeightKg,
                        Reps = x.Reps,
                        DurationSeconds = x.DurationSeconds,
                        DistanceM = x.DistanceM,
                        Rir = x.Rir,
                    }).ToList();
                }
            }
        }
        catch (GsmApiException)
        {
            // Sin historial se muestra la rutina igual, solo que sin lo ya marcado.
        }
    }

    private async Task<ExerciseAlternativeResponse> FindAlternativeAsync(Guid plannedId, Guid performedId, string name)
    {
        try
        {
            var found = (await ExercisesApi.AlternativesAllAsync(plannedId)).FirstOrDefault(a => a.Id == performedId);
            if (found is not null)
            {
                return found;
            }
        }
        catch (GsmApiException)
        {
            // Sin la lista se muestra el nombre y se miden los campos del plan.
        }

        return new ExerciseAlternativeResponse { Id = performedId, Name = name, TrackingType = "RepsWeight" };
    }

    private async Task SaveAsync(RoutineExerciseResponse exercise, ExerciseState state)
    {
        state.Saving = true;
        try
        {
            await RoutineExercises.LogPOSTAsync(exercise.Id, new LogRoutineExerciseRequest
            {
                ReplacementExerciseId = state.Replacement?.Id,
                Sets = state.Rows.Select(r => new LogSetRequest
                {
                    SetType = r.Type,
                    Reps = r.Reps,
                    WeightKg = r.Weight,
                    DurationSeconds = r.DurationSeconds,
                    DistanceM = r.DistanceM,
                    Rir = r.Rir,
                }).ToList(),
            });
            state.Done = true;
            state.Open = false;
            Snackbar.Add("Ejercicio registrado.", Severity.Success);
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            state.Saving = false;
        }
    }

    private async Task RemoveAsync(RoutineExerciseResponse exercise, ExerciseState state)
    {
        state.Saving = true;
        try
        {
            await RoutineExercises.LogDELETEAsync(exercise.Id);
            state.Done = false;
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            state.Saving = false;
        }
    }
}

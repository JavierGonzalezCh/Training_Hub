@page "/app/rutina"
@layout MemberLayout
@attribute [Authorize(Roles = GsmRoles.Member)]
@using GSM.UI.Shared.Formatting
@using GSM.UI.Shared.Routines
@inject GymContext GymCtx
@inject IMeClient Me
@inject IRoutineExercisesClient RoutineExercises
@inject IExercisesClient ExercisesApi
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject GSM.Client.Http.SessionEvents SessionEvents
@implements IDisposable

<PageTitle>Entrenar — TrainingHub GO</PageTitle>

@* Entrenamiento de hoy (botón central de la barra). Antes de empezar: el día, sus cifras, «Hoy trabajas» y la lista
   completa de ejercicios para ver el volumen de un vistazo (cada uno se abre para ver su mapa, el equipo y registrar).
   «Empezar» abre el modo sesión: un ejercicio por pantalla, series ya llenas que se guardan al tocar ✓, descanso que
   inicia el miembro y, al terminar, el resumen. El planificador de la semana vive en Plan (/app/plan). *@
@if (_session is not null && _response?.Today is { } sessionToday)
{
    @SessionView(sessionToday)
    return;
}
@if (GymCtx.FeatureFlags?.ShowRoutines == false)
{
    <MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-3">Entrenar</MudText>
    <MudAlert Severity="Severity.Normal">Las rutinas no están activadas en este gimnasio.</MudAlert>
}
else if (_loading)
{
    <GsmLoader />
}
else if (_response?.Routine is null)
{
    <MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-3">Entrenar</MudText>
    <div class="gsm-empty">
        <MudIcon Icon="@Icons.Material.Filled.FitnessCenter" Size="Size.Large" Class="gsm-empty-icon" />
        <div class="gsm-empty-title">Todavía no tienes una rutina</div>
        @if (_createError is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true">@_createError</MudAlert>
        }
        else if (GymCtx.FeatureFlags?.MembersCanCreateRoutines == true)
        {
            <MudText Typo="Typo.body2">Arma la tuya y llévala contigo a cada entrenamiento.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       Href="/app/rutina/nueva" Class="mt-2">
                Crear mi rutina
            </MudButton>
        }
        else
        {
            <MudText Typo="Typo.body2">Pídele una a tu entrenador y aparecerá aquí.</MudText>
        }
    </div>
}
else
{
    var heroDay = ShownDay();
    var heroToday = _response.Today;
    var heroExercises = heroDay?.Exercises ?? (heroToday is { IsRest: false } ? heroToday.Exercises : []);
    var heroName = heroDay?.Name ?? heroToday?.DayName ?? _response.Routine.Name;
    var heroSets = heroExercises.Sum(e => Math.Max(1, e.SetTargets.Count));
    var heroFirst = heroExercises.FirstOrDefault();
    @* Encabezado: la foto del día y lo importante de la rutina. *@
    <section class="gsm-m-dayhero" data-testid="day-hero"
             style="background-image:url('@(heroFirst is not null ? PlaceholderMedia.Exercise(heroFirst.ImageUrl, heroFirst.PrimaryMuscle, 900) : heroDay is null && heroToday is { IsRest: true } ? PlaceholderMedia.Rest : PlaceholderMedia.Gym)')">
        <div class="gsm-m-dayhero__top">
            <span class="gsm-m-chip-glass">@_response.Routine.Name</span>
            <a class="gsm-m-chip-glass" href="/app/progreso?tab=fuerza" data-testid="progress-link">
                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" /> Tus récords
            </a>
        </div>
        <div class="gsm-m-dayhero__body">
            <span class="gsm-m-card__kicker">
                @(heroDay is not null ? "Día elegido" : heroToday is null ? "Tu rutina" : $"Hoy{(_response.Routine.ScheduleMode == "weekly" ? $" · {RoutineLabels.IsoWeekdayLabel(heroToday.DayOfWeek)}" : "")}")
            </span>
            <h1 class="gsm-m-dayhero__title">@(heroDay is null && heroToday is { IsRest: true } ? "Descanso" : heroName)</h1>
            @if (heroExercises.Count > 0)
            {
                <div class="gsm-m-dayhero__chips">
                    <span class="gsm-m-chip-glass">@heroExercises.Count ejercicios</span>
                    <span class="gsm-m-chip-glass">@heroSets series</span>
                    <span class="gsm-m-chip-glass">~@(Math.Max(10, (int)Math.Round(heroSets * 2.5 / 5) * 5)) min</span>
                </div>
            }
            @if (_response.Routine is { SelfAssigned: false, ReviewOn: { } reviewOn })
            {
                <span class="gsm-m-dayhero__meta" data-testid="routine-review-on">Tu rutina se revisa el @GsmFormat.Day(reviewOn)</span>
            }
        </div>
    </section>

    @* Las observaciones son para entrenar: en un día de descanso (sin un día elegido en Plan) no se muestran aquí;
       siguen en Plan. *@
    @if (heroDay is not null || heroToday is not { IsRest: true })
    {
        <RoutineNoteCard Notes="@_response.Routine.Notes" SelfAssigned="@_response.Routine.SelfAssigned" />
    }

    @if (_response.MissedSession is { } missedSession)
    {
        <MissedSessionCard @key="missedSession.MissedOn" Missed="missedSession" TodayName="@(_response.Today?.DayName ?? "la de hoy")"
                           OnDoDay="SelectDay" OnRecovered="OnRecoveredAsync" />
    }
    @if (_response.Today is { } today)
    {
        @if (today.PlannedDayName is { } plannedName)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2" data-testid="today-changed">
                Hoy haces <strong>@today.DayName</strong> en lugar de @plannedName: cuenta como la rutina de hoy.
            </MudAlert>
        }

        var shownDay = ShownDay();
        @if (shownDay is not null)
        {
            @* Eligió en Plan un día que no es el de hoy: se le recuerda cuál le toca y puede volver a él. *@
            <section class="gsm-m-card gsm-m-alert gsm-m-otherday" data-testid="other-day-notice">
                <span class="gsm-m-card__icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.SwapHoriz" /></span>
                <div class="gsm-m-card__body">
                    @if (today.IsRest)
                    {
                        <h2 class="gsm-m-card__title">Hoy es tu día de descanso</h2>
                        <p class="gsm-m-card__text">Vas a hacer <strong>@shownDay.Name</strong>. Se guarda con la fecha de hoy, pero no cuenta en tu cumplimiento.</p>
                    }
                    else
                    {
                        <h2 class="gsm-m-card__title">Hoy es tu día de @today.DayName</h2>
                        <p class="gsm-m-card__text">¿Empiezas con <strong>@shownDay.Name</strong> o cambias a la de tu día? Si haces otra, no cuenta como la de hoy en tu cumplimiento.</p>
                        <div class="gsm-m-otherday__actions">
                            <button type="button" class="gsm-m-chip" data-testid="back-to-today" @onclick="BackToToday">Cambiar a @today.DayName</button>
                        </div>
                    }
                </div>
            </section>
        }
        else if (today.IsRest)
        {
            <section class="gsm-m-card" data-testid="rest-today" style="align-items:flex-start">

                <span class="gsm-m-card__icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.SelfImprovement" /></span>
                <div class="gsm-m-card__body">
                    <h2 class="gsm-m-card__title">Hoy descansas</h2>
                    @* Recuperación activa: cardio suave y corto, que no compite con la recuperación de los músculos. *@
                    <p class="gsm-m-card__text" data-testid="rest-advice">
                        Descansar es tan importante como entrenar: es cuando tus músculos se recuperan y se hacen más fuertes.
                    </p>
                    <p class="gsm-m-card__text">
                        Si quieres moverte, te recomendamos cardio suave: 20 a 30 minutos de caminata, bicicleta o elíptica a un
                        ritmo en el que puedas conversar.
                    </p>
                    <p class="gsm-m-card__text">Si prefieres entrenar, elige una sesión de tu plan.</p>
                    <a class="gsm-m-chip mt-2 d-inline-flex" href="/app/plan" data-testid="pick-plan-day">Elegir una sesión</a>
                </div>
            </section>
        }

        var shown = shownDay?.Exercises ?? (today.IsRest ? [] : today.Exercises);
        @if (shown.Count > 0)
        {
            var (dayPrimary, daySecondary) = MusclesOf(shown);
            <section class="gsm-m-card gsm-m-worked" data-testid="today-muscles">
                <MuscleMap Primary="dayPrimary" Secondary="daySecondary" Compact="true" Label="Músculos que trabajas hoy" />
                <div class="gsm-m-card__body">
                    <span class="gsm-m-card__kicker">Hoy trabajas</span>
                    <h2 class="gsm-m-card__title">@MuscleLabels.Capitalize(MuscleLabels.Join(dayPrimary.Take(3)))</h2>
                    @if (daySecondary.Count > 0)
                    {
                        <p class="gsm-m-card__text">También: @MuscleLabels.Join(daySecondary.Take(5))</p>
                    }
                </div>
            </section>
        }
        @if (shown.Count > 0 && GymCtx.FeatureFlags?.RoutineEntry == true)
        {
            <div class="mb-4">
                <TrainingEntryCard CountedAt="_countedAt" />
            </div>
        }

        @if (shown.Count > 0)
        {
            var totalSets = shown.Sum(e => Math.Max(1, e.SetTargets.Count));
            var doneCount = shown.Count(e => StateOf(e).Done);
            <div class="gsm-m-startbar" data-testid="start-bar">
                @if (doneCount > 0)
                {
                    <span class="gsm-m-startbar__summary">@doneCount de @shown.Count ejercicios hechos</span>
                }
                <button type="button" class="gsm-m-cta" data-testid="start-day" @onclick="() => StartSessionAsync(shown, shownDay?.Name ?? today.DayName)">
                    <BarbellIcon Width="34" />
                    <span>@(doneCount == 0 ? $"Empezar {shownDay?.Name ?? today.DayName}" : doneCount < shown.Count ? "Continuar el entrenamiento" : "Ver el resumen")</span>
                </button>
            </div>
        }

        @if (shown.Count > 0)
        {
            var groupLabels = SetPlan.GroupLabels(shown);
            @foreach (var exercise in shown)
            {
                var state = StateOf(exercise);
                var fields = TrackingFields.Of(state.Replacement?.TrackingType ?? exercise.TrackingType);
                var unilateral = state.Replacement?.IsUnilateral ?? exercise.IsUnilateral == true;
                var targets = exercise.SetTargets.OrderBy(t => t.Number).ToList();
                var outcomes = OutcomesOf(exercise, state);
                var inGroup = groupLabels.TryGetValue(exercise.Id, out var groupLabel);
                <section class="gsm-m-ex @(state.Done ? "is-done" : null) @(inGroup ? "gsm-m-ex--grouped" : null)" data-testid="@($"ex-{exercise.Id}")">
                    <div class="gsm-m-ex__row">
                    <button type="button" class="gsm-m-ex__head" aria-expanded="@(state.Open ? "true" : "false")"
                            @onclick="() => state.Open = !state.Open">
                        <span class="gsm-m-ex__thumb" style="background-image:url('@PlaceholderMedia.Exercise(exercise.ImageUrl, exercise.PrimaryMuscle, 700)')" aria-hidden="true">
                            @if (state.Done)
                            {
                                <span class="gsm-m-ex__done"><MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" /></span>
                            }
                        </span>
                        <span class="gsm-m-ex__title">
                            <span class="gsm-m-ex__name">@(state.Replacement?.Name ?? exercise.ExerciseName)@(inGroup ? $" · superserie {groupLabel}" : "")</span>
                            @if (state.Replacement is not null)
                            {
                                <span class="gsm-m-ex__target" data-testid="@($"replaced-{exercise.Id}")">Hoy en lugar de @exercise.ExerciseName</span>
                            }
                            <span class="gsm-m-ex__target">
                                Meta: @SetPlan.Summary(targets, exercise.IsUnilateral == true, withRir: false)@(exercise.RestSeconds is { } rest ? (inGroup ? $" · descanso por vuelta {rest} s" : $" · descanso {rest} s") : "")
                            </span>
                            @if (EquipmentNotice.Warning(exercise.Equipment) is { } headWarning)
                            {
                                <span class="gsm-m-ex__target" style="color:var(--mud-palette-warning)" data-testid="@($"unavailable-{exercise.Id}")">@headWarning</span>
                            }
                            @if (state.Done)
                            {
                                <span class="gsm-m-ex__target" data-testid="@($"progress-{exercise.Id}")">@SetPlan.ProgressText(outcomes)</span>
                            }
                        </span>
                        <MudIcon Icon="@(state.Open ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" />
                    </button>
                    <MudIconButton Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Small" Class="gsm-m-ex__swap"
                                   aria-label="@($"Cambiar {exercise.ExerciseName} por otro ejercicio hoy")" aria-pressed="@(state.Picking ? "true" : "false")"
                                   data-testid="@($"swap-{exercise.Id}")" OnClick="() => OpenSwap(state)" />
                    </div>

                    @if (state.Open)
                    {
                        <div class="gsm-m-ex__body">
                            @if (exercise.PrimaryMuscle is { } primaryMuscle)
                            {
                                <div class="gsm-m-ex__muscles" data-testid="@($"muscles-{exercise.Id}")">
                                    <MuscleMap Primary="[primaryMuscle]" Secondary="exercise.SecondaryMuscles" Compact="true" Label="@($"Músculos de {exercise.ExerciseName}")" />
                                    <div>
                                        <div><span class="gsm-m-dot is-hot"></span>Principal: @MuscleLabels.Label(primaryMuscle)</div>
                                        @if (exercise.SecondaryMuscles is { Count: > 0 } secondary)
                                        {
                                            <div class="gsm-m-ex__sub"><span class="gsm-m-dot is-warm"></span>Secundarios: @MuscleLabels.Join(secondary)</div>
                                        }
                                    </div>
                                </div>
                            }
                            @if (exercise.Equipment is { } equipment)
                            {
                                var machine = EquipmentNotice.Primary(equipment);
                                <div class="gsm-m-equip" data-testid="@($"equipment-{exercise.Id}")">
                                    @if (machine is not null)
                                    {
                                        <div class="gsm-m-equip__row">
                                            @if (machine.PhotoUrl is { Length: > 0 } photo)
                                            {
                                                <img class="gsm-m-equip__photo" src="@photo" alt="@machine.Name" loading="lazy" />
                                            }
                                            else
                                            {
                                                <img class="gsm-m-equip__photo" src="@EquipmentPlaceholder.DataUri(machine.Type)" alt="" loading="lazy" />
                                            }
                                            <div class="gsm-m-equip__text">
                                                <strong data-testid="equipment-name">@machine.Name</strong>
                                                @if (machine.Instructions is { Length: > 0 } instructions)
                                                {
                                                    <p data-testid="equipment-instructions">@instructions</p>
                                                }
                                            </div>
                                        </div>
                                    }
                                    @if (EquipmentNotice.Warning(equipment) is { } warning)
                                    {
                                        <MudAlert Severity="Severity.Warning" Dense="true" data-testid="equipment-warning">@warning</MudAlert>
                                    }
                                    @if (equipment.Machines is { Count: > 0 } reportable)
                                    {
                                        <EquipmentReport Machines="reportable.ToList()" />
                                    }
                                </div>
                            }
                            <div class="gsm-m-ex__actions">
                                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.SwapHoriz"
                                           data-testid="@($"other-{exercise.Id}")"
                                           OnClick="() => state.Picking = !state.Picking">Hacer otro ejercicio hoy</MudButton>
                                @if (state.Replacement is not null)
                                {
                                    <MudButton Variant="Variant.Text" Size="Size.Small" data-testid="@($"undo-other-{exercise.Id}")"
                                               OnClick="() => ClearReplacement(exercise, state)">Volver al planeado</MudButton>
                                }
                            </div>
                            @if (state.Picking)
                            {
                                <AlternativePicker ExerciseId="exercise.ExerciseId" TestIdPrefix="@($"ex-{exercise.Id}-")"
                                                   OnPick="@(alt => ChooseReplacement(exercise, state, alt))" />
                            }
                            @for (var n = 0; n < state.Rows.Count; n++)
                            {
                                var row = state.Rows[n];
                                var index = n;
                                var target = index < targets.Count ? targets[index] : null;
                                <div class="gsm-m-setrow" data-testid="@($"setrow-{exercise.Id}-{index}")">
                                    <div class="gsm-m-setrow__head">
                                        <span class="gsm-m-set__num">@(index + 1)</span>
                                        <span class="gsm-m-setrow__plan">
                                            @(target is null ? "Serie extra" : SetPlan.Describe(target, exercise.IsUnilateral == true, withRir: false))
                                        </span>
                                        @if (state.Done)
                                        {
                                            <span class="gsm-m-setrow__status is-@(outcomes[index].ToString().ToLowerInvariant())" data-testid="@($"outcome-{exercise.Id}-{index}")">@SetPlan.OutcomeLabel(outcomes[index])</span>
                                        }
                                        <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small"
                                                       Disabled="state.Rows.Count <= 1" aria-label="@($"Quitar la serie {index + 1}")"
                                                       OnClick="() => state.Rows.RemoveAt(index)" />
                                    </div>
                                    <div class="gsm-m-setrow__fields">
                                        @if (fields.Weight)
                                        {
                                            <MudNumericField T="double?" @bind-Value="row.Weight" Label="Peso (kg)" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="@target?.WeightKg?.ToString()"
                                                             Min="0" Max="1000" Step="2.5" HideSpinButtons="true" Immediate="true"
                                                             aria-label="@($"Peso de la serie {index + 1}, en kilos")" />
                                        }
                                        @if (fields.Reps)
                                        {
                                            <MudNumericField T="int?" @bind-Value="row.Reps" Label="@(unilateral ? "Reps por lado" : "Reps")" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="@target?.RepsMin?.ToString()"
                                                             Min="0" Max="500" HideSpinButtons="true" Immediate="true"
                                                             aria-label="@($"Repeticiones de la serie {index + 1}")" />
                                        }
                                        @if (fields.Time)
                                        {
                                            <MudNumericField T="int?" @bind-Value="row.DurationSeconds" Label="Tiempo (s)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                             Min="0" Max="86400" HideSpinButtons="true" Immediate="true"
                                                             aria-label="@($"Tiempo de la serie {index + 1}, en segundos")" />
                                        }
                                        @if (fields.Distance)
                                        {
                                            <MudNumericField T="int?" @bind-Value="row.DistanceM" Label="Distancia (m)" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                             Min="0" Max="1000000" HideSpinButtons="true" Immediate="true"
                                                             aria-label="@($"Distancia de la serie {index + 1}, en metros")" />
                                        }
                                    </div>
                                </div>
                            }
                            <div class="gsm-m-ex__actions">
                                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="() => AddSet(state)">Serie</MudButton>
                                <span class="gsm-m-ex__spacer"></span>
                                @if (state.Done)
                                {
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" Disabled="state.Saving"
                                               OnClick="() => RemoveAsync(exercise, state)">Quitar registro</MudButton>
                                }
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="state.Saving"
                                           OnClick="() => SaveAsync(exercise, state)">
                                    @(state.Saving ? "Guardando..." : state.Done ? "Actualizar" : "Guardar")
                                </MudButton>
                            </div>
                        </div>
                    }
                </section>
            }
        }
    }
}

@code {
    private static string GroupsSuffix(IEnumerable<string>? groups)
        => RoutineLabels.MuscleGroupsSummary(groups) is { } summary ? $" ({summary})" : string.Empty;

    private MyRoutineResponse? _response;
    private RoutineWeekPlanner? _planner;

    /// <summary>Un día del plan pedido desde Plan (<c>?dia=</c>): se abre para hacerlo hoy.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "dia")]
    public Guid? Dia { get; set; }

    // Principales y secundarios de un grupo de ejercicios, sin repetir (un principal no se repite como secundario).
    private static (List<string> Primary, List<string> Secondary) MusclesOf(IEnumerable<RoutineExerciseResponse> exercises)
    {
        var list = exercises.ToList();
        var primary = list.Select(e => e.PrimaryMuscle).Where(m => m is not null).Select(m => m!).Distinct().ToList();
        var secondary = list.SelectMany(e => e.SecondaryMuscles ?? []).Distinct().Where(m => !primary.Contains(m)).ToList();
        return (primary, secondary);
    }

    // El día del plan que toca hoy (null en descanso): el planificador lo trata como "hoy".
    private Guid? TodayDayId => _response?.Today is { IsRest: false } todayView ? DayOf(todayView)?.Id : null;

    // Abre el primer ejercicio sin registrar (y cierra los demás) para empezar o seguir.
    private void StartNext(IEnumerable<RoutineExerciseResponse> exercises)
    {
        var next = exercises.FirstOrDefault(e => !StateOf(e).Done);
        foreach (var e in exercises)
        {
            StateOf(e).Open = ReferenceEquals(e, next);
        }
    }

    private static void OpenSwap(ExerciseState state)
    {
        state.Open = true;
        state.Picking = !state.Picking;
    }
    private readonly Dictionary<Guid, ExerciseState> _states = [];

    private sealed class SetRow
    {
        /// <summary>Modo sesión: la serie está marcada como hecha (y guardada).</summary>
        public bool Done { get; set; }
        public string Type { get; set; } = "normal";
        public double? Weight { get; set; }
        public int? Reps { get; set; }
        public int? DurationSeconds { get; set; }
        public int? DistanceM { get; set; }
        public int? Rir { get; set; }
    }

    private sealed class ExerciseState
    {
        public List<SetRow> Rows { get; set; } = [];
        public bool Open { get; set; }
        public bool Done { get; set; }
        public bool Saving { get; set; }

        /// <summary>Alternativa elegida solo para hoy ("Hacer otro ejercicio hoy"); <c>null</c> = el ejercicio planeado.</summary>
        public ExerciseAlternativeResponse? Replacement { get; set; }
        public bool Picking { get; set; }
    }
    private bool _loading = true;
    private DateTimeOffset? _countedAt;
    private string? _createError;

    /// <summary>SP1: el día del plan que el miembro eligió hacer hoy; <c>null</c> = el que toca hoy.</summary>
    private Guid? _selectedDayId;

    // Los días de entrenamiento del plan, menos el de hoy (ese es el chip "Hoy").
    private List<RoutineDayResponse> TrainingDays()
    {
        var days = _response?.Routine?.Days.Where(d => !d.IsRest && d.Exercises.Count > 0) ?? [];
        var todayView = _response?.Today;
        var todayDay = todayView is { IsRest: false } ? DayOf(todayView) : null;
        return days.Where(d => d.Id != todayDay?.Id)
            .OrderBy(d => d.DayOfWeek ?? d.Position).ThenBy(d => d.Position).ToList();
    }

    private RoutineDayResponse? ShownDay()
        => _selectedDayId is { } id ? _response?.Routine?.Days.FirstOrDefault(d => d.Id == id) : null;

    // El día del plan que corresponde a hoy: el que manda el servidor (con el cambio del miembro, SP) o, en clientes
    // anteriores, el mismo día de la semana (semanal) o la misma posición (rotativo).
    private RoutineDayResponse? DayOf(TodayView today)
        => today.DayId is { } dayId
            ? _response?.Routine?.Days.FirstOrDefault(d => d.Id == dayId)
            : _response?.Routine?.Days.FirstOrDefault(d => _response.Routine.ScheduleMode == "weekly"
            ? d.DayOfWeek == today.DayOfWeek
            : d.Position == today.Position);

    private string DayLabel(RoutineDayResponse day)
        => day.DayOfWeek is { } weekday && _response?.Routine?.ScheduleMode == "weekly"
            ? $"{RoutineLabels.IsoWeekdayLabel(weekday)} · {day.Name}"
            : day.Name;

    private void SelectDay(Guid? dayId) => _selectedDayId = dayId;

    // Deja el día elegido en Plan y vuelve al que toca hoy (también quita ?dia= de la dirección).
    private void BackToToday()
    {
        _selectedDayId = null;
        Navigation.NavigateTo("/app/rutina", replace: true);
    }

    private void SelectDay(Guid dayId) => _selectedDayId = dayId;

    // SP3: guardó el cambio; hoy ya muestra la rutina recuperada.
    private async Task OnRecoveredAsync(MyRoutineResponse response)
    {
        _response = response;
        _selectedDayId = null;
        _states.Clear();
        if (response.Today is { } todayView)
        {
            await LoadTodayAsync(todayView);
        }

        if (_planner is not null)
        {
            await _planner.RefreshAsync();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (GymCtx.FeatureFlags?.ShowRoutines == false)
        {
            _loading = false;
            return;
        }

        SessionEvents.EndedWhileHeld += OnSessionEndedWhileTraining;

        // Series que quedaron en este equipo sin poder enviarse (sin red o con la sesión cerrada): se envían primero,
        // para que lo que se carga a continuación ya las incluya.
        await LoadPendingAsync();
        await FlushPendingAsync();

        try
        {
            _response = await Me.RoutinesGETAsync();
            if (_response.Today is { } todayView)
            {
                await LoadTodayAsync(todayView);
            }

            if (Dia is { } wanted && wanted != TodayDayId && _response.Routine?.Days.Any(d => d.Id == wanted && !d.IsRest) == true)
            {
                _selectedDayId = wanted;
            }

            if (_response.Today is not null)
            {
                if (GymCtx.FeatureFlags?.RoutineEntry == true)
                {
                    // A8: ¿el día ya cuenta? (lo pudo marcar desde el inicio o recepción).
                    var entry = (await Me.GetMyHomeAsync()).Entry;
                    _countedAt = entry is { CheckedInToday: true } ? entry.CheckedInAt : null;
                }
            }
        }
        catch (GsmApiException ex) when (ex.StatusCode == 403)
        {
            // Sin rutina asignada y sin permiso de autoservicio: se queda vacío.
            _createError = "Pide a recepción que te asigne una rutina.";
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // Estado de cada ejercicio de hoy: una fila por serie planeada, con su objetivo como punto de partida.
    private ExerciseState StateOf(RoutineExerciseResponse exercise)
    {
        if (!_states.TryGetValue(exercise.Id, out var state))
        {
            var rows = exercise.SetTargets.OrderBy(t => t.Number).Select(t => new SetRow
            {
                Type = (t.SetType ?? "normal").ToLowerInvariant(),
            }).ToList();
            state = new ExerciseState { Rows = rows.Count > 0 ? rows : [new SetRow()] };
            _states[exercise.Id] = state;
        }

        return state;
    }

    // Planeado vs hecho, serie contra serie (las filas sobrantes son extras).
    private static IReadOnlyList<SetOutcome> OutcomesOf(RoutineExerciseResponse exercise, ExerciseState state)
        => SetPlan.CompareAll(
            exercise.SetTargets,
            state.Rows.Select(r => new DoneSet(r.Reps, r.Weight, r.DurationSeconds, r.DistanceM, r.Rir)).ToList());

    private static IEnumerable<SetRow> RowsFor(string? tracking)
        => DraftSet.DefaultsFor(tracking).Select(_ => new SetRow());

    // El reemplazo vale solo hoy: las series de partida son las del ejercicio elegido, no las del plan.
    private static Task ChooseReplacement(RoutineExerciseResponse exercise, ExerciseState state, ExerciseAlternativeResponse alt)
    {
        state.Replacement = alt;
        state.Picking = false;
        state.Rows = RowsFor(alt.TrackingType).ToList();
        return Task.CompletedTask;
    }

    private static void ClearReplacement(RoutineExerciseResponse exercise, ExerciseState state)
    {
        state.Replacement = null;
        state.Rows = exercise.SetTargets.OrderBy(t => t.Number).Select(t => new SetRow
        {
            Type = (t.SetType ?? "normal").ToLowerInvariant(),
        }).ToList();
    }

    private static void AddSet(ExerciseState state)
    {
        var last = state.Rows.LastOrDefault();
        state.Rows.Add(new SetRow
        {
            Type = last?.Type ?? "normal",
            Weight = last?.Weight,
            Reps = last?.Reps,
            DurationSeconds = last?.DurationSeconds,
            DistanceM = last?.DistanceM,
            Rir = last?.Rir,
        });
    }

    // Lo ya registrado hoy se carga al abrir la pantalla, para poder corregirlo y no perderlo al recargar. Incluye lo
    // registrado de otro día del plan (SP1): esa rutina se abre sola para que el miembro la encuentre.
    private async Task LoadTodayAsync(TodayView today)
    {
        try
        {
            var logged = await Me.HistoryAsync(today.Date, today.Date);
            var todayIds = today.IsRest ? [] : today.Exercises.Select(e => e.Id).ToHashSet();
            foreach (var item in logged)
            {
                var exercise = today.Exercises.FirstOrDefault(e => e.Id == item.RoutineExerciseId);
                if (exercise is null)
                {
                    var otherDay = _response?.Routine?.Days.FirstOrDefault(d => d.Exercises.Any(e => e.Id == item.RoutineExerciseId));
                    exercise = otherDay?.Exercises.First(e => e.Id == item.RoutineExerciseId);
                    if (exercise is null)
                    {
                        continue;
                    }

                    if (!todayIds.Overlaps(logged.Select(l => l.RoutineExerciseId)))
                    {
                        _selectedDayId ??= otherDay!.Id;
                    }
                }

                var state = StateOf(exercise);
                state.Done = true;
                if (item.PlannedExerciseId is not null && item.ExerciseId != exercise.ExerciseId)
                {
                    state.Replacement = await FindAlternativeAsync(exercise.ExerciseId, item.ExerciseId, item.ExerciseName);
                }

                if (item.Sets is { Count: > 0 } sets)
                {
                    state.Rows = sets.OrderBy(x => x.Number).Select(x => new SetRow
                    {
                        Done = true,
                        Type = (x.SetType ?? "normal").ToLowerInvariant(),
                        Weight = x.WeightKg,
                        Reps = x.Reps,
                        DurationSeconds = x.DurationSeconds,
                        DistanceM = x.DistanceM,
                        Rir = x.Rir,
                    }).ToList();
                }
            }
        }
        catch (GsmApiException)
        {
            // Sin historial se muestra la rutina igual, solo que sin lo ya marcado.
        }
    }

    private async Task<ExerciseAlternativeResponse> FindAlternativeAsync(Guid plannedId, Guid performedId, string name)
    {
        try
        {
            var found = (await ExercisesApi.AlternativesAllAsync(plannedId)).FirstOrDefault(a => a.Id == performedId);
            if (found is not null)
            {
                return found;
            }
        }
        catch (GsmApiException)
        {
            // Sin la lista se muestra el nombre y se miden los campos del plan.
        }

        return new ExerciseAlternativeResponse { Id = performedId, Name = name, TrackingType = "RepsWeight" };
    }

    private async Task SaveAsync(RoutineExerciseResponse exercise, ExerciseState state)
    {
        if (state.Rows.All(r => r.Reps is null && r.Weight is null && r.DurationSeconds is null && r.DistanceM is null))
        {
            Snackbar.Add("Anota al menos una serie antes de guardar.", Severity.Warning);
            return;
        }

        state.Saving = true;
        try
        {
            await RoutineExercises.LogPOSTAsync(exercise.Id, new LogRoutineExerciseRequest
            {
                ReplacementExerciseId = state.Replacement?.Id,
                Sets = state.Rows.Where(r => r.Reps is not null || r.Weight is not null || r.DurationSeconds is not null || r.DistanceM is not null).Select(r => new LogSetRequest
                {
                    SetType = r.Type,
                    Reps = r.Reps,
                    WeightKg = r.Weight,
                    DurationSeconds = r.DurationSeconds,
                    DistanceM = r.DistanceM,
                    Rir = r.Rir,
                }).ToList(),
            });
            state.Done = true;
            state.Open = false;
            foreach (var saved in state.Rows.Where(HasValues))
            {
                saved.Done = true;
            }

            Snackbar.Add("Ejercicio registrado.", Severity.Success);
            if (_planner is not null)
            {
                await _planner.RefreshAsync();
            }
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            state.Saving = false;
        }
    }

    private async Task RemoveAsync(RoutineExerciseResponse exercise, ExerciseState state)
    {
        state.Saving = true;
        try
        {
            await RoutineExercises.LogDELETEAsync(exercise.Id);
            state.Done = false;
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            state.Saving = false;
        }
    }

    // ===================================================================================================
    // Modo sesión: un ejercicio por pantalla. Cada ✓ guarda las series hechas del ejercicio (el endpoint reemplaza el
    // registro del día, así que guardar por serie no necesita nada nuevo en la API). El descanso lo inicia el miembro.
    // ===================================================================================================

    private sealed class SessionState
    {
        public List<RoutineExerciseResponse> Exercises { get; init; } = [];
        public string DayName { get; init; } = string.Empty;
        public int Index { get; set; }
        public bool Summary { get; set; }
        public DateTimeOffset Start { get; set; }
        public List<string> NewRecords { get; } = [];
    }

    private SessionState? _session;
    private bool _extrasLoaded;
    private readonly Dictionary<Guid, (double? Weight, int? Reps)> _last = [];
    private readonly Dictionary<Guid, double> _best = [];
    private int? _restLeft;
    private CancellationTokenSource? _restCts;

    // Al cambiar de pantalla (empezar, otro ejercicio, resumen) se vuelve arriba: si no, se queda el scroll de la lista.
    private async Task ScrollTopAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("scrollTo", 0, 0);
        }
        catch (Exception)
        {
        }
    }

    private string SessionKey => $"gsm.session.{GsmFormat.Today():yyyy-MM-dd}";

    private static bool HasValues(SetRow r)
        => r.Reps is not null || r.Weight is not null || r.DurationSeconds is not null || r.DistanceM is not null;

    private Guid PerformedId(RoutineExerciseResponse exercise, ExerciseState state) => state.Replacement?.Id ?? exercise.ExerciseId;

    private async Task StartSessionAsync(IEnumerable<RoutineExerciseResponse> shown, string dayName)
    {
        var exercises = shown.ToList();
        await LoadExtrasAsync();
        var start = DateTimeOffset.UtcNow;
        try
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", SessionKey);
            if (DateTimeOffset.TryParse(saved, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var parsed))
            {
                start = parsed;
            }
            else
            {
                await JS.InvokeVoidAsync("localStorage.setItem", SessionKey, start.ToString("O"));
            }
        }
        catch (Exception)
        {
            // Sin almacenamiento local la duración cuenta desde ahora.
        }

        // Mientras entrena, nada lo saca de aquí: si la sesión se cierra, se avisa y se sigue; el login espera a que salga.
        _hold ??= SessionEvents.Hold();

        var firstPending = exercises.FindIndex(e => !StateOf(e).Done);
        _session = new SessionState
        {
            Exercises = exercises,
            DayName = dayName,
            Index = firstPending < 0 ? Math.Max(0, exercises.Count - 1) : firstPending,
            Summary = firstPending < 0,
            Start = start,
        };
        PrefillCurrent();
        await ScrollTopAsync();
    }

    // La última carga de cada ejercicio (últimos 120 días) y su mejor peso, para prellenar y avisar récords.
    private async Task LoadExtrasAsync()
    {
        if (_extrasLoaded)
        {
            return;
        }

        _extrasLoaded = true;
        try
        {
            var today = GsmFormat.Today();
            var history = await Me.HistoryAsync(today.AddDays(-120), today.AddDays(-1)) ?? [];
            foreach (var item in history.OrderBy(h => h.PerformedOn))
            {
                var first = item.Sets?.OrderBy(x => x.Number).FirstOrDefault(x => !string.Equals(x.SetType, "warmup", StringComparison.OrdinalIgnoreCase));
                if (first is not null)
                {
                    _last[item.ExerciseId] = (first.WeightKg, first.Reps);
                }
            }
        }
        catch (GsmApiException)
        {
        }

        try
        {
            foreach (var summary in await Me.GetMyProgressAsync() ?? [])
            {
                var best = summary.Records?.FirstOrDefault(r => r.Kind == "best_weight");
                if (best is not null)
                {
                    _best[summary.ExerciseId] = best.Value;
                }
            }
        }
        catch (GsmApiException)
        {
        }
    }

    // Las series sin hacer y vacías se llenan con la meta o con la última carga: casi siempre basta con tocar ✓.
    private void PrefillCurrent()
    {
        if (_session is not { Summary: false } session || session.Exercises.Count == 0)
        {
            return;
        }

        var exercise = session.Exercises[session.Index];
        var state = StateOf(exercise);
        var targets = state.Replacement is null ? exercise.SetTargets.OrderBy(t => t.Number).ToList() : [];
        _last.TryGetValue(PerformedId(exercise, state), out var last);
        for (var i = 0; i < state.Rows.Count; i++)
        {
            var row = state.Rows[i];
            if (row.Done || HasValues(row))
            {
                continue;
            }

            var target = i < targets.Count ? targets[i] : null;
            row.Weight = target?.WeightKg ?? last.Weight;
            row.Reps = target?.RepsMin ?? last.Reps;
            row.DurationSeconds = target?.DurationSeconds;
            row.DistanceM = target?.DistanceM;
        }
    }

    private async Task ToggleSetAsync(RoutineExerciseResponse exercise, ExerciseState state, SetRow row)
    {
        if (!row.Done && !HasValues(row))
        {
            Snackbar.Add("Anota el peso o las repeticiones de la serie.", Severity.Warning);
            return;
        }

        row.Done = !row.Done;
        state.Saving = true;
        var done = state.Rows.Where(r => r.Done).ToList();
        var request = done.Count == 0 ? null : new LogRoutineExerciseRequest
        {
            ReplacementExerciseId = state.Replacement?.Id,
            Sets = done.Select(r => new LogSetRequest
            {
                SetType = r.Type,
                Reps = r.Reps,
                WeightKg = r.Weight,
                DurationSeconds = r.DurationSeconds,
                DistanceM = r.DistanceM,
                Rir = r.Rir,
            }).ToList(),
        };
        try
        {
            if (_pending.ContainsKey(exercise.Id) || SessionEvents.EndPending)
            {
                // Ya hay algo de este ejercicio sin enviar (o la sesión está cerrada): se encola detrás, en orden.
                await QueueAsync(exercise.Id, request, state);
                return;
            }

            if (request is null)
            {
                if (state.Done)
                {
                    await RoutineExercises.LogDELETEAsync(exercise.Id);
                }

                state.Done = false;
                return;
            }

            await RoutineExercises.LogPOSTAsync(exercise.Id, request);
            state.Done = true;

            var performed = PerformedId(exercise, state);
            if (row.Done && row.Weight is { } weight && weight > 0
                && (!_best.TryGetValue(performed, out var best) || weight > best))
            {
                var hadRecord = _best.ContainsKey(performed);
                _best[performed] = weight;
                if (hadRecord)
                {
                    var name = state.Replacement?.Name ?? exercise.ExerciseName;
                    _session?.NewRecords.Add($"{name}: {weight:0.#} kg");
                    Snackbar.Add($"¡Nuevo récord en {name}: {weight:0.#} kg!", Severity.Success);
                }
            }
        }
        catch (Exception ex) when (IsTransient(ex))
        {
            // Sin red, la API reiniciándose o la sesión cerrada: la serie no se pierde. Queda en este equipo y se envía
            // sola en cuanto se pueda.
            await QueueAsync(exercise.Id, request, state);
        }
        catch (GsmApiException ex)
        {
            row.Done = !row.Done;
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            state.Saving = false;
        }
    }

    // ---------- Series sin enviar (modo sesión sin conexión) ----------

    private const string PendingKey = "gsm.pending-logs";

    /// <summary>
    /// Lo último que hay que enviar por cada línea de la rutina: el registro completo de sus series hechas, o nulo para
    /// borrarlo. Se guarda en este equipo para sobrevivir a recargar la página o a volver a iniciar sesión.
    /// </summary>
    private Dictionary<Guid, LogRoutineExerciseRequest?> _pending = [];
    private IDisposable? _hold;
    private CancellationTokenSource? _retryCts;
    private bool _flushing;

    private static bool IsTransient(Exception ex) => ex switch
    {
        GsmApiException api => api.StatusCode is 0 or 401 or 408 or 429 or >= 500,
        HttpRequestException => true,
        TaskCanceledException => true,
        _ => false,
    };

    private async Task QueueAsync(Guid routineExerciseId, LogRoutineExerciseRequest? request, ExerciseState state)
    {
        var wasEmpty = _pending.Count == 0;
        _pending[routineExerciseId] = request;
        state.Done = request is not null;
        await SavePendingAsync();
        if (wasEmpty)
        {
            Snackbar.Add(SessionEvents.EndPending
                ? "Tu sesión se cerró: la serie quedó guardada en este equipo y se enviará al volver a entrar."
                : "Sin conexión: la serie quedó guardada en este equipo y se enviará sola.", Severity.Warning);
        }

        StartRetryLoop();
    }

    private async Task LoadPendingAsync()
    {
        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", PendingKey);
            if (!string.IsNullOrEmpty(raw))
            {
                _pending = System.Text.Json.JsonSerializer.Deserialize<Dictionary<Guid, LogRoutineExerciseRequest?>>(raw) ?? [];
            }
        }
        catch (Exception)
        {
            // Sin almacenamiento local (o un valor dañado) no hay nada que reenviar.
            _pending = [];
        }
    }

    private async Task SavePendingAsync()
    {
        try
        {
            if (_pending.Count == 0)
            {
                await JS.InvokeVoidAsync("localStorage.removeItem", PendingKey);
            }
            else
            {
                await JS.InvokeVoidAsync("localStorage.setItem", PendingKey, System.Text.Json.JsonSerializer.Serialize(_pending));
            }
        }
        catch (Exception)
        {
            // Sin almacenamiento local la cola vive solo en memoria mientras la pantalla esté abierta.
        }
    }

    private async Task FlushPendingAsync()
    {
        if (_flushing || _pending.Count == 0 || SessionEvents.EndPending)
        {
            return;
        }

        _flushing = true;
        try
        {
            foreach (var (id, request) in _pending.ToList())
            {
                try
                {
                    if (request is null)
                    {
                        await RoutineExercises.LogDELETEAsync(id);
                    }
                    else
                    {
                        await RoutineExercises.LogPOSTAsync(id, request);
                    }

                    _pending.Remove(id);
                }
                catch (Exception ex) when (IsTransient(ex))
                {
                    break;
                }
                catch (GsmApiException)
                {
                    // El servidor lo rechazó (la línea ya no existe, un dato inválido): reenviarlo no lo arreglaría.
                    _pending.Remove(id);
                }
            }

            await SavePendingAsync();
        }
        finally
        {
            _flushing = false;
        }
    }

    private void StartRetryLoop()
    {
        if (_retryCts is not null)
        {
            return;
        }

        _retryCts = new CancellationTokenSource();
        var token = _retryCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                while (!token.IsCancellationRequested && _pending.Count > 0)
                {
                    await Task.Delay(TimeSpan.FromSeconds(20), token);
                    await InvokeAsync(async () =>
                    {
                        await FlushPendingAsync();
                        StateHasChanged();
                    });
                }
            }
            catch (TaskCanceledException)
            {
            }
            finally
            {
                _retryCts = null;
            }
        }, token);
    }

    private void OnSessionEndedWhileTraining() => _ = InvokeAsync(StateHasChanged);

    private async Task StartRestAsync(int seconds)
    {
        _restCts?.Cancel();
        var cts = new CancellationTokenSource();
        _restCts = cts;
        _restLeft = seconds;
        try
        {
            while (_restLeft > 0)
            {
                await Task.Delay(1000, cts.Token);
                _restLeft--;
                StateHasChanged();
            }

            _restLeft = null;
            Snackbar.Add("Descanso terminado: a la siguiente serie.", Severity.Info);
            try
            {
                await JS.InvokeVoidAsync("navigator.vibrate", 400);
            }
            catch (Exception)
            {
                // Sin vibración en este dispositivo.
            }

            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void StopRest()
    {
        _restCts?.Cancel();
        _restLeft = null;
    }

    private async Task Go(int delta)
    {
        if (_session is null)
        {
            return;
        }

        StopRest();
        _session.Index = Math.Clamp(_session.Index + delta, 0, _session.Exercises.Count - 1);
        PrefillCurrent();
        await ScrollTopAsync();
    }

    private async Task GoTo(int index)
    {
        if (_session is null)
        {
            return;
        }

        StopRest();
        _session.Summary = false;
        _session.Index = index;
        PrefillCurrent();
        await ScrollTopAsync();
    }

    private async Task FinishAsync()
    {
        if (_session is null)
        {
            return;
        }

        StopRest();
        _session.Summary = true;
        await ScrollTopAsync();
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", SessionKey);
        }
        catch (Exception)
        {
        }
    }

    private void ExitSession()
    {
        StopRest();
        _session = null;
        ReleaseHold();
    }

    private void ReleaseHold()
    {
        _hold?.Dispose();
        _hold = null;
    }

    public void Dispose()
    {
        _restCts?.Cancel();
        _retryCts?.Cancel();
        SessionEvents.EndedWhileHeld -= OnSessionEndedWhileTraining;
        ReleaseHold();
    }

    private RenderFragment SessionView(TodayView today) => __builder =>
    {
        var session = _session!;
        if (GymCtx.FeatureFlags?.RoutineEntry == true)
        {
            <MembershipLapsedNotice />
        }

        if (SessionEvents.EndPending)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" data-testid="session-offline">
                Tu sesión se cerró. Sigue entrenando: tus series quedan guardadas en este equipo y se envían cuando vuelvas a entrar.
            </MudAlert>
        }
        else if (_pending.Count > 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" data-testid="session-pending">
                Sin conexión: @(_pending.Count == 1 ? "1 ejercicio" : $"{_pending.Count} ejercicios") por enviar. Se guardan solos al volver la señal.
            </MudAlert>
        }

        if (session.Summary)
        {
            var exercises = session.Exercises;
            var done = exercises.Count(e => StateOf(e).Done);
            var rows = exercises.SelectMany(e => StateOf(e).Rows.Where(r => r.Done)).ToList();
            var volume = rows.Sum(r => (r.Weight ?? 0) * (r.Reps ?? 0));
            var minutes = Math.Max(1, (int)Math.Round((DateTimeOffset.UtcNow - session.Start).TotalMinutes));
            var (primary, secondary) = MusclesOf(exercises.Where(e => StateOf(e).Done));
            <section class="gsm-m-summary" data-testid="session-summary">
                <span class="gsm-m-card__kicker">@(done == exercises.Count ? "Sesión completa" : "Resumen de la sesión")</span>
                <h1 class="gsm-m-summary__title">@session.DayName</h1>
                <div class="gsm-m-kpis">
                    <div class="gsm-m-kpi"><b>@(minutes >= 300 ? "—" : $"{minutes}")</b><span>minutos</span></div>
                    <div class="gsm-m-kpi"><b>@done/@exercises.Count</b><span>ejercicios</span></div>
                    <div class="gsm-m-kpi"><b>@rows.Count</b><span>series</span></div>
                    <div class="gsm-m-kpi"><b>@(volume >= 1000 ? $"{volume / 1000:0.#} t" : $"{volume:0} kg")</b><span>volumen</span></div>
                </div>
                @if (primary.Count > 0)
                {
                    <div class="gsm-m-card gsm-m-worked">
                        <MuscleMap Primary="primary" Secondary="secondary" Compact="true" Label="Músculos que trabajaste" />
                        <div class="gsm-m-card__body">
                            <span class="gsm-m-card__kicker">Trabajaste</span>
                            <h2 class="gsm-m-card__title">@MuscleLabels.Capitalize(MuscleLabels.Join(primary.Take(4)))</h2>
                        </div>
                    </div>
                }
                @if (session.NewRecords.Count > 0)
                {
                    <div class="gsm-m-card gsm-m-records" data-testid="session-records">
                        <span class="gsm-m-card__icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.EmojiEvents" /></span>
                        <div class="gsm-m-card__body">
                            <h2 class="gsm-m-card__title">@(session.NewRecords.Count == 1 ? "Nuevo récord" : $"{session.NewRecords.Count} récords nuevos")</h2>
                            <p class="gsm-m-card__text">@string.Join(" · ", session.NewRecords)</p>
                        </div>
                    </div>
                }
                @if (done < exercises.Count)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                        Te faltaron @(exercises.Count - done == 1 ? "1 ejercicio" : $"{exercises.Count - done} ejercicios").
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => GoTo(exercises.FindIndex(e => !StateOf(e).Done)))">Volver a ellos</MudButton>
                    </MudAlert>
                }
                <a class="gsm-m-cta" href="/app" data-testid="session-done">Listo</a>
                <a class="gsm-m-secondary" href="/app/progreso?tab=fuerza">Ver mi progreso</a>
            </section>
            return;
        }

        var exercise = session.Exercises[session.Index];
        var state = StateOf(exercise);
        var fields = TrackingFields.Of(state.Replacement?.TrackingType ?? exercise.TrackingType);
        var unilateral = state.Replacement?.IsUnilateral ?? exercise.IsUnilateral == true;
        var targets = exercise.SetTargets.OrderBy(t => t.Number).ToList();
        _last.TryGetValue(PerformedId(exercise, state), out var last);
        var progress = (session.Index + 1) * 100 / Math.Max(1, session.Exercises.Count);
        var isLast = session.Index == session.Exercises.Count - 1;
        var rest = exercise.RestSeconds ?? 90;
        <section class="gsm-m-session" data-testid="session" aria-label="@($"Ejercicio {session.Index + 1} de {session.Exercises.Count}")">
            <div class="gsm-m-session__top">
                <span data-testid="session-position">Ejercicio @(session.Index + 1) de @session.Exercises.Count</span>
                <button type="button" class="gsm-m-session__exit" @onclick="ExitSession" data-testid="session-exit">
                    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" /> Salir
                </button>
            </div>
            <div class="gsm-m-session__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@progress" aria-label="Avance de la sesión">
                <span style="@($"width:{progress}%")"></span>
            </div>

            <div class="gsm-m-session__media" style="background-image:url('@PlaceholderMedia.Exercise(state.Replacement is null ? exercise.ImageUrl : null, exercise.PrimaryMuscle, 900)')">
                @if (exercise.PrimaryMuscle is { } muscle)
                {
                    <div class="gsm-m-session__map"><MuscleMap Primary="[muscle]" Secondary="exercise.SecondaryMuscles" Compact="true" Label="@($"Músculos de {exercise.ExerciseName}")" /></div>
                }
                @if (state.Replacement is null && exercise.VideoUrl is { Length: > 0 } video)
                {
                    <a class="gsm-m-session__video" href="@video" target="_blank" rel="noopener noreferrer">
                        <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Size="Size.Small" /> Ver video
                    </a>
                }
            </div>

            <div class="gsm-m-session__head">
                <div>
                    <h1 class="gsm-m-session__name" data-testid="session-exercise">@(state.Replacement?.Name ?? exercise.ExerciseName)</h1>
                    @if (state.Replacement is not null)
                    {
                        <span class="gsm-m-session__sub">Hoy en lugar de @exercise.ExerciseName</span>
                    }
                    <span class="gsm-m-session__sub">
                        Meta: @SetPlan.Summary(targets, exercise.IsUnilateral == true, withRir: false)@(last.Weight is not null || last.Reps is not null ? $" · la vez pasada {(last.Weight is { } lw ? $"{lw:0.#} kg" : "")}{(last.Weight is not null && last.Reps is not null ? " × " : "")}{last.Reps}" : "")
                    </span>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.SwapHoriz" aria-label="Cambiar por otro ejercicio hoy" aria-pressed="@(state.Picking ? "true" : "false")"
                               data-testid="session-swap" OnClick="@(() => state.Picking = !state.Picking)" />
            </div>
            @if (state.Picking)
            {
                <AlternativePicker ExerciseId="exercise.ExerciseId" TestIdPrefix="@($"session-{exercise.Id}-")"
                                   OnPick="@(async alt => { await ChooseReplacement(exercise, state, alt); PrefillCurrent(); })" />
                @if (state.Replacement is not null)
                {
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => { ClearReplacement(exercise, state); PrefillCurrent(); })">Volver al planeado</MudButton>
                }
            }
            @if (EquipmentNotice.Warning(exercise.Equipment) is { } warning)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">@warning</MudAlert>
            }

            <ol class="gsm-m-sets">
                @for (var n = 0; n < state.Rows.Count; n++)
                {
                    var row = state.Rows[n];
                    var index = n;
                    var target = index < targets.Count ? targets[index] : null;
                    <li class="gsm-m-set @(row.Done ? "is-done" : null)" data-testid="@($"session-set-{index}")">
                        <button type="button" class="gsm-m-set__check" disabled="@state.Saving"
                                aria-pressed="@(row.Done ? "true" : "false")"
                                aria-label="@($"Serie {index + 1} {(row.Done ? "hecha; tocar para desmarcar" : "por hacer; tocar al terminarla")}")"
                                data-testid="@($"session-check-{index}")"
                                @onclick="() => ToggleSetAsync(exercise, state, row)">
                            @if (row.Done)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Check" />
                            }
                            else
                            {
                                <span>@(index + 1)</span>
                            }
                        </button>
                        <div class="gsm-m-set__fields">
                            @if (fields.Weight)
                            {
                                <MudNumericField T="double?" @bind-Value="row.Weight" Label="kg" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 Min="0" Max="1000" Step="2.5" HideSpinButtons="true" Immediate="true" ReadOnly="row.Done"
                                                 aria-label="@($"Peso de la serie {index + 1}, en kilos")" />
                            }
                            @if (fields.Reps)
                            {
                                <MudNumericField T="int?" @bind-Value="row.Reps" Label="@(unilateral ? "reps/lado" : "reps")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 Min="0" Max="500" HideSpinButtons="true" Immediate="true" ReadOnly="row.Done"
                                                 aria-label="@($"Repeticiones de la serie {index + 1}")" />
                            }
                            @if (fields.Time)
                            {
                                <MudNumericField T="int?" @bind-Value="row.DurationSeconds" Label="seg" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 Min="0" Max="86400" HideSpinButtons="true" Immediate="true" ReadOnly="row.Done"
                                                 aria-label="@($"Tiempo de la serie {index + 1}, en segundos")" />
                            }
                            @if (fields.Distance)
                            {
                                <MudNumericField T="int?" @bind-Value="row.DistanceM" Label="m" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 Min="0" Max="1000000" HideSpinButtons="true" Immediate="true" ReadOnly="row.Done"
                                                 aria-label="@($"Distancia de la serie {index + 1}, en metros")" />
                            }
                        </div>
                        <span class="gsm-m-set__plan">@(target is null ? "Extra" : "")</span>
                    </li>
                }
            </ol>
            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="() => AddSet(state)">Agregar serie</MudButton>

            @if (_restLeft is { } left)
            {
                <div class="gsm-m-rest is-running" role="timer" aria-live="polite" data-testid="session-rest">
                    <span class="gsm-m-rest__time">@($"{left / 60}:{left % 60:00}")</span>
                    <button type="button" class="gsm-m-chip" @onclick="() => _restLeft = left + 15">+15 s</button>
                    <button type="button" class="gsm-m-chip" @onclick="StopRest">Saltar</button>
                </div>
            }
            else
            {
                <button type="button" class="gsm-m-rest" data-testid="session-rest-start" @onclick="() => StartRestAsync(rest)">
                    <MudIcon Icon="@Icons.Material.Outlined.Timer" Size="Size.Small" /> Iniciar descanso · @(rest >= 60 && rest % 60 == 0 ? $"{rest / 60} min" : $"{rest} s")
                </button>
            }

            <div class="gsm-m-session__nav">
                <button type="button" class="gsm-m-secondary" disabled="@(session.Index == 0)" @onclick="() => Go(-1)" data-testid="session-prev">Anterior</button>
                @if (isLast)
                {
                    <button type="button" class="gsm-m-cta" @onclick="FinishAsync" data-testid="session-finish">Terminar</button>
                }
                else
                {
                    <button type="button" class="gsm-m-cta" @onclick="() => Go(1)" data-testid="session-next">Siguiente</button>
                }
            </div>

            <ol class="gsm-m-session__list" aria-label="Ejercicios de la sesión">
                @for (var i = 0; i < session.Exercises.Count; i++)
                {
                    var item = session.Exercises[i];
                    var position = i;
                    <li>
                        <button type="button" class="@($"{(position == session.Index ? "is-current" : "")} {(StateOf(item).Done ? "is-done" : "")}")" @onclick="() => GoTo(position)">
                            @(position + 1). @(StateOf(item).Replacement?.Name ?? item.ExerciseName)
                        </button>
                    </li>
                }
            </ol>
        </section>
    };
}

@page "/app/crear-contrasena"
@layout MemberAuthLayout
@attribute [Authorize]
@inject SessionService Session
@inject NavigationManager Navigation

@* FL1: quien entró por primera vez con su documento crea aquí su contraseña. Hasta hacerlo, la API no le deja
   usar nada más (el MemberLayout lo trae de vuelta). *@

<PageTitle>Crea tu contraseña — TrainingHub GO</PageTitle>

<MemberAuthBrand />

<MudText Typo="Typo.h6" HtmlTag="h1" Class="mb-2">Crea tu contraseña</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Entraste con tu número de documento. Elige una contraseña para las próximas veces: el documento deja de servir.
</MudText>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4" data-testid="create-password-error">@_error</MudAlert>
}

<PasswordField @bind-Value="_password" Label="Contraseña nueva" Variant="Variant.Outlined" Class="mb-1"
               Immediate="true" autocomplete="new-password" data-testid="create-password-new" />
<MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
    Mínimo 10 caracteres, con mayúscula, minúscula y número.
</MudText>
<PasswordField @bind-Value="_confirm" Label="Repítela" Variant="Variant.Outlined" Class="mb-4"
               Immediate="true" autocomplete="new-password" OnKeyDown="KeyDownAsync" data-testid="create-password-confirm" />

<MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy"
           data-testid="create-password-submit">
    @(_busy ? "Guardando..." : "Guardar y entrar")
</MudButton>

<MudButton FullWidth="true" Variant="Variant.Text" Class="mt-3" OnClick="LogoutAsync" Disabled="_busy">
    Salir
</MudButton>

@code {
    private string _password = string.Empty;
    private string _confirm = string.Empty;
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        // Ya con contraseña (o recargó después de crearla): no hay nada que hacer aquí.
        if (!await Session.MustChangePasswordAsync())
        {
            Navigation.NavigateTo("/app", replace: true);
        }
    }

    private async Task KeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter" && !_busy)
        {
            await SaveAsync();
        }
    }

    private async Task SaveAsync()
    {
        _error = Validate();
        if (_error is not null)
        {
            return;
        }

        _busy = true;
        try
        {
            var me = await Session.SetInitialPasswordAsync(_password);
            Navigation.NavigateTo(GsmRoles.HomeFor(me.Role), replace: true);
        }
        catch (ApiErrorException ex)
        {
            _error = ex.Error.DisplayMessage;
        }
        finally
        {
            _busy = false;
        }
    }

    private string? Validate()
    {
        if (_password.Length < 10 || !_password.Any(char.IsUpper) || !_password.Any(char.IsLower) || !_password.Any(char.IsDigit))
        {
            return "La contraseña debe tener al menos 10 caracteres, con mayúscula, minúscula y número.";
        }

        return _password == _confirm ? null : "Las dos contraseñas no coinciden.";
    }

    private async Task LogoutAsync()
    {
        await Session.LogoutAsync();
        Navigation.NavigateTo("/app/entrar", replace: true);
    }
}

@page "/app"
@layout MemberLayout
@attribute [Authorize(Roles = GsmRoles.Member)]
@inject GymContext GymCtx
@inject MemberContext MemberCtx
@inject IAttendanceClient Attendance
@inject IMemberAttendanceClient MemberAttendance
@inject ISnackbar Snackbar

<PageTitle>Mi gimnasio — GSM</PageTitle>

@if (MemberCtx.Detail is { } member)
{
    <div class="d-flex align-center mb-4" style="gap:1rem">
        <MudAvatar Size="Size.Large" Style="width:64px;height:64px">
            @if (!string.IsNullOrEmpty(member.PhotoUrl))
            {
                <MudImage Src="@member.PhotoUrl" />
            }
            else
            {
                @($"{member.FirstName[0]}{member.LastName[0]}".ToUpperInvariant())
            }
        </MudAvatar>
        <div>
            <MudText Typo="Typo.h5">@member.FirstName @member.LastName</MudText>
            <StatusChip Status="@member.Status" />
        </div>
    </div>

    <MudPaper Class="pa-4 mb-4 d-flex flex-column align-center" Elevation="0" Style="border:1px solid var(--gsm-border)">
        <QrCodeSvg Value="@member.QrCode" SizePx="200" />
        <MudText Typo="Typo.caption" Class="gsm-mono mt-2" Color="Color.Secondary">@member.QrCode</MudText>
    </MudPaper>

    @if (GymCtx.FeatureFlags?.CheckinQr == true)
    {
        <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" Class="mb-4"
                   OnClick="CheckInAsync" Disabled="_checkingIn">
            @(_checkingIn ? "Registrando..." : "Registrar mi entrada")
        </MudButton>

        @if (_checkInMessage is not null)
        {
            <MudAlert Severity="@_checkInSeverity" Dense="true" Class="mb-4">@_checkInMessage</MudAlert>
        }
    }

    <MudGrid Class="mb-4">
        <MudItem xs="6">
            <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid var(--gsm-border)">
                <MudText Typo="Typo.overline" Color="Color.Secondary">Racha</MudText>
                <MudText Typo="Typo.h4" Class="gsm-mono">@(_streak?.CurrentStreak ?? 0)</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">días seguidos</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6">
            <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid var(--gsm-border)">
                <MudText Typo="Typo.overline" Color="Color.Secondary">Congeladores</MudText>
                <MudText Typo="Typo.h4" Class="gsm-mono">@(_streak?.FreezesAvailable ?? 0)</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">disponibles</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (member.CurrentMembership is { } membership)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid var(--gsm-border)">
            <MudText Typo="Typo.overline" Color="Color.Secondary">Membresía</MudText>
            <MudText Typo="Typo.h6">@membership.PlanName</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Vence @GsmFormat.Day(membership.EndDate)</MudText>
        </MudPaper>
    }

    <MudText Typo="Typo.h6" Class="mb-2">Últimas visitas</MudText>
    @if (_recentAttendance is null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_recentAttendance.Count == 0)
    {
        <MudText Color="Color.Secondary">Todavía no has entrado.</MudText>
    }
    else
    {
        @foreach (var visit in _recentAttendance)
        {
            <div class="d-flex justify-space-between py-1">
                <MudText Typo="Typo.body2">@GsmFormat.Day(visit.AttendanceDate)</MudText>
                <MudText Typo="Typo.body2" Class="gsm-mono" Color="Color.Secondary">@GsmFormat.Instant(visit.CheckedInAt)</MudText>
            </div>
        }
    }
}

@code {
    private MemberStreakResponse? _streak;
    private List<AttendanceListItem>? _recentAttendance;
    private bool _checkingIn;
    private string? _checkInMessage;
    private Severity _checkInSeverity = Severity.Success;

    protected override async Task OnInitializedAsync()
    {
        if (MemberCtx.MemberId is not { } memberId)
        {
            return;
        }

        try
        {
            _streak = await MemberAttendance.Streak2Async(memberId);
            var page = await MemberAttendance.AttendanceGET2Async(memberId, 1, 5);
            _recentAttendance = page.Items.ToList();
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
    }

    private async Task CheckInAsync()
    {
        _checkingIn = true;
        _checkInMessage = null;
        try
        {
            var result = await Attendance.CheckinAsync(new CheckInRequest());
            if (result.AlreadyCheckedInToday)
            {
                _checkInSeverity = Severity.Warning;
                _checkInMessage = "Ya habías entrado hoy.";
            }
            else
            {
                _checkInSeverity = Severity.Success;
                _checkInMessage = "¡Entrada registrada!";
            }

            if (result.MembershipExpired)
            {
                _checkInSeverity = Severity.Error;
                _checkInMessage += " Tu membresía está vencida — pasa por recepción.";
            }

            if (MemberCtx.MemberId is { } memberId)
            {
                var page = await MemberAttendance.AttendanceGET2Async(memberId, 1, 5);
                _recentAttendance = page.Items.ToList();
            }
        }
        catch (GsmApiException ex)
        {
            _checkInSeverity = Severity.Error;
            _checkInMessage = ApiError.FromException(ex).DisplayMessage;
        }
        finally
        {
            _checkingIn = false;
        }
    }
}

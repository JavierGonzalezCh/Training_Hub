@page "/app/registro"
@layout MemberAuthLayout
@attribute [AllowAnonymous]
@inject IMembersClient Members
@inject SessionService Session
@inject NavigationManager Navigation
@inject MemberLoginBranding Branding

<PageTitle>Crear cuenta — GSM</PageTitle>

<MemberAuthBrand />

<MudText Typo="Typo.body2" Class="mb-4" Color="Color.Secondary">
    Escribe el código de invitación que te dio el gimnasio y tu documento. Si ya tienes cuenta en otro
    gimnasio, usa tu contraseña de siempre; si no, crea una.
</MudText>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
}

<MudTextField T="string" @bind-Value="_code" Label="Código de invitación" Class="mb-3 gsm-mono" />
<MudTextField T="string" @bind-Value="_documentNumber" Label="Documento" Class="mb-3" />
<MudTextField T="string" @bind-Value="_email" Label="Email (solo si tu ficha no lo tiene)" InputType="InputType.Email" Class="mb-3" />
<MudTextField T="string" @bind-Value="_password" Label="Contraseña" InputType="InputType.Password" Class="mb-4" />

<MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_submitting">
    @(_submitting ? "Creando..." : "Crear cuenta")
</MudButton>

<div class="d-flex justify-center mt-4">
    <MudLink Href="/app/entrar" Typo="Typo.body2" Color="Color.Secondary">Ya tengo cuenta</MudLink>
</div>

@code {
    [SupplyParameterFromQuery(Name = "code")]
    public string? CodeFromQuery { get; set; }

    private string _code = string.Empty;
    private string _documentNumber = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private bool _submitting;
    private string? _error;

    [SupplyParameterFromQuery(Name = "gym")]
    public string? GymSlug { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _code = CodeFromQuery ?? string.Empty;
        await Branding.LoadAsync(GymSlug);
    }

    private async Task SubmitAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_code) || string.IsNullOrWhiteSpace(_documentNumber)
            || string.IsNullOrWhiteSpace(_password))
        {
            _error = "Rellena todos los campos.";
            return;
        }

        _submitting = true;
        try
        {
            var response = await Members.RegisterAsync(new RegisterMemberRequest
            {
                Code = _code,
                DocumentNumber = _documentNumber,
                Email = string.IsNullOrWhiteSpace(_email) ? null : _email.Trim(),
                Password = _password,
            });

            // Queda con la sesión iniciada.
            var me = await Session.StartSessionAsync(response.Session);
            await Branding.RememberAsync(me.Gym);
            // Navegar en vez de pintar una confirmación: al cambiar la autenticación el router vuelve a montar
            // esta página y cualquier estado local (como "ya terminé") se perdía (B8).
            Navigation.NavigateTo("/app");
        }
        catch (GsmApiException ex)
        {
            // 404: código inválido o caducado. 409: el miembro ya tiene cuenta. 401: la contraseña de su cuenta existente no coincide.
            _error = ApiError.FromException(ex).DisplayMessage;
        }
        finally
        {
            _submitting = false;
        }
    }
}

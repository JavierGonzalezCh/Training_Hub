@page "/app/logros"
@layout MemberLayout
@attribute [Authorize(Roles = GsmRoles.Member)]
@inject GymContext GymCtx
@inject IMeClient Me
@inject ISnackbar Snackbar

<PageTitle>Logros — GSM</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-4">Logros</MudText>

@if (GymCtx.FeatureFlags?.ShowGamification == false)
{
    <MudAlert Severity="Severity.Normal">La gamificación no está activada en este gimnasio.</MudAlert>
}
else if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_achievements.Count == 0)
{
    <MudText Color="Color.Secondary">Todavía no hay logros configurados.</MudText>
}
else
{
    <MudGrid>
        @foreach (var achievement in _achievements)
        {
            <MudItem xs="6" sm="4">
                <MudPaper Class="@($"pa-4 text-center gsm-achievement{(achievement.Unlocked ? "" : " gsm-achievement--locked")}")" Elevation="0">
                    <MudIcon Icon="@(achievement.Unlocked ? Icons.Material.Filled.EmojiEvents : Icons.Material.Filled.Lock)"
                             Size="Size.Large" Class="mb-2"
                             Style="@($"color:{(achievement.Unlocked ? "var(--gsm-red)" : "var(--gsm-muted)")}")" />
                    <MudText Typo="Typo.body1" Style="@(achievement.Unlocked ? null : "color:var(--gsm-silver)")">@achievement.Name</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @AchievementConditionLabels.Label(achievement.ConditionType) · @achievement.Progress/@achievement.ConditionValue
                    </MudText>
                    @if (!achievement.Unlocked && achievement.ConditionValue > 0)
                    {
                        <div class="gsm-achievement-progress"
                             role="progressbar"
                             aria-valuenow="@achievement.Progress"
                             aria-valuemin="0"
                             aria-valuemax="@achievement.ConditionValue"
                             aria-label="@($"Progreso de {achievement.Name}")">
                            <span style="@($"width:{Math.Min(100, achievement.Progress * 100d / achievement.ConditionValue).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}%")"></span>
                        </div>
                    }
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<MemberAchievementItem> _achievements = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        if (GymCtx.FeatureFlags?.ShowGamification == false)
        {
            _loading = false;
            return;
        }

        try
        {
            var result = await Me.AchievementsAll2Async();
            _achievements = result.ToList();
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}

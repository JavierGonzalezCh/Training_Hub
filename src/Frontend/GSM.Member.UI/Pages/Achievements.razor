@page "/app/logros"
@layout MemberLayout
@attribute [Authorize(Roles = GsmRoles.Member)]
@inject GymContext GymCtx
@inject IMeClient Me
@inject ISnackbar Snackbar

<PageTitle>Logros — GSM</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-4">Logros</MudText>

@if (GymCtx.FeatureFlags?.ShowGamification == false)
{
    <MudAlert Severity="Severity.Normal">La gamificación no está activada en este gimnasio.</MudAlert>
}
else if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_achievements.Count == 0)
{
    <MudText Color="Color.Secondary">Todavía no hay logros configurados.</MudText>
}
else
{
    @if (PendingRewards.Count > 0)
    {
        <div class="mb-4" data-testid="pending-rewards">
            @foreach (var reward in PendingRewards)
            {
                <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Outlined.CardGiftcard" Class="mb-2"
                          data-testid="@($"pending-reward-{reward.AchievementId}")">
                    Premio pendiente: <strong>@reward.RewardDescription</strong> · reclámalo en recepción@(reward.RewardExpiresAt is { } exp ? $" · vence el {exp:d MMM yyyy}" : string.Empty)
                </MudAlert>
            }
        </div>
    }

    <MudGrid>
        @foreach (var achievement in _achievements)
        {
            <MudItem xs="6" sm="4">
                <MudPaper Class="@($"pa-4 text-center gsm-achievement{(achievement.Unlocked ? "" : " gsm-achievement--locked")}")" Elevation="0">
                    <MudIcon Icon="@(achievement.Unlocked ? Icons.Material.Filled.EmojiEvents : Icons.Material.Filled.Lock)"
                             Size="Size.Large" Class="mb-2"
                             Style="@($"color:{(achievement.Unlocked ? "var(--gsm-red)" : "var(--gsm-muted)")}")" />
                    <MudText Typo="Typo.body1" Style="@(achievement.Unlocked ? null : "color:var(--gsm-silver)")">@achievement.Name</MudText>
                    @if (achievement.IsManual)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" data-testid="manual-caption">
                            @(achievement.Unlocked && !string.IsNullOrWhiteSpace(achievement.GrantReason) ? achievement.GrantReason : AchievementConditionLabels.Label(achievement.ConditionType))
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @AchievementConditionLabels.Label(achievement.ConditionType) · @achievement.Progress/@achievement.ConditionValue
                        </MudText>
                    }
                    @if (!string.IsNullOrWhiteSpace(achievement.RewardDescription))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" data-testid="@($"reward-line-{achievement.AchievementId}")">
                            @RewardLine(achievement)
                        </MudText>
                    }
                    @if (!achievement.Unlocked && !achievement.IsManual && achievement.ConditionValue > 0)
                    {
                        <div class="gsm-achievement-progress"
                             role="progressbar"
                             aria-valuenow="@achievement.Progress"
                             aria-valuemin="0"
                             aria-valuemax="@achievement.ConditionValue"
                             aria-label="@($"Progreso de {achievement.Name}")">
                            <span style="@($"width:{Math.Min(100, achievement.Progress * 100d / achievement.ConditionValue).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}%")"></span>
                        </div>
                    }
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<MemberAchievementItem> _achievements = [];
    private bool _loading = true;

    /// <summary>Premios ganados que aún se pueden reclamar en recepción (L5), los que vencen antes primero.</summary>
    private List<MemberAchievementItem> PendingRewards => _achievements
        .Where(a => a.Unlocked && a.RewardStatus == "Pending" && !string.IsNullOrWhiteSpace(a.RewardDescription))
        .OrderBy(a => a.RewardExpiresAt ?? DateTimeOffset.MaxValue)
        .ToList();

    private static string RewardLine(MemberAchievementItem a) => a.RewardStatus switch
    {
        "Pending" => $"Premio pendiente: {a.RewardDescription}",
        "Delivered" => $"Premio entregado: {a.RewardDescription}",
        "Expired" => $"Premio vencido: {a.RewardDescription}",
        _ => $"Premio: {a.RewardDescription}",
    };

    protected override async Task OnInitializedAsync()
    {
        if (GymCtx.FeatureFlags?.ShowGamification == false)
        {
            _loading = false;
            return;
        }

        try
        {
            var result = await Me.AchievementsAll2Async();
            _achievements = result.ToList();
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}

@page "/app/logros"
@layout MemberLayout
@attribute [Authorize(Roles = GsmRoles.Member)]
@using GSM.Member.UI.MyProgress
@inject GymContext GymCtx

@* "Mi progreso" (L7, Achievements v2 §8): una sola pantalla con tres pestañas, Racha, Logros y Ranking (si el gym lo
   tiene encendido). Conserva la ruta /app/logros —la pestaña "Logros" de la barra inferior apunta ahí— y acepta
   ?tab=racha|logros|ranking. El progreso por ejercicio (récords y gráficas) no está aquí: vive en /app/progreso, junto
   a la rutina. *@

<PageTitle>Mi progreso — GSM</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-3">Mi progreso</MudText>

<div class="gsm-streak-tabs" role="tablist" aria-label="Secciones de Mi progreso">
    @foreach (var tab in Tabs)
    {
        var current = tab.Key;
        <button type="button" role="tab" id="@($"progress-tab-{tab.Key}")"
                aria-selected="@(current == _active ? "true" : "false")"
                class="gsm-streak-tabs__tab @(current == _active ? "is-active" : null)"
                data-testid="@($"tab-{tab.Key}")"
                @onclick="() => _active = current">@tab.Label</button>
    }
</div>

<div role="tabpanel" aria-labelledby="@($"progress-tab-{_active}")" data-testid="@($"panel-{_active}")">
    @if (_active == "racha")
    {
        <StreakPanel />
    }
    else if (_active == "ranking")
    {
        <RankingPanel />
    }
    else
    {
        <AchievementsPanel />
    }
</div>

@code {
    /// <summary>Pestaña inicial: <c>racha</c> (por defecto), <c>logros</c> o <c>ranking</c>.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    private string _active = "racha";

    private bool RankingOn => GymCtx.FeatureFlags is not { ShowRanking: false } and not { ShowGamification: false };

    private List<(string Key, string Label)> Tabs
    {
        get
        {
            var tabs = new List<(string, string)> { ("racha", "Racha"), ("logros", "Logros") };
            if (RankingOn)
            {
                tabs.Add(("ranking", "Ranking"));
            }

            return tabs;
        }
    }

    private string? _appliedTab;

    protected override void OnParametersSet()
    {
        // Solo cuando cambia el ?tab= de la dirección: así un re-render no deshace la pestaña que tocó el miembro.
        if (Tab == _appliedTab)
        {
            return;
        }

        _appliedTab = Tab;
        var requested = Tab?.Trim().ToLowerInvariant();
        if (requested is not null && Tabs.Any(t => t.Key == requested))
        {
            _active = requested;
        }
    }
}

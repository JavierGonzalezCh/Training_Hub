@page "/app/progreso"
@page "/app/logros"
@layout MemberLayout
@attribute [Authorize(Roles = GsmRoles.Member)]
@using GSM.Member.UI.MyProgress
@using GSM.UI.Shared.Routines
@inject IMeClient Me
@inject GymContext GymCtx

@* Progreso (pestaña de la barra): una sola pantalla con Constancia (racha y calendario), Fuerza (récords y gráficas
   por ejercicio, si el gym tiene rutinas), Logros y Ranking (si el gym lo tiene encendido). /app/progreso es la ruta
   de la barra; /app/logros se conserva porque la usan los avisos. Acepta ?tab=racha|fuerza|logros|ranking. *@

<PageTitle>Progreso — TrainingHub GO</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-3">Tu progreso</MudText>

<div class="gsm-streak-tabs" role="tablist" aria-label="Secciones de tu progreso">
    @foreach (var tab in Tabs)
    {
        var current = tab.Key;
        <button type="button" role="tab" id="@($"progress-tab-{tab.Key}")"
                aria-selected="@(current == _active ? "true" : "false")"
                class="gsm-streak-tabs__tab @(current == _active ? "is-active" : null)"
                data-testid="@($"tab-{tab.Key}")"
                @onclick="() => _active = current">@tab.Label</button>
    }
</div>

<div role="tabpanel" aria-labelledby="@($"progress-tab-{_active}")" data-testid="@($"panel-{_active}")">
    @if (_active == "racha")
    {
        <StreakPanel />
    }
    else if (_active == "ranking")
    {
        <RankingPanel />
    }
    else if (_active == "fuerza")
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Cómo has avanzado en cada ejercicio y tus récords. Cuentan los ejercicios que anotaste con peso, repeticiones, tiempo o distancia; el calentamiento no.
        </MudText>
        <ProgressPanel LoadSummaries="@(() => Me.GetMyProgressAsync())"
                       LoadDetail="@(id => Me.GetMyExerciseProgressAsync(id))"
                       EmptyText="Cuando anotes tus series en Entrenar, aquí verás tu evolución y tus récords." />
    }
    else
    {
        <AchievementsPanel />
    }
</div>

@code {
    /// <summary>Pestaña inicial: <c>racha</c> (Constancia, por defecto), <c>fuerza</c>, <c>logros</c> o <c>ranking</c>.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    private string _active = "racha";

    private bool RankingOn => GymCtx.FeatureFlags is not { ShowRanking: false } and not { ShowGamification: false };

    private List<(string Key, string Label)> Tabs
    {
        get
        {
            var tabs = new List<(string, string)> { ("racha", "Constancia") };
            if (GymCtx.FeatureFlags?.ShowRoutines != false)
            {
                tabs.Add(("fuerza", "Fuerza"));
            }

            tabs.Add(("logros", "Logros"));
            if (RankingOn)
            {
                tabs.Add(("ranking", "Ranking"));
            }

            return tabs;
        }
    }

    private string? _appliedTab;

    protected override void OnParametersSet()
    {
        // Solo cuando cambia el ?tab= de la dirección: así un re-render no deshace la pestaña que tocó el miembro.
        if (Tab == _appliedTab)
        {
            return;
        }

        _appliedTab = Tab;
        var requested = Tab?.Trim().ToLowerInvariant();
        if (requested is not null && Tabs.Any(t => t.Key == requested))
        {
            _active = requested;
        }
    }
}

@page "/app/clases"
@layout MemberLayout
@attribute [Authorize(Roles = GsmRoles.Member)]
@inject GymContext GymCtx
@inject IMeClient Me
@inject IMemberClassesClient MemberClasses
@inject IMemberClassAttendanceClient ClassAttendance
@inject IMemberWaitlistClient Waitlist
@inject IMeClassBookingStatusClient BookingStatus
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Clases — GSM</PageTitle>

<MudText Typo="Typo.h5" HtmlTag="h1" Class="mb-4">Clases</MudText>

@if (_offerPush)
{
    <PushPermissionPrompt Platform="@GSM.UI.Shared.Push.PushPlatforms.WebMember"
                          Title="Activa los avisos"
                          Message="Activa los avisos para que te recordemos tu clase y te contemos si se cancela." />
}

@if (GymCtx.FeatureFlags?.ShowClasses == false)
{
    <MudAlert Severity="Severity.Normal">Las clases no están activadas en este gimnasio.</MudAlert>
}
else
{
    @if (BlockedUntil is { } blockedUntil)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4" id="booking-blocked">
            No puedes reservar hasta el @GsmFormat.Day(blockedUntil) por inasistencias. Tus reservas ya hechas se mantienen.
        </MudAlert>
    }

    <div class="gsm-cal-nav">
        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" OnClick="@(() => ShiftWeekAsync(-7))" aria-label="Semana anterior" />
        <div class="gsm-cal-nav__label">
            <span class="gsm-cal-nav__range">@GsmFormat.DayRange(_weekStart, _weekStart.AddDays(6))</span>
            @if (!IsCurrentWeek)
            {
                <button type="button" class="gsm-cal-nav__today" @onclick="GoToTodayAsync">Ir a hoy</button>
            }
        </div>
        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" OnClick="@(() => ShiftWeekAsync(7))" aria-label="Semana siguiente" />
    </div>

    @* Tira de la semana: un botón por día, con un punto por clase. *@
    <div class="gsm-cal-week" role="tablist" aria-label="Días de la semana">
        @for (var d = 0; d < 7; d++)
        {
            var day = _weekStart.AddDays(d);
            var count = _entries.Count(e => e.SessionDate == day && e.Status != "Cancelled");
            <button type="button" role="tab" aria-selected="@(day == _selected ? "true" : "false")"
                    class="gsm-cal-day @(day == _selected ? "is-selected" : null) @(day == _today ? "is-today" : null)"
                    @onclick="() => _selected = day">
                <span class="gsm-cal-day__dow">@DayInitial(day)</span>
                <span class="gsm-cal-day__num">@day.Day</span>
                <span class="gsm-cal-day__dots" aria-hidden="true">
                    @for (var k = 0; k < Math.Min(count, 3); k++)
                    {
                        <i></i>
                    }
                </span>
                <span class="gsm-visually-hidden">@(count == 0 ? "sin clases" : count == 1 ? "1 clase" : $"{count} clases")</span>
            </button>
        }
    </div>

    <h2 class="gsm-cal-title">@GsmFormat.DayLong(_selected)</h2>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        var dayEntries = _entries.Where(e => e.SessionDate == _selected).OrderBy(e => e.StartTime).ToList();
        @if (dayEntries.Count == 0)
        {
            <div class="gsm-empty">
                <MudIcon Icon="@Icons.Material.Outlined.EventAvailable" Class="gsm-empty-icon" />
                <span>No hay clases este día.</span>
            </div>
        }
        else
        {
            <ol class="gsm-cal-agenda">
                @foreach (var entry in dayEntries)
                {
                    var end = entry.StartTime.AddMinutes(entry.DurationMinutes);
                    var cancelled = entry.Status == "Cancelled";
                    <li class="gsm-cal-slot">
                        <div class="gsm-cal-slot__time">
                            <span class="gsm-cal-slot__start">@entry.StartTime.ToString("HH:mm")</span>
                            <span class="gsm-cal-slot__end">@end.ToString("HH:mm")</span>
                        </div>
                        <article class="gsm-cal-card @(cancelled ? "is-cancelled" : entry.MyBookingStatus == "Booked" ? "is-booked" : null)">
                            <div class="gsm-cal-card__main">
                                <h3 class="gsm-cal-card__name">@entry.ClassName</h3>
                                <p class="gsm-cal-card__meta">
                                    @entry.DurationMinutes min@(string.IsNullOrWhiteSpace(entry.InstructorName) ? "" : $" · {entry.InstructorName}")@(entry.Capacity is { } cap ? $" · {cap} {(cap == 1 ? "cupo" : "cupos")}" : " · entrada libre")
                                </p>
                                @if (cancelled && !string.IsNullOrWhiteSpace(entry.CancellationReason))
                                {
                                    <p class="gsm-cal-card__meta">@entry.CancellationReason</p>
                                }
                            </div>
                            @if (cancelled)
                            {
                                <MudChip T="string" Color="Color.Error" Variant="Variant.Text" Size="Size.Small" Class="gsm-mono">CANCELADA</MudChip>
                            }
                            else if (entry.OutsideOpeningHours == true && entry.MyBookingStatus is not "Booked")
                            {
                                <MudChip T="string" Color="Color.Warning" Variant="Variant.Text" Size="Size.Small" Class="gsm-mono outside-hours-chip">GYM CERRADO</MudChip>
                            }
                            else if (entry.MyBookingStatus is "Attended")
                            {
                                <MudChip T="string" Color="Color.Success" Variant="Variant.Text" Size="Size.Small" Class="gsm-mono attended-chip">ASISTISTE</MudChip>
                            }
                            else if (CanMarkAttendance(entry))
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" id="@($"attend-{entry.ClassId}")"
                                           OnClick="@(() => AttendAsync(entry))">
                                    Estoy en clase
                                </MudButton>
                            }
                            else if (entry.MyBookingStatus is "Booked")
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => CancelAsync(entry))">
                                    Cancelar
                                </MudButton>
                            }
                            else if (entry.MyWaitlistStatus is "Offered")
                            {
                                <div class="waitlist-offer">
                                    <span class="gsm-cal-card__meta waitlist-offer-text">
                                        Se liberó un cupo. Confirma antes de las @(entry.MyOfferExpiresAt is { } until ? GsmFormat.Time(until) : "")
                                    </span>
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" id="@($"confirm-offer-{entry.ClassId}")"
                                               OnClick="@(() => ConfirmOfferAsync(entry))">
                                        Confirmar
                                    </MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" id="@($"decline-offer-{entry.ClassId}")"
                                               OnClick="@(() => LeaveWaitlistAsync(entry))">
                                        Rechazar
                                    </MudButton>
                                </div>
                            }
                            else if (entry.MyWaitlistStatus is "Waiting")
                            {
                                <div class="waitlist-waiting">
                                    <MudChip T="string" Color="Color.Info" Variant="Variant.Text" Size="Size.Small" Class="gsm-mono waitlist-position-chip">
                                        EN ESPERA · Eres el @entry.MyWaitlistPosition
                                    </MudChip>
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" id="@($"leave-waitlist-{entry.ClassId}")"
                                               OnClick="@(() => LeaveWaitlistAsync(entry))">
                                        Salir de la lista
                                    </MudButton>
                                </div>
                            }
                            else if (entry.Capacity is not null && entry.IsFull == true && entry.SessionDate <= _today.AddDays(WindowDays))
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" id="@($"join-waitlist-{entry.ClassId}")"
                                           Disabled="@(BlockedUntil is not null)" OnClick="@(() => JoinWaitlistAsync(entry))">
                                    Anotarme en espera
                                </MudButton>
                            }
                            else if (entry.Capacity is not null && entry.SessionDate > _today.AddDays(WindowDays))
                            {
                                <MudChip T="string" Color="Color.Default" Variant="Variant.Text" Size="Size.Small" Class="gsm-mono booking-window-chip">
                                    ABRE EL @GsmFormat.DayShort(entry.SessionDate.AddDays(-WindowDays)).ToUpperInvariant()
                                </MudChip>
                            }
                            else if (entry.Capacity is not null)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => BookAsync(entry))"
                                           Disabled="@(BlockedUntil is not null)">
                                    Reservar
                                </MudButton>
                            }
                        </article>
                    </li>
                }
            </ol>
        }
    }
}

@code {
    private readonly DateOnly _today = GsmFormat.Today();
    private DateOnly _weekStart = StartOfWeek(GsmFormat.Today());
    private DateOnly _selected = GsmFormat.Today();

    private bool IsCurrentWeek => _today >= _weekStart && _today <= _weekStart.AddDays(6);

    private static string DayInitial(DateOnly day) => day.DayOfWeek switch
    {
        DayOfWeek.Monday => "L",
        DayOfWeek.Tuesday => "M",
        DayOfWeek.Wednesday => "X",
        DayOfWeek.Thursday => "J",
        DayOfWeek.Friday => "V",
        DayOfWeek.Saturday => "S",
        _ => "D",
    };

    private async Task GoToTodayAsync()
    {
        _weekStart = StartOfWeek(_today);
        _selected = _today;
        await LoadAsync();
    }
    private List<ScheduleEntry> _entries = [];
    private bool _loading = true;
    private bool _offerPush;

    // C3: reglas de reserva del gym. Los valores por defecto solo rigen si la consulta falla.
    private DateOnly? BlockedUntil { get; set; }
    private int WindowDays { get; set; } = 7;
    private int CancelDeadlineHours { get; set; } = 2;

    private async Task LoadStatusAsync()
    {
        try
        {
            var status = await BookingStatus.ClassBookingStatusAsync();
            if (status is null)
            {
                return;
            }

            BlockedUntil = status.BlockedUntil;
            WindowDays = (int?)status.BookingWindowDays ?? WindowDays;
            CancelDeadlineHours = (int?)status.CancelDeadlineHours ?? CancelDeadlineHours;
        }
        catch (GsmApiException)
        {
            // Sin las reglas la pantalla sigue funcionando: el servidor las impone igual al reservar.
        }
    }

    private const int AttendWindowMinutes = 15; // C7: igual que el servidor (MarkOwnAttendanceHandler.WindowMinutes)

    /// <summary>
    /// C7: "Estoy en clase" se ofrece el día de la clase, de 15 minutos antes a 15 minutos después del inicio, a quien
    /// tiene reserva (o en una clase de entrada libre). El servidor lo valida igual, y además exige la entrada al gym de hoy.
    /// </summary>
    private bool CanMarkAttendance(ScheduleEntry entry)
    {
        if (entry.SessionDate != _today || entry.Status == "Cancelled")
        {
            return false;
        }

        if (entry.Capacity is not null ? entry.MyBookingStatus != "Booked" : entry.MyBookingStatus is "Attended")
        {
            return false;
        }

        var nowTime = TimeOnly.ParseExact(GsmFormat.Time(DateTimeOffset.UtcNow), "HH:mm");
        var minutes = (nowTime.ToTimeSpan() - entry.StartTime.ToTimeSpan()).TotalMinutes;
        return minutes >= -AttendWindowMinutes && minutes <= AttendWindowMinutes;
    }

    private async Task AttendAsync(ScheduleEntry entry)
    {
        try
        {
            await ClassAttendance.AttendAsync(entry.ClassId, entry.SessionDate);
            Snackbar.Add("Listo, quedó marcada tu asistencia a la clase.", Severity.Success);
            await LoadAsync();
        }
        catch (GsmApiException ex)
        {
            // 409: aún no registró su entrada al gym, no está al día o no tiene reserva. 422: fuera de la ventana de tiempo.
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
    }

    /// <summary>Cancelar pasado el plazo del gym libera el cupo pero cuenta como inasistencia.</summary>
    private bool IsLateCancellation(ScheduleEntry entry)
    {
        var nowTime = TimeOnly.ParseExact(GsmFormat.Time(DateTimeOffset.UtcNow), "HH:mm");
        var now = GsmFormat.Today().ToDateTime(nowTime);
        return now > entry.SessionDate.ToDateTime(entry.StartTime).AddHours(-CancelDeadlineHours);
    }

    protected override Task OnInitializedAsync() => GymCtx.FeatureFlags?.ShowClasses == false ? Task.CompletedTask : LoadAsync();

    private static DateOnly StartOfWeek(DateOnly date)
    {
        var diff = ((int)date.DayOfWeek + 6) % 7;
        return date.AddDays(-diff);
    }

    private async Task ShiftWeekAsync(int days)
    {
        _weekStart = _weekStart.AddDays(days);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await Me.ClassesGET2Async(_weekStart, _weekStart.AddDays(6));
            _entries = result.Entries.ToList();
            await LoadStatusAsync();
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task BookAsync(ScheduleEntry entry)
    {
        try
        {
            var booking = await MemberClasses.BookPOSTAsync(entry.ClassId, entry.SessionDate);
            Snackbar.Add("Reserva confirmada.", Severity.Success);
            if (!string.IsNullOrWhiteSpace(booking?.AccessNotice))
            {
                Snackbar.Add(booking.AccessNotice, Severity.Warning); // por vencer o en gracia ese día
            }

            _offerPush = true; // el momento con sentido para pedir el permiso de avisos
            await LoadAsync();
        }
        catch (GsmApiException ex)
        {
            // 409: cupo lleno, gym cerrado o el plan no cubre ese día. 422: la clase no admite reservas.
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
    }

    private async Task JoinWaitlistAsync(ScheduleEntry entry)
    {
        try
        {
            var result = await Waitlist.JoinAsync(entry.ClassId, entry.SessionDate);
            Snackbar.Add($"Estás en la lista de espera (eres el {result?.Position}). Te avisamos si se libera un cupo.", Severity.Success);
            _offerPush = true; // el aviso de la oferta es lo que importa: buen momento para pedir el permiso
            await LoadAsync();
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
            await LoadAsync(); // si la sesión ya tenía cupo, el botón cambia a "Reservar"
        }
    }

    private async Task ConfirmOfferAsync(ScheduleEntry entry)
    {
        try
        {
            await Waitlist.ConfirmAsync(entry.ClassId, entry.SessionDate);
            Snackbar.Add("Cupo confirmado: tu reserva está hecha.", Severity.Success);
            await LoadAsync();
        }
        catch (GsmApiException ex)
        {
            // 409: la oferta venció y el cupo pasó al siguiente, o ya no está al día.
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
            await LoadAsync();
        }
    }

    private async Task LeaveWaitlistAsync(ScheduleEntry entry)
    {
        try
        {
            await Waitlist.LeaveAsync(entry.ClassId, entry.SessionDate);
            Snackbar.Add("Saliste de la lista de espera.", Severity.Success);
            await LoadAsync();
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
    }

    private async Task CancelAsync(ScheduleEntry entry)
    {
        if (IsLateCancellation(entry))
        {
            var confirmed = await Dialogs.ShowMessageBox(
                "Cancelar fuera de plazo",
                $"El plazo para cancelar sin penalización era hasta {CancelDeadlineHours} h antes de la clase. "
                + "Puedes cancelar para liberar el cupo, pero contará como inasistencia.",
                yesText: "Cancelar la reserva", cancelText: "Mantenerla");
            if (confirmed != true)
            {
                return;
            }
        }

        try
        {
            var result = await MemberClasses.BookDELETEAsync(entry.ClassId, entry.SessionDate);
            Snackbar.Add("Reserva cancelada.", Severity.Success);
            if (result?.BlockedUntil is { } until)
            {
                Snackbar.Add($"No podrás reservar hasta el {GsmFormat.Day(until)} por inasistencias.", Severity.Warning);
            }

            await LoadAsync();
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
    }
}

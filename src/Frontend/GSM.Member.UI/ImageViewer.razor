@* Visor de una imagen a pantalla completa (la foto de un anuncio). Un toque sobre la foto la amplía al doble y se recorre
   arrastrando; en el celular también vale pellizcar. Se cierra con la X, con Escape o tocando fuera de la foto. *@
@if (Src is not null)
{
    <div class="gsm-viewer" role="dialog" aria-modal="true" aria-label="@(Alt ?? "Imagen")" data-testid="image-viewer"
         tabindex="-1" @ref="_root" @onkeydown="OnKeyDown" @onclick="CloseAsync">
        <button type="button" class="gsm-viewer__close" aria-label="Cerrar" data-testid="image-viewer-close" @onclick="CloseAsync"
                @onclick:stopPropagation="true">
            <MudIcon Icon="@Icons.Material.Filled.Close" />
        </button>
        <div class="gsm-viewer__stage @(_zoomed ? "is-zoomed" : null)" @onclick:stopPropagation="true">
            <img src="@Src" alt="@Alt" class="gsm-viewer__image" data-testid="image-viewer-image"
                 @onclick="ToggleZoom" />
        </div>
        <span class="gsm-viewer__hint" aria-hidden="true">@(_zoomed ? "Toca la foto para alejar" : "Toca la foto para ampliar")</span>
    </div>
}

@code {
    /// <summary>La imagen abierta; nulo, el visor está cerrado.</summary>
    [Parameter] public string? Src { get; set; }

    [Parameter] public string? Alt { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private ElementReference _root;
    private bool _zoomed;
    private string? _shown;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Src is not null && Src != _shown)
        {
            _shown = Src;
            _zoomed = false;
            try
            {
                await _root.FocusAsync();
            }
            catch (InvalidOperationException)
            {
                // Sin DOM (pruebas): el foco es un extra.
            }
        }
        else if (Src is null)
        {
            _shown = null;
        }
    }

    private void ToggleZoom() => _zoomed = !_zoomed;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CloseAsync();
        }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();
}

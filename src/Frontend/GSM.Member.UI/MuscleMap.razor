@* Mapa muscular: silueta propia de frente y de espalda; cada músculo del catálogo (Chest, Lower_back…) es una zona
   que se colorea por separado. Dos usos: qué trabaja un ejercicio o un día (Primary en rojo, Secondary en rosa) y
   la recuperación estimada (Recovery: 0–100 por músculo; cansado en rojo, recuperando en rosa, listo en gris). *@
<div class="gsm-musclemap @(Compact ? "is-compact" : null)" role="img" aria-label="@Label" data-testid="muscle-map">
    <svg viewBox="0 0 100 220" style="@Style" aria-hidden="true" focusable="false">
        <g stroke="#0d0c0b" stroke-width="1.2">
            <circle cx="50" cy="15" r="10" fill="#3a3633" />
            <rect x="45" y="24" width="10" height="8" rx="3" fill="var(--m-neck,#2e2b29)" />
            <path d="M38 33 L45 30 L55 30 L62 33 L56 37 L44 37 Z" fill="var(--m-traps,#2e2b29)" />
            <ellipse cx="31" cy="43" rx="9" ry="8" fill="var(--m-shoulders,#2e2b29)" />
            <ellipse cx="69" cy="43" rx="9" ry="8" fill="var(--m-shoulders,#2e2b29)" />
            <path d="M39 38 Q50 36 49 40 L49 58 Q40 60 36 54 Q34 44 39 38 Z" fill="var(--m-chest,#2e2b29)" />
            <path d="M61 38 Q50 36 51 40 L51 58 Q60 60 64 54 Q66 44 61 38 Z" fill="var(--m-chest,#2e2b29)" />
            <rect x="42" y="61" width="16" height="40" rx="6" fill="var(--m-abs,#2e2b29)" />
            <path d="M36 60 Q40 62 41 66 L41 98 Q36 96 35 88 Z" fill="var(--m-obliques,#2e2b29)" />
            <path d="M64 60 Q60 62 59 66 L59 98 Q64 96 65 88 Z" fill="var(--m-obliques,#2e2b29)" />
            <ellipse cx="25" cy="64" rx="6" ry="12" fill="var(--m-biceps,#2e2b29)" />
            <ellipse cx="75" cy="64" rx="6" ry="12" fill="var(--m-biceps,#2e2b29)" />
            <ellipse cx="20" cy="92" rx="5" ry="14" fill="var(--m-forearms,#2e2b29)" />
            <ellipse cx="80" cy="92" rx="5" ry="14" fill="var(--m-forearms,#2e2b29)" />
            <circle cx="17" cy="111" r="4" fill="#3a3633" /><circle cx="83" cy="111" r="4" fill="#3a3633" />
            <path d="M36 102 Q50 98 64 102 L62 112 L38 112 Z" fill="var(--m-abductors,#3a3633)" />
            <path d="M38 113 Q35 135 39 160 Q44 164 48 158 L49 118 Q44 112 38 113 Z" fill="var(--m-quadriceps,#2e2b29)" />
            <path d="M62 113 Q65 135 61 160 Q56 164 52 158 L51 118 Q56 112 62 113 Z" fill="var(--m-quadriceps,#2e2b29)" />
            <path d="M48 118 L49 150 Q46 146 46 132 Z" fill="var(--m-adductors,#2e2b29)" />
            <path d="M52 118 L51 150 Q54 146 54 132 Z" fill="var(--m-adductors,#2e2b29)" />
            <ellipse cx="43" cy="188" rx="5" ry="18" fill="var(--m-calves,#2e2b29)" />
            <ellipse cx="57" cy="188" rx="5" ry="18" fill="var(--m-calves,#2e2b29)" />
            <ellipse cx="42" cy="210" rx="5" ry="3" fill="#3a3633" /><ellipse cx="58" cy="210" rx="5" ry="3" fill="#3a3633" />
        </g>
    </svg>
    <svg viewBox="0 0 100 220" style="@Style" aria-hidden="true" focusable="false">
        <g stroke="#0d0c0b" stroke-width="1.2">
            <circle cx="50" cy="15" r="10" fill="#3a3633" />
            <path d="M50 26 L64 36 L50 50 L36 36 Z" fill="var(--m-traps,#2e2b29)" />
            <ellipse cx="31" cy="43" rx="9" ry="8" fill="var(--m-shoulders,#2e2b29)" />
            <ellipse cx="69" cy="43" rx="9" ry="8" fill="var(--m-shoulders,#2e2b29)" />
            <path d="M37 40 L49 52 L49 84 Q40 80 36 66 Q33 50 37 40 Z" fill="var(--m-back,#2e2b29)" />
            <path d="M63 40 L51 52 L51 84 Q60 80 64 66 Q67 50 63 40 Z" fill="var(--m-back,#2e2b29)" />
            <rect x="42" y="84" width="16" height="18" rx="5" fill="var(--m-lower_back,#2e2b29)" />
            <ellipse cx="25" cy="64" rx="6" ry="12" fill="var(--m-triceps,#2e2b29)" />
            <ellipse cx="75" cy="64" rx="6" ry="12" fill="var(--m-triceps,#2e2b29)" />
            <ellipse cx="20" cy="92" rx="5" ry="14" fill="var(--m-forearms,#2e2b29)" />
            <ellipse cx="80" cy="92" rx="5" ry="14" fill="var(--m-forearms,#2e2b29)" />
            <circle cx="17" cy="111" r="4" fill="#3a3633" /><circle cx="83" cy="111" r="4" fill="#3a3633" />
            <path d="M37 104 Q43 100 49 104 L49 122 Q41 126 37 118 Z" fill="var(--m-glutes,#2e2b29)" />
            <path d="M63 104 Q57 100 51 104 L51 122 Q59 126 63 118 Z" fill="var(--m-glutes,#2e2b29)" />
            <path d="M38 124 Q37 145 41 162 Q46 164 48 158 L49 126 Z" fill="var(--m-hamstrings,#2e2b29)" />
            <path d="M62 124 Q63 145 59 162 Q54 164 52 158 L51 126 Z" fill="var(--m-hamstrings,#2e2b29)" />
            <ellipse cx="43" cy="186" rx="6" ry="17" fill="var(--m-calves,#2e2b29)" />
            <ellipse cx="57" cy="186" rx="6" ry="17" fill="var(--m-calves,#2e2b29)" />
            <ellipse cx="42" cy="210" rx="5" ry="3" fill="#3a3633" /><ellipse cx="58" cy="210" rx="5" ry="3" fill="#3a3633" />
        </g>
    </svg>
</div>

@code {
    public const string Hot = "#B50016";
    public const string Warm = "#ff6b78";

    /// <summary>Músculos principales (en rojo).</summary>
    [Parameter] public IEnumerable<string>? Primary { get; set; }

    /// <summary>Músculos secundarios (en rosa).</summary>
    [Parameter] public IEnumerable<string>? Secondary { get; set; }

    /// <summary>Recuperación 0–100 por músculo; si viene, manda sobre Primary/Secondary.</summary>
    [Parameter] public IReadOnlyDictionary<string, int>? Recovery { get; set; }

    [Parameter] public bool Compact { get; set; }

    [Parameter] public string? Label { get; set; }

    private string Style
    {
        get
        {
            var colors = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            if (Recovery is not null)
            {
                foreach (var (muscle, percent) in Recovery)
                {
                    if (percent < 50)
                    {
                        colors[muscle] = Hot;
                    }
                    else if (percent < 100)
                    {
                        colors[muscle] = Warm;
                    }
                }
            }
            else
            {
                foreach (var m in Secondary ?? [])
                {
                    colors[m] = Warm;
                }

                foreach (var m in Primary ?? [])
                {
                    colors[m] = Hot;
                }
            }

            return string.Join(';', colors.Select(c => $"--m-{c.Key.ToLowerInvariant()}:{c.Value}"));
        }
    }
}

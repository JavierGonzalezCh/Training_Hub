        </g>
    </svg>
</div>

@code {
    /// <summary>Principal o cansado: rojo vivo.</summary>
    public const string Hot = "#FF3347";

    /// <summary>Secundario o recuperando: naranja, para que no se confunda con el principal.</summary>
    public const string Warm = "#FF9F43";

    /// <summary>Músculos principales (en rojo).</summary>
    [Parameter] public IEnumerable<string>? Primary { get; set; }

    /// <summary>Músculos secundarios (en naranja).</summary>
    [Parameter] public IEnumerable<string>? Secondary { get; set; }

    /// <summary>Recuperación 0–100 por músculo; si viene, manda sobre Primary/Secondary.</summary>
    [Parameter] public IReadOnlyDictionary<string, int>? Recovery { get; set; }

    [Parameter] public bool Compact { get; set; }

    [Parameter] public string? Label { get; set; }

    private string Style
    {
        get
        {
            var colors = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            if (Recovery is not null)
            {
                foreach (var (muscle, percent) in Recovery)
                {
                    if (percent < 50)
                    {
                        colors[muscle] = Hot;
                    }
                    else if (percent < 100)
                    {
                        colors[muscle] = Warm;
                    }
                }
            }
            else
            {
                foreach (var m in Secondary ?? [])
                {
                    colors[m] = Warm;
                }

                foreach (var m in Primary ?? [])
                {
                    colors[m] = Hot;
                }
            }

            return string.Join(';', colors.Select(c => $"--m-{c.Key.ToLowerInvariant()}:{c.Value}"));
        }
    }
}

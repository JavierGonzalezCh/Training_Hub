@* Pestaña "Novedades" de la barra inferior, con el indicador de no leídos. Consulta al entrar y cada
   60 s; el temporizador se libera al salir. Solo existe si el gym tiene las comunicaciones activas. *@
@implements IAsyncDisposable
@inject NewsUnreadState Unread

<NavLink href="/app/novedades" aria-label="@Label">
    <span class="gsm-tabbar-icon">
        <MudIcon Icon="@Icons.Material.Filled.Campaign" Size="Size.Small" />
        @if (Unread.Total > 0)
        {
            <span class="gsm-tabbar-badge" aria-hidden="true">@(Unread.Total > 9 ? "9+" : Unread.Total.ToString())</span>
        }
    </span>
    <span class="gsm-tabbar-label">Novedades</span>
</NavLink>

@code {
    private PeriodicTimer? _timer;
    private Task? _loop;

    private string Label => Unread.Total > 0 ? $"Novedades, {Unread.Total} sin leer" : "Novedades";

    protected override async Task OnInitializedAsync()
    {
        Unread.Changed += OnChanged;
        await Unread.RefreshAsync();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(60));
        _loop = PollAsync(_timer);
    }

    private async Task PollAsync(PeriodicTimer timer)
    {
        try
        {
            while (await timer.WaitForNextTickAsync())
            {
                await Unread.RefreshAsync();
            }
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Unread.Changed -= OnChanged;
        _timer?.Dispose();
        if (_loop is not null)
        {
            await _loop;
        }
    }
}

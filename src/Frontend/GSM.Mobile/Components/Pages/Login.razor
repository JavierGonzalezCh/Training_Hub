@page "/login"
@layout GSM.Member.UI.MemberAuthLayout
@attribute [AllowAnonymous]
@inject SessionService Session
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión — TrainingHub GO</PageTitle>

<img class="gsm-brand-hero mb-6" src="_content/GSM.UI.Shared/brand/traininghub-go.png" alt="TrainingHub GO" />

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
}

@if (_selection is not null)
{
    <MudText Typo="Typo.h6" Class="mb-3">¿A qué gimnasio quieres entrar?</MudText>
    <GymAccessPicker Accesses="_selection.Accesses" Busy="_submitting" OnSelect="SelectAsync" />
}
else
{
    <MudTextField T="string" @bind-Value="_email" Label="Correo o celular" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Person" InputType="InputType.Text" Class="mb-3"
                  HelperText="El celular, con sus 10 dígitos (sin +57). La primera vez, tu contraseña es tu número de documento." />
    <PasswordField @bind-Value="_password" Label="Contraseña" Variant="Variant.Outlined" Class="mb-4" />

    <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_submitting">
        @(_submitting ? "Entrando..." : "Entrar")
    </MudButton>

    <div class="d-flex justify-center mt-4">
        <MudLink Href="/forgot-password" Typo="Typo.body2" Color="Color.Secondary" data-testid="forgot-password-link">¿Olvidaste tu contraseña?</MudLink>
    </div>
}

@code {
    private string _email = string.Empty;
    private string _password = string.Empty;
    private bool _submitting;
    private string? _error;
    private GymSelection? _selection;

    private async Task SubmitAsync()
    {
        _error = null;
        _submitting = true;
        try
        {
            var outcome = await Session.LoginAsync(_email.Trim(), _password);
            if (outcome.Selection is { } selection)
            {
                _selection = selection;
                return;
            }

            Navigation.NavigateTo(await Session.HomeAfterLoginAsync(outcome.Me!), replace: true);
        }
        catch (ApiErrorException ex)
        {
            // Un 401 al iniciar sesión es "datos incorrectos"; el texto genérico del 401 ("Tu sesión ha caducado")
            // solo tiene sentido con una sesión ya abierta. Igual que en el login de la web.
            _error = SessionService.LoginErrorMessage(ex, "Credenciales inválidas.");
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task SelectAsync(GymAccessOption access)
    {
        _error = null;
        _submitting = true;
        try
        {
            var me = await Session.SelectGymAsync(_selection!, access.AccessId);
            Navigation.NavigateTo(await Session.HomeAfterLoginAsync(me), replace: true);
        }
        catch (ApiErrorException ex)
        {
            _error = ex.Error.DisplayMessage;
        }
        finally
        {
            _submitting = false;
        }
    }
}

@* Barra inferior del panel en el celular (por debajo de 960 px): lo diario a un toque y "Más" con
   el resto. Las entradas salen del registro (PanelMenuEntry.BottomBar), no se escriben aquí.
   En escritorio no se dibuja: ahí manda el menú lateral (NavMenu). *@
@using GSM.Panel.UI.Navigation
@implements IDisposable
@inject ViewportState Viewport
@inject PanelRegistry Registry
@inject GymContext GymContext
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation

@if (Viewport.IsNarrow)
{
    @if (_moreOpen)
    {
        <div class="gsm-more-backdrop" @onclick="CloseMore" aria-hidden="true"></div>
        <div id="gsm-more-sheet" class="gsm-more-sheet" role="dialog" aria-label="Más opciones" data-testid="more-sheet">
            @foreach (var group in _more)
            {
                <div class="gsm-more-sheet__group">
                    <div class="gsm-nav__label">@group.Label</div>
                    @foreach (var entry in group.Entries)
                    {
                        <NavLink class="gsm-nav-link" href="@entry.Href" Match="@(entry.MatchAll ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                                 @onclick="CloseMore">
                            <MudIcon Icon="@entry.Icon" Size="Size.Small" /><span>@entry.Title</span>
                        </NavLink>
                    }
                </div>
            }
        </div>
    }

    <nav class="gsm-tabbar gsm-tabbar--panel@(_moreOpen ? " gsm-tabbar--more-open" : null)" aria-label="Navegación del celular" data-testid="bottom-nav">
        @foreach (var entry in _bottom)
        {
            <NavLink href="@entry.Href" Match="@(entry.MatchAll ? NavLinkMatch.All : NavLinkMatch.Prefix)" @onclick="CloseMore">
                <MudIcon Icon="@entry.Icon" Size="Size.Small" />
                <span class="gsm-tabbar-label">@entry.ShortTitle</span>
            </NavLink>
        }
        <button type="button" class="gsm-tabbar__more @(_moreOpen ? "active" : null)" aria-expanded="@(_moreOpen ? "true" : "false")"
                aria-controls="gsm-more-sheet" @onclick="ToggleMore">
            <MudIcon Icon="@Icons.Material.Outlined.MoreHoriz" Size="Size.Small" />
            <span class="gsm-tabbar-label">Más</span>
        </button>
    </nav>
}

@code {
    private IReadOnlyList<PanelMenuEntry> _bottom = [];
    private IReadOnlyList<PanelMenuGroup> _more = [];
    private bool _moreOpen;

    protected override async Task OnInitializedAsync()
    {
        Viewport.Changed += OnViewportChanged;
        Navigation.LocationChanged += OnLocationChanged;
        var state = await AuthState.GetAuthenticationStateAsync();
        _bottom = Registry.GetBottomBar(state.User, GymContext);
        _more = Registry.GetMore(state.User, GymContext);
    }

    private void ToggleMore() => _moreOpen = !_moreOpen;

    private void CloseMore() => _moreOpen = false;

    private void OnViewportChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => _ = InvokeAsync(() =>
        {
            _moreOpen = false;
            StateHasChanged();
        });

    public void Dispose()
    {
        Viewport.Changed -= OnViewportChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}

@* Navegación del panel agrupada por tarea, no por módulo: lo que se hace en el mostrador
   arriba, la gestión comercial después y el entrenamiento al final. Las entradas no se escriben
   aquí: cada módulo declara las suyas (IPanelModule.MenuEntries) y PanelRegistry las ordena. *@
@using GSM.Panel.UI.Navigation
@implements IDisposable
@inject GymContext GymContext
@inject PanelRegistry Registry
@inject AuthenticationStateProvider AuthState

<nav class="gsm-nav" aria-label="Navegación principal">
    @foreach (var group in _groups)
    {
        <div class="gsm-nav__group">
            <div class="gsm-nav__label">@group.Label</div>
            @foreach (var entry in group.Entries)
            {
                <NavLink class="gsm-nav-link" href="@entry.Href" Match="@(entry.MatchAll ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                    <MudIcon Icon="@entry.Icon" Size="Size.Small" /><span>@entry.Title</span>
                </NavLink>
            }
        </div>
    }

    @if (GymContext.Gym is { } gym)
    {
        @* Fijo al pie del menú: los enlaces se desplazan por detrás y el gym conectado queda siempre a la vista. *@
        <div class="gsm-nav__foot">
            <div class="gsm-nav__gym">
                <span class="gsm-nav__gym-mark" aria-hidden="true">@GymInitial(gym.Name)</span>
                <span class="gsm-nav__gym-text">
                    <span class="gsm-nav__gym-name">@gym.Name</span>
                    <span class="gsm-nav__gym-meta">Sesión · @RoleLabel(GymContext.Role)</span>
                </span>
            </div>
        </div>
    }
</nav>

@code {
    private IReadOnlyList<PanelMenuGroup> _groups = [];

    protected override async Task OnInitializedAsync()
    {
        GymContext.Changed += OnGymChanged;
        var state = await AuthState.GetAuthenticationStateAsync();
        _user = state.User;
        _groups = Registry.GetMenu(_user, GymContext);
    }

    private System.Security.Claims.ClaimsPrincipal? _user;

    // Si el gym cambia (o se apaga Recepción), el menú se vuelve a armar con sus opciones.
    private void OnGymChanged()
    {
        if (_user is not null)
        {
            _groups = Registry.GetMenu(_user, GymContext);
        }

        InvokeAsync(StateHasChanged);
    }

    private static string RoleLabel(string? role) => role switch
    {
        GsmRoles.Owner => "propietario",
        GsmRoles.Staff => "staff",
        GsmRoles.SuperAdmin => "soporte",
        _ => "—",
    };

    private static string GymInitial(string name)
        => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();

    public void Dispose() => GymContext.Changed -= OnGymChanged;
}

@* Campana de intentos de entrada rechazados (membresía vencida fuera de la gracia o sin membresía).
   Consulta el contador cada 30 s; no hay push, así que el aviso vive dentro del panel. *@
@implements IDisposable
@inject IAttendanceClient Attendance
@inject NavigationManager Navigation

<AuthorizeView Policy="@GsmPolicies.RequireStaff">
    <Authorized>
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="ml-2" OpenChanged="OnOpenChangedAsync">
            <ActivatorContent>
                <button type="button" class="gsm-bell @(_count > 0 ? "has-alerts" : null)" aria-label="@Label">
                    <MudIcon Icon="@(_count > 0 ? Icons.Material.Filled.NotificationsActive : Icons.Material.Outlined.Notifications)" Size="Size.Small" />
                    @if (_count > 0)
                    {
                        <span class="gsm-bell__count" aria-hidden="true">@(_count > 99 ? "99+" : _count.ToString())</span>
                    }
                </button>
            </ActivatorContent>
            <ChildContent>
                <div class="gsm-bell-panel">
                    <div class="gsm-bell-panel__title">Entradas rechazadas</div>
                    @if (_items.Count == 0)
                    {
                        <div class="gsm-bell-panel__empty">Nada pendiente.</div>
                    }
                    else
                    {
                        <ul class="gsm-bell-list">
                            @foreach (var item in _items)
                            {
                                <li class="gsm-bell-item">
                                    <a href="@($"/members/{item.MemberId}")" class="gsm-bell-item__name">@item.MemberName</a>
                                    <span class="gsm-bell-item__meta">
                                        @ReasonText(item) · @GsmFormat.Time(item.AttemptedAt)@(item.AttemptCount > 1 ? $" · {item.AttemptCount} intentos" : "")
                                    </span>
                                </li>
                            }
                        </ul>
                        <MudMenuItem Icon="@Icons.Material.Outlined.DoneAll" OnClick="AcknowledgeAllAsync">Marcar como vistos</MudMenuItem>
                    }
                </div>
            </ChildContent>
        </MudMenu>
        <span class="gsm-visually-hidden" role="status" aria-live="polite">@Announcement</span>
    </Authorized>
</AuthorizeView>

@code {
    private readonly CancellationTokenSource _cts = new();
    private List<CheckinAttemptItem> _items = [];
    private int _count;
    private int _announced;
    private PeriodicTimer? _timer;

    private string Label => $"Intentos de entrada rechazados: {_count}";

    private string Announcement => _announced > 0 ? Label : string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await RefreshCountAsync();
        _ = PollAsync();
    }

    private async Task PollAsync()
    {
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            while (await _timer.WaitForNextTickAsync(_cts.Token))
            {
                var before = _count;
                await RefreshCountAsync();
                _announced = _count > before ? _count : 0;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RefreshCountAsync()
    {
        try
        {
            _count = (await Attendance.PendingCountAsync(_cts.Token)).Count;
        }
        catch (GsmApiException)
        {
            // Sin permiso o sin red: la campana simplemente no muestra nada.
        }
    }

    private async Task OnOpenChangedAsync(bool open)
    {
        if (open)
        {
            await LoadListAsync();
        }
    }

    private async Task LoadListAsync()
    {
        try
        {
            _items = (await Attendance.AttemptsAsync(null, null, true, 1, 8)).Items.ToList();
        }
        catch (GsmApiException)
        {
        }
    }

    private async Task AcknowledgeAllAsync()
    {
        try
        {
            await Attendance.AcknowledgeAllAsync();
            _items = [];
            _count = 0;
        }
        catch (GsmApiException)
        {
        }
    }

    private static string ReasonText(CheckinAttemptItem item)
        => item.Reason == "NoMembership" ? "Sin membresía"
            : item.MembershipEndedOn is { } ended ? $"Venció el {GsmFormat.DayCompact(ended)}" : "Membresía vencida";

    public void Dispose()
    {
        _cts.Cancel();
        _timer?.Dispose();
        _cts.Dispose();
    }
}

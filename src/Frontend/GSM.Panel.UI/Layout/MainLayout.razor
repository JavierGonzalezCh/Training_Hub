@inherits LayoutComponentBase
@inject GymContext GymContext
@inject SessionService Session
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState
@inject IBrowserViewportService BrowserViewport
@inject ViewportState Viewport
@inject IDialogService Dialogs
@inject GSM.UI.Shared.Push.PushRegistrationService PushRegistration
@inject GSM.Panel.UI.Onboarding.OnboardingGate OnboardingGate
@implements IDisposable

<GsmThemeProvider Gym="@GymContext.Gym" />
<MudPopoverProvider />
<PanelDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="gsm-shell">
    <ImpersonationBar />
    <MudAppBar Elevation="0" Class="gsm-topbar">
        @* En el celular manda la barra inferior (BottomNav); el menú lateral es solo de escritorio. *@
        @if (!Viewport.IsNarrow)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                           Class="mr-2 d-md-none" OnClick="@(() => _drawerOpen = !_drawerOpen)" aria-label="Abrir menú" />
        }
        <a href="/" class="gsm-topbar__brand" aria-label="TrainingHub, ir al dashboard">
            <span class="gsm-wordmark">TRAINING<span class="accent">HUB</span><span class="gsm-wordmark__tag">OS</span></span>
        </a>
        @if (GymContext.Gym is { } gym)
        {
            <span class="gsm-topbar__gym d-none d-sm-inline">@gym.Name</span>
        }
        <MudSpacer />
        <StaffBell />
        @* La acción más repetida en recepción, a un clic desde cualquier pantalla. *@
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="gsm-topbar__action ml-3"
                   StartIcon="@Icons.Material.Filled.QrCodeScanner" Href="/attendance/checkin" aria-label="Check-in">
            <span class="d-none d-sm-inline">Check-in</span>
        </MudButton>
        <AuthorizeView>
            <Authorized>
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="ml-2">
                    <ActivatorContent>
                        <button type="button" class="gsm-avatar-button" aria-label="Menú de usuario">
                            <span class="gsm-avatar">@GsmFormat.Initials(context.User.Identity?.Name)</span>
                        </button>
                    </ActivatorContent>
                    <ChildContent>
                        <div class="gsm-user-card">
                            <div class="gsm-user-card__name">@(context.User.Identity?.Name ?? "—")</div>
                            <div class="gsm-user-card__meta">@RoleLabel(GymContext.Role)</div>
                        </div>
                        <MudDivider />
                        <ModeSwitch Accesses="_accesses" />
                        @if (_accesses.Count > 1)
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.SwapHoriz" OnClick="SwitchGymAsync">Cambiar de gimnasio</MudMenuItem>
                        }
                        @* Quien impersona un gym no es dueño de esa cuenta: no puede cambiar su contraseña desde aquí. *@
                        @if (context.User.IsInRole("owner") || context.User.IsInRole("staff"))
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.NotificationsActive" Href="/cuenta/avisos">Avisos en el teléfono</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.Lock" Href="/cuenta/contrasena">Cambiar contraseña</MudMenuItem>
                        }
                        <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="LogoutAsync">Cerrar sesión</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    @if (!Viewport.IsNarrow)
    {
        <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md"
                   ClipMode="DrawerClipMode.Always" Class="gsm-drawer">
            <NavMenu />
        </MudDrawer>
    }

    <MudMainContent Class="gsm-main">
        <SubscriptionBanner />
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="gsm-page">
            @* Invitación a activar los avisos: solo con el panel instalado como app, que es cuando el push llega con él cerrado. *@
            <AuthorizeView Roles="owner,staff">
                <PushPermissionPrompt Platform="@GSM.UI.Shared.Push.PushPlatforms.WebPanel" RequireInstalled="true"
                                      Title="Activa los avisos del gimnasio"
                                      Message="Recibe en este teléfono las alertas del gimnasio aunque el panel esté cerrado. Elige cuáles quieres en «Avisos en el teléfono»." />
            </AuthorizeView>
            @if (_staffWaiting)
            {
                @* Gyms §5: el staff no puede hacer nada hasta que el Owner termine el onboarding. *@
                <div class="gsm-empty" data-testid="onboarding-staff-waiting">
                    <MudIcon Icon="@Icons.Material.Outlined.Construction" Class="gsm-empty-icon" />
                    <MudText Typo="Typo.h6">Tu gym todavía se está configurando</MudText>
                    <MudText Color="Color.Secondary">El propietario está terminando de dejar todo listo. Vuelve en un rato.</MudText>
                </div>
            }
            else if (!_redirectingToOnboarding)
            {
                <GSM.UI.Shared.Diagnostics.GsmErrorBoundary>
                    @Body
                </GSM.UI.Shared.Diagnostics.GsmErrorBoundary>
            }
        </MudContainer>
    </MudMainContent>
    <BottomNav />
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private IReadOnlyList<GymAccessOption> _accesses = [];
    private bool _staffWaiting;
    private bool _redirectingToOnboarding;

    protected override async Task OnInitializedAsync()
    {
        GymContext.Changed += OnGymChanged;
        Navigation.LocationChanged += OnLocationChanged;
        Viewport.Changed += OnViewportChanged;

        // El layout envuelve tanto el contenido autorizado como el "acceso denegado" de
        // AuthorizeRouteView: si aún no hay sesión, no tiene sentido pedir /api/auth/me.
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        // La cuenta de kiosco no tiene perfil: /api/auth/me le responde 403 (B9) y el kiosco no usa el panel.
        if (state.User.IsInRole(GsmRoles.Kiosk))
        {
            return;
        }

        if (!GymContext.IsLoaded)
        {
            try
            {
                await Session.BootstrapAsync();
            }
            catch (ApiErrorException ex) when (ex.Error.IsUnauthorized)
            {
                Navigation.NavigateTo("/login", replace: true);
                return;
            }
        }

        // Onboarding obligatorio (Gyms §5): hasta completar los pasos 1 a 5, el Owner va al asistente y el staff espera.
        if (await ApplyOnboardingGateAsync(state.User))
        {
            return;
        }

        // Con más de un acceso (otros gyms, o el otro modo de este gym) se ofrece "Cambiar de gimnasio".
        _accesses = await Session.GetAccessesAsync();

        // Si la persona del equipo ya dio el permiso en este dispositivo, se registra su token (puede haber rotado).
        if (state.User.IsInRole("owner") || state.User.IsInRole("staff"))
        {
            _ = PushRegistration.SyncAsync(GSM.UI.Shared.Push.PushPlatforms.WebPanel);
        }
    }

    /// <summary>Devuelve <c>true</c> si el panel quedó bloqueado (y no hay que seguir cargándolo).</summary>
    private async Task<bool> ApplyOnboardingGateAsync(System.Security.Claims.ClaimsPrincipal user)
    {
        if (!await OnboardingGate.IsBlockedAsync())
        {
            _staffWaiting = false;
            _redirectingToOnboarding = false;
            return false;
        }

        if (user.IsInRole(GsmRoles.Owner))
        {
            _redirectingToOnboarding = true;
            Navigation.NavigateTo("/onboarding", replace: true);
        }
        else
        {
            _staffWaiting = true;
        }

        return true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Viewport.EnsureStartedAsync();
        }
    }

    private void OnViewportChanged() => InvokeAsync(StateHasChanged);

    private async Task SwitchGymAsync()
        => await Dialogs.ShowAsync<GymSwitchDialog>(
            "Cambiar de gimnasio",
            new DialogParameters<GymSwitchDialog> { { x => x.Accesses, _accesses } });

    // En móvil el drawer se abre por encima del contenido: navegar tiene que cerrarlo.
    // En escritorio queda fijo, así que solo se cierra por debajo del breakpoint.
    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // El staff que esperaba entra en cuanto el Owner termina: se vuelve a preguntar al navegar.
        if (_staffWaiting && !await OnboardingGate.IsBlockedAsync(refresh: true))
        {
            _staffWaiting = false;
            await InvokeAsync(StateHasChanged);
        }

        if (!_drawerOpen)
        {
            return;
        }

        var breakpoint = await BrowserViewport.GetCurrentBreakpointAsync();
        if (breakpoint is Breakpoint.Xs or Breakpoint.Sm)
        {
            _drawerOpen = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // El nombre del gym y su color de marca (GsmThemeProvider) llegan con el bootstrap.
    private void OnGymChanged() => InvokeAsync(StateHasChanged);

    private async Task LogoutAsync()
    {
        await PushRegistration.DisableAsync(); // da de baja el dispositivo mientras la sesión sigue válida
        await Session.LogoutAsync();
        Navigation.NavigateTo("/login", replace: true);
    }

    private static string RoleLabel(string? role) => role switch
    {
        GsmRoles.Owner => "Propietario",
        GsmRoles.Staff => "Staff",
        GsmRoles.SuperAdmin => "SuperAdmin",
        _ => "—",
    };

    public void Dispose()
    {
        GymContext.Changed -= OnGymChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        Viewport.Changed -= OnViewportChanged;
    }
}

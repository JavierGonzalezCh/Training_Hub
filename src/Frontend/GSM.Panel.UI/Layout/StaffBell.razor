@* Campana del panel: la bandeja general del staff (avisos de acción del gym, como un intento de entrada
   rechazado, e informativos propios). Consulta el contador cada 30 s; el push llega en N2. *@
@implements IDisposable
@inject IStaffNotificationsClient Notifications

<AuthorizeView Policy="@GsmPolicies.RequireStaff">
    <Authorized>
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="ml-2" OpenChanged="OnOpenChangedAsync">
            <ActivatorContent>
                <button type="button" class="gsm-bell @(_count > 0 ? "has-alerts" : null)" aria-label="@Label">
                    <MudIcon Icon="@(_count > 0 ? Icons.Material.Filled.NotificationsActive : Icons.Material.Outlined.Notifications)" Size="Size.Small" />
                    @if (_count > 0)
                    {
                        <span class="gsm-bell__count" aria-hidden="true">@(_count > 99 ? "99+" : _count.ToString())</span>
                    }
                </button>
            </ActivatorContent>
            <ChildContent>
                <StaffNotificationList Items="_items" OnResolve="ResolveAsync" OnRead="ReadAsync" OnResolveAll="ResolveAllAsync" />
            </ChildContent>
        </MudMenu>
        <span class="gsm-visually-hidden" role="status" aria-live="polite">@Announcement</span>
    </Authorized>
</AuthorizeView>

@code {
    private readonly CancellationTokenSource _cts = new();
    private List<StaffNotificationItem> _items = [];
    private int _count;
    private int _announced;
    private PeriodicTimer? _timer;

    private string Label => $"Avisos sin atender: {_count}";

    private string Announcement => _announced > 0 ? Label : string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await RefreshCountAsync();
        _ = PollAsync();
    }

    private async Task PollAsync()
    {
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            while (await _timer.WaitForNextTickAsync(_cts.Token))
            {
                var before = _count;
                await RefreshCountAsync();
                _announced = _count > before ? _count : 0;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RefreshCountAsync()
    {
        try
        {
            _count = (await Notifications.OpenCountAsync(_cts.Token)).Count;
        }
        catch (GsmApiException)
        {
            // Sin permiso o sin red: la campana simplemente no muestra nada.
        }
    }

    private async Task OnOpenChangedAsync(bool open)
    {
        if (open)
        {
            await LoadListAsync();
        }
    }

    // Abierta o cerrada, la lista trae primero lo abierto y después lo atendido (con quién y cuándo).
    private async Task LoadListAsync()
    {
        try
        {
            _items = (await Notifications.Notifications2Async(false, 1, 8)).Items.ToList();
        }
        catch (GsmApiException)
        {
        }
    }

    private async Task ResolveAsync(StaffNotificationItem item)
    {
        try
        {
            await Notifications.ResolveAsync(item.Id);
        }
        catch (GsmApiException)
        {
        }

        await ReloadAsync();
    }

    private async Task ReadAsync(StaffNotificationItem item)
    {
        try
        {
            await Notifications.Read2Async(item.Id);
        }
        catch (GsmApiException)
        {
        }

        await ReloadAsync();
    }

    private async Task ResolveAllAsync()
    {
        try
        {
            await Notifications.ResolveAllAsync();
        }
        catch (GsmApiException)
        {
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        await LoadListAsync();
        await RefreshCountAsync();
    }

    public void Dispose()
    {
        _cts.Cancel();
        _timer?.Dispose();
        _cts.Dispose();
    }
}

@inject GSM.UI.Shared.IClipboard Clipboard
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Class="mb-3">Código de invitación (válido 7 días). Compártelo con el miembro para que cree su cuenta.</MudText>
        <MudPaper Class="pa-3 d-flex align-center justify-space-between" Elevation="0" Style="border:1px solid var(--gsm-border)">
            <MudText Typo="Typo.h5" Class="gsm-mono">@Code</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" OnClick="CopyAsync" title="Copiar" />
        </MudPaper>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">Expira: @GsmFormat.Instant(ExpiresAt)</MudText>
        @if (MemberId is { } memberId)
        {
            <div class="mt-3">
                <WhatsAppButton MemberId="memberId" Kind="AppInvitation" />
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="@(() => MudDialog.Close())">Listo</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired]
    public string Code { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public DateTimeOffset ExpiresAt { get; set; }

    /// <summary>Si viene, se ofrece mandar la invitación por WhatsApp con el enlace de registro.</summary>
    [Parameter]
    public Guid? MemberId { get; set; }

    private async Task CopyAsync()
    {
        if (await Clipboard.CopyAsync(Code))
        {
            Snackbar.Add("Código copiado.", Severity.Success);
        }
        else
        {
            Snackbar.Add("No se pudo copiar. Selecciónalo manualmente.", Severity.Warning);
        }
    }
}

@inject IMembersClient Members

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <GsmLoader />
        }
        else
        {
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4" role="alert">@_error</MudAlert>
            }
            <MudForm @ref="_form" Model="_model">
                <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-1">Identificación</MudText>
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" @bind-Value="_model.FirstName" Label="Nombres" Required="true"
                                      RequiredError="Los nombres son obligatorios." />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" @bind-Value="_model.LastName" Label="Apellidos" Required="true"
                                      RequiredError="Los apellidos son obligatorios." />
                    </MudItem>
                    <MudItem xs="12" sm="5">
                        <MudSelect T="string" @bind-Value="_model.DocumentType" Label="Tipo de documento">
                            @foreach (var (value, label) in MemberLabels.DocumentTypes)
                            {
                                <MudSelectItem Value="@value">@label</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="7">
                        <MudTextField T="string" @bind-Value="_model.DocumentNumber" Label="Número de documento" Required="true"
                                      RequiredError="El documento es obligatorio."
                                      Error="@_documentHasError" ErrorText="@_documentError" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker Label="Fecha de nacimiento" Required="@(MemberId is null)"
                                       RequiredError="La fecha de nacimiento es obligatoria."
                                       Date="_model.BirthDate" DateChanged="OnBirthDateChanged"
                                       MaxDate="@DateTime.Today.AddDays(-1)"
                                       Error="@_birthDateHasError" ErrorText="@_birthDateError" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" @bind-Value="_model.Gender" Label="Género" Clearable="true">
                            @foreach (var (value, label) in MemberLabels.Genders)
                            {
                                <MudSelectItem Value="@value">@label</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>

                <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mt-4 mb-1">Contacto</MudText>
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" @bind-Value="_model.Phone" Label="Teléfono"
                                      HelperText="10 dígitos de Colombia o formato internacional (+57…)"
                                      Error="@_phoneHasError" ErrorText="@_phoneError" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" @bind-Value="_model.Email" Label="Email" InputType="InputType.Email"
                                      Error="@_emailHasError" ErrorText="@_emailError" />
                    </MudItem>
                    <MudItem xs="12" sm="8">
                        <MudTextField T="string" @bind-Value="_model.Address" Label="Dirección" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField T="string" @bind-Value="_model.City" Label="Ciudad" />
                    </MudItem>
                </MudGrid>

                <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mt-4 mb-1">Contacto de emergencia</MudText>
                <MudGrid>
                    <MudItem xs="12" sm="5">
                        <MudTextField T="string" @bind-Value="_model.EmergencyContactName" Label="Nombre" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudTextField T="string" @bind-Value="_model.EmergencyContactRelationship" Label="Parentesco" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudTextField T="string" @bind-Value="_model.EmergencyContactPhone" Label="Teléfono"
                                      Error="@_emergencyPhoneHasError" ErrorText="@_emergencyPhoneError" />
                    </MudItem>
                </MudGrid>

                @if (_isMinor)
                {
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mt-4 mb-1" id="guardian-section">Datos del acudiente</MudText>
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                        El miembro es menor de edad: los datos del acudiente son obligatorios.
                    </MudAlert>
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" @bind-Value="_model.GuardianName" Label="Nombre del acudiente" Required="true"
                                          RequiredError="El nombre del acudiente es obligatorio." />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" @bind-Value="_model.GuardianRelationship" Label="Parentesco" Required="true"
                                          RequiredError="El parentesco es obligatorio." />
                        </MudItem>
                        <MudItem xs="12" sm="5">
                            <MudSelect T="string" @bind-Value="_model.GuardianDocumentType" Label="Tipo de documento">
                                @foreach (var (value, label) in MemberLabels.DocumentTypes)
                                {
                                    <MudSelectItem Value="@value">@label</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="7">
                            <MudTextField T="string" @bind-Value="_model.GuardianDocumentNumber" Label="Número de documento" Required="true"
                                          RequiredError="El documento del acudiente es obligatorio." />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="string" @bind-Value="_model.GuardianPhone" Label="Teléfono del acudiente" Required="true"
                                          RequiredError="El teléfono del acudiente es obligatorio."
                                          Error="@_guardianPhoneHasError" ErrorText="@_guardianPhoneError" />
                        </MudItem>
                    </MudGrid>
                }

                <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mt-4 mb-1">Relación con el gimnasio</MudText>
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" @bind-Value="_model.Source" Label="Cómo nos conoció" Clearable="true">
                            @foreach (var (value, label) in MemberLabels.Sources)
                            {
                                <MudSelectItem Value="@value">@label</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" @bind-Value="_model.Goal" Label="Objetivo" Clearable="true">
                            @foreach (var (value, label) in MemberLabels.Goals)
                            {
                                <MudSelectItem Value="@value">@label</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudAutocomplete T="MemberListItem" Label="Referido por" Clearable="true"
                                         Value="_referrer" ValueChanged="OnReferrerChanged"
                                         SearchFunc="SearchReferrersAsync"
                                         ToStringFunc="@(m => m is null ? string.Empty : $"{m.FirstName} {m.LastName} · {m.DocumentNumber}")"
                                         Error="@_referrerHasError" ErrorText="@_referrerError" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" @bind-Value="_model.TagsText" Label="Etiquetas"
                                      HelperText="Separadas por coma: crossfit, mañanas" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker Label="Fecha de ingreso" @bind-Date="_model.JoinedAt"
                                       MaxDate="@DateTime.Today"
                                       HelperText="@(MemberId is null ? "Vacía = hoy. Cámbiala si migras miembros antiguos." : null)" />
                    </MudItem>
                </MudGrid>
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_loading || _submitting">
            @(_submitting ? "Guardando..." : "Guardar")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>Null = alta; con valor, edición.</summary>
    [Parameter]
    public Guid? MemberId { get; set; }

    private readonly MemberFormModel _model = new();
    private MudForm _form = null!;
    private MemberListItem? _referrer;
    private bool _loading;
    private bool _submitting;
    private string? _error;
    private Dictionary<string, string[]> _fieldErrors = new(StringComparer.OrdinalIgnoreCase);

    private bool _isMinor => _model.IsMinor(GsmFormat.Today());

    protected override async Task OnInitializedAsync()
    {
        if (MemberId is not { } id)
        {
            return;
        }

        _loading = true;
        try
        {
            var member = await Members.MembersGET2Async(id);
            var loaded = MemberFormModel.From(member);
            CopyInto(loaded);

            if (member.ReferredByMemberId is { } referrerId)
            {
                try
                {
                    var referrer = await Members.MembersGET2Async(referrerId);
                    _referrer = new MemberListItem
                    {
                        Id = referrer.Id,
                        FirstName = referrer.FirstName,
                        LastName = referrer.LastName,
                        DocumentNumber = referrer.DocumentNumber,
                        DocumentType = referrer.DocumentType,
                    };
                }
                catch (GsmApiException)
                {
                    // El referente no se pudo leer: se conserva el id y se edita el resto.
                }
            }
        }
        catch (GsmApiException ex)
        {
            _error = ApiError.FromException(ex).DisplayMessage;
        }
        finally
        {
            _loading = false;
        }
    }

    private void CopyInto(MemberFormModel source)
    {
        foreach (var property in typeof(MemberFormModel).GetProperties().Where(p => p.CanWrite))
        {
            property.SetValue(_model, property.GetValue(source));
        }
    }

    private void OnBirthDateChanged(DateTime? date) => _model.BirthDate = date;

    private void OnReferrerChanged(MemberListItem? referrer)
    {
        _referrer = referrer;
        _model.ReferredByMemberId = referrer?.Id;
    }

    private async Task<IEnumerable<MemberListItem>> SearchReferrersAsync(string value, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Length < 2)
        {
            return [];
        }

        try
        {
            var page = await Members.MembersGETAsync(value, null, null, null, 1, 8, null, null, null, cancellationToken);
            return page.Items.Where(m => m.Id != MemberId).ToList();
        }
        catch (GsmApiException)
        {
            return [];
        }
    }

    private string? FieldError(string name) => _fieldErrors.TryGetValue(name, out var errors) ? errors.FirstOrDefault() : null;

    private bool _documentHasError => _fieldErrors.ContainsKey("documentNumber");
    private string? _documentError => FieldError("documentNumber");
    private bool _birthDateHasError => _fieldErrors.ContainsKey("birthDate");
    private string? _birthDateError => FieldError("birthDate");
    private bool _phoneHasError => _fieldErrors.ContainsKey("phone");
    private string? _phoneError => FieldError("phone");
    private bool _emailHasError => _fieldErrors.ContainsKey("email");
    private string? _emailError => FieldError("email");
    private bool _emergencyPhoneHasError => _fieldErrors.ContainsKey("emergencyContactPhone");
    private string? _emergencyPhoneError => FieldError("emergencyContactPhone");
    private bool _guardianPhoneHasError => _fieldErrors.ContainsKey("guardianPhone");
    private string? _guardianPhoneError => FieldError("guardianPhone");
    private bool _referrerHasError => _fieldErrors.ContainsKey("referredByMemberId");
    private string? _referrerError => FieldError("referredByMemberId");

    private async Task SubmitAsync()
    {
        _error = null;
        _fieldErrors = new(StringComparer.OrdinalIgnoreCase);
        await _form.Validate();
        if (!_form.IsValid)
        {
            return;
        }

        if (MemberId is null && _model.BirthDate is null)
        {
            _fieldErrors["birthDate"] = ["La fecha de nacimiento es obligatoria."];
            _error = "Revisa los campos marcados.";
            return;
        }

        // Aviso antes de enviar; el servidor sigue siendo quien decide (422).
        var missing = _model.MissingGuardianFields(GsmFormat.Today());
        if (missing.Count > 0)
        {
            _error = $"El miembro es menor de edad: falta del acudiente {string.Join(", ", missing)}.";
            return;
        }

        _submitting = true;
        try
        {
            if (MemberId is { } id)
            {
                await Members.MembersPUTAsync(id, _model.ToUpdateRequest());
            }
            else
            {
                await Members.MembersPOSTAsync(_model.ToCreateRequest());
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (GsmApiException ex)
        {
            var error = ApiError.FromException(ex);
            if (error.IsConflict)
            {
                _error = "Ya existe un miembro con ese documento.";
                _fieldErrors["documentNumber"] = [_error];
            }
            else if (error.IsValidation)
            {
                _fieldErrors = new Dictionary<string, string[]>(error.FieldErrors, StringComparer.OrdinalIgnoreCase);
                _error = "Revisa los campos marcados.";
            }
            else
            {
                // 422 (regla de negocio): el detalle del servidor es el mensaje.
                _error = error.DisplayMessage;
            }
        }
        finally
        {
            _submitting = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}

@inject IMemberMembershipsClient MemberMemberships
@inject IMembershipPlansClient Plans
@inject IPaymentsClient Payments

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
            }
            @if (_plans.Count == 0)
            {
                <MudText Color="Color.Secondary">No hay planes activos. Crea uno primero en Planes.</MudText>
            }
            else
            {
                <MudForm @ref="_form">
                    <MudSelect T="Guid" Value="_planId" ValueChanged="OnPlanChanged" ToStringFunc="PlanLabel" Label="Plan" Required="true" Class="mb-3"
                               Disabled="@(_pendingCharge is not null)">
                        @foreach (var plan in _plans)
                        {
                            <MudSelectItem Value="plan.Id">@PlanLabel(plan.Id)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudDatePicker Label="Cambiar la fecha de inicio (opcional)" Date="_startDate" DateChanged="OnStartChanged" Class="mb-2"
                                   Disabled="@(_pendingCharge is not null)" />

                    @if (_preview is { } preview)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" role="status" id="renewal-preview">
                            <strong>Empieza el @GsmFormat.DayShort(preview.StartDate) · vence el @GsmFormat.DayShort(preview.EndDate)</strong>
                            <div>@KindText(preview)</div>
                        </MudAlert>
                        @if (preview.StartDateChanged && preview.Kind != "new")
                        {
                            <MudTextField T="string" @bind-Value="_startReason" Label="Motivo del cambio de fecha" Required="true"
                                          MaxLength="500" Class="mb-3"
                                          HelperText="El sistema calcula el inicio según la situación del miembro; cambiarlo exige un motivo." />
                        }
                    }

                    <MudNumericField T="decimal" Culture="GsmFormat.Colombia" Format="@GsmFormat.MoneyFieldFormat"
                                     @bind-Value="_agreedPrice" Label="Precio acordado (COP)" Min="0" Max="@PlanPrice" id="agreed-price" Class="mb-2"
                                     Disabled="@(_pendingCharge is not null)"
                                     HelperText="@($"Precio del plan: {GsmFormat.Money(PlanPrice)}. Si es menor, hay descuento.")" />
                    @if (HasDiscount)
                    {
                        <MudTextField T="string" @bind-Value="_discountReason" Label="Motivo del descuento" Required="true"
                                      MaxLength="500" id="discount-reason" Class="mb-3" Disabled="@(_pendingCharge is not null)" />
                    }

                    @if (EnrollmentFee > 0)
                    {
                        <MudSwitch T="bool" @bind-Value="_waiveEnrollment" Color="Color.Primary" id="waive-enrollment"
                                   Disabled="@(_pendingCharge is not null)"
                                   Label="@($"Exonerar la matrícula ({GsmFormat.Money(EnrollmentFee)})")" Class="mb-1" />
                        @if (_waiveEnrollment)
                        {
                            <MudTextField T="string" @bind-Value="_waiveReason" Label="Motivo para exonerar la matrícula" Required="true"
                                          MaxLength="500" id="waive-reason" Class="mb-3" Disabled="@(_pendingCharge is not null)" />
                        }
                    }

                    <MudAlert Severity="Severity.Normal" Dense="true" Class="mb-3" role="status" id="total-to-charge">
                        <div>Plan: @GsmFormat.Money(_agreedPrice)</div>
                        @if (EnrollmentFee > 0)
                        {
                            <div>Matrícula: @(_waiveEnrollment ? "exonerada" : GsmFormat.Money(EnrollmentFee))</div>
                        }
                        <strong>Total a cobrar: @GsmFormat.Money(Total)</strong>
                    </MudAlert>

                    @if (_pendingCharge is not null)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3" id="charge-failed">
                            La membresía quedó creada, pero el cobro no se registró: @_chargeError
                        </MudAlert>
                    }

                    @if (Total > 0)
                    {
                        <MudSelect T="int" @bind-Value="_method" Label="Método de pago" Required="true">
                            @foreach (var (value, label) in PaymentMethodLabels.All)
                            {
                                <MudSelectItem Value="value">@label</MudSelectItem>
                            }
                        </MudSelect>
                    }
                </MudForm>
            }
        }
    </DialogContent>
    <DialogActions>
        @if (_pendingCharge is null)
        {
            <MudButton OnClick="Cancel">Cancelar</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_loading || _submitting || _plans.Count == 0">
                @(_submitting ? "Guardando..." : Total > 0 ? "Asignar y cobrar" : "Asignar")
            </MudButton>
        }
        else
        {
            <MudButton Color="Color.Error" OnClick="CancelMembershipAsync" Disabled="_submitting">Cancelar la membresía</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="RetryChargeAsync" Disabled="_submitting">
                @(_submitting ? "Cobrando..." : "Reintentar el cobro")
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired]
    public Guid MemberId { get; set; }

    private List<PlanResponse> _plans = [];
    private Guid _planId;
    private DateTime? _startDate;
    private string? _startReason;
    private RenewalPreviewResponse? _preview;
    private decimal _agreedPrice;
    private string? _discountReason;
    private bool _waiveEnrollment;
    private string? _waiveReason;
    private int _method;
    private MembershipResponse? _pendingCharge;
    private string? _chargeError;
    private MudForm _form = null!;
    private bool _loading = true;
    private bool _submitting;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var plans = await Plans.MembershipPlansAllAsync(includeInactive: false);
            _plans = plans.ToList();
            if (_plans.Count > 0)
            {
                // Se propone el plan que el miembro ya tenía (la última membresía que no se canceló).
                var history = await MemberMemberships.MembershipsAllAsync(MemberId);
                var lastPlanId = history
                    .Where(m => m.Status != "Cancelled")
                    .OrderByDescending(m => m.StartDate)
                    .Select(m => (Guid?)m.PlanId)
                    .FirstOrDefault();
                var proposed = _plans.FirstOrDefault(p => p.Id == lastPlanId) ?? _plans[0];
                await OnPlanChanged(proposed.Id);
            }
        }
        catch (GsmApiException ex)
        {
            _error = ApiError.FromException(ex).DisplayMessage;
        }
        finally
        {
            _loading = false;
        }
    }

    private string PlanLabel(Guid planId)
        => _plans.FirstOrDefault(p => p.Id == planId) is { } plan
            ? $"{plan.Name} — {GsmFormat.Money((decimal)plan.Price)} · {plan.DurationDays} días"
            : string.Empty;

    private async Task OnPlanChanged(Guid planId)
    {
        _planId = planId;
        if (_plans.FirstOrDefault(p => p.Id == planId) is { } plan)
        {
            _agreedPrice = (decimal)plan.Price;
            _discountReason = null;
        }

        await LoadPreviewAsync();
    }

    private async Task OnStartChanged(DateTime? date)
    {
        _startDate = date;
        await LoadPreviewAsync();
    }

    // La vista previa usa el mismo cálculo que "asignar": lo que se muestra es lo que se crea.
    private async Task LoadPreviewAsync()
    {
        try
        {
            _preview = await MemberMemberships.PreviewAsync(
                MemberId, _planId, _startDate is { } d ? DateOnly.FromDateTime(d) : null);
        }
        catch (GsmApiException ex)
        {
            _preview = null;
            _error = ApiError.FromException(ex).DisplayMessage;
        }
    }

    private static string KindText(RenewalPreviewResponse preview) => preview.Kind switch
    {
        "early" => $"Renueva antes de vencer: empieza al terminar la anterior ({(preview.PreviousEndDate is { } e ? GsmFormat.DayShort(e) : "—")}).",
        "in_grace" => "Venció dentro de la gracia: conserva su fecha de ciclo.",
        "after_grace" => "Venció hace más que la gracia: empieza el día en que paga.",
        _ => "Primera membresía.",
    };

    private decimal PlanPrice => _plans.FirstOrDefault(p => p.Id == _planId) is { } plan ? (decimal)plan.Price : 0m;

    private bool HasDiscount => _agreedPrice < PlanPrice;

    // Matrícula que aplica según el servidor (0 si el miembro ya tuvo membresía o el gym no la cobra).
    private decimal EnrollmentFee => _preview is { } p ? (decimal)p.EnrollmentFee : 0m;

    private decimal Total => _agreedPrice + (_waiveEnrollment ? 0m : EnrollmentFee);

    // Asignar y cobrar son dos llamadas, no una operación atómica: asignar es de Memberships y cobrar
    // de Payments, y la regla del proyecto es no escribir en otro módulo. El cobro completo es parte
    // de asignar (Memberships v2 §6): si falla, el diálogo no se cierra y ofrece reintentar el cobro
    // o cancelar la membresía recién creada. Un total de 0 (cortesía) no genera cobro.
    private async Task SubmitAsync()
    {
        _error = null;
        if (_agreedPrice > PlanPrice)
        {
            _error = "El precio acordado no puede superar el precio del plan.";
            return;
        }

        if (HasDiscount && (_discountReason?.Trim().Length ?? 0) < 3)
        {
            _error = "El motivo del descuento es obligatorio.";
            return;
        }

        if (_waiveEnrollment && EnrollmentFee > 0 && (_waiveReason?.Trim().Length ?? 0) < 3)
        {
            _error = "El motivo para exonerar la matrícula es obligatorio.";
            return;
        }

        _submitting = true;
        MembershipResponse membership;
        try
        {
            var waive = _waiveEnrollment && EnrollmentFee > 0;
            membership = await MemberMemberships.MembershipsAsync(MemberId, new AssignMembershipRequest
            {
                PlanId = _planId,
                StartDate = _startDate is { } d ? DateOnly.FromDateTime(d) : null,
                StartDateReason = string.IsNullOrWhiteSpace(_startReason) ? null : _startReason.Trim(),
                AgreedPrice = (double)_agreedPrice,
                DiscountReason = HasDiscount ? _discountReason!.Trim() : null,
                WaiveEnrollment = waive,
                EnrollmentWaivedReason = waive ? _waiveReason!.Trim() : null,
            });
        }
        catch (GsmApiException ex)
        {
            // 409: ya tiene una membresía vigente que se solapa. 422: precio o motivos inválidos.
            _error = ApiError.FromException(ex).DisplayMessage;
            _submitting = false;
            return;
        }

        if ((decimal)membership.TotalToCharge <= 0)
        {
            MudDialog.Close(DialogResult.Ok(new AssignMembershipResult(Charged: false, ChargeError: null)));
            return;
        }

        await ChargeAsync(membership);
    }

    private async Task ChargeAsync(MembershipResponse membership)
    {
        try
        {
            var concept = $"Membresía {membership.PlanName} ({GsmFormat.DayRange(membership.StartDate, membership.EndDate)})";
            if ((decimal)membership.EnrollmentFee > 0)
            {
                concept += " + matrícula";
            }

            await Payments.PaymentsPOST2Async(new RecordPaymentRequest
            {
                Amount = membership.TotalToCharge,
                Method = _method,
                Concept = concept,
                MemberId = MemberId,
                MembershipId = membership.Id,
            });
            MudDialog.Close(DialogResult.Ok(new AssignMembershipResult(Charged: true, ChargeError: null)));
        }
        catch (GsmApiException ex)
        {
            _pendingCharge = membership;
            _chargeError = ApiError.FromException(ex).DisplayMessage;
            _submitting = false;
        }
    }

    private async Task RetryChargeAsync()
    {
        if (_pendingCharge is null)
        {
            return;
        }

        _submitting = true;
        await ChargeAsync(_pendingCharge);
    }

    // Sin el cobro la membresía no debe quedar: se cancela con motivo (no se borra, queda en el historial).
    private async Task CancelMembershipAsync()
    {
        if (_pendingCharge is null)
        {
            return;
        }

        _submitting = true;
        try
        {
            await MemberMemberships.Cancel2Async(
                MemberId, _pendingCharge.Id, new CancelMembershipRequest { Reason = "Cobro no registrado al asignar" });
            MudDialog.Close(DialogResult.Ok(new AssignMembershipResult(Charged: false, ChargeError: null, Cancelled: true)));
        }
        catch (GsmApiException ex)
        {
            _chargeError = ApiError.FromException(ex).DisplayMessage;
            _submitting = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}

@code {
    public sealed record AssignMembershipResult(bool Charged, string? ChargeError, bool Cancelled = false);
}

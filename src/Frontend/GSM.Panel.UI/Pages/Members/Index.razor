@page "/members"
@attribute [Authorize(Policy = GsmPolicies.RequireStaff)]
@inject IMembersClient Members
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Miembros — GSM</PageTitle>

<PageHeader Eyebrow="Negocio" Title="Miembros">
    <Subtitle>@(_total is { } total ? $"{total} {(total == 1 ? "miembro" : "miembros")} con este filtro." : "Busca por nombre o documento.")</Subtitle>
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
                   OnClick="OpenCreateAsync">
            Nuevo miembro
        </MudButton>
    </Actions>
</PageHeader>

<ServerTable @ref="_table" TItem="MemberListItem" Load="LoadAsync" Class="gsm-table">
    <ToolBarContent>
        <MudTextField T="string" Placeholder="Buscar por nombre o documento" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" DebounceInterval="400"
                      ValueChanged="OnSearchChangedAsync" Class="mr-4" Style="max-width:320px" />
        <MudTextField T="string" Placeholder="Etiqueta" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Sell" Immediate="true" DebounceInterval="400"
                      ValueChanged="OnTagChangedAsync" Class="mr-4" Style="max-width:180px" aria-label="Filtrar por etiqueta" />
        <MudSelect T="string" Value="_commercial" ValueChanged="OnCommercialChangedAsync" Label="Estado comercial"
                   Dense="true" Class="mr-4" Style="max-width:200px" Margin="Margin.Dense">
            <MudSelectItem Value="@FilterValues.All">Todos</MudSelectItem>
            @foreach (var (value, label) in CommercialStatusLabels.Filters)
            {
                <MudSelectItem Value="value">@label</MudSelectItem>
            }
        </MudSelect>
        @* Tres opciones caben a la vista: un desplegable las escondía detrás de un clic. *@
        <div class="gsm-segmented" role="group" aria-label="Filtrar por estado">
            @foreach (var (value, label) in StatusFilters)
            {
                <button type="button" class="gsm-segmented__option @(_status == value ? "is-active" : null)"
                        aria-pressed="@(_status == value ? "true" : "false")"
                        @onclick="() => OnStatusChangedAsync(value)">@label</button>
            }
        </div>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Miembro</MudTh>
        <MudTh>Documento</MudTh>
        <MudTh>Teléfono</MudTh>
        <MudTh>Situación</MudTh>
        <MudTh>Ingresó</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Miembro">
            <MudLink OnClick="@(() => Navigation.NavigateTo($"/members/{context.Id}"))" Underline="Underline.None">
                <span class="gsm-identity">
                    <span class="gsm-avatar gsm-avatar--sm" aria-hidden="true">@GsmFormat.Initials($"{context.FirstName} {context.LastName}")</span>
                    <span>@context.FirstName @context.LastName</span>
                    @if (context.IsProfileIncomplete)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Ficha incompleta</MudChip>
                    }
                </span>
            </MudLink>
        </MudTd>
        <MudTd DataLabel="Documento" Class="gsm-num">@MemberLabels.DocumentShort(context.DocumentType) @context.DocumentNumber</MudTd>
        <MudTd DataLabel="Teléfono" Class="gsm-num">@(context.Phone ?? "—")</MudTd>
        <MudTd DataLabel="Situación">
            @if (context.Status == "Inactive")
            {
                <MudChip T="string" Color="Color.Default" Variant="Variant.Text" Size="Size.Small" Class="gsm-mono">DADO DE BAJA</MudChip>
            }
            else
            {
                <CommercialStatusChip Status="@context.CommercialStatus" />
            }
        </MudTd>
        <MudTd DataLabel="Ingresó">@GsmFormat.Day(context.JoinedAt)</MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="@(() => OpenEditAsync(context))"
                           aria-label="@($"Editar a {context.FirstName} {context.LastName}")" />
        </MudTd>
    </RowTemplate>
</ServerTable>

@code {
    private ServerTable<MemberListItem> _table = null!;
    private string _search = string.Empty;
    private string _status = FilterValues.All;
    private string _tag = string.Empty;
    private string _commercial = FilterValues.All;
    private int? _total;

    private static readonly (string Value, string Label)[] StatusFilters =
        [(FilterValues.All, "Todos"), ("0", "Activos"), ("1", "Inactivos")];

    private async Task<ServerTablePage<MemberListItem>> LoadAsync(int page, int pageSize, CancellationToken cancellationToken)
    {
        try
        {
            var result = await Members.MembersGETAsync(
                string.IsNullOrWhiteSpace(_search) ? null : _search,
                FilterValues.IsAll(_status) ? null : int.Parse(_status),
                string.IsNullOrWhiteSpace(_tag) ? null : _tag.Trim(),
                FilterValues.IsAll(_commercial) ? null : _commercial,
                page, pageSize, cancellationToken);
            // La cabecera vive fuera de la tabla: hay que avisarla cuando cambia el total.
            if (_total != result.Total)
            {
                _total = result.Total;
                _ = InvokeAsync(StateHasChanged);
            }

            return new ServerTablePage<MemberListItem>(result.Items.ToList(), result.Total);
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
            return new ServerTablePage<MemberListItem>([], 0);
        }
    }

    private async Task OnSearchChangedAsync(string value)
    {
        _search = value;
        await _table.RefreshAsync();
    }

    private async Task OnTagChangedAsync(string value)
    {
        _tag = value;
        await _table.RefreshAsync();
    }

    private async Task OnCommercialChangedAsync(string value)
    {
        _commercial = value;
        await _table.RefreshAsync();
    }

    private async Task OnStatusChangedAsync(string value)
    {
        _status = value;
        await _table.RefreshAsync();
    }

    private static readonly DialogOptions MemberFormOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };

    private async Task OpenCreateAsync()
    {
        var dialog = await Dialogs.ShowAsync<MemberFormDialog>("Nuevo miembro", MemberFormOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Miembro creado.", Severity.Success);
            await _table.RefreshAsync();
        }
    }

    private async Task OpenEditAsync(MemberListItem item)
    {
        var parameters = new DialogParameters<MemberFormDialog> { { x => x.MemberId, item.Id } };
        var dialog = await Dialogs.ShowAsync<MemberFormDialog>("Editar miembro", parameters, MemberFormOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Miembro actualizado.", Severity.Success);
            await _table.RefreshAsync();
        }
    }
}

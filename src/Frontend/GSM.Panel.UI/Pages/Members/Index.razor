@page "/members"
@attribute [Authorize(Policy = GsmPolicies.RequireStaff)]
@inject IMembersClient Members
@inject IWhatsAppClient WhatsApp
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthState

<PageTitle>Miembros — TrainingHub OS</PageTitle>

<PageHeader Title="Miembros">
    <Subtitle>@(_total is { } total ? $"{total} {(total == 1 ? "miembro" : "miembros")} con este filtro." : "Busca por nombre o documento.")</Subtitle>
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
                   OnClick="OpenCreateAsync">
            Nuevo miembro
        </MudButton>
    </Actions>
</PageHeader>

<ServerTable @ref="_table" TItem="MemberListItem" Load="LoadAsync" Class="gsm-table">
    <ToolBarContent>
        <MudTextField T="string" Label="Buscar" Placeholder="Nombre o documento" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" DebounceInterval="400"
                      ValueChanged="OnSearchChangedAsync" Class="mr-4" Style="max-width:320px" />
        @* A la vista, lo que se usa a diario: buscar, la situación y activos/inactivos. Etiqueta, entrenador y salud van
           en "Más filtros" (eran seis controles de una vez). Siguen en el DOM: se ocultan, no se quitan. *@
        <MudSelect T="string" Value="_commercial" ValueChanged="OnCommercialChangedAsync" Label="Situación"
                   Dense="true" Class="mr-4" Style="max-width:200px" Margin="Margin.Dense">
            <MudSelectItem Value="@FilterValues.All">Todas</MudSelectItem>
            @foreach (var (value, label) in CommercialStatusLabels.Filters)
            {
                <MudSelectItem Value="value">@label</MudSelectItem>
            }
        </MudSelect>
        @* Tres opciones caben a la vista: un desplegable las escondía detrás de un clic. *@
        <div class="gsm-segmented mr-4" role="group" aria-label="Filtrar por estado">
            @foreach (var (value, label) in StatusFilters)
            {
                <button type="button" class="gsm-segmented__option @(_status == value ? "is-active" : null)"
                        aria-pressed="@(_status == value ? "true" : "false")"
                        @onclick="() => OnStatusChangedAsync(value)">@label</button>
            }
        </div>
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.FilterList" OnClick="@(() => _moreFiltersOpen = !_moreFiltersOpen)"
                   aria-expanded="@(_moreFiltersOpen ? "true" : "false")" aria-controls="member-more-filters" data-testid="more-filters">
            @(MoreFiltersActive > 0 ? $"Más filtros ({MoreFiltersActive})" : "Más filtros")
        </MudButton>
        <div id="member-more-filters" class="@($"gsm-more-filters {(_moreFiltersOpen ? "is-open" : null)}")">
            <MudTextField T="string" Placeholder="Etiqueta" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Sell" Immediate="true" DebounceInterval="400"
                          ValueChanged="OnTagChangedAsync" Style="max-width:180px" aria-label="Filtrar por etiqueta" />
            <MudSelect T="string" Value="_trainerFilter" ValueChanged="OnTrainerFilterChangedAsync" Label="Entrenador"
                       Dense="true" Style="max-width:200px" Margin="Margin.Dense" id="trainer-filter">
                <MudSelectItem Value="@FilterValues.All">Todos</MudSelectItem>
                @if (_isTrainer)
                {
                    <MudSelectItem Value="@TrainerFilterMine">Mis miembros</MudSelectItem>
                }
                <MudSelectItem Value="@TrainerFilterNone">Sin entrenador</MudSelectItem>
            </MudSelect>
            <MudCheckBox T="bool" Value="_withHealthAlerts" ValueChanged="OnHealthAlertsChangedAsync"
                         Label="Con alertas de salud" Class="gsm-health-filter" />
        </div>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Miembro</MudTh>
        <MudTh>Documento</MudTh>
        <MudTh>Teléfono</MudTh>
        <MudTh>Entrenador</MudTh>
        <MudTh>Situación</MudTh>
        <MudTh>Ingresó</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Miembro">
            <MudLink Href="@($"/members/{context.Id}")" Underline="Underline.None">
                <span class="gsm-identity">
                    <span class="gsm-avatar gsm-avatar--sm" aria-hidden="true">@GsmFormat.Initials($"{context.FirstName} {context.LastName}")</span>
                    <span>@context.FirstName @context.LastName</span>
                    @if (context.HasHealthAlerts == true)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Class="gsm-health-alert">Restricciones</MudChip>
                    }
                    @if (context.IsProfileIncomplete)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Ficha incompleta</MudChip>
                    }
                </span>
            </MudLink>
        </MudTd>
        <MudTd DataLabel="Documento" Class="gsm-num">@MemberLabels.DocumentShort(context.DocumentType) @context.DocumentNumber</MudTd>
        <MudTd DataLabel="Teléfono" Class="gsm-num">@(context.Phone ?? "—")</MudTd>
        <MudTd DataLabel="Entrenador">@(context.TrainerName ?? (context.TrainerUserId is null ? "—" : "…"))</MudTd>
        <MudTd DataLabel="Situación">
            @if (context.Status == "Inactive")
            {
                <MudChip T="string" Color="Color.Default" Variant="Variant.Text" Size="Size.Small" Class="gsm-mono">DADO DE BAJA</MudChip>
            }
            else
            {
                <CommercialStatusChip Status="@context.CommercialStatus" />
            }
        </MudTd>
        <MudTd DataLabel="Ingresó">@GsmFormat.Day(context.JoinedAt)</MudTd>
        <MudTd>
            @if (context.Status != "Inactive")
            {
                <WhatsAppButton MemberId="context.Id" State="StateOf(context.Id)" AutoLoad="false" Compact="true"
                                Kind="@WhatsAppLabels.KindForStatus(context.CommercialStatus)" />
            }
            <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="@(() => OpenEditAsync(context))"
                           aria-label="@($"Editar a {context.FirstName} {context.LastName}")" />
        </MudTd>
    </RowTemplate>
</ServerTable>

@code {
    private ServerTable<MemberListItem> _table = null!;
    private string _search = string.Empty;
    private string _status = FilterValues.All;
    private string _tag = string.Empty;
    private string _commercial = FilterValues.All;
    private string _trainerFilter = FilterValues.All;
    private bool _isTrainer;
    private Guid? _myUserId;
    private const string TrainerFilterMine = "mine";
    private const string TrainerFilterNone = "none";
    private int? _total;
    private Dictionary<Guid, WhatsAppMemberStateResponse> _whatsApp = [];

    private static readonly (string Value, string Label)[] StatusFilters =
        [(FilterValues.All, "Todos"), ("0", "Activos"), ("1", "Inactivos")];

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _isTrainer = user.HasPermission(GsmPermissions.Trainer);
        _myUserId = Guid.TryParse(user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : null;
    }

    private bool _withHealthAlerts;
    private bool _moreFiltersOpen;

    /// <summary>Filtros activos dentro de "Más filtros", para que se note que hay algo filtrando aunque esté plegado.</summary>
    private int MoreFiltersActive =>
        (string.IsNullOrWhiteSpace(_tag) ? 0 : 1) + (FilterValues.IsAll(_trainerFilter) ? 0 : 1) + (_withHealthAlerts ? 1 : 0);

    private async Task OnHealthAlertsChangedAsync(bool value)
    {
        _withHealthAlerts = value;
        await _table.RefreshAsync();
    }

    private async Task OnTrainerFilterChangedAsync(string value)
    {
        _trainerFilter = value;
        await _table.RefreshAsync();
    }

    private async Task<ServerTablePage<MemberListItem>> LoadAsync(int page, int pageSize, CancellationToken cancellationToken)
    {
        try
        {
            var result = await Members.MembersGETAsync(
                string.IsNullOrWhiteSpace(_search) ? null : _search,
                FilterValues.IsAll(_status) ? null : int.Parse(_status),
                string.IsNullOrWhiteSpace(_tag) ? null : _tag.Trim(),
                FilterValues.IsAll(_commercial) ? null : _commercial,
                page, pageSize,
                _trainerFilter == TrainerFilterMine ? _myUserId : null,
                _trainerFilter == TrainerFilterNone ? true : null,
                _withHealthAlerts ? true : null, // withHealthAlerts (M3)
                cancellationToken);
            // La cabecera vive fuera de la tabla: hay que avisarla cuando cambia el total.
            if (_total != result.Total)
            {
                _total = result.Total;
                _ = InvokeAsync(StateHasChanged);
            }

            await LoadWhatsAppStatesAsync(result.Items.Select(i => i.Id).ToList(), cancellationToken);
            return new ServerTablePage<MemberListItem>(result.Items.ToList(), result.Total);
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
            return new ServerTablePage<MemberListItem>([], 0);
        }
    }

    // Una sola consulta por página: quién tiene celular válido y a quién se contactó por última vez.
    private async Task LoadWhatsAppStatesAsync(List<Guid> ids, CancellationToken cancellationToken)
    {
        try
        {
            _whatsApp = ids.Count == 0
                ? []
                : (await WhatsApp.StatesAsync(ids, cancellationToken)).ToDictionary(s => s.MemberId);
        }
        catch (GsmApiException)
        {
            _whatsApp = [];
        }
    }

    private WhatsAppMemberStateResponse? StateOf(Guid id) => _whatsApp.GetValueOrDefault(id);

    private async Task OnSearchChangedAsync(string value)
    {
        _search = value;
        await _table.RefreshAsync();
    }

    private async Task OnTagChangedAsync(string value)
    {
        _tag = value;
        await _table.RefreshAsync();
    }

    private async Task OnCommercialChangedAsync(string value)
    {
        _commercial = value;
        await _table.RefreshAsync();
    }

    private async Task OnStatusChangedAsync(string value)
    {
        _status = value;
        await _table.RefreshAsync();
    }

    private static readonly DialogOptions MemberFormOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };

    private async Task OpenCreateAsync()
    {
        var dialog = await Dialogs.ShowAsync<MemberFormDialog>("Nuevo miembro", MemberFormOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Miembro creado.", Severity.Success);
            await _table.RefreshAsync();
        }
    }

    private async Task OpenEditAsync(MemberListItem item)
    {
        var parameters = new DialogParameters<MemberFormDialog> { { x => x.MemberId, item.Id } };
        var dialog = await Dialogs.ShowAsync<MemberFormDialog>("Editar miembro", parameters, MemberFormOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Miembro actualizado.", Severity.Success);
            await _table.RefreshAsync();
        }
    }
}

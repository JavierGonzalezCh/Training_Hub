@page "/members/{MemberId:guid}/routines/new"
@page "/members/{MemberId:guid}/routines/{RoutineId:guid}"
@using GSM.UI.Shared.Routines
@attribute [Authorize(Policy = GsmPolicies.RequireStaff)]
@inject IRoutinesClient Routines
@inject IMemberRoutinesClient MemberRoutines
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Rutina — GSM</PageTitle>

<MudLink OnClick="@(() => Navigation.NavigateTo($"/members/{MemberId}"))" Class="mb-4 d-inline-block">← Volver a la ficha</MudLink>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
    }

    <RoutineForm Draft="_draft" />

    <div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving">
            @(_saving ? "Guardando..." : "Guardar rutina")
        </MudButton>
        @if (RoutineId is { } savedId)
        {
            <MudButton Variant="Variant.Outlined" Class="ml-2" OnClick="@(() => SaveAsTemplateAsync(savedId))"
                       data-testid="routine-save-as-template">
                Guardar como plantilla
            </MudButton>
        }
    </div>
}

@code {
    [Parameter]
    public Guid MemberId { get; set; }

    [Parameter]
    public Guid? RoutineId { get; set; }

    private RoutineDraft _draft = RoutineDraft.Empty();
    private bool _loading = true;
    private bool _saving;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (RoutineId is not { } id)
        {
            _loading = false;
            return;
        }

        try
        {
            _draft = RoutineDraft.From(await Routines.RoutinesGET2Async(id));
        }
        catch (GsmApiException ex)
        {
            _error = ApiError.FromException(ex).DisplayMessage;
        }
        finally
        {
            _loading = false;
        }
    }

    // R11: la plantilla toma la rutina guardada (no los cambios sin guardar del formulario).
    private async Task SaveAsTemplateAsync(Guid routineId)
    {
        var parameters = new DialogParameters<SaveAsTemplateDialog>
        {
            { x => x.RoutineId, routineId },
            { x => x.SuggestedName, _draft.Name },
        };
        var dialog = await Dialogs.ShowAsync<SaveAsTemplateDialog>("Guardar como plantilla", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Plantilla creada. La encuentras en Entrenamiento → Plantillas de rutina.", Severity.Success);
        }
    }

    private async Task SaveAsync()
    {
        _error = _draft.Validate();
        if (_error is not null)
        {
            return;
        }

        _saving = true;
        try
        {
            if (RoutineId is { } id)
            {
                await Routines.RoutinesPUTAsync(id, _draft.ToRequest());
            }
            else
            {
                await MemberRoutines.RoutinesPOST2Async(MemberId, _draft.ToRequest());
            }

            Snackbar.Add("Rutina guardada.", Severity.Success);
            Navigation.NavigateTo($"/members/{MemberId}");
        }
        catch (GsmApiException ex)
        {
            _error = ApiError.FromException(ex).DisplayMessage;
        }
        finally
        {
            _saving = false;
        }
    }
}

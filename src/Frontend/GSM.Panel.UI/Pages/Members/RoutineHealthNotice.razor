@* Aviso de salud en el editor de rutinas (Routines v2, R9). Todos los del staff ven "tiene alertas de
   salud"; el detalle solo lo ve quien tiene el permiso ViewMemberHealth, y pedirlo queda registrado como
   cualquier consulta de salud (M3). Si el miembro no autorizó el tratamiento de datos, solo el aviso. *@
@inject IMembersClient Members
@inject AuthenticationStateProvider AuthState

@if (_hasAlerts)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4 gsm-routine-health" data-testid="routine-health-notice">
        <span class="gsm-routine-health__generic">Este miembro tiene alertas de salud.</span>
        @if (_detail is not null)
        {
            @if (!string.IsNullOrWhiteSpace(_detail.MedicalConditions))
            {
                <div class="gsm-routine-health__conditions"><strong>Condiciones médicas:</strong> @_detail.MedicalConditions</div>
            }
            @if (!string.IsNullOrWhiteSpace(_detail.TrainingRestrictions))
            {
                <div class="gsm-routine-health__restrictions"><strong>Restricciones de entrenamiento:</strong> @_detail.TrainingRestrictions</div>
            }
        }
    </MudAlert>
}

@code {
    [Parameter, EditorRequired]
    public Guid MemberId { get; set; }

    private bool _hasAlerts;
    private MemberHealth? _detail;

    protected override async Task OnParametersSetAsync()
    {
        _hasAlerts = false;
        _detail = null;
        try
        {
            // La ficha trae solo la bandera; el detalle no viaja por ahí.
            var member = await Members.MembersGET2Async(MemberId);
            _hasAlerts = member.HasHealthAlerts == true;
            if (!_hasAlerts)
            {
                return;
            }

            var user = (await AuthState.GetAuthenticationStateAsync()).User;
            if (!user.HasPermission(GsmPermissions.ViewMemberHealth))
            {
                return;
            }

            var view = await Members.GetMemberHealthAsync(MemberId);
            if (!view.ConsentRequired)
            {
                _detail = view.Health;
            }
        }
        catch (GsmApiException)
        {
            // El aviso es informativo: si falla la consulta, el editor sigue funcionando sin él
            // (y sin detalle: ante la duda, lo conservador es no mostrar más).
        }
    }
}

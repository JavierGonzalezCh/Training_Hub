@inject IMembersClient Members

@* Vista rápida del miembro, desde su ficha: foto a la izquierda y la información más importante a la derecha. *@
<MudDialog>
    <DialogContent>
        @if (_member is null)
        {
            <GsmLoader Small="true" />
        }
        else
        {
            <div class="gsm-quick-view" data-testid="member-quick-view">
                <div class="gsm-quick-view__photo">
                    @if (!string.IsNullOrWhiteSpace(_member.PhotoUrl))
                    {
                        <img src="@_member.PhotoUrl" alt="@($"Foto de {_member.FirstName} {_member.LastName}")" data-testid="member-quick-photo" />
                    }
                    else
                    {
                        <span class="gsm-avatar gsm-quick-view__initials" aria-hidden="true">@GsmFormat.Initials($"{_member.FirstName} {_member.LastName}")</span>
                    }
                </div>
                <div class="gsm-quick-view__info">
                    <MudText Typo="Typo.h5">@_member.FirstName @_member.LastName</MudText>
                    <MudText Typo="Typo.body2" Class="gsm-mono" Color="Color.Secondary">@MemberLabels.DocumentShort(_member.DocumentType) @_member.DocumentNumber</MudText>
                    <div class="my-2"><CommercialStatusChip Status="@_member.CommercialStatus" /></div>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            <tr><td>Teléfono</td><td>@(_member.Phone ?? "—")</td></tr>
                            <tr><td>Email</td><td>@(_member.Email ?? "—")</td></tr>
                            <tr><td>Ingresó</td><td>@GsmFormat.Day(_member.JoinedAt)</td></tr>
                        </tbody>
                    </MudSimpleTable>
                </div>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired]
    public Guid MemberId { get; set; }

    private MemberDetail? _member;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _member = await Members.MembersGET2Async(MemberId);
        }
        catch (GsmApiException)
        {
            MudDialog.Cancel();
        }
    }
}

@page "/members/{Id:guid}"
@attribute [Authorize(Policy = GsmPolicies.RequireStaff)]
@using GSM.Panel.UI.Pages.Payments
@inject IMembersClient Members
@inject IMemberAttendanceClient MemberAttendance
@inject IMemberPaymentsClient MemberPayments
@inject IMemberMembershipsClient MemberMemberships
@inject IMemberRoutinesClient MemberRoutinesClient
@inject IRoutinesClient RoutinesClient
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>@(_member?.FirstName is null ? "Miembro" : $"{_member.FirstName} {_member.LastName}") — GSM</PageTitle>

<MudLink OnClick="@(() => Navigation.NavigateTo("/members"))" Class="mb-4 d-inline-block">← Miembros</MudLink>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_notFound)
{
    <MudAlert Severity="Severity.Error">No se encontró el miembro.</MudAlert>
}
else if (_member is not null)
{
    <div class="d-flex flex-wrap align-start mb-6" style="gap:1.5rem">
        <div class="d-flex flex-column align-center" style="gap:0.35rem">
            <MudAvatar Size="Size.Large" Style="width:72px;height:72px">
                @if (!string.IsNullOrEmpty(_member.PhotoUrl))
                {
                    <MudImage Src="@_member.PhotoUrl" />
                }
                else
                {
                    @($"{_member.FirstName[0]}{_member.LastName[0]}".ToUpperInvariant())
                }
            </MudAvatar>
            <MudFileUpload T="IBrowserFile" FilesChanged="UploadPhotoAsync" Class="ma-0">
                <ActivatorContent>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="_uploadingPhoto">
                        @(_uploadingPhoto ? "Subiendo..." : "Cambiar foto")
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
        </div>
        <div style="flex:1; min-width:220px">
            <div class="d-flex align-center flex-wrap" style="gap:0.75rem">
                <MudText Typo="Typo.h4">@_member.FirstName @_member.LastName</MudText>
                <StatusChip Status="@_member.Status" />
            </div>
            <MudText Typo="Typo.body2" Class="gsm-mono" Color="Color.Secondary">
                @_member.DocumentNumber · ingresó @GsmFormat.Day(_member.JoinedAt)
            </MudText>
        </div>
        <div class="d-flex flex-wrap" style="gap:0.5rem">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Link" OnClick="InviteAsync">Invitar</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.CardMembership" OnClick="AssignMembershipAsync">
                Asignar membresía
            </MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Payments" OnClick="RecordPaymentAsync">
                Registrar pago
            </MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditAsync">Editar</MudButton>
            @if (_member.Status == "Active")
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.PersonOff" OnClick="DeactivateAsync">
                    Dar de baja
                </MudButton>
            }
        </div>
    </div>

    <MudGrid Class="mb-6">
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid var(--gsm-border)">
                <MudText Typo="Typo.overline" Color="Color.Secondary">Membresía vigente</MudText>
                @if (_member.CurrentMembership is { } membership)
                {
                    <MudText Typo="Typo.h6">@membership.PlanName</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Vence @GsmFormat.Day(membership.EndDate)</MudText>
                }
                else
                {
                    <MudText Color="Color.Secondary">Sin membresía activa.</MudText>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid var(--gsm-border)">
                <MudText Typo="Typo.overline" Color="Color.Secondary">Racha</MudText>
                @if (_streak is { } streak)
                {
                    <MudText Typo="Typo.h6" Class="gsm-mono">@streak.CurrentStreak días</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @(streak.LastVisit is { } last ? $"Última visita {GsmFormat.Day(last)}" : "Sin visitas todavía")
                    </MudText>
                }
                else
                {
                    <MudText Color="Color.Secondary">—</MudText>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid var(--gsm-border)">
                <MudText Typo="Typo.overline" Color="Color.Secondary">Últimos pagos</MudText>
                @if (_member.RecentPayments is { Count: > 0 } payments)
                {
                    @foreach (var payment in payments)
                    {
                        <div class="d-flex justify-space-between">
                            <MudText Typo="Typo.body2">@payment.Concept</MudText>
                            <MudText Typo="Typo.body2" Class="gsm-mono">@GsmFormat.Money((decimal)payment.Amount)</MudText>
                        </div>
                    }
                }
                else
                {
                    <MudText Color="Color.Secondary">Sin pagos todavía.</MudText>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudTabs Rounded="true" Color="Color.Primary">
        <MudTabPanel Text="Membresías">
            @if (_memberships is null)
            {
                <MudProgressCircular Indeterminate="true" Class="mt-4" />
            }
            else if (_memberships.Count == 0)
            {
                <MudText Color="Color.Secondary" Class="mt-4">Sin membresías todavía.</MudText>
            }
            else
            {
                <MudTable Items="_memberships" Hover="true" Dense="true" Elevation="0" Class="mt-4">
                    <HeaderContent>
                        <MudTh>Plan</MudTh>
                        <MudTh>Estado</MudTh>
                        <MudTh>Desde</MudTh>
                        <MudTh>Hasta</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Plan">
                            @context.PlanName
                            @if (context.CancellationReason is { } cancelReason)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">@cancelReason</MudText>
                            }
                            else if (context.PausedOn is { } pausedOn)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">Congelada desde @GsmFormat.Day(pausedOn)</MudText>
                            }
                        </MudTd>
                        <MudTd DataLabel="Estado"><StatusChip Status="@context.Status" /></MudTd>
                        <MudTd DataLabel="Desde">@GsmFormat.Day(context.StartDate)</MudTd>
                        <MudTd DataLabel="Hasta">@GsmFormat.Day(context.EndDate)</MudTd>
                        <MudTd>
                            @if (context.Status != "Cancelled")
                            {
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true"
                                         AriaLabel="@($"Acciones de la membresía {context.PlanName}")">
                                    @if (context.Status == "Active")
                                    {
                                        <MudMenuItem OnClick="@(() => PauseMembershipAsync(context))">Congelar</MudMenuItem>
                                    }
                                    @if (context.Status == "Paused")
                                    {
                                        <MudMenuItem OnClick="@(() => ResumeMembershipAsync(context))">Reanudar</MudMenuItem>
                                    }
                                    <MudMenuItem OnClick="@(() => CancelMembershipAsync(context))">Cancelar membresía</MudMenuItem>
                                </MudMenu>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudTabPanel>
        <MudTabPanel Text="Rutina">
            <div class="d-flex justify-end mb-3 mt-4">
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@(() => Navigation.NavigateTo($"/members/{Id}/routines/new"))">
                    Nueva rutina
                </MudButton>
            </div>
            @if (_routines is null)
            {
                <MudProgressCircular Indeterminate="true" />
            }
            else if (_routines.Count == 0)
            {
                <MudText Color="Color.Secondary">Sin rutinas todavía.</MudText>
            }
            else
            {
                @* Pulsar una rutina despliega sus días y ejercicios (se cargan al abrirla). *@
                <MudExpansionPanels MultiExpansion="true" Elevation="0" Class="gsm-routine-list">
                    @foreach (var routine in _routines)
                    {
                        var current = routine;
                        <MudExpansionPanel ExpandedChanged="@((bool open) => OnRoutineToggledAsync(current.Id, open))">
                            <TitleContent>
                                <div class="gsm-routine-head">
                                    <div class="gsm-routine-head__main">
                                        <span class="gsm-routine-head__name">@current.Name</span>
                                        <span class="gsm-routine-head__meta">Desde @GsmFormat.Day(current.StartsOn) · @(current.ScheduleMode == "weekly" ? $"semanal, {current.CycleLength} días de entrenamiento" : $"ciclo de {current.CycleLength} días")</span>
                                    </div>
                                    <MudChip T="string" Color="@(current.IsActive ? Color.Info : Color.Default)" Variant="Variant.Text" Size="Size.Small" Class="gsm-mono">
                                        @(current.IsActive ? "ACTIVA" : "INACTIVA")
                                    </MudChip>
                                    <span @onclick:stopPropagation="true">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="Editar rutina"
                                                       OnClick="@(() => Navigation.NavigateTo($"/members/{Id}/routines/{current.Id}"))" />
                                    </span>
                                </div>
                            </TitleContent>
                            <ChildContent>
                                @if (!_routineDetails.TryGetValue(current.Id, out var detail))
                                {
                                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                                }
                                else
                                {
                                    @if (!string.IsNullOrWhiteSpace(detail.Notes))
                                    {
                                        <p class="gsm-routine-notes">@detail.Notes</p>
                                    }
                                    <div class="gsm-routine-days">
                                        @foreach (var day in detail.Days.OrderBy(d => d.Position))
                                        {
                                            <section class="gsm-routine-day @(day.IsRest ? "is-rest" : null)">
                                                <h3 class="gsm-routine-day__title">
                                                    <span class="gsm-routine-day__num">@(day.DayOfWeek is { } weekday ? RoutineLabels.IsoWeekdayLabel(weekday) : $"Día {day.Position}")</span> @day.Name
                                                </h3>
                                                @if (day.IsRest)
                                                {
                                                    <p class="gsm-routine-day__rest">Descanso</p>
                                                }
                                                else
                                                {
                                                    <ol class="gsm-routine-ex">
                                                        @foreach (var ex in day.Exercises.OrderBy(e => e.Order))
                                                        {
                                                            <li class="gsm-routine-ex__item">
                                                                <span class="gsm-routine-ex__name">@ex.ExerciseName</span>
                                                                <span class="gsm-routine-ex__target">@ex.TargetSets × @ex.TargetReps@(ex.TargetWeightKg is { } kg ? $" · {kg:0.#} kg" : "")@(ex.RestSeconds is { } rest ? $" · {rest} s" : "")</span>
                                                            </li>
                                                        }
                                                    </ol>
                                                }
                                            </section>
                                        }
                                    </div>
                                }
                            </ChildContent>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            }
        </MudTabPanel>
        <MudTabPanel Text="Pagos">
            <ServerTable @ref="_paymentsTable" TItem="PaymentResponse" Load="LoadPaymentsAsync" Class="mt-4">
                <HeaderContent>
                    <MudTh>Fecha</MudTh>
                    <MudTh>Concepto</MudTh>
                    <MudTh>Método</MudTh>
                    <MudTh>Monto</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Fecha">@GsmFormat.Instant(context.PaidAt)</MudTd>
                    <MudTd DataLabel="Concepto">@context.Concept</MudTd>
                    <MudTd DataLabel="Método">@PaymentMethodLabels.Label(context.Method)</MudTd>
                    <MudTd DataLabel="Monto" Class="gsm-mono">@GsmFormat.Money((decimal)context.Amount)</MudTd>
                    <MudTd><PaymentVoidAction Payment="context" OnVoided="OnPaymentVoidedAsync" /></MudTd>
                </RowTemplate>
            </ServerTable>
        </MudTabPanel>
        <MudTabPanel Text="Asistencia">
            <ServerTable TItem="AttendanceListItem" Load="LoadAttendanceAsync" Class="mt-4">
                <HeaderContent>
                    <MudTh>Fecha</MudTh>
                    <MudTh>Hora</MudTh>
                    <MudTh>Método</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Fecha">@GsmFormat.Day(context.AttendanceDate)</MudTd>
                    <MudTd DataLabel="Hora">@GsmFormat.Instant(context.CheckedInAt)</MudTd>
                    <MudTd DataLabel="Método">@(context.Method == "Qr" ? "QR" : "Manual")</MudTd>
                </RowTemplate>
            </ServerTable>
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private MemberDetail? _member;
    private MemberStreakResponse? _streak;
    private List<MembershipResponse>? _memberships;
    private List<RoutineListItem>? _routines;
    private readonly Dictionary<Guid, RoutineResponse> _routineDetails = [];
    private bool _loading = true;
    private bool _notFound;
    private bool _uploadingPhoto;

    private async Task OnRoutineToggledAsync(Guid routineId, bool open)
    {
        if (!open || _routineDetails.ContainsKey(routineId))
        {
            return;
        }

        try
        {
            _routineDetails[routineId] = await RoutinesClient.RoutinesGET2Async(routineId);
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
    }

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _notFound = false;
        try
        {
            _member = await Members.MembersGET2Async(Id);
            _streak = await MemberAttendance.Streak2Async(Id);
            var memberships = await MemberMemberships.MembershipsAllAsync(Id);
            _memberships = memberships.OrderByDescending(m => m.StartDate).ToList();
            var routines = await MemberRoutinesClient.RoutinesAllAsync(Id);
            _routines = routines.OrderByDescending(r => r.StartsOn).ToList();
        }
        catch (GsmApiException ex) when (ex.StatusCode == 404)
        {
            _notFound = true;
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    // Null mientras la pestaña Pagos no se ha abierto: MudTabs solo renderiza la pestaña activa.
    private ServerTable<PaymentResponse>? _paymentsTable;

    private async Task<ServerTablePage<PaymentResponse>> LoadPaymentsAsync(int page, int pageSize, CancellationToken cancellationToken)
    {
        var result = await MemberPayments.PaymentsGET2Async(Id, page, pageSize, cancellationToken);
        return new ServerTablePage<PaymentResponse>(result.Items.ToList(), result.Total);
    }

    private async Task<ServerTablePage<AttendanceListItem>> LoadAttendanceAsync(int page, int pageSize, CancellationToken cancellationToken)
    {
        var result = await MemberAttendance.AttendanceGET2Async(Id, page, pageSize, cancellationToken);
        return new ServerTablePage<AttendanceListItem>(result.Items.ToList(), result.Total);
    }

    private async Task InviteAsync()
    {
        try
        {
            var invite = await Members.InviteAsync(Id);
            var parameters = new DialogParameters<MemberInviteDialog>
            {
                { x => x.Code, invite.Code },
                { x => x.ExpiresAt, invite.ExpiresAt },
            };
            await Dialogs.ShowAsync<MemberInviteDialog>("Invitación", parameters);
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
    }

    private async Task EditAsync()
    {
        var parameters = new DialogParameters<MemberFormDialog> { { x => x.MemberId, Id } };
        var dialog = await Dialogs.ShowAsync<MemberFormDialog>("Editar miembro", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Miembro actualizado.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task AssignMembershipAsync()
    {
        var parameters = new DialogParameters<AssignMembershipDialog> { { x => x.MemberId, Id } };
        var dialog = await Dialogs.ShowAsync<AssignMembershipDialog>("Asignar membresía", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: AssignMembershipDialog.AssignMembershipResult outcome })
        {
            if (outcome.ChargeError is { } chargeError)
            {
                Snackbar.Add($"Membresía asignada, pero el cobro no se registró: {chargeError}", Severity.Warning);
            }
            else
            {
                Snackbar.Add(outcome.Charged ? "Membresía asignada y cobrada." : "Membresía asignada sin cobro.", Severity.Success);
            }

            await LoadAsync();
        }
    }

    private async Task RecordPaymentAsync()
    {
        var parameters = new DialogParameters<RecordPaymentDialog> { { x => x.MemberId, Id } };
        var dialog = await Dialogs.ShowAsync<RecordPaymentDialog>("Registrar pago", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Pago registrado.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task PauseMembershipAsync(MembershipResponse membership)
    {
        var confirmed = await Dialogs.ShowMessageBox(
            "Congelar membresía",
            $"«{membership.PlanName}» deja de dar acceso desde hoy. Al reanudarla, su fin (y el de las renovaciones encadenadas) se corre los días que estuvo congelada.",
            yesText: "Congelar", cancelText: "Volver");
        if (confirmed != true)
        {
            return;
        }

        await RunMembershipActionAsync(() => MemberMemberships.PauseAsync(Id, membership.Id), "Membresía congelada.");
    }

    private Task ResumeMembershipAsync(MembershipResponse membership)
        => RunMembershipActionAsync(
            () => MemberMemberships.ResumeAsync(Id, membership.Id), "Membresía reanudada; su fin se corrió los días que estuvo congelada.");

    private async Task CancelMembershipAsync(MembershipResponse membership)
    {
        var parameters = new DialogParameters<CancelMembershipDialog>
        {
            { x => x.MemberId, Id },
            { x => x.Membership, membership },
        };
        var dialog = await Dialogs.ShowAsync<CancelMembershipDialog>("Cancelar membresía", parameters);
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: CancelMembershipDialog.CancelMembershipResult outcome })
        {
            return;
        }

        if (outcome.FailedVoids > 0)
        {
            Snackbar.Add($"Membresía cancelada, pero {outcome.FailedVoids} pago(s) no se anularon: anúlalos desde la pestaña Pagos.", Severity.Warning);
        }
        else
        {
            Snackbar.Add(outcome.VoidedPayments > 0
                ? $"Membresía cancelada y {outcome.VoidedPayments} pago(s) anulados."
                : "Membresía cancelada.", Severity.Success);
        }

        await RefreshMembershipsAsync();
    }

    private async Task RunMembershipActionAsync(Func<Task> action, string successMessage)
    {
        try
        {
            await action();
            Snackbar.Add(successMessage, Severity.Success);
            await RefreshMembershipsAsync();
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
    }

    // Como OnPaymentVoidedAsync: sin el indicador de carga, para no desmontar la ficha.
    private async Task RefreshMembershipsAsync()
    {
        try
        {
            _member = await Members.MembersGET2Async(Id);
            var memberships = await MemberMemberships.MembershipsAllAsync(Id);
            _memberships = memberships.OrderByDescending(m => m.StartDate).ToList();
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }

        if (_paymentsTable is not null)
        {
            await _paymentsTable.RefreshAsync();
        }
    }

    // Sin LoadAsync: su indicador de carga desmonta la ficha y devolvería al usuario a la primera
    // pestaña. Basta con refrescar "Últimos pagos" y la tabla (el asiento nuevo y la fila anulada).
    private async Task OnPaymentVoidedAsync()
    {
        try
        {
            _member = await Members.MembersGET2Async(Id);
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }

        if (_paymentsTable is not null)
        {
            await _paymentsTable.RefreshAsync();
        }
    }

    private async Task UploadPhotoAsync(IBrowserFile file)
    {
        _uploadingPhoto = true;
        try
        {
            // 5 MB de tope: solo para no mandar archivos absurdos a la API.
            await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            _member = await Members.PhotoAsync(Id, new FileParameter(stream, file.Name, file.ContentType));
            Snackbar.Add("Foto actualizada.", Severity.Success);
        }
        catch (GsmApiException ex) when (ex.StatusCode == 500)
        {
            // R2 no está configurado todavía (ver CLAUDE.md): la subida falla siempre con 500.
            Snackbar.Add("Las fotos no están disponibles todavía: falta configurar el almacenamiento.", Severity.Warning);
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            _uploadingPhoto = false;
        }
    }

    private async Task DeactivateAsync()
    {
        var confirmed = await Dialogs.ShowMessageBox(
            "Dar de baja", $"¿Dar de baja a {_member!.FirstName} {_member.LastName}?", yesText: "Dar de baja", cancelText: "Cancelar");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Members.MembersDELETEAsync(Id);
            Snackbar.Add("Miembro dado de baja.", Severity.Success);
            await LoadAsync();
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
    }
}

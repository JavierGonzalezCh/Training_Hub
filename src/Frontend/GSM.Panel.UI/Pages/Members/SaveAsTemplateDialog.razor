@* R11: guardar una rutina ya armada como plantilla del gym. *@
@inject IRoutineTemplatesClient Templates

<MudDialog>
    <DialogContent>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" data-testid="save-template-error">@_error</MudAlert>
        }
        <MudTextField T="string" @bind-Value="_name" Label="Nombre de la plantilla" Required="true" MaxLength="120"
                      Class="mb-3" data-testid="save-template-name" />
        <MudTextField T="string" @bind-Value="_description" Label="Descripción (opcional)" Lines="2" MaxLength="500" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_submitting"
                   data-testid="save-template-submit">
            @(_submitting ? "Guardando..." : "Guardar plantilla")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired]
    public Guid RoutineId { get; set; }

    [Parameter]
    public string? SuggestedName { get; set; }

    private string _name = string.Empty;
    private string? _description;
    private bool _submitting;
    private string? _error;

    protected override void OnInitialized() => _name = SuggestedName ?? string.Empty;

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            _error = "Ponle un nombre a la plantilla.";
            return;
        }

        _error = null;
        _submitting = true;
        try
        {
            await Templates.SaveRoutineAsTemplateAsync(RoutineId, new SaveRoutineAsTemplateRequest
            {
                Name = _name.Trim(),
                Description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
            });
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (GsmApiException ex)
        {
            _error = ApiError.FromException(ex).DisplayMessage;
            _submitting = false;
        }
    }
}

@* Pestaña "Check-in" de la configuración: tipo de QR del gym, documento en el kiosco, permanencia asumida y cartel impreso.
   La gracia, "por vencer" y la matrícula están en la sección Membresías. Solo Owner. Ver docs/GSM-modulo-attendance.md. *@
@inject IAttendanceClient Attendance
@inject GymContext GymCtx
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

@if (_loading)
{
    <GsmLoader Class="mt-4" />
}
else
{
    <div class="gsm-checkin-settings">
        <fieldset class="gsm-choice-group">
            <legend class="gsm-choice-group__legend">Tipo de QR en la entrada</legend>
            <label class="gsm-choice @(_mode == Rotating ? "is-selected" : null)">
                <input type="radio" name="checkin-mode" value="@Rotating" checked="@(_mode == Rotating)"
                       @onchange="@(() => _mode = Rotating)" />
                <span class="gsm-choice__body">
                    <span class="gsm-choice__title">Pantalla en la entrada</span>
                    <span class="gsm-choice__hint">El código cambia cada 30 s. Una captura no sirve para entrar desde casa.</span>
                </span>
            </label>
            <label class="gsm-choice @(_mode == Static ? "is-selected" : null)">
                <input type="radio" name="checkin-mode" value="@Static" checked="@(_mode == Static)"
                       @onchange="@(() => _mode = Static)" />
                <span class="gsm-choice__body">
                    <span class="gsm-choice__title">Cartel impreso</span>
                    <span class="gsm-choice__hint">Código fijo que se imprime una vez. Puedes regenerarlo si se filtra. Si el gimnasio tiene coordenadas en Configuración, se pide la ubicación del teléfono: quien no la comparta o esté fuera del radio entra, pero esa entrada no suma a su racha ni a sus logros.</span>
                </span>
            </label>
        </fieldset>

        <MudSwitch T="bool" @bind-Value="_byDocument" Color="Color.Primary" data-testid="checkin-by-document"
                   Label="Entrada con documento en el kiosco" Class="mb-1" />
        <p class="gsm-choice__hint mb-4">
            El miembro digita su documento en el teclado del kiosco y entra con las mismas reglas que el QR.
            Riesgo: alguien puede digitar el número de otra persona; por eso el kiosco muestra el nombre de pila y la foto,
            y solo vale una entrada por día. Apagada por defecto.
        </p>

        <MudSwitch T="bool" @bind-Value="_remote" Color="Color.Primary" data-testid="checkin-remote-training"
                   Label="Mis miembros entrenan fuera de mi sede" Class="mb-1" />
        <p class="gsm-choice__hint mb-4" data-testid="checkin-remote-hint">
            Para entrenadores personales o entrenamiento en línea. Con esto encendido: el horario de apertura no frena el
            conteo del día por entrenamiento, no se avisa del riesgo de marcar desde casa (es lo esperado) y el aforo y las
            horas pico no cuentan esas entradas. La membresía se exige igual, y el QR, el documento y la recepción siguen
            respetando el horario. Apagado por defecto.
        </p>

        <fieldset class="gsm-choice-group" data-testid="checkin-trigger">
            <legend class="gsm-choice-group__legend">Cuándo cuenta el día sin registro en la puerta</legend>
            <label class="gsm-choice @(_trigger == TriggerStart ? "is-selected" : null)">
                <input type="radio" name="checkin-trigger" value="@TriggerStart" checked="@(_trigger == TriggerStart)"
                       @onchange="@(() => _trigger = TriggerStart)" />
                <span class="gsm-choice__body">
                    <span class="gsm-choice__title">Al iniciar el entrenamiento</span>
                    <span class="gsm-choice__hint">El miembro toca «Iniciar rutina» o «Registrar entrenamiento» en la app.</span>
                </span>
            </label>
            <label class="gsm-choice @(_trigger == TriggerFirstLog ? "is-selected" : null)">
                <input type="radio" name="checkin-trigger" value="@TriggerFirstLog" checked="@(_trigger == TriggerFirstLog)"
                       @onchange="@(() => _trigger = TriggerFirstLog)" />
                <span class="gsm-choice__body">
                    <span class="gsm-choice__title">Al registrar el primer ejercicio</span>
                    <span class="gsm-choice__hint">Tocar un botón ya no basta: el día cuenta cuando el miembro anota su primer ejercicio. Es más difícil de fingir. Un miembro sin rutina no puede contar su día así.</span>
                </span>
            </label>
        </fieldset>
        <p class="gsm-choice__hint mb-4">Solo aplica si el check-in con QR y la entrada con documento están apagados.</p>

        <MudNumericField T="int" @bind-Value="_stayMinutes" Label="Permanencia asumida (minutos)" Min="15" Max="480"
                         HelperText="Para saber cuánta gente hay en el gimnasio se asume que cada persona se queda este tiempo tras entrar, porque no se registra la salida. Es una estimación; se compara con el aforo del gimnasio."
                         Class="mb-4" Style="max-width:420px" data-testid="assumed-stay" />
        <div class="d-flex flex-wrap" style="gap:0.75rem">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving">
                @(_saving ? "Guardando..." : "Guardar cambios")
            </MudButton>
            @if (GymCtx.FeatureFlags?.ShowFrontDesk != false)
            {
                <MudButton Variant="Variant.Outlined" Href="/settings/kioscos" StartIcon="@Icons.Material.Outlined.QrCode2">Configurar kiosco</MudButton>
            }
            @if (_savedMode == Static)
            {
                <MudButton Variant="Variant.Outlined" OnClick="ShowPosterAsync" Disabled="_loadingPoster"
                           StartIcon="@Icons.Material.Outlined.Print" data-testid="show-qr-poster">
                    Ver cartel para imprimir
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="RegenerateAsync" Disabled="_regenerating"
                           StartIcon="@Icons.Material.Outlined.Refresh">
                    Regenerar código
                </MudButton>
            }
        </div>
    </div>
}

@code {
    /// <summary>La página de la sección en /settings, para avisar que ya no hay cambios sin guardar. Nulo en el onboarding.</summary>
    [CascadingParameter]
    public GSM.Panel.UI.Navigation.SettingsSectionState? SectionState { get; set; }

    private const string Rotating = "Rotating";
    private const string Static = "Static";

    private bool _loading = true;
    private bool _saving;
    private bool _regenerating;
    private string _mode = Rotating;
    private string _savedMode = Rotating;
    private bool _byDocument;
    private bool _savedByDocument;
    private bool _remote;
    private bool _savedRemote;
    private const string TriggerStart = "Start";
    private const string TriggerFirstLog = "FirstLog";
    private string _trigger = TriggerStart;
    private int _stayMinutes = 120;
    private bool _loadingPoster;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settings = await Attendance.SettingsGETAsync();
            _mode = _savedMode = settings.Mode;
            _byDocument = _savedByDocument = settings.ByDocument;
            _stayMinutes = settings.AssumedStayMinutes;
            _remote = _savedRemote = settings.RemoteTraining == true;
            _trigger = settings.TrainingEntryTrigger ?? TriggerStart;
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        // A8: apagar el documento con el QR apagado deja al gym sin registro en la puerta.
        if (GymCtx.FeatureFlags is { } flags)
        {
            var before = new RoutineEntryRisk.State(
                flags.CheckinQr, _savedByDocument, flags.ShowGamification, flags.ShowProgress, _savedRemote);
            var after = before with { ByDocument = _byDocument, RemoteTraining = _remote };
            if (RoutineEntryRisk.ShouldWarn(before, after) && !await RoutineEntryRisk.ConfirmAsync(Dialogs))
            {
                return;
            }
        }

        _saving = true;
        try
        {
            var saved = await Attendance.SettingsPUTAsync(new UpdateCheckinSettingsRequest
            {
                Mode = _mode,
                ByDocument = _byDocument,
                AssumedStayMinutes = _stayMinutes,
                RemoteTraining = _remote,
                TrainingEntryTrigger = _trigger,
            });
            _mode = _savedMode = saved.Mode;
            _byDocument = _savedByDocument = saved.ByDocument;
            _stayMinutes = saved.AssumedStayMinutes;
            _remote = _savedRemote = saved.RemoteTraining == true;
            _trigger = saved.TrainingEntryTrigger ?? TriggerStart;
            Snackbar.Add("Ajustes de check-in guardados.", Severity.Success);
            SectionState?.MarkSaved();
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    // A3-1: el cartel con el QR fijo vigente, listo para imprimir. Solo existe en modo de cartel fijo.
    private async Task ShowPosterAsync()
    {
        _loadingPoster = true;
        try
        {
            var code = await Attendance.GetStaticCodeAsync();
            var parameters = new DialogParameters<QrPosterDialog> { { x => x.Code, code.Code } };
            await Dialogs.ShowAsync<QrPosterDialog>("Cartel del QR", parameters, new DialogOptions { FullScreen = true, CloseButton = true });
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            _loadingPoster = false;
        }
    }

    private async Task RegenerateAsync()
    {
        var confirmed = await Dialogs.ShowMessageBox(
            "Regenerar el código",
            "El cartel impreso actual dejará de funcionar. Tendrás que imprimir y colocar el nuevo.",
            yesText: "Regenerar", cancelText: "Cancelar");
        if (confirmed != true)
        {
            return;
        }

        _regenerating = true;
        try
        {
            await Attendance.RegenerateAsync();
            Snackbar.Add("Código regenerado. Imprime el cartel nuevo con «Ver cartel para imprimir».", Severity.Success);
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            _regenerating = false;
        }
    }
}

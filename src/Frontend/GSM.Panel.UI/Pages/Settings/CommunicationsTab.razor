@* Pestaña "Comunicaciones" de la configuración: antelación del recordatorio de vencimiento, felicitación de
   cumpleaños y plantillas de WhatsApp. Solo Owner. *@
@inject IAnnouncementsClient Announcements
@inject ISnackbar Snackbar

@if (_loading)
{
    <GsmLoader Class="mt-4" />
}
else
{
    <MudNumericField T="int" @bind-Value="_days" Label="Avisar del vencimiento con (días de antelación)" Min="0" Max="14"
                     HelperText="El miembro recibe un aviso en la app y por email cuando su membresía está por vencer. 0 = sin recordatorios."
                     Class="mb-4" Style="max-width:460px" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_saving">
        @(_saving ? "Guardando..." : "Guardar cambios")
    </MudButton>

    <section class="mt-8" aria-labelledby="birthday-title" id="birthday-settings">
        <h3 id="birthday-title" class="mud-typography mud-typography-h6">Cumpleaños</h3>
        <MudSwitch T="bool" @bind-Value="_birthdayEnabled" Color="Color.Primary" data-testid="birthday-enabled"
                   Label="Felicitar a los miembros activos el día de su cumpleaños" />
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            Sale a las 8:00 a. m. como aviso en la app y notificación (categoría "Novedades del gym").
            Quien nació el 29 de febrero lo recibe el 28 en los años no bisiestos.
        </MudText>
        <MudTextField T="string" @bind-Value="_birthdayMessage" Label="Texto de la felicitación" Lines="3"
                      MaxLength="600" data-testid="birthday-message" Disabled="!_birthdayEnabled"
                      HelperText="@($"Puedes usar {string.Join(" y ", _birthdayVariables)}. Vacío = el texto por defecto.")"
                      Style="max-width:560px" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveBirthdayAsync" Disabled="_savingBirthday"
                   Class="mt-3" id="save-birthday">
            @(_savingBirthday ? "Guardando..." : "Guardar cumpleaños")
        </MudButton>
    </section>
}

<WhatsAppTemplatesEditor />

@code {
    private bool _loading = true;
    private bool _saving;
    private bool _savingBirthday;
    private int _days = 3;
    private bool _birthdayEnabled;
    private string? _birthdayMessage;
    private string _birthdayDefault = string.Empty;
    private string[] _birthdayVariables = ["{nombre}", "{gym}"];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _days = (await Announcements.ReminderSettingsGETAsync()).ReminderDaysBefore;
            ApplyBirthday(await Announcements.BirthdaySettingsGETAsync());
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyBirthday(BirthdaySettingsResponse response)
    {
        _birthdayEnabled = response.Enabled;
        _birthdayDefault = response.DefaultMessage;
        // El campo muestra el texto vigente; si coincide con el de por defecto se guarda vacío para seguirlo.
        _birthdayMessage = response.Message;
        _birthdayVariables = response.Variables.ToArray();
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            _days = (await Announcements.ReminderSettingsPUTAsync(new UpdateCommunicationsSettingsRequest { ReminderDaysBefore = _days }))
                .ReminderDaysBefore;
            Snackbar.Add("Ajustes de comunicaciones guardados.", Severity.Success);
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveBirthdayAsync()
    {
        _savingBirthday = true;
        try
        {
            var message = string.IsNullOrWhiteSpace(_birthdayMessage) || _birthdayMessage.Trim() == _birthdayDefault
                ? null
                : _birthdayMessage;
            ApplyBirthday(await Announcements.BirthdaySettingsPUTAsync(
                new UpdateBirthdaySettingsRequest { Enabled = _birthdayEnabled, Message = message }));
            Snackbar.Add("Felicitación de cumpleaños guardada.", Severity.Success);
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            _savingBirthday = false;
        }
    }
}

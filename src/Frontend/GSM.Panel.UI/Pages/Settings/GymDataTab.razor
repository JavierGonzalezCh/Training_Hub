@* Pestaña "Datos del gym" de la configuración (la registra GymsPanelModule). *@
@inject IGymClient Gym
@inject SessionService Session
@inject GymContext GymCtx
@inject ISnackbar Snackbar

@if (_loadingGym)
{
    <GsmLoader Class="mt-4" />
}
else
{
    <MudGrid Class="mt-2" Style="max-width:640px">
        <MudItem xs="12" sm="8">
            <MudTextField T="string" @bind-Value="_gymModel.Name" Label="Nombre" Required="true" Class="mb-3" />
            <MudTextField T="string" @bind-Value="_gymModel.LegalName" Label="Razón social" Class="mb-3"
                          HelperText="Para los recibos." id="gym-legal-name" />
            <MudTextField T="string" @bind-Value="_gymModel.Nit" Label="NIT" Class="mb-3" />
            <MudTextField T="string" @bind-Value="_gymModel.Phone" Label="Teléfono" Class="mb-3"
                          HelperText="Con indicativo, por ejemplo +573001234567. Si escribes 10 dígitos le ponemos +57." id="gym-phone" />
            <MudTextField T="string" @bind-Value="_gymModel.Email" Label="Email" InputType="InputType.Email" Class="mb-3" />

            <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-2 mt-2">Ubicación</MudText>
            <MudTextField T="string" @bind-Value="_gymModel.Address" Label="Dirección" Required="true" Class="mb-3"
                          Error="@(string.IsNullOrWhiteSpace(_gymModel.Address))" ErrorText="La dirección es obligatoria." id="gym-address" />
            <MudTextField T="string" @bind-Value="_gymModel.City" Label="Ciudad" Required="true" Class="mb-3"
                          Error="@(string.IsNullOrWhiteSpace(_gymModel.City))" ErrorText="La ciudad es obligatoria." id="gym-city" />
            <div class="d-flex" style="gap:0.75rem">
                <MudNumericField T="double?" @bind-Value="_gymModel.Latitude" Label="Latitud" Min="-90" Max="90"
                                 Format="0.######" Immediate="true" Class="mb-3" id="gym-lat" />
                <MudNumericField T="double?" @bind-Value="_gymModel.Longitude" Label="Longitud" Min="-180" Max="180"
                                 Format="0.######" Immediate="true" Class="mb-3" id="gym-lon" />
            </div>
            <MudNumericField T="int?" @bind-Value="_gymModel.GeofenceRadiusMeters" Label="Radio de la geocerca (metros)"
                             Min="20" Max="2000" Immediate="true" Class="mb-1"
                             HelperText="Qué tan lejos de las coordenadas se acepta un registro de entrada. 150 por defecto." id="gym-radius" />
            @if (MapLink is { } mapLink)
            {
                <MudLink Href="@mapLink" Target="_blank" rel="noopener noreferrer" Class="mb-3 d-inline-block" id="gym-map-link">Ver en el mapa</MudLink>
            }
            else
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">
                    Escribe latitud y longitud (o la dirección) para ver el lugar en el mapa.
                </MudText>
            }

            <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-2 mt-2">Redes y contacto</MudText>
            <MudTextField T="string" @bind-Value="_gymModel.WhatsAppPhone" Label="WhatsApp" Class="mb-3"
                          HelperText="Con indicativo. Los miembros lo usan para escribirle al gimnasio." id="gym-whatsapp" />
            <MudTextField T="string" @bind-Value="_gymModel.InstagramUrl" Label="Instagram (enlace)" Class="mb-3"
                          Error="@(!IsOptionalUrl(_gymModel.InstagramUrl))" ErrorText="Debe empezar por http:// o https://" />
            <MudTextField T="string" @bind-Value="_gymModel.FacebookUrl" Label="Facebook (enlace)" Class="mb-3"
                          Error="@(!IsOptionalUrl(_gymModel.FacebookUrl))" ErrorText="Debe empezar por http:// o https://" />
            <MudTextField T="string" @bind-Value="_gymModel.TikTokUrl" Label="TikTok (enlace)" Class="mb-3"
                          Error="@(!IsOptionalUrl(_gymModel.TikTokUrl))" ErrorText="Debe empezar por http:// o https://" />
            <MudTextField T="string" @bind-Value="_gymModel.WebsiteUrl" Label="Sitio web (enlace)" Class="mb-3"
                          Error="@(!IsOptionalUrl(_gymModel.WebsiteUrl))" ErrorText="Debe empezar por http:// o https://" />

            <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-2 mt-2">Operación y marca</MudText>
            <MudNumericField T="int?" @bind-Value="_gymModel.Capacity" Label="Aforo aproximado (clientes a la vez)"
                             Min="1" Max="5000" Immediate="true" Class="mb-3"
                             HelperText="¿Cuántas personas caben cómodamente entrenando al mismo tiempo? Con este dato calcularemos qué tan lleno está el gimnasio en tiempo real." />
            <div class="d-flex align-center mb-3" style="gap:0.75rem">
                <MudTextField T="string" @bind-Value="_gymModel.PrimaryColor" Label="Color primario (hex)"
                              Error="@(!IsValidHex(_gymModel.PrimaryColor))" ErrorText="Formato #RRGGBB" />
                <div class="gsm-swatch" style="@SwatchStyle(_gymModel.PrimaryColor)"></div>
            </div>
            <div class="d-flex align-center mb-4" style="gap:0.75rem">
                <MudTextField T="string" @bind-Value="_gymModel.SecondaryColor" Label="Color secundario (hex)"
                              Error="@(!IsValidHex(_gymModel.SecondaryColor))" ErrorText="Formato #RRGGBB" />
                <div class="gsm-swatch" style="@SwatchStyle(_gymModel.SecondaryColor)"></div>
            </div>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveGymAsync"
                       Disabled="@(_savingGym || !CanSave)" id="gym-save">
                @(_savingGym ? "Guardando..." : "Guardar cambios")
            </MudButton>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-2">Logo</MudText>
            <MudAvatar Style="width:96px;height:96px" Square="true" Class="mb-2">
                @if (!string.IsNullOrEmpty(GymCtx.Gym?.LogoUrl))
                {
                    <MudImage Src="@GymCtx.Gym!.LogoUrl" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Image" />
                }
            </MudAvatar>
            <MudFileUpload T="IBrowserFile" FilesChanged="UploadLogoAsync">
                <ActivatorContent>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="_uploadingLogo">
                        @(_uploadingLogo ? "Subiendo..." : "Cambiar logo")
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>
        </MudItem>
    </MudGrid>
}

@code {
    private readonly GymModel _gymModel = new();

    private bool _loadingGym = true;
    private bool _savingGym;
    private bool _uploadingLogo;

    protected override Task OnInitializedAsync() => LoadGymAsync();

    private async Task LoadGymAsync()
    {
        _loadingGym = true;
        try
        {
            var gym = await Gym.GymGETAsync();
            _gymModel.Name = gym.Name;
            _gymModel.Nit = gym.Nit;
            _gymModel.Phone = gym.Phone;
            _gymModel.Email = gym.Email;
            _gymModel.Capacity = gym.Capacity;
            _gymModel.LegalName = gym.LegalName;
            _gymModel.Address = gym.Address;
            _gymModel.City = gym.City;
            _gymModel.Latitude = gym.Latitude;
            _gymModel.Longitude = gym.Longitude;
            _gymModel.GeofenceRadiusMeters = gym.GeofenceRadiusMeters;
            _gymModel.InstagramUrl = gym.InstagramUrl;
            _gymModel.FacebookUrl = gym.FacebookUrl;
            _gymModel.TikTokUrl = gym.TikTokUrl;
            _gymModel.WebsiteUrl = gym.WebsiteUrl;
            _gymModel.WhatsAppPhone = gym.WhatsAppPhone;
            _gymModel.PrimaryColor = gym.PrimaryColor;
            _gymModel.SecondaryColor = gym.SecondaryColor;
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            _loadingGym = false;
        }
    }

    private async Task SaveGymAsync()
    {
        _savingGym = true;
        try
        {
            await Gym.GymPUTAsync(new UpdateGymRequest
            {
                Name = _gymModel.Name,
                Nit = _gymModel.Nit,
                Phone = _gymModel.Phone,
                Email = _gymModel.Email,
                Capacity = _gymModel.Capacity,
                LegalName = _gymModel.LegalName,
                Address = _gymModel.Address,
                City = _gymModel.City,
                Latitude = _gymModel.Latitude,
                Longitude = _gymModel.Longitude,
                GeofenceRadiusMeters = _gymModel.GeofenceRadiusMeters,
                InstagramUrl = _gymModel.InstagramUrl,
                FacebookUrl = _gymModel.FacebookUrl,
                TikTokUrl = _gymModel.TikTokUrl,
                WebsiteUrl = _gymModel.WebsiteUrl,
                WhatsAppPhone = _gymModel.WhatsAppPhone,
                PrimaryColor = _gymModel.PrimaryColor,
                SecondaryColor = _gymModel.SecondaryColor,
            });
            await Session.BootstrapAsync(); // refresca branding/tema en el shell
            Snackbar.Add("Datos del gym actualizados.", Severity.Success);
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            _savingGym = false;
        }
    }

    private async Task UploadLogoAsync(IBrowserFile file)
    {
        _uploadingLogo = true;
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            await Gym.LogoAsync(new FileParameter(stream, file.Name, file.ContentType));
            await Session.BootstrapAsync();
            Snackbar.Add("Logo actualizado.", Severity.Success);
        }
        catch (GsmApiException ex) when (ex.StatusCode == 500)
        {
            Snackbar.Add("El logo no está disponible todavía: falta configurar el almacenamiento.", Severity.Warning);
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            _uploadingLogo = false;
        }
    }

    private string? MapLink
        => GymLinks.MapUrl(_gymModel.Latitude, _gymModel.Longitude, _gymModel.Address, _gymModel.City);

    private bool CanSave
        => IsValidHex(_gymModel.PrimaryColor) && IsValidHex(_gymModel.SecondaryColor)
           && !string.IsNullOrWhiteSpace(_gymModel.Address) && !string.IsNullOrWhiteSpace(_gymModel.City)
           && (_gymModel.Latitude is null) == (_gymModel.Longitude is null)
           && IsOptionalUrl(_gymModel.InstagramUrl) && IsOptionalUrl(_gymModel.FacebookUrl)
           && IsOptionalUrl(_gymModel.TikTokUrl) && IsOptionalUrl(_gymModel.WebsiteUrl);

    private static bool IsOptionalUrl(string? url)
        => string.IsNullOrWhiteSpace(url)
           || (Uri.TryCreate(url.Trim(), UriKind.Absolute, out var uri) && uri.Scheme is "http" or "https");

    private static bool IsValidHex(string? hex)
        => System.Text.RegularExpressions.Regex.IsMatch(hex ?? "", "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$");

    private static string SwatchStyle(string? hex)
        => $"width:32px;height:32px;border-radius:6px;border:1px solid var(--gsm-border);flex-shrink:0;background:{(IsValidHex(hex) ? hex : "transparent")}";

    private sealed class GymModel
    {
        public int? Capacity { get; set; }
        public string? LegalName { get; set; }
        public string? Address { get; set; }
        public string? City { get; set; }
        public double? Latitude { get; set; }
        public double? Longitude { get; set; }
        public int? GeofenceRadiusMeters { get; set; } = 150;
        public string? InstagramUrl { get; set; }
        public string? FacebookUrl { get; set; }
        public string? TikTokUrl { get; set; }
        public string? WebsiteUrl { get; set; }
        public string? WhatsAppPhone { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Nit { get; set; }
        public string? Phone { get; set; }
        public string? Email { get; set; }
        public string PrimaryColor { get; set; } = "#B50016";
        public string SecondaryColor { get; set; } = "#0AAFCA";
    }
}

@page "/settings"
@attribute [Authorize(Roles = GsmRoles.Owner)]
@using GSM.Panel.UI.Navigation
@inject PanelRegistry Registry
@inject AuthenticationStateProvider AuthState

<PageTitle>Configuración — GSM</PageTitle>

<MudText Typo="Typo.h4" Class="mb-6">Configuración</MudText>

@* Las pestañas no se escriben aquí: cada módulo declara las suyas (IPanelModule.SettingsSections)
   y este contenedor solo las muestra, en orden. *@
@if (_sections is not null)
{
    <MudTabs Rounded="true" Color="Color.Primary" Class="gsm-settings-tabs">
        @foreach (var section in _sections)
        {
            <MudTabPanel Text="@section.Title">
                <DynamicComponent Type="@section.Component" />
            </MudTabPanel>
        }
    </MudTabs>
}

@code {
    private IReadOnlyList<PanelSettingsSection>? _sections;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _sections = Registry.GetSettingsSections(state.User);
    }
}

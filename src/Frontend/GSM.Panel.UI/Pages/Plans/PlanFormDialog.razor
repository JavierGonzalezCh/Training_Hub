@inject IMembershipPlansClient Plans

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
            }
            <MudForm @ref="_form" Model="_model">
                <MudTextField T="string" @bind-Value="_model.Name" Label="Nombre" Required="true" Class="mb-3" />
                <MudTextField T="string" @bind-Value="_model.Description" Label="Descripción" Class="mb-3" />
                <MudNumericField T="decimal" Culture="GsmFormat.Colombia" Format="@GsmFormat.MoneyFieldFormat" @bind-Value="_model.Price" Label="Precio (COP)" Required="true" Min="0" Class="mb-3" />
                <MudGrid Spacing="2">
                    <MudItem xs="5">
                        <MudNumericField T="int" @bind-Value="_model.DurationValue" Label="Duración" Required="true" Min="1" Max="@MaxValue" />
                    </MudItem>
                    <MudItem xs="7">
                        <MudSelect T="string" @bind-Value="_model.DurationUnit" Label="Unidad" Required="true">
                            @foreach (var (value, label) in PlanDurationLabels.Units)
                            {
                                <MudSelectItem Value="value">@label</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>
                <MudGrid Spacing="2" Class="mt-1">
                    <MudItem xs="6">
                        <MudNumericField T="int" @bind-Value="_model.MaxFreezeDays" Label="Máx. días de congelamiento" Min="0" Max="365" id="plan-max-freeze"
                                         HelperText="0 = no se congela." />
                    </MudItem>
                    <MudItem xs="6">
                        <MudNumericField T="int" @bind-Value="_model.MinFreezeDays" Label="Mínimo por congelamiento (días)" Min="1" Max="365" id="plan-min-freeze" />
                    </MudItem>
                </MudGrid>
                @if (_model.DurationUnit == PlanDurationLabels.Months)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                        Un plan de 1 mes que empieza el 8 de septiembre cubre hasta el 7 de octubre.
                    </MudText>
                }
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_loading || _submitting">
            @(_submitting ? "Guardando..." : "Guardar")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>Null = alta; con valor, edición.</summary>
    [Parameter]
    public Guid? PlanId { get; set; }

    private readonly FormModel _model = new();
    private MudForm _form = null!;
    private bool _loading;
    private bool _submitting;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (PlanId is not { } id)
        {
            return;
        }

        _loading = true;
        try
        {
            var plan = await Plans.MembershipPlansGETAsync(id);
            _model.Name = plan.Name;
            _model.Description = plan.Description;
            _model.Price = (decimal)plan.Price;
            _model.DurationValue = plan.DurationValue;
            _model.DurationUnit = plan.DurationUnit;
            _model.MaxFreezeDays = plan.MaxFreezeDays;
            _model.MinFreezeDays = plan.MinFreezeDays;
        }
        catch (GsmApiException ex)
        {
            _error = ApiError.FromException(ex).DisplayMessage;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SubmitAsync()
    {
        _error = null;
        await _form.Validate();
        if (!_form.IsValid)
        {
            return;
        }

        _submitting = true;
        try
        {
            if (PlanId is { } id)
            {
                await Plans.MembershipPlansPUTAsync(id, new UpdatePlanRequest
                {
                    Name = _model.Name,
                    Description = _model.Description,
                    Price = (double)_model.Price,
                    DurationValue = _model.DurationValue,
                    DurationUnit = _model.DurationUnit,
                    MaxFreezeDays = _model.MaxFreezeDays,
                    MinFreezeDays = _model.MinFreezeDays,
                });
            }
            else
            {
                await Plans.MembershipPlansPOSTAsync(new CreatePlanRequest
                {
                    Name = _model.Name,
                    Description = _model.Description,
                    Price = (double)_model.Price,
                    DurationValue = _model.DurationValue,
                    DurationUnit = _model.DurationUnit,
                    MaxFreezeDays = _model.MaxFreezeDays,
                    MinFreezeDays = _model.MinFreezeDays,
                });
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (GsmApiException ex)
        {
            _error = ApiError.FromException(ex).DisplayMessage;
        }
        finally
        {
            _submitting = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private sealed class FormModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public decimal Price { get; set; }
        public int DurationValue { get; set; } = 30;
        public string DurationUnit { get; set; } = PlanDurationLabels.Days;
        public int MaxFreezeDays { get; set; }
        public int MinFreezeDays { get; set; } = 1;
    }

    private int MaxValue => _model.DurationUnit == PlanDurationLabels.Months ? 120 : 3650;
}

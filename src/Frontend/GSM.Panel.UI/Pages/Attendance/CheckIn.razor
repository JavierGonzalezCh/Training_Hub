@page "/attendance/checkin"
@attribute [Authorize(Policy = GsmPolicies.RequireStaff)]
@using GSM.Panel.UI.Pages.Members
@using GSM.Panel.UI.Pages.Payments
@inject IAttendanceClient Attendance
@inject IMembersClient Members
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Recepción — TrainingHub OS</PageTitle>

<PageHeader Title="Recepción">
    <Subtitle>Busca al miembro, revisa su tarjeta y registra la entrada.</Subtitle>
</PageHeader>

@* El buscador va primero: es la acción que recepción repite todo el día. La caja y el kiosco van debajo; antes
   iban arriba y en el celular empujaban el buscador al borde de la pantalla. *@
<MudGrid>
    <MudItem xs="12" md="7">
        <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid var(--gsm-border)">
            <MudAutocomplete OpenOnFocus="false" @ref="_search" T="MemberListItem" Value="null" ValueChanged="OnMemberPickedAsync"
                              SearchFunc="SearchMembersAsync" Disabled="_submitting" AutoFocus="true"
                              ToStringFunc="@(m => m is null ? string.Empty : $"{m.FirstName} {m.LastName} · {m.DocumentNumber}")"
                              Label="Buscar miembro" Placeholder="Nombre o documento" ResetValueOnEmptyText="true" />
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="5">
        @* Lo que recepción tiene que anunciar en voz alta va también para el lector de pantalla, corto. *@
        <div class="gsm-visually-hidden" role="status" aria-live="polite" aria-atomic="true" id="reception-announcer">@_announcement</div>

        @if (_card is { } card)
        {
            var verdict = Verdict(card);
            <MudPaper Class="@($"pa-6 gsm-reception gsm-reception--{verdict.Tone}")" Elevation="0" id="reception-card">
                @* El veredicto va primero y no depende solo del color: rótulo, icono y tono dicen lo mismo. *@
                <div class="gsm-verdict" id="reception-verdict">
                    <MudIcon Icon="@verdict.Icon" aria-hidden="true" />
                    <span>@verdict.Label</span>
                </div>
                <div class="d-flex align-center" style="gap:1rem">
                    <MudAvatar Size="Size.Large">
                        @if (!string.IsNullOrEmpty(card.PhotoUrl))
                        {
                            <MudImage Src="@card.PhotoUrl" Alt="@card.MemberName" />
                        }
                        else
                        {
                            @GsmFormat.Initials(card.MemberName)
                        }
                    </MudAvatar>
                    <div>
                        <MudText Typo="Typo.h4" HtmlTag="h2">@card.MemberName</MudText>
                        <CommercialStatusChip Status="@card.Commercial" />
                    </div>
                </div>

                @if (card.DaysLeft is { } daysLeft)
                {
                    <MudText Typo="Typo.body2" Class="mt-3" id="days-left">
                        @(daysLeft == 0 ? "Vence hoy" : daysLeft == 1 ? "Le queda 1 día" : $"Le quedan {daysLeft} días")
                    </MudText>
                }
                @if (card.EntriesTotal is { } passTotal)
                {
                    <MudText Typo="Typo.body2" Class="mt-1" id="pass-balance">@PlanDurationLabels.Balance(card.EntriesLeft ?? 0, passTotal)</MudText>
                }
                @* Lo que decide la entrada va arriba (motivo y botones); lo demás, plegado en "Además", con un resumen que
                   dice qué hay dentro. Antes la tarjeta apilaba hasta nueve avisos del mismo peso y el veredicto se perdía. *@
                @if (ReceptionNotice.For(card.Kind, card.EndsOn, card.DaysLeft, card.GraceDaysLeft, card.EntriesLeft, card.EntriesTotal, card.Notice) is { } notice)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3" id="access-notice">@notice</MudAlert>
                }
                @if (card.GymClosed)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3" role="alert" id="gym-closed">
                        @(card.GymClosedMessage ?? "El gimnasio está cerrado.")
                    </MudAlert>
                }
                else if (!card.MemberActive)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3" role="alert" id="member-inactive">
                        Está dado de baja. Reactiva su ficha para registrar su entrada.
                    </MudAlert>
                }
                else if (card.AlreadyCheckedInToday)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3" role="status" id="already-in">
                        Ya entró hoy a las @(card.CheckedInAt is { } at ? GsmFormat.Time(at) : "?")
                    </MudAlert>
                    @if (card.NextEntryAt is { } next)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3" role="status" id="next-entry">
                            Puede volver a entrar a partir de las @GsmFormat.Time(next) (mínimo 2 horas entre entradas).
                        </MudAlert>
                    }
                }
                else if (card.CanLetThrough)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3" role="alert" id="block-message">
                        @(card.BlockMessage ?? "No puede entrar.")
                    </MudAlert>
                }

                @if (_askReason)
                {
                    <MudTextField T="string" @bind-Value="_reason" Label="Motivo para dejarlo pasar" Required="true" MaxLength="500"
                                  Class="mt-4" HelperText="Queda registrado con tu nombre (por ejemplo: paga mañana, cortesía)." AutoFocus="true" />
                    <div class="d-flex mt-3" style="gap:0.5rem">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LetThroughAsync" Disabled="_submitting">
                            Confirmar entrada
                        </MudButton>
                        <MudButton OnClick="@(() => _askReason = false)">Volver</MudButton>
                    </div>
                }
                else if (card.CanRegister)
                {
                    <div class="d-flex flex-wrap mt-4" style="gap:0.5rem">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RegisterAsync" Disabled="_submitting" id="register-button">
                            Registrar entrada
                        </MudButton>
                    </div>
                }
                else if (card.CanLetThrough)
                {
                    <div class="d-flex flex-wrap mt-4" style="gap:0.5rem">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RenewAsync">Renovar y cobrar</MudButton>
                        <MudButton Variant="Variant.Outlined" OnClick="@(() => _askReason = true)">Dejar pasar</MudButton>
                    </div>
                }

                @if (Extras(card) is { Count: > 0 } extras)
                {
                    <details class="gsm-reception__extras" data-testid="reception-extras">
                        <summary>Además: @string.Join(" · ", extras)</summary>
                        @if (card.BirthdayToday)
                        {
                            <MudAlert Severity="Severity.Success" Icon="@Icons.Material.Outlined.Cake" Dense="true" Class="mt-3" role="status"
                                      id="birthday-today">
                                Hoy cumple años. ¡Salúdalo!
                                <div class="mt-2">
                                    <WhatsAppButton MemberId="card.MemberId" Kind="Birthday" />
                                </div>
                            </MudAlert>
                        }
                        @if (card.PendingRewards is { Count: > 0 } pendingRewards)
                        {
                            <ReceptionRewards MemberId="card.MemberId" Rewards="pendingRewards" OnDelivered="@(() => LoadCardAsync(card.MemberId))" />
                        }
                        @if (card.MissingWaiver)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3" role="status" id="missing-waiver">
                                Falta la exoneración de responsabilidad: pídele que la firme y regístrala en su ficha, pestaña Autorizaciones.
                            </MudAlert>
                        }
                        @if (card.MultipleEntries == true)
                        {
                            <MudText Typo="Typo.body2" Class="mt-3" id="multiple-entries">
                                Entradas múltiples: @card.MaxDailyEntries por día · lleva @card.EntriesToday hoy
                            </MudText>
                        }
                        @if (card.CanLetThrough)
                        {
                            <div class="mt-3">
                                <WhatsAppButton MemberId="card.MemberId" Kind="@WhatsAppLabels.KindForStatus(card.Commercial)" />
                            </div>
                        }
                    </details>
                }
            </MudPaper>
        }
        else if (_result is not null)
        {
            @* La entrada quedó registrada: siempre es un resultado de éxito. Lo pendiente (gracia, exoneración)
               va como nota dentro, no tiñe la tarjeta de error. *@
            <MudPaper Class="pa-6 gsm-reception gsm-reception--ok" Elevation="0" id="checkin-result-card">
                <div class="gsm-verdict">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" aria-hidden="true" />
                    <span>Entrada registrada</span>
                </div>
                <MudText Typo="Typo.h4" HtmlTag="h2">@_result.MemberName</MudText>
                <MudText Typo="Typo.body1" Class="gsm-mono mt-1" id="checkin-result">Entrada registrada · @GsmFormat.Time(_result.CheckedInAt)</MudText>

                @if (_result.Authorized == true)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-4">Entrada autorizada por recepción.</MudAlert>
                }
                @if (_result.EntriesTotal is { } resultTotal)
                {
                    <MudText Typo="Typo.body2" Class="mt-2" id="pass-balance-result">@PlanDurationLabels.Balance(_result.EntriesLeft ?? 0, resultTotal)</MudText>
                }
                @if (ResultNotice(_result) is { } resultNotice)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-4" id="access-notice">@resultNotice</MudAlert>
                }
                @if (_result.MembershipExpired)
                {
                    <div class="mt-3 d-flex flex-wrap align-center" style="gap:.5rem">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ChargeResultAsync" data-testid="charge-expired">Cobrar</MudButton>
                        <WhatsAppButton MemberId="_result.MemberId" Kind="Expired" />
                    </div>
                }
                @if (_result.MissingWaiver == true)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-4" role="status" id="missing-waiver">
                        Falta la exoneración de responsabilidad: pídele que la firme y regístrala en su ficha, pestaña Autorizaciones.
                    </MudAlert>
                }
                @if (_result.UnlockedAchievements is { Count: > 0 } achievements)
                {
                    <MudDivider Class="my-4" />
                    <MudText Typo="Typo.overline" Color="Color.Secondary">Logros desbloqueados</MudText>
                    @foreach (var achievement in achievements)
                    {
                        <MudChip T="string" Color="Color.Primary" Class="ma-1">@achievement.Name</MudChip>
                    }
                }
            </MudPaper>
        }
        else
        {
            <MudPaper Class="pa-6 text-center" Elevation="0" Style="border:1px dashed var(--gsm-border)">
                <MudText Color="Color.Secondary">El resultado del check-in aparece aquí.</MudText>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

@* P3-4: la misma barra de la caja que en Pagos, para cobrar sin salir de recepción. *@
<div class="mt-6">
    <CashDrawerBar />
</div>

<RequireRole Roles="@GsmRoles.Owner">
    <div class="d-flex align-center flex-wrap mt-2" style="gap:0.75rem">
        <MudText Typo="Typo.body2" Color="Color.Secondary">Los miembros también entran solos escaneando el QR del kiosco.</MudText>
        <MudButton Variant="Variant.Outlined" Href="/settings/kioscos" StartIcon="@Icons.Material.Outlined.QrCode2">Configurar kiosco</MudButton>
    </div>
</RequireRole>

@code {
    private CheckInResponse? _result;
    private ReceptionCardResponse? _card;
    private bool _askReason;
    private string? _reason;
    private bool _submitting;
    private MudAutocomplete<MemberListItem>? _search;
    private string? _announcement;
    private bool _focusSearch;

    private sealed record ReceptionVerdict(string Label, string Tone, string Icon);

    /// <summary>
    /// El veredicto de la tarjeta, en el orden en que el servidor decide. <c>ok</c> = puede entrar,
    /// <c>danger</c> = no puede, <c>neutral</c> = ya entró y no le toca otra entrada todavía.
    /// </summary>
    private static ReceptionVerdict Verdict(ReceptionCardResponse card)
    {
        if (card.CanRegister)
        {
            return new(card.Kind == "grace" ? "Puede entrar · en gracia" : "Puede entrar", "ok", Icons.Material.Filled.CheckCircle);
        }

        if (card.GymClosed)
        {
            return new("No puede entrar · gimnasio cerrado", "danger", Icons.Material.Filled.Block);
        }

        if (!card.MemberActive)
        {
            return new("No puede entrar · dado de baja", "danger", Icons.Material.Filled.Block);
        }

        if (card.AlreadyCheckedInToday)
        {
            return new("Ya entró hoy", "neutral", Icons.Material.Filled.History);
        }

        return new("No puede entrar", "danger", Icons.Material.Filled.Block);
    }

    /// <summary>
    /// Lo que va plegado en "Además", nombrado en corto para el resumen: así se ve de un vistazo que hay un cumpleaños
    /// o un premio por entregar sin que cada cosa ocupe un aviso entero.
    /// </summary>
    private static IReadOnlyList<string> Extras(ReceptionCardResponse card)
    {
        var extras = new List<string>();
        if (card.BirthdayToday)
        {
            extras.Add("cumpleaños");
        }

        if (card.PendingRewards is { Count: > 0 } rewards)
        {
            extras.Add(rewards.Count == 1 ? "1 premio por entregar" : $"{rewards.Count} premios por entregar");
        }

        if (card.MissingWaiver)
        {
            extras.Add("falta la exoneración");
        }

        if (card.MultipleEntries == true)
        {
            extras.Add("entradas múltiples");
        }

        if (card.CanLetThrough)
        {
            extras.Add("avisar por WhatsApp");
        }

        return extras;
    }

    /// <summary>El aviso del resultado, para recepción. Una entrada autorizada a mano ya lleva su propia nota.</summary>
    private static string? ResultNotice(CheckInResponse result)
    {
        if (result.Authorized == true)
        {
            return null;
        }

        var kind = result.MembershipExpired ? "grace" : result.Notice is null ? null : "expiring";
        return ReceptionNotice.For(
            kind, result.MembershipEndsOn, result.DaysLeft, result.GraceDaysLeft, result.EntriesLeft, result.EntriesTotal,
            result.Notice);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Tras registrar, el foco vuelve al buscador para atender al siguiente de la fila sin tocar el ratón.
        // Se hace después del render porque mientras se enviaba el buscador estaba deshabilitado.
        if (_focusSearch && _search is not null)
        {
            _focusSearch = false;
            await _search.FocusAsync();
        }
    }

    private async Task<IEnumerable<MemberListItem>> SearchMembersAsync(string search, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            return [];
        }

        var result = await Members.MembersGETAsync(search, null, null, null, 1, 10, null, null, null, cancellationToken);
        return result.Items;
    }

    private async Task OnMemberPickedAsync(MemberListItem? member)
    {
        if (member is null)
        {
            return;
        }

        _result = null;
        _card = null;
        _askReason = false;
        _reason = null;

        // Paso 1: la tarjeta. Elegir al miembro no registra nada; la entrada es un botón (paso 2).
        await LoadCardAsync(member.Id);
    }

    private async Task LoadCardAsync(Guid memberId)
    {
        try
        {
            _card = await Attendance.ReceptionCardAsync(memberId);
            _announcement = $"{_card.MemberName}: {Verdict(_card).Label}.";
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
    }

    private async Task RegisterAsync()
    {
        if (_card is not { CanRegister: true } card)
        {
            return;
        }

        if (await SubmitAsync(new CheckInRequest { MemberId = card.MemberId }))
        {
            _card = null;
        }
        else
        {
            // Pudo cambiar el estado (otro recepcionista, el horario): se vuelve a leer la tarjeta.
            await LoadCardAsync(card.MemberId);
        }
    }

    private async Task LetThroughAsync()
    {
        if (_card is not { } card)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_reason) || _reason.Trim().Length < 3)
        {
            Snackbar.Add("Indica el motivo para dejarlo pasar (mínimo 3 caracteres).", Severity.Warning);
            return;
        }

        if (await SubmitAsync(new CheckInRequest { MemberId = card.MemberId, AuthorizationReason = _reason.Trim() }))
        {
            _card = null;
            _askReason = false;
        }
    }

    private async Task RenewAsync()
    {
        if (_card is not { } card)
        {
            return;
        }

        var parameters = new DialogParameters<AssignMembershipDialog> { { x => x.MemberId, card.MemberId } };
        var dialog = await Dialogs.ShowAsync<AssignMembershipDialog>("Asignar membresía", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Membresía renovada.", Severity.Success);
            _askReason = false;
            await LoadCardAsync(card.MemberId);
        }
    }

    private async Task<bool> SubmitAsync(CheckInRequest request)
    {
        _submitting = true;
        try
        {
            _result = await Attendance.CheckinAsync(request);
            _announcement = $"Entrada registrada: {_result.MemberName}, {GsmFormat.Time(_result.CheckedInAt)}.";
            _focusSearch = true;
            return true;
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
            return false;
        }
        finally
        {
            _submitting = false;
        }
    }

    // P1: el miembro entró con el plan vencido: recepción cobra desde aquí, con el miembro ya elegido.
    private async Task ChargeResultAsync()
    {
        if (_result is null)
        {
            return;
        }

        var parameters = new DialogParameters<RecordPaymentDialog> { { x => x.MemberId, _result.MemberId } };
        var dialog = await Dialogs.ShowAsync<RecordPaymentDialog>("Cobrar", parameters);
        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add("Pago registrado.", Severity.Success);
        }
    }
}

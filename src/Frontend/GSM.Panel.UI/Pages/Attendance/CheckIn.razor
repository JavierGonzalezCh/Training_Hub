@page "/attendance/checkin"
@attribute [Authorize(Policy = GsmPolicies.RequireStaff)]
@inject IAttendanceClient Attendance
@inject IMembersClient Members
@inject ISnackbar Snackbar

<PageTitle>Recepción — GSM</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Recepción</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">
    Registro manual: busca al miembro por nombre o documento. Los miembros entran solos escaneando el QR del kiosco.
</MudText>

<MudButton Variant="Variant.Outlined" Href="/kiosk" StartIcon="@Icons.Material.Outlined.QrCode2" Class="mb-6">Abrir kiosco</MudButton>

<MudGrid>
    <MudItem xs="12" md="7">
        <MudPaper Class="pa-4" Elevation="0" Style="border:1px solid var(--gsm-border)">
            <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-2">Buscar a mano</MudText>
            <MudAutocomplete T="MemberListItem" Value="null" ValueChanged="OnMemberPickedAsync"
                              SearchFunc="SearchMembersAsync" Disabled="_submitting" AutoFocus="true"
                              ToStringFunc="@(m => m is null ? string.Empty : $"{m.FirstName} {m.LastName} · {m.DocumentNumber}")"
                              Placeholder="Nombre o documento" ResetValueOnEmptyText="true" />
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="5">
        @if (_result is not null)
        {
            <MudPaper Class="pa-6 text-center" Elevation="0"
                      Style="@ResultStyle()">
                <MudIcon Icon="@(_result.MembershipExpired ? Icons.Material.Filled.WarningAmber : Icons.Material.Filled.CheckCircle)"
                         Size="Size.Large" Color="@(_result.MembershipExpired ? Color.Error : Color.Info)" Class="mb-2" />
                <MudText Typo="Typo.h4">@_result.MemberName</MudText>
                <MudText Typo="Typo.body1" Class="gsm-mono mt-1">@GsmFormat.Instant(_result.CheckedInAt)</MudText>

                @if (_result.AlreadyCheckedInToday)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-4">Ya había entrado hoy.</MudAlert>
                }
                @if (_result.MembershipExpired)
                {
                    @if (_result.GraceDaysLeft is { } left)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-4">
                            Dentro de la gracia: le @(left == 1 ? "queda 1 día" : $"quedan {left} días").
                            Venció el @(_result.MembershipEndsOn is { } e ? GsmFormat.Day(e) : "—").
                        </MudAlert>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-4">
                            Membresía vencida@(_result.MembershipEndsOn is { } e2 ? $" el {GsmFormat.Day(e2)}" : " o inexistente"). La entrada quedó registrada igual.
                        </MudAlert>
                    }
                }

                @if (_result.UnlockedAchievements is { Count: > 0 } achievements)
                {
                    <MudDivider Class="my-4" />
                    <MudText Typo="Typo.overline" Color="Color.Secondary">Logros desbloqueados</MudText>
                    @foreach (var achievement in achievements)
                    {
                        <MudChip T="string" Color="Color.Info" Class="ma-1">@achievement.Name</MudChip>
                    }
                }
            </MudPaper>
        }
        else
        {
            <MudPaper Class="pa-6 text-center" Elevation="0" Style="border:1px dashed var(--gsm-border)">
                <MudText Color="Color.Secondary">El resultado del check-in aparece aquí.</MudText>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

@code {
    private CheckInResponse? _result;
    private bool _submitting;

    private async Task<IEnumerable<MemberListItem>> SearchMembersAsync(string search, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            return [];
        }

        var result = await Members.MembersGETAsync(search, null, null, 1, 10, cancellationToken);
        return result.Items;
    }

    private async Task OnMemberPickedAsync(MemberListItem? member)
    {
        if (member is null)
        {
            return;
        }

        await SubmitAsync(new CheckInRequest { MemberId = member.Id });
    }

    private async Task SubmitAsync(CheckInRequest request)
    {
        _submitting = true;
        try
        {
            _result = await Attendance.CheckinAsync(request);
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            _submitting = false;
        }
    }

    private string ResultStyle() => _result switch
    {
        { MembershipExpired: true } => "border:1px solid var(--gsm-red-hot)",
        { AlreadyCheckedInToday: true } => "border:1px solid var(--gsm-border)",
        _ => "border:1px solid var(--gsm-cyan)",
    };
}

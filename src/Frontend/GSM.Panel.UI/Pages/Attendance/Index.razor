@page "/attendance"
@attribute [Authorize(Policy = GsmPolicies.RequireStaff)]
@inject IAttendanceClient Attendance
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Asistencia — TrainingHub OS</PageTitle>

<PageHeader Title="Asistencia">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.QrCodeScanner"
                   OnClick="@(() => Navigation.NavigateTo("/attendance/checkin"))">
            Recepción
        </MudButton>
    </Actions>
</PageHeader>

<MudPaper Class="pa-4 mb-6" Elevation="0" Style="border:1px solid var(--gsm-border)">
    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-2">Horas pico (últimos 7 días)</MudText>
    @if (_peakHours is null)
    {
        <GsmLoader />
    }
    else if (_peakHours.Sum(b => b.Count) == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.QueryStats" Compact="true">Sin check-ins en el rango.</EmptyState>
    }
    else
    {
        <MudChart ChartType="ChartType.Bar" ChartSeries="_series" XAxisLabels="_labels" Width="100%" Height="260px" />
    }
</MudPaper>

<ServerTable @ref="_table" TItem="AttendanceListItem" Load="LoadAsync">
    <ToolBarContent>
        <MudDatePicker Label="Desde" Date="_from" DateChanged="OnFromChangedAsync" Class="mr-4" Style="max-width:180px" />
        <MudDatePicker Label="Hasta" Date="_to" DateChanged="OnToChangedAsync" Class="mr-4" Style="max-width:180px" />
        <MudSwitch T="bool" Value="_authorizedOnly" ValueChanged="OnAuthorizedChangedAsync" Color="Color.Primary"
                   Label="Entradas autorizadas" />
        <MudSwitch T="bool" Value="_includeVoided" ValueChanged="OnIncludeVoidedChangedAsync" Color="Color.Primary"
                   Label="Ver anuladas" data-testid="include-voided" />
        <MudSwitch T="bool" Value="_notCountedOnly" ValueChanged="OnNotCountedChangedAsync" Color="Color.Primary"
                   Label="Sin ubicación o fuera del radio" data-testid="not-counted-only" />
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Miembro</MudTh>
        <MudTh>Fecha</MudTh>
        <MudTh>Hora</MudTh>
        <MudTh>Método</MudTh>
        <MudTh>Autorizada</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Miembro">
            <MudLink Href="@($"/members/{context.MemberId}")" Underline="Underline.None">
                @context.MemberName
            </MudLink>
        </MudTd>
        <MudTd DataLabel="Fecha">@GsmFormat.Day(context.AttendanceDate)</MudTd>
        <MudTd DataLabel="Hora">@GsmFormat.Instant(context.CheckedInAt)</MudTd>
        <MudTd DataLabel="Método">
            @(AttendanceMethodLabels.Of(context.Method))
            @* A6: con el QR fijo, fuera del radio o sin ubicación la entrada no suma a racha ni logros. *@
            @if (context.CountsForProgress == false)
            {
                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Class="ml-2 location-not-counted">
                    @(context.LocationCheck == "Denied" ? "Sin ubicación" : "Fuera del radio")
                </MudChip>
            }
        </MudTd>
        <MudTd DataLabel="Autorizada">
            @if (context.Authorized == true)
            {
                <MudText Typo="Typo.body2">@(context.AuthorizedByName ?? "Staff") · @context.AuthorizationReason</MudText>
            }
            else
            {
                <MudText Color="Color.Secondary">—</MudText>
            }
        </MudTd>
        <MudTd DataLabel="">
            <CheckInVoidAction Entry="context" OnVoided="@(() => _table.RefreshAsync())" />
        </MudTd>
    </RowTemplate>
    <CardTemplate>
        <div class="gsm-card__row">
            <MudLink Href="@($"/members/{context.MemberId}")" Underline="Underline.None" Class="gsm-card__title">
                @context.MemberName
            </MudLink>
            <span class="gsm-mono">@(AttendanceMethodLabels.Of(context.Method))</span>
        </div>
        <div class="gsm-card__meta">@GsmFormat.Instant(context.CheckedInAt)</div>
        <div class="gsm-card__meta">
            <CheckInVoidAction Entry="context" OnVoided="@(() => _table.RefreshAsync())" />
        </div>
    </CardTemplate>
</ServerTable>

<MudText Typo="Typo.h6" HtmlTag="h2" Class="mt-8 mb-2">Intentos rechazados</MudText>
<ServerTable @ref="_attemptsTable" TItem="CheckinAttemptItem" Load="LoadAttemptsAsync">
    <ToolBarContent>
        <MudSelect T="string" Label="Motivo" Value="_reason" ValueChanged="OnReasonChangedAsync" Clearable="true"
                   Style="max-width:260px" id="attempt-reason">
            @foreach (var (key, label) in ReasonLabels)
            {
                <MudSelectItem T="string" Value="@key">@label</MudSelectItem>
            }
        </MudSelect>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Miembro</MudTh>
        <MudTh>Hora</MudTh>
        <MudTh>Motivo</MudTh>
        <MudTh>Intentos</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Miembro">
            <MudLink Href="@($"/members/{context.MemberId}")" Underline="Underline.None">@context.MemberName</MudLink>
        </MudTd>
        <MudTd DataLabel="Hora">@GsmFormat.Instant(context.AttemptedAt)</MudTd>
        <MudTd DataLabel="Motivo">@ReasonLabel(context.Reason)</MudTd>
        <MudTd DataLabel="Intentos">
            @* Tres o más veces el mismo día con "ya entró" puede ser un QR o documento prestado. *@
            @if (IsSuspicious(context))
            {
                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Class="attempt-suspicious">@context.AttemptCount veces — posible uso prestado</MudChip>
            }
            else
            {
                @context.AttemptCount
            }
        </MudTd>
    </RowTemplate>
    <CardTemplate>
        <div class="gsm-card__row">
            <span class="gsm-card__title">@context.MemberName</span>
            <span class="gsm-mono">@context.AttemptCount x</span>
        </div>
        <div class="gsm-card__meta">@ReasonLabel(context.Reason) · @GsmFormat.Instant(context.AttemptedAt)</div>
    </CardTemplate>
</ServerTable>

@code {
    private static readonly (string Key, string Label)[] ReasonLabels =
    [
        ("already_checked_in", "Ya entró hoy"),
        ("membership_expired", "Membresía vencida"),
        ("no_membership", "Sin membresía"),
        ("membership_frozen", "Membresía congelada"),
        ("pass_exhausted", "Tiquetera sin entradas"),
        ("member_inactive", "Miembro dado de baja"),
    ];

    private ServerTable<CheckinAttemptItem> _attemptsTable = null!;
    private string? _reason;

    private static string ReasonLabel(string reason)
        => ReasonLabels.FirstOrDefault(r => r.Key == reason).Label ?? reason;

    private static bool IsSuspicious(CheckinAttemptItem item) => item.Reason == "already_checked_in" && item.AttemptCount >= 3;

    private async Task<ServerTablePage<CheckinAttemptItem>> LoadAttemptsAsync(int page, int pageSize, CancellationToken cancellationToken)
    {
        try
        {
            var result = await Attendance.AttemptsAsync(
                _from is { } f ? DateOnly.FromDateTime(f) : null,
                _to is { } t ? DateOnly.FromDateTime(t) : null,
                null, string.IsNullOrEmpty(_reason) ? null : _reason, page, pageSize, cancellationToken);
            return new ServerTablePage<CheckinAttemptItem>(result.Items.ToList(), result.Total);
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
            return new ServerTablePage<CheckinAttemptItem>([], 0);
        }
    }

    private async Task OnReasonChangedAsync(string? value)
    {
        _reason = value;
        await _attemptsTable.RefreshAsync();
    }

    private ServerTable<AttendanceListItem> _table = null!;
    private DateTime? _from;
    private DateTime? _to;
    private bool _authorizedOnly;
    private bool _includeVoided;
    private bool _notCountedOnly;
    private List<PeakHourBucket>? _peakHours;
    private List<ChartSeries> _series = [];
    private string[] _labels = [];

    protected override Task OnInitializedAsync() => LoadPeakHoursAsync();

    private async Task LoadPeakHoursAsync()
    {
        try
        {
            var from = DateOnly.FromDateTime(DateTime.Today.AddDays(-6));
            var result = await Attendance.PeakHoursAsync(from, null);
            _peakHours = result.OrderBy(b => b.Hour).ToList();

            _labels = _peakHours.Select(b => b.Hour.ToString("00")).ToArray();
            _series = [new ChartSeries { Name = "Check-ins", Data = _peakHours.Select(b => (double)b.Count).ToArray() }];
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
    }

    private async Task<ServerTablePage<AttendanceListItem>> LoadAsync(int page, int pageSize, CancellationToken cancellationToken)
    {
        try
        {
            var result = await Attendance.AttendanceGETAsync(
                null,
                _from is { } f ? DateOnly.FromDateTime(f) : null,
                _to is { } t ? DateOnly.FromDateTime(t) : null,
                _authorizedOnly ? true : null,
                null,
                _includeVoided ? true : null,
                _notCountedOnly ? true : null,
                page, pageSize, cancellationToken);
            return new ServerTablePage<AttendanceListItem>(result.Items.ToList(), result.Total);
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
            return new ServerTablePage<AttendanceListItem>([], 0);
        }
    }

    private async Task OnFromChangedAsync(DateTime? value)
    {
        _from = value;
        await _table.RefreshAsync();
    }

    private async Task OnAuthorizedChangedAsync(bool value)
    {
        _authorizedOnly = value;
        await _table.RefreshAsync();
    }

    private async Task OnIncludeVoidedChangedAsync(bool value)
    {
        _includeVoided = value;
        await _table.RefreshAsync();
    }

    private async Task OnNotCountedChangedAsync(bool value)
    {
        _notCountedOnly = value;
        await _table.RefreshAsync();
    }

    private async Task OnToChangedAsync(DateTime? value)
    {
        _to = value;
        await _table.RefreshAsync();
    }
}

@page "/subscription"
@attribute [Authorize(Roles = GsmRoles.Owner)]
@inject NavigationManager Navigation

@* La suscripción vive en un solo lugar: Configuración › Suscripción. Esta ruta se queda porque los avisos de
   suscripción ya enviados (SubscriptionNoticeHandlers.SubscriptionLink) apuntan aquí; solo redirige. *@

@code {
    protected override void OnInitialized() => Navigation.NavigateTo("/settings/suscripcion", replace: true);
}

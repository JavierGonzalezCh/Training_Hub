@* Editor de anuncios: contenido, fijado, caducidad y envío por email, con vista previa tal como
   lo verá el miembro en la app. Guardar deja un borrador; Publicar lo hace visible. *@
@inject IAnnouncementsClient Announcements
@inject IDialogService Dialogs
@inject AuthenticationStateProvider AuthState

<MudDialog>
    <DialogContent>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
        }

        <div class="gsm-editor">
            <div class="gsm-editor__form">
                <MudTextField T="string" @bind-Value="_title" Label="Título" Required="true" MaxLength="120"
                              Counter="120" Immediate="true" />
                <MudTextField T="string" @bind-Value="_body" Label="Texto" Lines="7" Required="true" MaxLength="4000"
                              Counter="4000" Immediate="true" Class="mt-2"
                              HelperText="Texto plano. Los saltos de línea se respetan." />
                <MudDatePicker Label="Visible hasta (opcional)" Date="_expires" DateChanged="d => _expires = d"
                               Clearable="true" MinDate="DateTime.Today" Class="mt-2"
                               HelperText="Después de ese día deja de verse en la app." />

                @if (IsNew)
                {
                    <MudSwitch T="bool" @bind-Value="_pinned" Label="Fijar arriba" Color="Color.Primary" Class="mt-3" />
                }

                @* Audiencia (CO2): editable en borrador; publicado, los destinatarios ya están fijados. *@
                @if (IsDraft)
                {
                    <div class="mt-3">
                        <div class="gsm-eyebrow">Audiencia</div>
                        <AnnouncementAudiencePicker Audience="_audienceFilter" AudienceChanged="a => _audienceFilter = a" />
                    </div>
                }
                else if (Existing?.RecipientCount is { } reached)
                {
                    <p class="gsm-editor__hint" data-testid="audience-fixed">
                        Llegó a @reached @(reached == 1 ? "miembro" : "miembros") (fijados al publicar).
                    </p>
                }

                @* Imagen (CO4): una por anuncio. Se sube al guardar, cuando el anuncio ya existe. *@
                <div class="gsm-editor__image mt-3" data-testid="image-section">
                    <div class="gsm-eyebrow">Imagen (opcional)</div>
                    @if (_pendingImage is not null)
                    {
                        <p class="gsm-editor__hint" data-testid="image-pending">Se subirá al guardar: @_pendingImage.Name</p>
                    }
                    else if (_currentImageUrl is not null)
                    {
                        <img class="gsm-announcement__image" src="@_currentImageUrl" alt="Imagen actual del anuncio" data-testid="image-current" />
                    }
                    <div class="d-flex" style="gap:0.5rem">
                        <MudFileUpload T="IBrowserFile" FilesChanged="OnImageChosen" Accept=".jpg,.jpeg,.png,.webp" Class="ma-0">
                            <ActivatorContent>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Image">
                                    @(_currentImageUrl is null && _pendingImage is null ? "Agregar imagen" : "Cambiar imagen")
                                </MudButton>
                            </ActivatorContent>
                        </MudFileUpload>
                        @if (_pendingImage is not null || _currentImageUrl is not null)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="RemoveImage" data-testid="image-remove">Quitar</MudButton>
                        }
                    </div>
                    <p class="gsm-editor__hint">JPG, PNG o WebP, hasta 5 MB.</p>
                </div>

                @* Programar la publicación (CO4): solo mientras no ha salido. *@
                @if (IsDraft)
                {
                    <MudSwitch T="bool" @bind-Value="_schedule" Label="Programar la publicación" Color="Color.Primary"
                               Class="mt-3" data-testid="schedule-switch" />
                    @if (_schedule)
                    {
                        <div class="d-flex flex-wrap" style="gap:0.75rem">
                            <MudDatePicker Label="Día" Date="_schedDate" DateChanged="d => _schedDate = d" MinDate="DateTime.Today" />
                            <MudTimePicker Label="Hora" Time="_schedTime" TimeChanged="t => _schedTime = t" />
                        </div>
                        <p class="gsm-editor__hint" data-testid="schedule-hint">
                            Sale en la hora indicada o unos minutos después, nunca antes. La audiencia se calcula en ese momento.
                        </p>
                    }
                }

                @if (IsDraft)
                {
                    <MudSelect T="int" Value="_category" ValueChanged="CategoryChangedAsync" Label="Tipo de anuncio" Class="mt-2"
                               HelperText="Las promociones solo les llegan por push y correo a quienes las aceptaron.">
                        <MudSelectItem T="int" Value="0">Novedades del gym</MudSelectItem>
                        <MudSelectItem T="int" Value="1">Promoción</MudSelectItem>
                    </MudSelect>
                    <MudSwitch T="bool" @bind-Value="_sendEmail" Label="Enviar también por email" Color="Color.Primary" />
                    @if (_sendEmail)
                    {
                        <p class="gsm-editor__hint">
                            @(_audience is { } n ? $"Se enviará a {n} {(n == 1 ? "miembro" : "miembros")} con email al publicar." : "Se enviará al publicar.")
                        </p>
                    }

                    @* Solo el Owner marca un anuncio como importante: se salta el horario sin avisos y las preferencias. *@
                    @* Una promoción nunca es importante: necesita la autorización previa del miembro (Ley 1581). *@
                    @if (_canMarkImportant && _category == 1)
                    {
                        <p class="gsm-editor__hint" data-testid="important-not-for-promotions">
                            Las promociones no pueden marcarse como importantes.
                        </p>
                    }
                    else if (_canMarkImportant)
                    {
                        <MudSwitch T="bool" @bind-Value="_important" Label="Anuncio importante" Color="Color.Error"
                                   Class="gsm-important-switch" />
                        @if (_important)
                        {
                            <p class="gsm-editor__hint gsm-important-hint" role="note">
                                Le llega a todos por push aunque tengan apagadas las novedades y aunque sea horario sin
                                avisos, y queda fijo arriba del feed hasta la fecha «Visible hasta». Úsalo solo para
                                cosas urgentes (un cierre, una emergencia). Quedará registrado que lo marcaste tú.
                            </p>
                        }
                    }
                }
                else if (Existing.SendEmail)
                {
                    <p class="gsm-editor__hint">Ya se envió por email: editar cambia lo que se ve en la app, pero no reenvía correos.</p>
                }

                @if (Existing is { Status: not "Draft" and not "Scheduled", Important: true })
                {
                    <p class="gsm-editor__hint">Este anuncio se publicó como importante: ya no se puede cambiar.</p>
                }
            </div>

            <aside class="gsm-editor__preview" aria-label="Vista previa en la app">
                <div class="gsm-eyebrow">Vista previa</div>
                <article class="gsm-feed-card">
                    <h3 class="gsm-feed-card__title">@(string.IsNullOrWhiteSpace(_title) ? "Título del anuncio" : _title)</h3>
                    <p class="gsm-feed-card__body">@(string.IsNullOrWhiteSpace(_body) ? "El texto aparecerá aquí." : _body)</p>
                    @if (_currentImageUrl is not null && _pendingImage is null)
                    {
                        <img class="gsm-announcement__image" src="@_currentImageUrl" alt="" />
                    }
                </article>
            </aside>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="() => SaveAsync(publish: false)" Disabled="_submitting">
            @(Existing is null || Existing.Status == "Draft" ? "Guardar borrador" : "Guardar cambios")
        </MudButton>
        @if (IsDraft)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => SaveAsync(publish: true)" Disabled="_submitting"
                       data-testid="primary-action">
                @(_schedule ? "Programar" : "Publicar")
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>Nulo = anuncio nuevo.</summary>
    [Parameter]
    public AnnouncementResponse? Existing { get; set; }

    private string _title = string.Empty;
    private string _body = string.Empty;
    private DateTime? _expires;
    private bool _pinned;
    private bool _sendEmail;
    private bool _important;
    private bool _canMarkImportant;
    private int? _audience;
    private AnnouncementAudienceDto _audienceFilter = new();
    private int _category;
    private string? _error;
    private bool _submitting;

    private bool IsNew => Existing is null;

    /// <summary>Borrador o programado: todavía no salió, así que audiencia, tipo y correo se pueden cambiar.</summary>
    private bool IsDraft => Existing is null || Existing.Status is "Draft" or "Scheduled";

    private bool _schedule;
    private DateTime? _schedDate;
    private TimeSpan? _schedTime;
    private IBrowserFile? _pendingImage;
    private string? _currentImageUrl;
    private bool _removeImage;

    protected override async Task OnInitializedAsync()
    {
        if (Existing is { } a)
        {
            _title = a.Title;
            _body = a.Body;
            _expires = a.ExpiresOn?.ToDateTime(TimeOnly.MinValue);
            _pinned = a.Pinned;
            _sendEmail = a.SendEmail;
            _category = a.Category == "Promotions" ? 1 : 0;
            _important = a.Important;
            _audienceFilter = a.Audience;
            _currentImageUrl = a.ImageUrl;
            if (a.Status == "Scheduled" && a.ScheduledFor is { } at)
            {
                var local = GsmFormat.GymLocal(at);
                _schedule = true;
                _schedDate = local.Date;
                _schedTime = local.TimeOfDay;
            }
        }

        // Solo el Owner (o un SuperAdmin impersonando) puede marcar el anuncio como importante, y solo en borrador.
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        _canMarkImportant = IsDraft
            && (user.IsInRole(GsmRoles.Owner) || (user.IsInRole(GsmRoles.SuperAdmin) && user.IsImpersonating()));

        await LoadAudienceAsync();
    }

    private async Task CategoryChangedAsync(int category)
    {
        _category = category;
        if (_category == 1)
        {
            _important = false;
        }

        await LoadAudienceAsync();
    }

    private async Task LoadAudienceAsync()
    {
        try
        {
            _audience = (await Announcements.EmailAudienceAsync(_category)).Recipients;
        }
        catch (GsmApiException)
        {
            _audience = null;
        }
    }

    private async Task SaveAsync(bool publish)
    {
        _error = null;
        if (_title.Trim().Length < 3 || string.IsNullOrWhiteSpace(_body))
        {
            _error = "El título necesita al menos 3 caracteres y el texto no puede estar vacío.";
            return;
        }

        DateTimeOffset? scheduledFor = null;
        if (_schedule)
        {
            if (_schedDate is null || _schedTime is null)
            {
                _error = "Elige el día y la hora de publicación.";
                return;
            }

            scheduledFor = GsmFormat.GymInstant(DateOnly.FromDateTime(_schedDate.Value), _schedTime.Value);
            if (scheduledFor <= DateTimeOffset.UtcNow)
            {
                _error = "La hora de publicación debe ser futura.";
                return;
            }
        }

        if (publish && !await AnnouncementActions.ConfirmPublishAsync(Dialogs, Announcements, _sendEmail))
        {
            return;
        }

        _submitting = true;
        try
        {
            var expires = _expires is { } e ? DateOnly.FromDateTime(e) : (DateOnly?)null;
            Guid id;
            if (Existing is null)
            {
                id = (await Announcements.AnnouncementsPOSTAsync(new CreateAnnouncementRequest
                {
                    Title = _title, Body = _body, Pinned = _pinned, ExpiresOn = expires, SendEmail = _sendEmail, Category = _category,
                    Important = _canMarkImportant && _important,
                    Audience = _audienceFilter,
                })).Id;
            }
            else
            {
                id = Existing.Id;
                await Announcements.AnnouncementsPUTAsync(id, new UpdateAnnouncementRequest
                {
                    Title = _title, Body = _body, ExpiresOn = expires, SendEmail = _sendEmail, Category = _category,
                    Important = _canMarkImportant ? _important : null,
                    Audience = IsDraft ? _audienceFilter : null,
                });
            }

            await SyncImageAsync(id);

            // Programar: el botón principal, o guardar un anuncio que ya estaba programado (mantiene la hora).
            var wasScheduled = Existing?.Status == "Scheduled";
            if (scheduledFor is { } sched && (publish || wasScheduled))
            {
                await Announcements.ScheduleAnnouncementAsync(id, new ScheduleAnnouncementRequest { ScheduledFor = sched });
            }
            else if (wasScheduled && !_schedule && !publish)
            {
                await Announcements.UnscheduleAsync(id);
            }
            else if (publish)
            {
                await Announcements.PublishAsync(id);
            }

            var message = publish
                ? (scheduledFor is null ? "Anuncio publicado." : "Anuncio programado.")
                : IsNew ? "Borrador guardado." : "Cambios guardados.";
            MudDialog.Close(DialogResult.Ok(message));
        }
        catch (GsmApiException ex) when (ex.StatusCode == 500 && _pendingImage is not null)
        {
            // El anuncio ya quedó guardado; solo falló la subida (R2 sin configurar, ver CLAUDE.md).
            _error = "El anuncio se guardó, pero las imágenes no están disponibles todavía: falta configurar el almacenamiento.";
        }
        catch (GsmApiException ex)
        {
            _error = ApiError.FromException(ex).DisplayMessage;
        }
        finally
        {
            _submitting = false;
        }
    }

    private void OnImageChosen(IBrowserFile file)
    {
        _pendingImage = file;
        _removeImage = false;
    }

    private void RemoveImage()
    {
        _pendingImage = null;
        if (_currentImageUrl is not null)
        {
            _removeImage = true;
            _currentImageUrl = null;
        }
    }

    /// <summary>Sube la imagen elegida o quita la actual, ya con el anuncio guardado.</summary>
    private async Task SyncImageAsync(Guid id)
    {
        if (_pendingImage is { } file)
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            await Announcements.ImagePOSTAsync(id, new FileParameter(stream, file.Name, file.ContentType));
            _pendingImage = null;
        }
        else if (_removeImage)
        {
            await Announcements.ImageDELETEAsync(id);
            _removeImage = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}

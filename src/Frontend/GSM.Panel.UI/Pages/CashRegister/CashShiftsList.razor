@inject ICashShiftsClient CashShifts
@inject IStaffClient Staff
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

@* Lista de turnos con sus diferencias, filtrable por persona y fecha (Payments v2 §4.4, vista del Owner).
   Una persona con diferencias repetidas salta a la vista: la diferencia sale en rojo. *@
<ServerTable @ref="_table" TItem="CashShiftResponse" Load="LoadAsync">
    <ToolBarContent>
        <MudDatePicker Label="Desde" Date="_from" DateChanged="OnFromChangedAsync" Class="mr-4" Style="max-width:180px" />
        <MudDatePicker Label="Hasta" Date="_to" DateChanged="OnToChangedAsync" Class="mr-4" Style="max-width:180px" />
        @if (_people.Count > 0)
        {
            <MudSelect T="string" Value="_person" ValueChanged="OnPersonChangedAsync" Label="Persona" Style="max-width:220px">
                <MudSelectItem Value="@FilterValues.All">Todas</MudSelectItem>
                @foreach (var person in _people)
                {
                    <MudSelectItem Value="@person.Id.ToString()">@person.FullName</MudSelectItem>
                }
            </MudSelect>
        }
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Abierto</MudTh>
        <MudTh>Quién</MudTh>
        <MudTh>Esperado</MudTh>
        <MudTh>Contado</MudTh>
        <MudTh>Diferencia</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Abierto">@GsmFormat.Instant(context.OpenedAt)</MudTd>
        <MudTd DataLabel="Quién">@context.OpenedByName</MudTd>
        <MudTd DataLabel="Esperado" Class="gsm-mono">@Money(context.ExpectedCash)</MudTd>
        <MudTd DataLabel="Contado" Class="gsm-mono">@Money(context.CountedCash)</MudTd>
        <MudTd DataLabel="Diferencia">@DifferenceCell(context)</MudTd>
        <MudTd>
            <MudButton Size="Size.Small" Variant="Variant.Text" data-testid="open-shift-report"
                       OnClick="@(() => Navigation.NavigateTo($"/cash-shifts/{context.Id}"))">Reporte</MudButton>
        </MudTd>
    </RowTemplate>
    <CardTemplate>
        <div class="gsm-card__row">
            <span class="gsm-card__title">@context.OpenedByName</span>
            @DifferenceCell(context)
        </div>
        <div class="gsm-card__meta">@GsmFormat.Instant(context.OpenedAt) · esperado @Money(context.ExpectedCash)</div>
        <div class="gsm-card__actions">
            <MudButton Size="Size.Small" Variant="Variant.Text"
                       OnClick="@(() => Navigation.NavigateTo($"/cash-shifts/{context.Id}"))">Reporte</MudButton>
        </div>
    </CardTemplate>
</ServerTable>

@code {
    private ServerTable<CashShiftResponse> _table = null!;
    private DateTime? _from;
    private DateTime? _to;
    private string _person = FilterValues.All;
    private List<StaffResponse> _people = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // La lista de equipo es del Owner; a quien solo tiene "ver finanzas" se le oculta el filtro por persona.
            _people = (await Staff.StaffAllAsync())?.ToList() ?? [];
        }
        catch (GsmApiException)
        {
            _people = [];
        }
    }

    public Task RefreshAsync() => _table is null ? Task.CompletedTask : _table.RefreshAsync();

    private static string Money(double? value) => value is { } v ? GsmFormat.Money((decimal)v) : "—";

    private static RenderFragment DifferenceCell(CashShiftResponse shift) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", "gsm-mono");
        if (shift.Difference is { } difference && difference != 0)
        {
            builder.AddAttribute(2, "style", "color:var(--mud-palette-error)");
            builder.AddAttribute(3, "data-testid", "shift-difference");
        }

        builder.AddContent(4, shift.IsOpen ? (shift.IsStale ? "ABIERTA +16 h" : "ABIERTA") : GsmFormat.Money((decimal)(shift.Difference ?? 0)));
        builder.CloseElement();
    };

    private async Task<ServerTablePage<CashShiftResponse>> LoadAsync(int page, int pageSize, CancellationToken cancellationToken)
    {
        try
        {
            var result = await CashShifts.CashShiftsAsync(
                _from is { } f ? DateOnly.FromDateTime(f) : null,
                _to is { } t ? DateOnly.FromDateTime(t) : null,
                FilterValues.IsAll(_person) ? null : Guid.Parse(_person),
                page, pageSize, cancellationToken);
            return new ServerTablePage<CashShiftResponse>(result.Items.ToList(), result.Total);
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
            return new ServerTablePage<CashShiftResponse>([], 0);
        }
    }

    private async Task OnFromChangedAsync(DateTime? value)
    {
        _from = value;
        await _table.RefreshAsync();
    }

    private async Task OnToChangedAsync(DateTime? value)
    {
        _to = value;
        await _table.RefreshAsync();
    }

    private async Task OnPersonChangedAsync(string value)
    {
        _person = value;
        await _table.RefreshAsync();
    }
}

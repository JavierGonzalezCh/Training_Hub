@inject IClassesClient Classes
@inject IEquipmentClient EquipmentApi

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
            }
            <MudForm @ref="_form" Model="_model">
                <MudTextField T="string" @bind-Value="_model.Name" Label="Nombre" Required="true" Class="mb-3" />
                <MudTextField T="string" @bind-Value="_model.Description" Label="Descripción" Class="mb-3" />
                <MudSelect T="string" Value="_instructorChoice" ValueChanged="v => _instructorChoice = v"
                           Label="Instructor" Class="mb-3" id="class-instructor">
                    <MudSelectItem Value="@NoInstructor">Sin instructor</MudSelectItem>
                    @foreach (var trainer in _trainers)
                    {
                        <MudSelectItem Value="@trainer.UserId.ToString()">@trainer.FullName@(trainer.IsOwner ? " (Owner)" : "")</MudSelectItem>
                    }
                    <MudSelectItem Value="@OtherInstructor">Otro...</MudSelectItem>
                </MudSelect>
                @if (_instructorChoice == OtherInstructor)
                {
                    <MudTextField T="string" @bind-Value="_model.InstructorName" Label="Nombre del instructor"
                                  Class="mb-3" id="class-instructor-other" MaxLength="120" />
                }
                <MudNumericField T="int?" @bind-Value="_model.Capacity" Label="Cupo (vacío = entrada libre)" Min="1" Class="mb-3" />

                @* C6: el cupo de cada sesión no pasa de las máquinas ligadas que estén disponibles ese día. Solo con cupo. *@
                @if (_model.Capacity is not null && _machines.Count > 0)
                {
                    <MudSelect T="Guid" MultiSelection="true" @bind-SelectedValues="_selectedMachines"
                               Label="Máquinas del cupo (opcional)" Class="mb-3" id="class-machines"
                               HelperText="El cupo de cada sesión no pasará de las máquinas disponibles ese día.">
                        @foreach (var machine in _machines)
                        {
                            <MudSelectItem Value="machine.Id">@MachineLabel(machine)</MudSelectItem>
                        }
                    </MudSelect>
                }

                <MudGrid Class="mb-3">
                    <MudItem xs="6">
                        <MudTimePicker Label="Hora de inicio" Time="_startTime" TimeChanged="t => _startTime = t" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudNumericField T="int" @bind-Value="_model.DurationMinutes" Label="Duración (min)" Min="1" />
                    </MudItem>
                </MudGrid>

                <MudSwitch T="bool" @bind-Value="_model.IsRecurring" Label="Clase recurrente" Color="Color.Primary" Class="mb-3" />

                @if (_model.IsRecurring)
                {
                    <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="_daysOfWeek" Label="Días de la semana" Required="true"
                               ToStringFunc="ClassLabels.DayLabel">
                        @foreach (var (value, label) in ClassLabels.DaysOfWeek)
                        {
                            <MudSelectItem Value="value">@label</MudSelectItem>
                        }
                    </MudSelect>
                    <MudDatePicker Label="Termina el (opcional)" Date="_endsOn" DateChanged="d => _endsOn = d"
                                   Clearable="true" Class="mt-3" id="class-ends-on"
                                   HelperText="Vacío = se repite hasta que des de baja la clase." />
                }
                else
                {
                    <MudDatePicker Label="Fecha" Date="_scheduledDate" DateChanged="d => _scheduledDate = d" Required="true" />
                }

                @* C8: solo al crear. Editar nunca avisa; si cambió la hora de una clase existente, el staff publica un anuncio. *@
                @if (ClassId is null)
                {
                    <MudSwitch T="bool" @bind-Value="_notifyMembers" Label="Avisar a los miembros" Color="Color.Primary"
                               Class="mt-3" id="class-notify-members" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        Publica «Nueva clase» en Novedades y manda un aviso. Desmárcalo si estás armando el horario y vas a avisar todo junto.
                    </MudText>
                }
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_loading || _submitting">
            @(_submitting ? "Guardando..." : "Guardar")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public Guid? ClassId { get; set; }

    private const string NoInstructor = "none";
    private const string OtherInstructor = "other";

    private readonly FormModel _model = new();
    private List<ClassInstructorOption> _trainers = [];
    private List<EquipmentItemResponse> _machines = [];
    private IEnumerable<Guid> _selectedMachines = [];
    private string _instructorChoice = NoInstructor;
    private IEnumerable<int> _daysOfWeek = [];
    private DateTime? _scheduledDate;
    private DateTime? _endsOn;
    private TimeSpan? _startTime = new(6, 0, 0);
    private MudForm _form = null!;
    private bool _notifyMembers = true;
    private bool _loading;
    private bool _submitting;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _trainers = (await Classes.TrainersAsync()).ToList();
        }
        catch (GsmApiException ex)
        {
            _error = ApiError.FromException(ex).DisplayMessage;
        }

        try
        {
            _machines = ((await EquipmentApi.ListEquipmentAsync()) ?? []).Where(m => m.IsActive).ToList();
        }
        catch (GsmApiException)
        {
            _machines = []; // sin inventario legible la clase se guarda sin máquinas; no estorba el resto del formulario
        }

        if (ClassId is not { } id)
        {
            return;
        }

        _loading = true;
        try
        {
            var gymClass = await Classes.ClassesGETAsync(id);
            _model.Name = gymClass.Name;
            _model.Description = gymClass.Description;
            _model.InstructorName = gymClass.InstructorName;
            if (gymClass.InstructorUserId is { } instructorId)
            {
                // Si ya no es entrenador activo no está en la lista: se agrega para no perder la selección.
                if (_trainers.All(t => t.UserId != instructorId))
                {
                    _trainers.Add(new ClassInstructorOption
                    {
                        UserId = instructorId,
                        FullName = $"{gymClass.InstructorName} (sin entrenador activo)",
                    });
                }

                _instructorChoice = instructorId.ToString();
            }
            else
            {
                _instructorChoice = string.IsNullOrWhiteSpace(gymClass.InstructorName) ? NoInstructor : OtherInstructor;
            }

            _model.Capacity = gymClass.Capacity;
            _model.DurationMinutes = gymClass.DurationMinutes;
            _model.IsRecurring = gymClass.IsRecurring;
            _startTime = gymClass.StartTime.ToTimeSpan();
            _daysOfWeek = gymClass.DaysOfWeek.Select(ClassLabels.ToValue).ToList();
            _scheduledDate = gymClass.ScheduledDate?.ToDateTime(TimeOnly.MinValue);
            _endsOn = gymClass.EndsOn?.ToDateTime(TimeOnly.MinValue);
            _selectedMachines = (gymClass.EquipmentItemIds ?? []).ToList();
        }
        catch (GsmApiException ex)
        {
            _error = ApiError.FromException(ex).DisplayMessage;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SubmitAsync()
    {
        _error = null;
        await _form.Validate();
        if (!_form.IsValid || _startTime is null)
        {
            return;
        }

        if (_model.IsRecurring && !_daysOfWeek.Any())
        {
            _error = "Elige al menos un día de la semana.";
            return;
        }

        if (!_model.IsRecurring && _scheduledDate is null)
        {
            _error = "Elige la fecha de la clase.";
            return;
        }

        var request = new SaveClassRequest
        {
            Name = _model.Name,
            Description = _model.Description,
            InstructorName = _instructorChoice == OtherInstructor ? _model.InstructorName : null,
            InstructorUserId = Guid.TryParse(_instructorChoice, out var instructorUserId) ? instructorUserId : null,
            Capacity = _model.Capacity,
            StartTime = TimeOnly.FromTimeSpan(_startTime.Value),
            DurationMinutes = _model.DurationMinutes,
            IsRecurring = _model.IsRecurring,
            DaysOfWeek = _model.IsRecurring ? _daysOfWeek.ToList() : null,
            ScheduledDate = _model.IsRecurring ? null : DateOnly.FromDateTime(_scheduledDate!.Value),
            EndsOn = _model.IsRecurring && _endsOn is { } endsOn ? DateOnly.FromDateTime(endsOn) : null,
            // Siempre se manda la lista: vacía (o sin cupo) quita las ligas que la clase tuviera.
            EquipmentItemIds = _model.Capacity is null
                ? []
                : _selectedMachines.Where(id => _machines.Any(m => m.Id == id)).ToList(),
            NotifyMembers = _notifyMembers,
        };

        _submitting = true;
        try
        {
            if (ClassId is { } id)
            {
                await Classes.ClassesPUTAsync(id, request);
            }
            else
            {
                await Classes.ClassesPOSTAsync(request);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (GsmApiException ex)
        {
            _error = ApiError.FromException(ex).DisplayMessage;
        }
        finally
        {
            _submitting = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private static string MachineLabel(EquipmentItemResponse m)
    {
        var units = m.Quantity > 1 ? $" ({m.Quantity})" : "";
        var state = m.Status switch
        {
            "Maintenance" => " · en mantenimiento",
            "OutOfService" => " · fuera de servicio",
            _ => "",
        };
        return $"{m.Name}{units}{state}";
    }

    private sealed class FormModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string? InstructorName { get; set; }
        public int? Capacity { get; set; }
        public int DurationMinutes { get; set; } = 60;
        public bool IsRecurring { get; set; } = true;
    }
}

@page "/classes"
@attribute [Authorize(Policy = GsmPolicies.RequireStaff)]
@inject IClassesClient Classes
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Clases — TrainingHub OS</PageTitle>

<PageHeader Title="Clases">
    <Actions>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.CalendarViewWeek"
                   OnClick="@(() => Navigation.NavigateTo("/classes/schedule"))">
            Horario semanal
        </MudButton>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.EventBusy" OnClick="OpenBlocksAsync" id="open-blocks">
            Penalizados
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateAsync">
            Nueva clase
        </MudButton>
    </Actions>
</PageHeader>

@if (_outsideHours.Count > 0)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4" id="outside-hours">
        <MudText Typo="Typo.subtitle2">Estas clases quedaron fuera del horario del gym</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            Muévelas a un tramo en el que el gym esté abierto. Mientras tanto, esas fechas no se pueden reservar.
        </MudText>
        <ul style="margin:0; padding-left:1.25rem">
            @foreach (var item in _outsideHours)
            {
                <li>
                    <strong>@item.Name</strong> · @item.StartTime.ToString("HH:mm") · @item.DurationMinutes min ·
                    @(item.IsRecurring
                        ? string.Join(", ", item.DaysOutside.Select(ClassLabels.DayLabel))
                        : GsmFormat.Day(item.ScheduledDate!.Value))
                </li>
            }
        </ul>
    </MudAlert>
}

@if (_loading)
{
    <GsmLoader />
}
else if (_classes.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Outlined.EventNote" Title="No hay clases todavía">
        <ChildContent>Crea la primera para que los miembros puedan reservar desde la app.</ChildContent>
        <Action>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateAsync">Nueva clase</MudButton>
        </Action>
    </EmptyState>
}
else
{
    @* En el celular cada clase se apila en una tarjeta con sus rótulos (el mismo patrón que Equipos): siete
       columnas no caben y el Owner gestiona desde el teléfono. *@
    <MudTable Items="_classes" Hover="true" Dense="true" Elevation="0" Breakpoint="Breakpoint.Sm" Class="gsm-table--stack"
              data-testid="classes-table">
        <HeaderContent>
            <MudTh>Nombre</MudTh>
            <MudTh>Instructor</MudTh>
            <MudTh>Cuándo</MudTh>
            <MudTh>Hora</MudTh>
            <MudTh>Cupo</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nombre">@context.Name</MudTd>
            <MudTd DataLabel="Instructor">
                @(context.InstructorName ?? "—")
                @if (context.NoActiveInstructor)
                {
                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Text" Size="Size.Small" Class="gsm-mono no-active-instructor-chip">SIN ENTRENADOR ACTIVO</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Cuándo">
                @(context.IsRecurring
                    ? string.Join(", ", context.DaysOfWeek.Select(ClassLabels.DayLabel))
                    : GsmFormat.Day(context.ScheduledDate!.Value))
                @if (context.IsRecurring && context.EndsOn is { } endsOn)
                {
                    <div class="gsm-class-ends-on"><MudText Typo="Typo.caption" Color="Color.Secondary">hasta @GsmFormat.Day(endsOn)</MudText></div>
                }
            </MudTd>
            <MudTd DataLabel="Hora">@context.StartTime.ToString("HH:mm") · @context.DurationMinutes min</MudTd>
            <MudTd DataLabel="Cupo">@(context.Capacity?.ToString() ?? "Libre")</MudTd>
            <MudTd DataLabel="Estado">
                <MudChip T="string" Color="@(context.IsActive ? Color.Info : Color.Default)" Variant="Variant.Text" Size="Size.Small" Class="gsm-mono">
                    @(context.IsActive ? "ACTIVA" : "INACTIVA")
                </MudChip>
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEditAsync(context))"
                               aria-label="@($"Editar {context.Name}")" title="Editar" />
                @if (context.IsActive)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeactivateAsync(context))"
                                   aria-label="@($"Desactivar {context.Name}")" title="Desactivar" />
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<ClassListItem> _classes = [];
    private List<ClassOutsideHoursItem> _outsideHours = [];
    private bool _loading = true;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await Classes.ClassesAllAsync(includeInactive: true);
            _classes = result?.ToList() ?? [];
            _outsideHours = (await Classes.OutsideHoursAsync())?.ToList() ?? [];
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenBlocksAsync()
        => await Dialogs.ShowAsync<BookingBlocksDialog>("Penalizados por inasistencia");

    private async Task OpenCreateAsync()
    {
        var dialog = await Dialogs.ShowAsync<ClassFormDialog>("Nueva clase");
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Clase creada.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task OpenEditAsync(ClassListItem item)
    {
        var parameters = new DialogParameters<ClassFormDialog> { { x => x.ClassId, item.Id } };
        var dialog = await Dialogs.ShowAsync<ClassFormDialog>("Editar clase", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Clase actualizada.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task DeactivateAsync(ClassListItem item)
    {
        var confirmed = await Dialogs.ShowMessageBox(
            "Desactivar clase", $"¿Desactivar \"{item.Name}\"?", yesText: "Desactivar", cancelText: "Cancelar");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Classes.ClassesDELETEAsync(item.Id);
            Snackbar.Add("Clase desactivada.", Severity.Success);
            await LoadAsync();
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
    }
}

@inject IEquipmentClient Equipment

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            @Name — ahora: @EquipmentDisplay.StatusLabel(CurrentStatus)
        </MudText>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" data-testid="status-error">@_error</MudAlert>
        }
        <div class="d-flex flex-wrap mb-3" style="gap:1rem">
            <label class="gsm-native-field">
                <span>Nuevo estado</span>
                <select data-testid="status-select" @onchange="OnStatusChanged">
                    @foreach (var (value, name, label) in EquipmentDisplay.Statuses)
                    {
                        if (name == CurrentStatus)
                        {
                            // Fuera de servicio, repetir el estado sirve para mover la fecha de regreso.
                            if (value != 0)
                            {
                                <option value="@value" selected="@(_status == value)">@label — actualizar fecha de regreso</option>
                            }
                            continue;
                        }
                        <option value="@value" selected="@(_status == value)">@label</option>
                    }
                </select>
            </label>
            @if (_status != 0)
            {
                <label class="gsm-native-field">
                    <span>Regresa el (opcional)</span>
                    <input type="date" data-testid="status-back-on" min="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")"
                           value="@(_expectedBackOn?.ToString("yyyy-MM-dd"))"
                           @onchange="@(e => _expectedBackOn = DateOnly.TryParse(e.Value?.ToString(), out var d) ? d : null)" />
                </label>
            }
        </div>
        <MudTextField T="string" @bind-Value="_reason" Label="@(_status == 0 ? "Motivo (opcional)" : "Motivo (obligatorio)")"
                      Lines="2" MaxLength="500" Immediate="true" data-testid="status-reason" />
        @if (_status == 0 && _openIssues > 0)
        {
            <MudCheckBox T="bool" @bind-Value="_closeOpenIssues" Color="Color.Primary" Class="mt-2"
                         Label="@CloseIssuesLabel" data-testid="status-close-issues" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_submitting"
                   data-testid="status-save">
            @(_submitting ? "Guardando..." : "Cambiar estado")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired]
    public Guid EquipmentId { get; set; }

    [Parameter]
    public string Name { get; set; } = string.Empty;

    /// <summary>Estado actual (nombre del enum, como lo devuelve la API).</summary>
    [Parameter]
    public string CurrentStatus { get; set; } = "Available";

    private int _status;
    /// <summary>E4-3: reportes sin cerrar de la máquina; si hay y se deja disponible, se ofrece cerrarlos en el mismo paso.</summary>
    private int _openIssues;
    private bool _closeOpenIssues = true;
    private string? _reason;
    private DateOnly? _expectedBackOn;
    private bool _submitting;
    private string? _error;

    private string CloseIssuesLabel => _openIssues == 1
        ? "Cerrar también el reporte abierto"
        : $"Cerrar también los {_openIssues} reportes abiertos";

    protected override async Task OnInitializedAsync()
    {
        _status = EquipmentDisplay.Statuses.First(s => s.Name != CurrentStatus).Value;
        if (CurrentStatus == "Available")
        {
            return; // ya está disponible: el cambio posible no es «dejarla disponible»
        }

        try
        {
            _openIssues = (await Equipment.ListEquipmentIssuesAsync(null, EquipmentId, true))?.Count ?? 0;
        }
        catch (GsmApiException)
        {
            _openIssues = 0; // la casilla es un atajo: sin ella el cambio de estado sigue funcionando
        }
    }

    private void OnStatusChanged(ChangeEventArgs e)
    {
        _status = int.TryParse(e.Value?.ToString(), out var n) ? n : _status;
        if (_status == 0)
        {
            _expectedBackOn = null;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        _error = null;
        if (_status != 0 && string.IsNullOrWhiteSpace(_reason))
        {
            _error = "Indica el motivo para sacar el equipo de servicio.";
            return;
        }

        if (EquipmentDisplay.Statuses.First(s => s.Value == _status).Name == CurrentStatus && _expectedBackOn is null)
        {
            _error = "Para actualizar el arreglo, indica la nueva fecha de regreso.";
            return;
        }

        _submitting = true;
        try
        {
            await Equipment.ChangeEquipmentStatusAsync(EquipmentId, new ChangeEquipmentStatusRequest
            {
                Status = _status,
                Reason = string.IsNullOrWhiteSpace(_reason) ? null : _reason.Trim(),
                ExpectedBackOn = _status == 0 ? null : _expectedBackOn,
                CloseOpenIssues = _status == 0 && _openIssues > 0 && _closeOpenIssues,
            });
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (GsmApiException ex)
        {
            _error = ApiError.FromException(ex).DisplayMessage;
        }
        finally
        {
            _submitting = false;
        }
    }
}

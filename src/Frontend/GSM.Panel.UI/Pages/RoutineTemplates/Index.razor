@page "/routine-templates"
@attribute [Authorize(Policy = GsmPolicies.RequireStaff)]
@inject IRoutineTemplatesClient Templates
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Plantillas de rutina — TrainingHub OS</PageTitle>

<PageHeader Title="Plantillas de rutina">
    <Subtitle>
        Rutinas listas para reutilizar. Al asignar una a un miembro se copia: editar o borrar la plantilla después no cambia las rutinas ya asignadas.
    </Subtitle>
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="@(() => Navigation.NavigateTo("/routine-templates/new"))" data-testid="template-new">
            Nueva plantilla
        </MudButton>
    </Actions>
</PageHeader>

@if (_loading)
{
    <GsmLoader />
}
else if (_items.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Outlined.ContentCopy" Title="Todavía no hay plantillas" TestId="templates-empty">
        <ChildContent>Crea una, o guarda como plantilla una rutina ya armada desde su editor.</ChildContent>
        <Action>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="/routine-templates/new">Nueva plantilla</MudButton>
        </Action>
    </EmptyState>
}
else
{
    <div class="gsm-template-grid" data-testid="templates-table">
        @foreach (var item in _items)
        {
            var missing = item.UnavailableHere ?? [];
            <MudPaper Outlined="true" Elevation="0" Class="gsm-template-card" data-testid="@($"template-card-{item.Id}")">
                <a href="@($"/routine-templates/{item.Id}")" class="gsm-template-cover"
                   style="@CoverStyle(item)" aria-label="@item.Name"></a>
                <div class="pa-3 d-flex flex-column gap-1" style="flex:1">
                    <div class="d-flex align-center gap-2 flex-wrap">
                        <MudLink Href="@($"/routine-templates/{item.Id}")" Underline="Underline.None" Typo="Typo.subtitle1">
                            <b>@item.Name</b>
                        </MudLink>
                        @if (item.BaseKey is not null)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">Base</MudChip>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(item.Description))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Description</MudText>
                    }
                    <MudText Typo="Typo.caption">
                        @(item.ScheduleMode == "weekly" ? "Semanal" : "Rotativo") · @item.DayCount @(item.DayCount == 1 ? "día" : "días") · @item.ExerciseCount ejercicios
                    </MudText>
                    @if (missing.Count > 0)
                    {
                        <div class="d-flex align-center gap-1">
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined"
                                     Icon="@Icons.Material.Outlined.WarningAmber" Class="ma-0"
                                     data-testid="@($"template-missing-{item.Id}")">
                                Faltan máquinas (@missing.Count)
                            </MudChip>
                            <InfoTip Text="@($"Este gym no puede hacer: {string.Join(", ", missing)}. Revisa la plantilla antes de usarla.")"
                                     TestId="@($"template-missing-info-{item.Id}")" />
                        </div>
                    }
                    <div class="d-flex gap-2 mt-auto pt-2">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => Edit(item))"
                                   data-testid="@($"template-edit-{item.Id}")">Editar</MudButton>
                        @if (_canDelete)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Disabled="_busy.Contains(item.Id)"
                                       OnClick="@(() => DeleteAsync(item))" data-testid="@($"template-delete-{item.Id}")">Eliminar</MudButton>
                        }
                    </div>
                </div>
            </MudPaper>
        }
    </div>
}

@code {
    private readonly HashSet<Guid> _busy = [];
    private List<RoutineTemplateListItem> _items = [];
    private bool _loading = true;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    /// <summary>R11-1: borrar una plantilla es del Owner y del staff con el permiso Trainer; crear y editar, de cualquiera.</summary>
    private bool _canDelete;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is not null)
        {
            _canDelete = (await AuthenticationState).User.HasPermission(GsmPermissions.Trainer);
        }

        await LoadAsync();
    }

    /// <summary>Portada de la plantilla; sin imagen, el degradado de la marca.</summary>
    private static string CoverStyle(RoutineTemplateListItem item)
        => string.IsNullOrWhiteSpace(item.ImageUrl)
            ? "background: linear-gradient(135deg, #B50016, #140306);"
            : $"background-image: url('{item.ImageUrl}');";

    private void Edit(RoutineTemplateListItem item) => Navigation.NavigateTo($"/routine-templates/{item.Id}");

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items = (await Templates.ListRoutineTemplatesAsync()).ToList();
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DeleteAsync(RoutineTemplateListItem item)
    {
        var confirmed = await Dialogs.ShowMessageBox(
            "Eliminar plantilla",
            $"¿Eliminar «{item.Name}»? Las rutinas que ya se asignaron con ella no cambian.",
            yesText: "Eliminar", cancelText: "Cancelar");
        if (confirmed != true)
        {
            return;
        }

        _busy.Add(item.Id);
        try
        {
            await Templates.DeleteRoutineTemplateAsync(item.Id);
            Snackbar.Add("Plantilla eliminada.", Severity.Success);
            await LoadAsync();
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            _busy.Remove(item.Id);
        }
    }
}

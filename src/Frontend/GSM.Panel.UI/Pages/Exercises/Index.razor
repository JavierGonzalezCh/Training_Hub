@page "/exercises"
@attribute [Authorize(Policy = GsmPolicies.RequireStaff)]
@inject IExercisesClient Exercises
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Ejercicios — TrainingHub OS</PageTitle>

<PageHeader Title="Catálogo de ejercicios">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateAsync">
            Nuevo ejercicio
        </MudButton>
    </Actions>
</PageHeader>

@* En el celular, el buscador y un botón "Filtros"; los siete filtros se abren a pedido. Antes ocupaban la
   pantalla entera y el primer ejercicio aparecía al fondo. En escritorio se ven siempre. *@
<div class="d-flex flex-wrap align-end mb-4" style="gap:1rem">
    <MudTextField T="string" Value="_search" ValueChanged="OnSearchChangedAsync" Label="Buscar ejercicio" Placeholder="Nombre"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                  DebounceInterval="400" Style="max-width:260px" aria-label="Buscar ejercicio" />
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FilterList" Class="gsm-filters-toggle"
               OnClick="@(() => _filtersOpen = !_filtersOpen)" aria-expanded="@(_filtersOpen ? "true" : "false")"
               aria-controls="exercise-filters" data-testid="filters-toggle">
        @(ActiveFilters > 0 ? $"Filtros ({ActiveFilters})" : "Filtros")
    </MudButton>
</div>

<div id="exercise-filters" class="@($"gsm-filters d-flex flex-wrap align-end mb-4 {(_filtersOpen ? "is-open" : null)}")" style="gap:1rem">
    @* Filtro en dos pasos: primero la zona del cuerpo, después solo los músculos de esa zona. *@
    <label class="gsm-native-field">
        <span>Zona</span>
        <select data-testid="filter-group" @onchange="OnGroupChangedAsync">
            <option value="@FilterValues.All" selected="@FilterValues.IsAll(_group)">Todas</option>
            @foreach (var (value, label) in RoutineLabels.MuscleGroups)
            {
                <option value="@value" selected="@(_group == value.ToString())">@label</option>
            }
        </select>
    </label>
    <label class="gsm-native-field">
        <span>Músculo</span>
        <select data-testid="filter-muscle" disabled="@FilterValues.IsAll(_group)" @onchange="OnMuscleChangedAsync">
            <option value="@FilterValues.All" selected="@FilterValues.IsAll(_muscle)">Todos</option>
            @if (!FilterValues.IsAll(_group))
            {
                @foreach (var (value, label) in RoutineLabels.MusclesOfGroup(int.Parse(_group)))
                {
                    <option value="@value" selected="@(_muscle == value.ToString())">@label</option>
                }
            }
        </select>
    </label>
    <label class="gsm-native-field">
        <span>Tipo</span>
        <select data-testid="filter-type" @onchange="OnTypeChangedAsync">
            <option value="@FilterValues.All" selected="@FilterValues.IsAll(_type)">Todos</option>
            @foreach (var (value, label) in RoutineLabels.ExerciseTypes)
            {
                <option value="@value" selected="@(_type == value.ToString())">@label</option>
            }
        </select>
    </label>
    <label class="gsm-native-field">
        <span>Nivel</span>
        <select data-testid="filter-difficulty" @onchange="OnDifficultyChangedAsync">
            <option value="@FilterValues.All" selected="@FilterValues.IsAll(_difficulty)">Todos</option>
            @foreach (var (value, label) in RoutineLabels.Difficulties)
            {
                <option value="@value" selected="@(_difficulty == value.ToString())">@label</option>
            }
        </select>
    </label>
    <label class="gsm-native-field">
        <span>Equipo</span>
        <select data-testid="filter-equipment" @onchange="OnEquipmentChangedAsync">
            <option value="@FilterValues.All" selected="@FilterValues.IsAll(_equipment)">Todos</option>
            @foreach (var (value, label) in RoutineLabels.Equipment)
            {
                <option value="@value" selected="@(_equipment == value.ToString())">@label</option>
            }
        </select>
    </label>
    @* Nivel 1 (Equipment E3): con inventario, por defecto solo lo que el gym puede hacer hoy. Sin inventario no filtra nada. *@
    <label class="d-flex align-center" style="gap:.5rem">
        <input type="checkbox" data-testid="filter-here" checked="@_onlyHere"
               @onchange="@(e => OnOnlyHereChangedAsync(e.Value is true))" />
        <span>Solo lo que se puede hacer en mi gym</span>
    </label>
    <label class="d-flex align-center" style="gap:.5rem">
        <input type="checkbox" data-testid="filter-hidden" checked="@_showHidden"
               @onchange="@(e => OnShowHiddenChangedAsync(e.Value is true))" />
        <span>Mostrar ocultos</span>
    </label>
</div>

@if (_loading)
{
    <GsmLoader />
}
else if (_exercises.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Outlined.SearchOff" Title="Sin resultados">
        Ningún ejercicio coincide con la búsqueda o los filtros. Prueba con otro nombre o quita un filtro.
    </EmptyState>
}
else
{
    <MudTable Items="_exercises" Hover="true" Dense="true" Elevation="0" Breakpoint="Breakpoint.Sm" Class="gsm-table--stack" data-testid="stack-table">
        <HeaderContent>
            <MudTh>Nombre</MudTh>
            <MudTh>Músculo</MudTh>
            <MudTh>Tipo</MudTh>
            <MudTh>Nivel</MudTh>
            <MudTh>Equipo</MudTh>
            <MudTh>Origen</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nombre">
                <span style="@(context.IsHidden ? "opacity:.55" : null)">@context.Name</span>
                @if (context.IsUnilateral)
                {
                    <MudChip T="string" Variant="Variant.Text" Size="Size.Small" Class="gsm-mono ml-2">POR LADO</MudChip>
                }
                @if (context.IsHidden)
                {
                    <MudChip T="string" Variant="Variant.Text" Size="Size.Small" Class="gsm-mono ml-2" Color="Color.Warning">OCULTO</MudChip>
                }
                @if (context.IsAvailableHere == false)
                {
                    <MudChip T="string" Variant="Variant.Text" Size="Size.Small" Class="gsm-mono ml-2" Color="Color.Error" data-testid="not-available-chip">NO SE PUEDE HOY</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Músculo">
                @RoutineLabels.MuscleLabel(context.PrimaryMuscle)
                <MudChip T="string" Variant="Variant.Text" Size="Size.Small" Class="ml-2" data-testid="group-chip">
                    @RoutineLabels.MuscleGroupLabel(context.MuscleGroup)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Tipo">
                @RoutineLabels.ExerciseTypeLabel(context.ExerciseType)
                <MudText Typo="Typo.caption" Color="Color.Secondary">@RoutineLabels.TrackingTypeLabel(context.TrackingType)</MudText>
            </MudTd>
            <MudTd DataLabel="Nivel">@RoutineLabels.DifficultyLabel(context.Difficulty)</MudTd>
            <MudTd DataLabel="Equipo">
                @string.Join(", ", context.Equipment.Select(RoutineLabels.EquipmentLabel))
                @if (context.Machines is { Count: > 0 } machines)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" data-testid="machines">@string.Join(", ", machines.Select(m => m.Name))</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Origen">
                <MudChip T="string" Color="@(context.IsSystem ? Color.Default : Color.Info)" Variant="Variant.Text" Size="Size.Small" Class="gsm-mono">
                    @(context.IsSystem ? "SISTEMA" : "GYM")
                </MudChip>
            </MudTd>
            <MudTd>
                @if (!context.IsSystem)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => OpenEditAsync(context))" title="Editar" />
                }
                <MudIconButton Icon="@Icons.Material.Filled.PrecisionManufacturing" Size="Size.Small" OnClick="@(() => OpenEquipmentAsync(context))" title="Máquinas" data-testid="@($"machines-{context.Id}")" />
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" OnClick="@(() => OpenDuplicateAsync(context))" title="Duplicar" />
                @if (context.IsSystem)
                {
                    @if (context.IsHidden)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" OnClick="@(() => ShowAsync(context))" title="Mostrar" />
                    }
                    else
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.VisibilityOff" Size="Size.Small" OnClick="@(() => HideAsync(context))" title="Ocultar" />
                    }
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<ExerciseResponse> _exercises = [];
    private bool _loading = true;
    private string _search = string.Empty;
    private string _group = FilterValues.All;
    private string _muscle = FilterValues.All;
    private string _type = FilterValues.All;
    private string _difficulty = FilterValues.All;
    private string _equipment = FilterValues.All;
    private bool _showHidden;
    private bool _onlyHere = true;
    private bool _filtersOpen;

    /// <summary>Filtros distintos de los de entrada, para el rótulo "Filtros (n)" del celular.</summary>
    private int ActiveFilters =>
        new[] { _group, _muscle, _type, _difficulty, _equipment }.Count(f => !FilterValues.IsAll(f))
        + (_showHidden ? 1 : 0) + (_onlyHere ? 0 : 1);

    protected override Task OnInitializedAsync() => LoadAsync();

    private static int? ToFilter(string value) => FilterValues.IsAll(value) ? null : int.Parse(value);

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await Exercises.ExercisesAllAsync(
                string.IsNullOrWhiteSpace(_search) ? null : _search,
                ToFilter(_muscle),
                ToFilter(_equipment),
                false,
                ToFilter(_group),
                ToFilter(_type),
                ToFilter(_difficulty),
                _showHidden,
                _onlyHere);
            _exercises = result.ToList();
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearchChangedAsync(string value)
    {
        _search = value;
        await LoadAsync();
    }

    private async Task OnGroupChangedAsync(ChangeEventArgs e)
    {
        _group = e.Value?.ToString() ?? FilterValues.All;
        _muscle = FilterValues.All; // el músculo elegido puede no ser de la zona nueva
        await LoadAsync();
    }

    private async Task OnMuscleChangedAsync(ChangeEventArgs e)
    {
        _muscle = e.Value?.ToString() ?? FilterValues.All;
        await LoadAsync();
    }

    private async Task OnTypeChangedAsync(ChangeEventArgs e)
    {
        _type = e.Value?.ToString() ?? FilterValues.All;
        await LoadAsync();
    }

    private async Task OnDifficultyChangedAsync(ChangeEventArgs e)
    {
        _difficulty = e.Value?.ToString() ?? FilterValues.All;
        await LoadAsync();
    }

    private async Task OnEquipmentChangedAsync(ChangeEventArgs e)
    {
        _equipment = e.Value?.ToString() ?? FilterValues.All;
        await LoadAsync();
    }

    private async Task OnShowHiddenChangedAsync(bool value)
    {
        _showHidden = value;
        await LoadAsync();
    }

    private async Task OnOnlyHereChangedAsync(bool value)
    {
        _onlyHere = value;
        await LoadAsync();
    }

    private async Task OpenEquipmentAsync(ExerciseResponse exercise)
    {
        var parameters = new DialogParameters<ExerciseEquipmentDialog>
        {
            { x => x.ExerciseId, exercise.Id },
            { x => x.ExerciseName, exercise.Name },
        };
        var dialog = await Dialogs.ShowAsync<ExerciseEquipmentDialog>("Máquinas del ejercicio", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Máquinas actualizadas.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task OpenCreateAsync()
    {
        var dialog = await Dialogs.ShowAsync<ExerciseFormDialog>("Nuevo ejercicio");
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Ejercicio creado.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task OpenEditAsync(ExerciseResponse exercise)
    {
        var parameters = new DialogParameters<ExerciseFormDialog> { { x => x.ExerciseId, exercise.Id } };
        var dialog = await Dialogs.ShowAsync<ExerciseFormDialog>("Editar ejercicio", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Ejercicio actualizado.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task OpenDuplicateAsync(ExerciseResponse exercise)
    {
        var parameters = new DialogParameters<DuplicateExerciseDialog>
        {
            { x => x.ExerciseId, exercise.Id },
            { x => x.ExerciseName, exercise.Name },
            { x => x.IsSystem, exercise.IsSystem },
        };
        var dialog = await Dialogs.ShowAsync<DuplicateExerciseDialog>("Duplicar ejercicio", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Ejercicio duplicado. Ya puedes editar tu copia.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task HideAsync(ExerciseResponse exercise)
    {
        try
        {
            await Exercises.HideAsync(exercise.Id);
            Snackbar.Add("Ejercicio oculto. Las rutinas que lo usan no cambian.", Severity.Success);
            await LoadAsync();
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
    }

    private async Task ShowAsync(ExerciseResponse exercise)
    {
        try
        {
            await Exercises.ShowAsync(exercise.Id);
            Snackbar.Add("Ejercicio visible de nuevo.", Severity.Success);
            await LoadAsync();
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
    }
}

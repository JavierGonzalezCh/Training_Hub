@inject IExercisesClient Exercises

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
            }
            <MudForm @ref="_form" Model="_model">
                <MudTextField T="string" @bind-Value="_model.Name" Label="Nombre" Required="true" Class="mb-3" />
                <MudTextField T="string" @bind-Value="_model.Description" Label="Descripción" Lines="2" Class="mb-3" />
                <div class="d-flex flex-wrap mb-3" style="gap:1rem">
                    <label class="gsm-native-field">
                        <span>Tipo de ejercicio</span>
                        <select data-testid="exercise-type" @onchange="OnTypeChanged">
                            @foreach (var (value, label) in RoutineLabels.ExerciseTypes)
                            {
                                <option value="@value" selected="@(_model.ExerciseType == value)">@label</option>
                            }
                        </select>
                    </label>
                    <label class="gsm-native-field">
                        <span>Qué se mide</span>
                        <select data-testid="tracking-type" @onchange="OnTrackingChanged">
                            @foreach (var (value, label) in RoutineLabels.TrackingTypes)
                            {
                                <option value="@value" selected="@(_model.TrackingType == value)">@label</option>
                            }
                        </select>
                    </label>
                    <label class="gsm-native-field">
                        <span>Nivel</span>
                        <select data-testid="difficulty" @onchange="@(e => _model.Difficulty = ToInt(e.Value, 1))">
                            @foreach (var (value, label) in RoutineLabels.Difficulties)
                            {
                                <option value="@value" selected="@(_model.Difficulty == value)">@label</option>
                            }
                        </select>
                    </label>
                </div>
                <MudSwitch T="bool" @bind-Value="_model.IsUnilateral" Color="Color.Primary" Class="mb-2"
                           Label="Se hace por lado (las repeticiones son por lado)" data-testid="unilateral" />
                <MudSelect T="int" @bind-Value="_model.PrimaryMuscle" Label="Músculo principal" Required="true" Class="mb-1"
                           HelperText="@GroupHelper">
                    @foreach (var (value, label) in RoutineLabels.Muscles)
                    {
                        <MudSelectItem Value="value">@label</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="_secondaryMuscles" Label="Músculos secundarios" Class="mb-3 mt-3">
                    @foreach (var (value, label) in RoutineLabels.Muscles)
                    {
                        <MudSelectItem Value="value">@label</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="int" MultiSelection="true" @bind-SelectedValues="_equipment" Label="Equipo" Class="mb-3">
                    @foreach (var (value, label) in RoutineLabels.Equipment)
                    {
                        <MudSelectItem Value="value">@label</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField T="string" @bind-Value="_model.VideoUrl" Label="Video (URL)" Class="mb-3" />
                <MudTextField T="string" @bind-Value="_model.ImageUrl" Label="Imagen (URL)" />
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_loading || _submitting">
            @(_submitting ? "Guardando..." : "Guardar")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public Guid? ExerciseId { get; set; }

    private readonly FormModel _model = new();
    private IEnumerable<int> _secondaryMuscles = [];
    private IEnumerable<int> _equipment = [];
    private MudForm _form = null!;
    private bool _loading;
    private bool _submitting;
    private string? _error;

    /// <summary>
    /// Una vez que la persona elige "qué se mide" a mano, cambiar el tipo ya no lo pisa. Al editar un ejercicio
    /// existente nunca se sobrescribe.
    /// </summary>
    private bool _trackingTouched;

    /// <summary>La zona del cuerpo se deriva del músculo principal; aquí solo se muestra.</summary>
    private string GroupHelper
    {
        get
        {
            var group = RoutineLabels.MuscleGroups
                .FirstOrDefault(g => RoutineLabels.MusclesOfGroup(g.Value).Any(m => m.Value == _model.PrimaryMuscle));
            return group.Label is null ? string.Empty : $"Zona: {group.Label}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (ExerciseId is not { } id)
        {
            return;
        }

        _loading = true;
        try
        {
            var exercise = await Exercises.ExercisesGETAsync(id);
            _model.Name = exercise.Name;
            _model.Description = exercise.Description;
            _model.PrimaryMuscle = RoutineLabels.MuscleValue(exercise.PrimaryMuscle);
            _secondaryMuscles = exercise.SecondaryMuscles.Select(RoutineLabels.MuscleValue).ToList();
            _equipment = exercise.Equipment.Select(ToEquipmentValue).ToList();
            _model.ExerciseType = RoutineLabels.ExerciseTypeValue(exercise.ExerciseType);
            _model.TrackingType = RoutineLabels.TrackingTypeValue(exercise.TrackingType);
            _model.Difficulty = RoutineLabels.DifficultyValue(exercise.Difficulty);
            _model.IsUnilateral = exercise.IsUnilateral;
            _trackingTouched = true;
            _model.VideoUrl = exercise.VideoUrl;
            _model.ImageUrl = exercise.ImageUrl;
        }
        catch (GsmApiException ex)
        {
            _error = ApiError.FromException(ex).DisplayMessage;
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnTypeChanged(ChangeEventArgs e)
    {
        _model.ExerciseType = ToInt(e.Value, 0);
        if (!_trackingTouched)
        {
            _model.TrackingType = RoutineLabels.SuggestedTracking(_model.ExerciseType);
        }
    }

    private void OnTrackingChanged(ChangeEventArgs e)
    {
        _model.TrackingType = ToInt(e.Value, 0);
        _trackingTouched = true;
    }

    private static int ToInt(object? value, int fallback) => int.TryParse(value?.ToString(), out var n) ? n : fallback;

    private static int ToEquipmentValue(string name) => name switch
    {
        "Barbell" => 0, "Dumbbell" => 1, "Kettlebell" => 2, "Machine" => 3, "Cable" => 4,
        "Smith_machine" => 5, "Bench" => 6, "Rack" => 7, "Resistance_band" => 8, "Trx" => 9,
        "Medicine_ball" => 10, "Mat" => 11, "Box" => 12, "Jump_rope" => 13, "Bodyweight" => 14,
        "Cardio_machine" => 15, _ => 0,
    };

    private async Task SubmitAsync()
    {
        _error = null;
        await _form.Validate();
        if (!_form.IsValid)
        {
            return;
        }

        _submitting = true;
        try
        {
            if (ExerciseId is { } id)
            {
                await Exercises.ExercisesPUTAsync(id, new UpdateExerciseRequest
                {
                    Name = _model.Name,
                    Description = _model.Description,
                    PrimaryMuscle = _model.PrimaryMuscle,
                    SecondaryMuscles = _secondaryMuscles.ToList(),
                    Equipment = _equipment.ToList(),
                    VideoUrl = _model.VideoUrl,
                    ImageUrl = _model.ImageUrl,
                    ExerciseType = _model.ExerciseType,
                    TrackingType = _model.TrackingType,
                    IsUnilateral = _model.IsUnilateral,
                    Difficulty = _model.Difficulty,
                });
            }
            else
            {
                await Exercises.ExercisesPOSTAsync(new CreateExerciseRequest
                {
                    Name = _model.Name,
                    Description = _model.Description,
                    PrimaryMuscle = _model.PrimaryMuscle,
                    SecondaryMuscles = _secondaryMuscles.ToList(),
                    Equipment = _equipment.ToList(),
                    VideoUrl = _model.VideoUrl,
                    ImageUrl = _model.ImageUrl,
                    ExerciseType = _model.ExerciseType,
                    TrackingType = _model.TrackingType,
                    IsUnilateral = _model.IsUnilateral,
                    Difficulty = _model.Difficulty,
                });
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (GsmApiException ex)
        {
            _error = ApiError.FromException(ex).DisplayMessage;
        }
        finally
        {
            _submitting = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    internal sealed class FormModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public int PrimaryMuscle { get; set; }
        public int ExerciseType { get; set; }
        public int TrackingType { get; set; }
        public int Difficulty { get; set; } = 1;
        public bool IsUnilateral { get; set; }
        public string? VideoUrl { get; set; }
        public string? ImageUrl { get; set; }
    }
}

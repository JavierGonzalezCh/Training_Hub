@page "/payments"
@attribute [Authorize(Policy = GsmPolicies.RequireStaff)]
@inject IPaymentsClient Payments
@inject IMembersClient Members
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Pagos — TrainingHub OS</PageTitle>

<PageHeader Title="Pagos">
    <Actions>
        <AuthorizeView Policy="@GsmPolicies.ForPermission(GsmPermissions.ViewFinances)">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PointOfSale"
                       OnClick="@(() => Navigation.NavigateTo("/cash-register"))">
                Cierre de caja
            </MudButton>
        </AuthorizeView>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenRecordAsync">
            Registrar pago
        </MudButton>
    </Actions>
</PageHeader>

@* Caja del turno (Payments v2 §4.4): la ve todo el staff, porque cobrar en efectivo exige caja abierta. *@
<CashDrawerBar @ref="_drawer" OnChanged="RefreshTableAsync" />

<AuthorizeView Policy="@GsmPolicies.ForPermission(GsmPermissions.VoidPayments)">
    <VoidRequestsInbox OnResolved="RefreshTableAsync" />
</AuthorizeView>

@* La lista completa de pagos del gym es financiera (Payments v2 §7): Owner o ViewFinances. Los pagos de un
   miembro los ve todo el staff en la pestaña Pagos de su ficha. *@
<AuthorizeView Policy="@GsmPolicies.ForPermission(GsmPermissions.ViewFinances)">
<Authorized Context="finance">
<ServerTable @ref="_table" TItem="PaymentResponse" Load="LoadAsync">
    <ToolBarContent>
        @* Recepción busca un pago por quién lo hizo, no por concepto: el filtro por miembro va primero. *@
        <MudAutocomplete OpenOnFocus="false" T="MemberListItem" Value="_member" ValueChanged="OnMemberChangedAsync" SearchFunc="SearchMembersAsync"
                         ToStringFunc="@(m => m is null ? string.Empty : $"{m.FirstName} {m.LastName}")"
                         Label="Miembro" Placeholder="Nombre o documento" Clearable="true" ResetValueOnEmptyText="true"
                         Class="mr-4" Style="max-width:240px" data-testid="filter-member" />
        <MudDatePicker Label="Desde" Date="_from" DateChanged="OnFromChangedAsync" Class="mr-4" Style="max-width:180px" />
        <MudDatePicker Label="Hasta" Date="_to" DateChanged="OnToChangedAsync" Class="mr-4" Style="max-width:180px" />
        <MudSelect T="string" Value="_method" ValueChanged="OnMethodChangedAsync" Label="Método" Style="max-width:180px">
            <MudSelectItem Value="@FilterValues.All">Todos</MudSelectItem>
            @foreach (var (value, label) in PaymentMethodLabels.All)
            {
                <MudSelectItem Value="@value.ToString()">@label</MudSelectItem>
            }
        </MudSelect>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Fecha</MudTh>
        <MudTh>Miembro</MudTh>
        <MudTh>Concepto</MudTh>
        <MudTh>Método</MudTh>
        <MudTh>Monto</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Fecha">@GsmFormat.Instant(context.PaidAt)</MudTd>
        <MudTd DataLabel="Miembro" data-testid="payment-member">
            @if (context.MemberId is { } memberId)
            {
                <MudLink Href="@($"/members/{memberId}")" Underline="Underline.None">@(context.MemberName ?? "Miembro")</MudLink>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">Venta sin miembro</MudText>
            }
        </MudTd>
        <MudTd DataLabel="Concepto">@context.Concept</MudTd>
        <MudTd DataLabel="Método">@PaymentMethodLabels.Label(context.Method)</MudTd>
        <MudTd DataLabel="Monto" Class="gsm-mono">@GsmFormat.Money((decimal)context.Amount)</MudTd>
        <MudTd><PaymentVoidAction Payment="context" OnVoided="@(() => _table.RefreshAsync())" /></MudTd>
    </RowTemplate>
    <CardTemplate>
        <div class="gsm-card__row">
            <span class="gsm-card__title">@(context.MemberName ?? (context.MemberId is null ? "Venta sin miembro" : "Miembro"))</span>
            <span class="gsm-mono">@GsmFormat.Money((decimal)context.Amount)</span>
        </div>
        <div class="gsm-card__meta">@context.Concept · @GsmFormat.Instant(context.PaidAt) · @PaymentMethodLabels.Label(context.Method)</div>
        <div class="gsm-card__actions"><PaymentVoidAction Payment="context" OnVoided="@(() => _table.RefreshAsync())" /></div>
    </CardTemplate>
</ServerTable>
</Authorized>
<NotAuthorized>
    <MudAlert Severity="Severity.Info" Dense="true" data-testid="no-finances">
        La lista completa de pagos es solo para el Owner o quien tenga el permiso de ver finanzas. Puedes registrar
        cobros aquí y ver los pagos de cada miembro en su ficha.
    </MudAlert>
</NotAuthorized>
</AuthorizeView>

@code {
    private ServerTable<PaymentResponse> _table = null!;
    private MemberListItem? _member;
    private DateTime? _from;
    private DateTime? _to;
    private string _method = FilterValues.All;

    private async Task RefreshTableAsync()
    {
        if (_table is not null)
        {
            await _table.RefreshAsync();
        }
    }

    private async Task<ServerTablePage<PaymentResponse>> LoadAsync(int page, int pageSize, CancellationToken cancellationToken)
    {
        try
        {
            var result = await Payments.PaymentsGET3Async(
                _from is { } f ? DateOnly.FromDateTime(f) : null,
                _to is { } t ? DateOnly.FromDateTime(t) : null,
                FilterValues.IsAll(_method) ? null : int.Parse(_method),
                _member?.Id, page, pageSize, cancellationToken);
            return new ServerTablePage<PaymentResponse>(result.Items.ToList(), result.Total);
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
            return new ServerTablePage<PaymentResponse>([], 0);
        }
    }

    private async Task<IEnumerable<MemberListItem>> SearchMembersAsync(string search, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            return [];
        }

        var result = await Members.MembersGETAsync(search, null, null, null, 1, 10, null, null, null, cancellationToken);
        return result.Items;
    }

    private async Task OnMemberChangedAsync(MemberListItem? value)
    {
        _member = value;
        await _table.RefreshAsync();
    }

    private async Task OnFromChangedAsync(DateTime? value)
    {
        _from = value;
        await _table.RefreshAsync();
    }

    private async Task OnToChangedAsync(DateTime? value)
    {
        _to = value;
        await _table.RefreshAsync();
    }

    private async Task OnMethodChangedAsync(string value)
    {
        _method = value;
        await _table.RefreshAsync();
    }

    private CashDrawerBar? _drawer;

    private async Task OpenRecordAsync()
    {
        var dialog = await Dialogs.ShowAsync<RecordPaymentDialog>("Registrar pago");
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            Snackbar.Add("Pago registrado.", Severity.Success);
            await RefreshTableAsync();
            // Un cobro en efectivo cambia el efectivo esperado de la caja (B11).
            if (_drawer is not null)
            {
                await _drawer.LoadAsync();
            }
        }
    }
}

@inject IPaymentsClient Payments
@inject ICashShiftsClient CashShifts

<MudDialog>
    <DialogContent>
        @* Antes de anular hay que poder reconocer el pago: de quién, cuándo y cuánto, no solo el concepto. *@
        <div class="gsm-payment-summary mb-4" data-testid="void-payment-summary">
            <div class="gsm-payment-summary__amount gsm-mono">@GsmFormat.Money((decimal)Payment.Amount)</div>
            <div class="gsm-payment-summary__who">@(Payment.MemberName ?? (Payment.MemberId is null ? "Venta sin miembro" : "Pago de un miembro"))</div>
            <div class="gsm-payment-summary__meta">
                @Payment.Concept · @PaymentMethodLabels.Label(Payment.Method) · @GsmFormat.Instant(Payment.PaidAt)
            </div>
        </div>
        <MudText Typo="Typo.body2" Class="mb-4">
            Se registra hoy un asiento de <span class="gsm-mono">@GsmFormat.Money(-(decimal)Payment.Amount)</span> que lo cancela.
            El pago original no se borra y la anulación cuenta en la caja de hoy.
        </MudText>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
        }
        <MudTextField T="string" @bind-Value="_reason" Label="Motivo" Required="true" Lines="2"
                      HelperText="Por ejemplo: monto mal digitado, cobro duplicado." />
        @if (_needsRefundDecision)
        {
            @* Efectivo de un turno ya cerrado (Payments v2 §4.3): ¿el dinero sale de la caja de ahora? *@
            <MudText Typo="Typo.subtitle2" Class="mt-4" data-testid="refund-question">¿Se devuelve el dinero ahora?</MudText>
            <MudRadioGroup T="bool?" @bind-Value="_refundNow" data-testid="refund-choice">
                <MudRadio T="bool?" Value="@((bool?)true)">Sí, se devuelve ahora (sale de la caja abierta)</MudRadio>
                <MudRadio T="bool?" Value="@((bool?)false)">No, fue un error de registro y la plata nunca estuvo</MudRadio>
            </MudRadioGroup>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_submitting">
            @(_submitting ? "Anulando..." : "Anular pago")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired]
    public PaymentResponse Payment { get; set; } = null!;

    private string _reason = string.Empty;
    private bool _submitting;
    private string? _error;
    private bool _needsRefundDecision;
    private bool? _refundNow;

    // Un pago en efectivo que no es del turno abierto exige decidir si el dinero se devuelve ahora.
    protected override async Task OnInitializedAsync()
    {
        if (Payment.Method != "Cash")
        {
            return;
        }

        try
        {
            var status = await CashShifts.CurrentAsync();
            _needsRefundDecision = Payment.ShiftId is null || Payment.ShiftId != status?.Shift?.Id;
        }
        catch (GsmApiException)
        {
            // Sin saberlo, se pregunta: el servidor ignora la respuesta si no hacía falta.
            _needsRefundDecision = true;
        }
    }

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_reason) || _reason.Trim().Length < 3)
        {
            _error = "Escribe el motivo de la anulación.";
            return;
        }

        if (_needsRefundDecision && _refundNow is null)
        {
            _error = "Indica si el dinero se devuelve ahora.";
            return;
        }

        _submitting = true;
        try
        {
            await Payments.VoidAsync(Payment.Id, new VoidPaymentRequest
            {
                Reason = _reason.Trim(),
                RefundNow = _needsRefundDecision ? _refundNow : null,
            });
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (GsmApiException ex)
        {
            _error = ApiError.FromException(ex).DisplayMessage;
        }
        finally
        {
            _submitting = false;
        }
    }
}

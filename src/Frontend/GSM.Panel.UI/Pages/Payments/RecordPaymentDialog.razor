@inject IPaymentsClient Payments
@inject IMembersClient Members
@inject IMemberMembershipsClient MemberMemberships

<MudDialog>
    <DialogContent>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
        }
        <MudForm @ref="_form" Model="_model">
            <MudAutocomplete T="MemberListItem" Label="Miembro (opcional)" Value="_member" ValueChanged="OnMemberChangedAsync"
                              SearchFunc="SearchMembersAsync" ToStringFunc="@(m => m is null ? string.Empty : $"{m.FirstName} {m.LastName} · {m.DocumentNumber}")"
                              Clearable="true" Class="mb-3" Placeholder="Buscar por nombre o documento" />
            @if (_memberships.Count > 0)
            {
                <MudSelect T="Guid?" Value="_membershipId" ValueChanged="OnMembershipChanged" Label="Membresía que cubre (opcional)"
                           Clearable="true" Class="mb-3">
                    @foreach (var membership in _memberships)
                    {
                        <MudSelectItem T="Guid?" Value="membership.Id">
                            @membership.PlanName · @GsmFormat.DayRange(membership.StartDate, membership.EndDate)
                        </MudSelectItem>
                    }
                </MudSelect>
            }
            <MudNumericField T="decimal" @bind-Value="_model.Amount" Label="Monto (COP)" Required="true" Min="1" Class="mb-3" />
            <MudSelect T="int" @bind-Value="_model.Method" Label="Método" Required="true" Class="mb-3">
                @foreach (var (value, label) in PaymentMethodLabels.All)
                {
                    <MudSelectItem Value="value">@label</MudSelectItem>
                }
            </MudSelect>
            <MudTextField T="string" @bind-Value="_model.Concept" Label="Concepto" Required="true" Class="mb-3" />
            <MudTextField T="string" @bind-Value="_model.Notes" Label="Notas" Lines="2" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_submitting">
            @(_submitting ? "Guardando..." : "Registrar")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>Preselecciona el miembro cuando el pago se registra desde su ficha.</summary>
    [Parameter]
    public Guid? MemberId { get; set; }

    private readonly FormModel _model = new();
    private MudForm _form = null!;
    private MemberListItem? _member;
    private List<MembershipResponse> _memberships = [];
    private Guid? _membershipId;
    private bool _submitting;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (MemberId is not { } id)
        {
            return;
        }

        try
        {
            var member = await Members.MembersGET2Async(id);
            _member = new MemberListItem
            {
                Id = member.Id,
                FirstName = member.FirstName,
                LastName = member.LastName,
                DocumentNumber = member.DocumentNumber,
                Status = member.Status,
                JoinedAt = member.JoinedAt,
            };
            await LoadMembershipsAsync();
        }
        catch (GsmApiException)
        {
            // Si falla, se deja sin preseleccionar; el usuario puede buscarlo a mano.
        }
    }

    private async Task OnMemberChangedAsync(MemberListItem? member)
    {
        _member = member;
        await LoadMembershipsAsync();
    }

    // Las más recientes primero: lo normal es cobrar la que se acaba de asignar o la vigente.
    private async Task LoadMembershipsAsync()
    {
        _membershipId = null;
        _memberships = [];
        if (_member is null)
        {
            return;
        }

        try
        {
            var memberships = await MemberMemberships.MembershipsAllAsync(_member.Id);
            _memberships = memberships.OrderByDescending(m => m.StartDate).Take(5).ToList();
        }
        catch (GsmApiException)
        {
            // Sin la lista se puede cobrar igual, solo que sin enlazar la membresía.
        }
    }

    private void OnMembershipChanged(Guid? membershipId)
    {
        _membershipId = membershipId;
        if (_memberships.FirstOrDefault(m => m.Id == membershipId) is { } membership && string.IsNullOrWhiteSpace(_model.Concept))
        {
            _model.Concept = $"Membresía {membership.PlanName} ({GsmFormat.DayRange(membership.StartDate, membership.EndDate)})";
        }
    }

    private async Task<IEnumerable<MemberListItem>> SearchMembersAsync(string search, CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            return [];
        }

        var result = await Members.MembersGETAsync(search, null, null, 1, 10, cancellationToken);
        return result.Items;
    }

    private async Task SubmitAsync()
    {
        _error = null;
        await _form.Validate();
        if (!_form.IsValid)
        {
            return;
        }

        _submitting = true;
        try
        {
            await Payments.PaymentsPOST2Async(new RecordPaymentRequest
            {
                Amount = (double)_model.Amount,
                Method = _model.Method,
                Concept = _model.Concept,
                Notes = _model.Notes,
                MemberId = _member?.Id,
                MembershipId = _member is null ? null : _membershipId,
            });

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (GsmApiException ex)
        {
            _error = ApiError.FromException(ex).DisplayMessage;
        }
        finally
        {
            _submitting = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private sealed class FormModel
    {
        public decimal Amount { get; set; }
        public int Method { get; set; }
        public string Concept { get; set; } = string.Empty;
        public string? Notes { get; set; }
    }
}

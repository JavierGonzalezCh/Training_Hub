@inject IPaymentsClient Payments
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

@* Bandeja de solicitudes de anulación pendientes. Solo se monta para quien puede resolverlas (Owner o
   VoidPayments): la página la envuelve en un AuthorizeView, así no se consulta sin permiso. *@
@if (_pending.Count > 0)
{
            <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid var(--gsm-border)" data-testid="void-requests-inbox">
                <MudText Typo="Typo.h6" Class="mb-2">Solicitudes de anulación (@_pending.Count)</MudText>
                @foreach (var request in _pending)
                {
                    <div class="d-flex align-center flex-wrap py-2" style="gap:1rem" data-testid="void-request">
                        <div style="flex:1 1 16rem">
                            <MudText Typo="Typo.body1">
                                @request.PaymentConcept · <span class="gsm-mono">@GsmFormat.Money((decimal)request.PaymentAmount)</span>
                                · @PaymentMethodLabels.Label(request.PaymentMethod)
                            </MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @(request.RequestedByName ?? "Alguien del equipo") pidió anularlo · @GsmFormat.Instant(request.RequestedAt)
                            </MudText>
                            <MudText Typo="Typo.body2">Motivo: @request.Reason</MudText>
                        </div>
                        @if (_rejectingId == request.Id)
                        {
                            <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="_busy"
                                       data-testid="cancel-reject" OnClick="@(() => _rejectingId = null)">Cancelar</MudButton>
                            <MudButton Variant="Variant.Filled" Size="Size.Small" Disabled="_busy"
                                       data-testid="confirm-reject" OnClick="@(() => RejectAsync(request))">Confirmar rechazo</MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="_busy"
                                       data-testid="reject-void" OnClick="@(() => StartReject(request))">Rechazar</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" Disabled="_busy"
                                       data-testid="approve-void" OnClick="@(() => ApproveAsync(request))">Aprobar y anular</MudButton>
                        }
                    </div>
                    @if (_rejectingId == request.Id)
                    {
                        @* La nota le llega a quien pidió la anulación, que no ve esta bandeja. *@
                        <MudTextField T="string" @bind-Value="_rejectNote" Label="Nota para quien lo pidió (opcional)"
                                      Lines="2" MaxLength="500" Immediate="true" Class="mb-2" data-testid="reject-note" />
                    }
                }
    </MudPaper>
}

@code {
    private List<VoidRequestResponse> _pending = [];
    private bool _busy;

    /// <summary>Se avisa al resolver una solicitud para que la tabla de pagos se refresque.</summary>
    [Parameter]
    public EventCallback OnResolved { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    public async Task LoadAsync()
    {
        try
        {
            _pending = (await Payments.VoidRequestsGETAsync("pending", 1, 50))?.Items.ToList() ?? [];
        }
        catch (GsmApiException)
        {
            // Sin el permiso (403) no hay bandeja: el AuthorizeView ya la oculta; esto cubre el desfase del token.
            _pending = [];
        }
    }

    private async Task ApproveAsync(VoidRequestResponse request)
    {
        // Efectivo de un turno ya cerrado (Payments v2 §4.3): primero se decide si el dinero se devuelve ahora.
        bool? refundNow = null;
        if (request.RequiresRefundDecision == true)
        {
            refundNow = await Dialogs.ShowMessageBox(
                "¿Se devuelve el dinero ahora?",
                "Este pago en efectivo es de un turno ya cerrado. Si se devuelve ahora, sale de la caja abierta; si fue un error de registro y la plata nunca estuvo, no se toca la caja.",
                yesText: "Sí, se devuelve ahora", noText: "No, nunca estuvo", cancelText: "Cancelar");
            if (refundNow is null)
            {
                return;
            }
        }

        await ResolveAsync(
            async () => await Payments.ApproveAsync(
                request.Id, refundNow is null ? null : new ApproveVoidRequestRequest { RefundNow = refundNow }),
            "Pago anulado.");
    }

    private Guid? _rejectingId;
    private string? _rejectNote;

    private void StartReject(VoidRequestResponse request)
    {
        _rejectingId = request.Id;
        _rejectNote = null;
    }

    private Task RejectAsync(VoidRequestResponse request)
    {
        var note = string.IsNullOrWhiteSpace(_rejectNote) ? null : _rejectNote.Trim();
        _rejectingId = null;
        return ResolveAsync(
            () => Payments.RejectAsync(request.Id, new RejectVoidRequestRequest { Note = note }), "Solicitud rechazada.");
    }

    private async Task ResolveAsync(Func<Task> action, string success)
    {
        _busy = true;
        try
        {
            await action();
            Snackbar.Add(success, Severity.Success);
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            _busy = false;
        }

        await LoadAsync();
        await OnResolved.InvokeAsync();
    }
}

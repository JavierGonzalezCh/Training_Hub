@inject IServiceProvider Services
@implements IDisposable
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

@* Barra de la caja del turno (Payments v2 §4.4): quién la tiene abierta, desde cuándo y cuánto efectivo se espera.
   La ve todo el staff; abrir, mover y cerrar son acciones de quien tiene la caja (el servidor decide quién puede). *@
@if (Drawer is { UseCashDrawer: true })
{
<MudPaper Class="pa-3 mb-4" Elevation="0" Style="border:1px solid var(--gsm-border)" data-testid="cash-drawer-bar">
    @if (_loading)
    {
        <GsmLoader />
    }
    else if (Drawer.Shift is not { } shift)
    {
        <div class="d-flex align-center flex-wrap" style="gap:1rem">
            <MudIcon Icon="@Icons.Material.Outlined.Lock" Color="Color.Secondary" />
            <MudText Typo="Typo.body1" Style="flex:1 1 14rem" data-testid="cash-drawer-closed">
                Caja cerrada. Ábrela para cobrar en efectivo.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" data-testid="open-cash" OnClick="OpenAsync">
                Abrir caja
            </MudButton>
        </div>
    }
    else
    {
        <div class="d-flex align-center flex-wrap" style="gap:1rem">
            <MudIcon Icon="@Icons.Material.Outlined.LockOpen" Color="Color.Success" />
            <div style="flex:1 1 16rem">
                <MudText Typo="Typo.body1" data-testid="cash-drawer-open">
                    Caja abierta por @(shift.OpenedByName ?? "alguien del equipo") desde @GsmFormat.Instant(shift.OpenedAt)
                    · efectivo esperado <span class="gsm-mono">@GsmFormat.Money((decimal)(shift.ExpectedCash ?? 0))</span>
                </MudText>
                @if (shift.IsStale)
                {
                    <MudText Typo="Typo.body2" Color="Color.Warning" data-testid="cash-drawer-stale">
                        Lleva abierta más de 16 horas: ciérrala con tu conteo antes de abrir la tuya.
                    </MudText>
                }
            </div>
            <MudButton Variant="Variant.Outlined" data-testid="cash-movement" OnClick="MovementAsync">Retiro / ingreso</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" data-testid="close-cash" OnClick="CloseAsync">Cerrar caja</MudButton>
        </div>
    }
</MudPaper>
}

@code {
    private bool _loading = true;

    // El estado compartido lo registra el panel; sin él (una pantalla suelta) la barra no se muestra.
    private CashDrawerState? Drawer { get; set; }

    /// <summary>Se avisa cuando la caja cambia (abrir, movimiento, cerrar) para que la página refresque su lista.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Drawer = Services.GetService(typeof(CashDrawerState)) as CashDrawerState;
        if (Drawer is null)
        {
            return;
        }

        Drawer.Changed += OnStateChanged;
        await Drawer.EnsureLoadedAsync();
        _loading = false;
    }

    public Task LoadAsync() => Drawer?.RefreshAsync() ?? Task.CompletedTask;

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (Drawer is not null)
        {
            Drawer.Changed -= OnStateChanged;
        }
    }

    private async Task OpenAsync()
    {
        var parameters = new DialogParameters<OpenCashDialog> { { x => x.SuggestedBase, Drawer!.SuggestedBase } };
        var dialog = await Dialogs.ShowAsync<OpenCashDialog>("Abrir caja", parameters);
        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add("Caja abierta.", Severity.Success);
            await ChangedAsync();
        }
    }

    private async Task MovementAsync()
    {
        var dialog = await Dialogs.ShowAsync<CashMovementDialog>("Retiro o ingreso de efectivo");
        if (await dialog.Result is { Canceled: false })
        {
            Snackbar.Add("Movimiento registrado.", Severity.Success);
            await ChangedAsync();
        }
    }

    private async Task CloseAsync()
    {
        if (Drawer?.Shift is not { } shift)
        {
            return;
        }

        var parameters = new DialogParameters<CloseCashDialog> { { x => x.Shift, shift } };
        var dialog = await Dialogs.ShowAsync<CloseCashDialog>("Cerrar caja", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: Guid shiftId })
        {
            await ChangedAsync();
            // Al confirmar sale el reporte del turno, listo para imprimir.
            Navigation.NavigateTo($"/cash-shifts/{shiftId}");
        }
    }

    private async Task ChangedAsync()
    {
        await Drawer!.RefreshAsync();
        await OnChanged.InvokeAsync();
    }
}

@page "/cuenta/contrasena"
@attribute [Authorize(Roles = "owner,staff")]

<PageTitle>Cambiar contraseña — TrainingHub OS</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">Cambiar contraseña</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6" Style="max-width:520px">
    Al cambiarla cerramos tus otras sesiones, en todos tus gimnasios. Esta se queda abierta.
</MudText>

<div style="max-width:420px">
    <ChangePasswordForm />
</div>

<MudText Typo="Typo.h5" Class="mt-10 mb-2">Cambiar correo</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4" Style="max-width:520px">
    Es el correo con el que entras. Lo confirmas con un código que mandamos al correo nuevo.
</MudText>

<div style="max-width:420px">
    <ChangeEmailForm />
</div>

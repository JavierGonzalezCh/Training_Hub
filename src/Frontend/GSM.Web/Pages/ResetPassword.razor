@page "/reset-password"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject SessionService Session
@inject NavigationManager Navigation

<PageTitle>Restablecer contraseña — GSM</PageTitle>

<MudText Typo="Typo.h6" Class="mb-6">Restablecer contraseña</MudText>

@if (_done)
{
    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-4">Contraseña actualizada.</MudAlert>
    <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" Href="/login">Iniciar sesión</MudButton>
}
else
{
    <MudText Typo="Typo.body2" Class="mb-4" Color="Color.Secondary">
        Pega el código que te enviamos por correo y elige una contraseña nueva.
    </MudText>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
    }

    <MudTextField T="string" @bind-Value="_email" Label="Email" InputType="InputType.Email" Class="mb-3" />
    <MudTextField T="string" @bind-Value="_token" Label="Código" Class="mb-3" />
    <MudTextField T="string" @bind-Value="_newPassword" Label="Contraseña nueva" InputType="InputType.Password" Class="mb-4" />

    <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_submitting">
        @(_submitting ? "Guardando..." : "Restablecer contraseña")
    </MudButton>
}

<div class="d-flex justify-center mt-4">
    <MudLink Href="/login" Typo="Typo.body2" Color="Color.Secondary">Volver a iniciar sesión</MudLink>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    private string _email = string.Empty;
    private string _token = string.Empty;
    private string _newPassword = string.Empty;
    private bool _submitting;
    private bool _done;
    private string? _error;

    protected override void OnInitialized() => _email = Email ?? string.Empty;

    private async Task SubmitAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_token) || string.IsNullOrWhiteSpace(_newPassword))
        {
            _error = "Rellena email, código y contraseña nueva.";
            return;
        }

        _submitting = true;
        try
        {
            await Session.ResetPasswordAsync(_email, _token, _newPassword);
            _done = true;
        }
        catch (ApiErrorException ex)
        {
            // 422: el código no procede (caducado, ya usado, no coincide).
            _error = ex.Error.DisplayMessage;
        }
        finally
        {
            _submitting = false;
        }
    }
}

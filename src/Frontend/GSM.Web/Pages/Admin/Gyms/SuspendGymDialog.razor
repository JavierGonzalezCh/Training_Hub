@inject IAdminGymsClient AdminGyms

<MudDialog>
    <DialogContent>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
        }
        <MudTextField T="string" @bind-Value="_reason" Label="Motivo" Required="true" Lines="2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_submitting">
            @(_submitting ? "Suspendiendo..." : "Suspender")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired]
    public Guid GymId { get; set; }

    private string _reason = string.Empty;
    private bool _submitting;
    private string? _error;

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_reason))
        {
            _error = "El motivo es obligatorio.";
            return;
        }

        _submitting = true;
        try
        {
            await AdminGyms.SuspendAsync(GymId, new SuspendGymRequest { Reason = _reason });
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (GsmApiException ex)
        {
            _error = ApiError.FromException(ex).DisplayMessage;
        }
        finally
        {
            _submitting = false;
        }
    }
}

@inject IGymsClient Gyms
@inject IAdminPlansClient AdminPlans
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
        }
        <MudForm @ref="_form">
            <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-2">Gym</MudText>
            <MudTextField T="string" @bind-Value="_name" Label="Nombre" Required="true" Class="mb-3" />
            <MudTextField T="string" @bind-Value="_slug" Label="Slug" Required="true" HelperText="Único, en minúsculas" Class="mb-3" />
            <MudTextField T="string" @bind-Value="_nit" Label="NIT" Class="mb-3" />
            <MudTextField T="string" @bind-Value="_phone" Label="Teléfono" Class="mb-3" />
            <MudTextField T="string" @bind-Value="_email" Label="Email del gym" InputType="InputType.Email" Class="mb-3" />
            <MudSelect T="Guid?" @bind-Value="_planId" Label="Plan" Class="mb-4" data-testid="plan-select" ToStringFunc="PlanText">
                @foreach (var plan in _plans)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)plan.Id)">@SubscriptionFormDialog.PlanLabel(plan)</MudSelectItem>
                }
            </MudSelect>

            <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-2">Owner</MudText>
            <MudTextField T="string" @bind-Value="_ownerName" Label="Nombre del owner" Required="true" Class="mb-3" />
            <MudTextField T="string" @bind-Value="_ownerEmail" Label="Email del owner" InputType="InputType.Email" Required="true" Class="mb-3" />
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4" data-testid="owner-invite-note">
                El owner recibe por correo un enlace para crear su contraseña (vence en 72 horas). También puedes copiarlo desde la ficha del gym.
            </MudText>

            <MudText Typo="Typo.overline" Color="Color.Secondary" Class="mb-2">Suscripción</MudText>
            <MudNumericField T="decimal" Culture="GsmFormat.Colombia" Format="@GsmFormat.MoneyFieldFormat" @bind-Value="_monthlyPrice" Label="Precio mensual (COP)" Min="0" Class="mb-3" />
            <MudSwitch T="bool" @bind-Value="_withTrial" Label="Con prueba gratis" Color="Color.Primary" data-testid="with-trial" Class="mb-2" />
            @if (_withTrial)
            {
                <MudNumericField T="int" @bind-Value="_trialDays" Label="Días de prueba" Min="1" Max="365" data-testid="trial-days" />
            }
            else
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2" data-testid="first-payment-note">
                    Sin prueba el gym nace activo y se registra su primer pago.
                </MudText>
                <MudNumericField T="decimal" Culture="GsmFormat.Colombia" Format="@GsmFormat.MoneyFieldFormat" @bind-Value="_paymentAmount" Label="Monto del primer pago (COP)" Min="1" Class="mb-3" data-testid="first-payment-amount" />
                <MudSelect T="int" @bind-Value="_paymentMethod" Label="Método" Class="mb-3">
                    @foreach (var (value, label) in PaymentMethodLabels.All)
                    {
                        <MudSelectItem Value="value">@label</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField T="string" @bind-Value="_paymentReference" Label="Referencia" Class="mb-2" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Sin fechas, cubre desde hoy un mes.
                </MudText>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_submitting">
            @(_submitting ? "Creando..." : "Crear gym")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string PlanText(Guid? id)
        => _plans.FirstOrDefault(p => p.Id == id) is { } plan ? SubscriptionFormDialog.PlanLabel(plan) : string.Empty;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private MudForm _form = null!;
    private string _name = string.Empty;
    private string _slug = string.Empty;
    private string? _nit;
    private string? _phone;
    private string? _email;
    private Guid? _planId;
    private List<SaasPlanItem> _plans = [];
    private string _ownerName = string.Empty;
    private string _ownerEmail = string.Empty;
    private decimal _monthlyPrice;
    private bool _withTrial = true;
    private int _trialDays = 30;
    private decimal _paymentAmount;
    private int _paymentMethod;
    private string? _paymentReference;
    private bool _submitting;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _plans = (await AdminPlans.PlansAllAsync()).Where(p => p.IsActive == true).ToList();
            _planId = _plans.FirstOrDefault()?.Id;
        }
        catch (GsmApiException ex)
        {
            _error = ApiError.FromException(ex).DisplayMessage;
        }
    }

    private async Task SubmitAsync()
    {
        _error = null;
        await _form.Validate();
        if (!_form.IsValid)
        {
            return;
        }

        if (!_withTrial && _paymentAmount <= 0)
        {
            _error = "Sin prueba hay que registrar el primer pago: el monto debe ser mayor que cero.";
            return;
        }

        if (_withTrial && _trialDays < 1)
        {
            _error = "Los días de prueba deben ser al menos 1.";
            return;
        }

        _submitting = true;
        try
        {
            var result = await Gyms.GymsPOSTAsync(new CreateGymRequest
            {
                Name = _name,
                Slug = _slug,
                Nit = _nit,
                Phone = _phone,
                Email = _email,
                SaasPlanId = _planId,
                Owner = new CreateGymOwner { Email = _ownerEmail, FullName = _ownerName },
                MonthlyPrice = (double)_monthlyPrice,
                TrialDays = _withTrial ? _trialDays : null,
                FirstPayment = _withTrial
                    ? null
                    : new CreateGymFirstPayment
                    {
                        Amount = (double)_paymentAmount,
                        Method = _paymentMethod,
                        Reference = _paymentReference,
                    },
            });

            if (result.OwnerInvitationSent != true)
            {
                Snackbar.Add("El gym se creó, pero el correo al owner falló. Copia su enlace desde la ficha.", Severity.Warning);
            }

            MudDialog.Close(DialogResult.Ok(result.GymId));
        }
        catch (GsmApiException ex)
        {
            // 409: el slug ya existe.
            _error = ApiError.FromException(ex).DisplayMessage;
        }
        finally
        {
            _submitting = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}

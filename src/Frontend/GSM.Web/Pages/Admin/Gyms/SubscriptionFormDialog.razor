@inject IAdminGymsClient AdminGyms
@inject IAdminPlansClient AdminPlans

<MudDialog>
    <DialogContent>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
        }
        <MudSelect T="Guid?" @bind-Value="_planId" Label="Plan" Class="mb-3" data-testid="plan-select">
            @foreach (var plan in _plans)
            {
                <MudSelectItem T="Guid?" Value="@plan.Id">@PlanLabel(plan)</MudSelectItem>
            }
        </MudSelect>
        <MudNumericField T="int?" @bind-Value="_limitOverride" Label="Límite de miembros propio" Min="1" Class="mb-3"
                         HelperText="@OverrideHelp()" data-testid="limit-override" />
        <MudNumericField T="decimal" Culture="GsmFormat.Colombia" Format="@GsmFormat.MoneyFieldFormat" @bind-Value="_price" Label="Precio mensual (COP)" Min="0" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_submitting">
            @(_submitting ? "Guardando..." : "Guardar")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired]
    public Guid GymId { get; set; }

    [Parameter, EditorRequired]
    public SubscriptionDetail Current { get; set; } = null!;

    private List<SaasPlanItem> _plans = [];
    private Guid? _planId;
    private int? _limitOverride;
    private decimal _price;
    private bool _submitting;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _price = (decimal)Current.MonthlyPrice;
        _limitOverride = Current.MemberLimitOverride;
        _planId = Current.SaasPlanId;

        try
        {
            // Solo los activos, más el que el cliente ya tiene aunque se haya desactivado.
            _plans = (await AdminPlans.PlansGETAsync())
                .Where(p => p.IsActive == true || p.Id == Current.SaasPlanId)
                .ToList();
            _planId ??= _plans.FirstOrDefault(p => p.Name == Current.Plan)?.Id;
        }
        catch (GsmApiException ex)
        {
            _error = ApiError.FromException(ex).DisplayMessage;
        }
    }

    public static string PlanLabel(SaasPlanItem plan)
        => plan.MemberLimit is { } max ? $"{plan.Name} · {max} miembros" : $"{plan.Name} · sin límite";

    private string OverrideHelp()
    {
        var planLimit = _plans.FirstOrDefault(p => p.Id == _planId)?.MemberLimit;
        var planText = planLimit is { } max ? $"El plan permite {max}" : "El plan no tiene límite";
        return $"Vacío = el del plan. {planText}.";
    }

    private async Task SubmitAsync()
    {
        _submitting = true;
        _error = null;
        try
        {
            var planName = _plans.FirstOrDefault(p => p.Id == _planId)?.Name ?? Current.Plan;
            await AdminGyms.SubscriptionAsync(GymId, new UpdateSubscriptionRequest
            {
                Plan = SuperAdminLabels.LegacyPlanValue(planName),
                SaasPlanId = _planId,
                MemberLimitOverride = _limitOverride,
                MonthlyPrice = (double)_price,
            });
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (GsmApiException ex)
        {
            _error = ApiError.FromException(ex).DisplayMessage;
        }
        finally
        {
            _submitting = false;
        }
    }
}

@* Owners del gym en la ficha del SuperAdmin: si ya activaron su cuenta y "Copiar enlace" (Identity §4) para
   mandarles por WhatsApp el enlace de activación (72 h). Cada copia queda registrada con quién la hizo. *@
@inject IAdminGymOwnersClient Owners
@inject GSM.UI.Shared.IClipboard Clipboard
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<MudText Typo="Typo.h6" Class="mb-2">Owners</MudText>
@if (!string.IsNullOrEmpty(_contactName))
{
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2" data-testid="admin-billing-contact">
        Contacto de facturación: @_contactName (@_contactEmail)
    </MudText>
}
<MudGrid Class="mb-2" Style="max-width:900px">
    <MudItem xs="12" sm="4">
        <MudTextField T="string" @bind-Value="_newName" Label="Nombre completo" Dense="true" data-testid="admin-owner-name" />
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudTextField T="string" @bind-Value="_newEmail" Label="Email" InputType="InputType.Email" Dense="true" data-testid="admin-owner-email" />
    </MudItem>
    <MudItem xs="12" sm="3" Class="d-flex align-end">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddAsync" FullWidth="true" data-testid="admin-add-owner">Agregar Owner</MudButton>
    </MudItem>
</MudGrid>
@if (_loading)
{
    <GsmLoader />
}
else if (_owners.Count == 0)
{
    <MudText Color="Color.Secondary" Class="mb-6">Este gym no tiene owners.</MudText>
}
else
{
    <MudTable Items="_owners" Hover="true" Dense="true" Elevation="0" Class="mb-6">
        <HeaderContent>
            <MudTh>Nombre</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Cuenta</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nombre">@context.FullName</MudTd>
            <MudTd DataLabel="Email">@context.Email</MudTd>
            <MudTd DataLabel="Cuenta">
                <MudChip T="string" Color="@(!context.IsActive ? Color.Default : context.IsActivated ? Color.Info : Color.Warning)"
                         Variant="Variant.Text" Size="Size.Small" Class="gsm-mono">
                    @(!context.IsActive ? "INACTIVO" : context.IsActivated ? "ACTIVADA" : "PENDIENTE")
                </MudChip>
            </MudTd>
            <MudTd>
                @if (context.IsActive)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ResendAsync(context))" data-testid="resend-access">Reenviar acceso</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => CopyLinkAsync(context))">Copiar enlace</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => RemoveAsync(context))" data-testid="admin-remove-owner">Quitar</MudButton>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [Parameter]
    public Guid GymId { get; set; }

    private List<GymOwnerResponse> _owners = [];
    private bool _loading = true;
    private string _newName = string.Empty;
    private string _newEmail = string.Empty;
    private string? _contactName;
    private string? _contactEmail;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _owners = (await Owners.OwnersAllAsync(GymId)).ToList();
            var contact = await Owners.BillingContactGETAsync(GymId);
            _contactName = contact.FullName;
            _contactEmail = contact.Email;
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName) || string.IsNullOrWhiteSpace(_newEmail))
        {
            Snackbar.Add("Nombre y email son obligatorios.", Severity.Warning);
            return;
        }

        try
        {
            var owner = await Owners.OwnersPOSTAsync(GymId, new InviteOwnerRequest { FullName = _newName, Email = _newEmail });
            Snackbar.Add($"{owner.FullName} ahora es Owner. Le enviamos el enlace a {owner.Email}.", Severity.Success);
            _newName = string.Empty;
            _newEmail = string.Empty;
            await LoadAsync();
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
    }

    private async Task RemoveAsync(GymOwnerResponse owner)
    {
        var confirmed = await Dialogs.ShowMessageBox(
            "Quitar Owner",
            $"¿Quitar a {owner.FullName}? Dejará de ser Owner y sus sesiones en este gym se cerrarán.",
            yesText: "Quitar", cancelText: "Cancelar");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Owners.OwnersDELETEAsync(GymId, owner.UserId);
            Snackbar.Add($"{owner.FullName} ya no es Owner.", Severity.Success);
            await LoadAsync();
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
    }

    private async Task ResendAsync(GymOwnerResponse owner)
    {
        try
        {
            await Owners.ResendAsync(GymId, owner.UserId);
            Snackbar.Add($"Acceso reenviado a {owner.Email}. El enlace anterior ya no sirve.", Severity.Success);
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
    }

    private async Task CopyLinkAsync(GymOwnerResponse owner)
    {
        try
        {
            var link = await Owners.LinkAsync(GymId, owner.UserId);
            var message = link.RequiresLogin
                ? $"{owner.FullName} ya activó su cuenta: el enlace lo lleva a entrar."
                : $"Enlace de activación de {owner.FullName} copiado (vence en 72 horas).";

            if (await Clipboard.CopyAsync(link.Url))
            {
                Snackbar.Add(message, Severity.Success);
            }
            else
            {
                await Dialogs.ShowMessageBox($"Enlace de {owner.FullName}", link.Url, yesText: "Cerrar");
            }
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
    }
}

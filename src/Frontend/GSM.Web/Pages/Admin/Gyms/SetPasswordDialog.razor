@* "Cambiar clave" del SuperAdmin (PW1): fija la contraseña de una persona del gym sin correo. La escribe el
   SuperAdmin o la genera al azar; se copia para mandársela a la persona. La política es la de la API: mínimo 10
   caracteres con mayúscula, minúscula y número. *@
@using System.Security.Cryptography
@inject IAdminGymAccountsClient Accounts
@inject GSM.UI.Shared.IClipboard Clipboard
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
        }
        <MudText Typo="Typo.body2" Class="mb-4">
            Nueva contraseña de <strong>@Account.FullName</strong> (@Account.Email). Sus sesiones abiertas se
            cerrarán y la clave vale en todos los gyms donde tenga acceso.
        </MudText>
        <PasswordField @bind-Value="_password" Label="Contraseña nueva" Variant="Variant.Outlined" Immediate="true"
                       HelperText="Mínimo 10 caracteres, con mayúscula, minúscula y número."
                       autocomplete="new-password" data-testid="admin-new-password" />
        <div class="d-flex gap-2 mt-2">
            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Casino"
                       OnClick="Generate" data-testid="admin-generate-password">Generar</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.ContentCopy"
                       OnClick="CopyAsync" Disabled="string.IsNullOrEmpty(_password)">Copiar</MudButton>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_submitting"
                   data-testid="admin-save-password">
            @(_submitting ? "Guardando..." : "Cambiar clave")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    // Sin caracteres que se confunden al dictarlos (0/O, 1/l/I).
    private const string Upper = "ABCDEFGHJKLMNPQRSTUVWXYZ";
    private const string Lower = "abcdefghijkmnopqrstuvwxyz";
    private const string Digits = "23456789";

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired]
    public Guid GymId { get; set; }

    [Parameter, EditorRequired]
    public GymAccountResponse Account { get; set; } = null!;

    private string? _password;
    private bool _submitting;
    private string? _error;

    private void Generate()
    {
        var all = Upper + Lower + Digits;
        var chars = new List<char>
        {
            Upper[RandomNumberGenerator.GetInt32(Upper.Length)],
            Lower[RandomNumberGenerator.GetInt32(Lower.Length)],
            Digits[RandomNumberGenerator.GetInt32(Digits.Length)],
        };
        while (chars.Count < 14)
        {
            chars.Add(all[RandomNumberGenerator.GetInt32(all.Length)]);
        }

        _password = new string(chars.OrderBy(_ => RandomNumberGenerator.GetInt32(int.MaxValue)).ToArray());
        _error = null;
    }

    private async Task CopyAsync()
    {
        if (await Clipboard.CopyAsync(_password!))
        {
            Snackbar.Add("Contraseña copiada.", Severity.Success);
        }
    }

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(_password) || _password.Length < 10)
        {
            _error = "La contraseña debe tener al menos 10 caracteres.";
            return;
        }

        _submitting = true;
        _error = null;
        try
        {
            await Accounts.PasswordPUTAsync(GymId, Account.UserId, new AdminSetPasswordRequest { NewPassword = _password });
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (GsmApiException ex)
        {
            _error = ApiError.FromException(ex).DisplayMessage;
        }
        finally
        {
            _submitting = false;
        }
    }
}

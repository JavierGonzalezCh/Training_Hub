@page "/admin"
@layout AdminLayout
@attribute [Authorize(Roles = GsmRoles.SuperAdmin)]
@inject IAdminDashboardClient DashboardClient
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Panel SuperAdmin — TrainingHub OS</PageTitle>

<MudText Typo="Typo.h4" Class="mb-6">Panel de plataforma</MudText>

@if (_loading)
{
    <GsmLoader />
}
else if (_dashboard is { } d)
{
    @* Ingresos. Misma retícula de 12 columnas en md para que las tarjetas no queden dentadas entre filas. *@
    <MudGrid Class="mb-6" data-testid="income-block">
        <MudItem xs="12" sm="6" md="3">
            <StatCard Label="MRR" Value="@GsmFormat.Money((decimal)d.Revenue.Mrr)" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <StatCard Label="Cobrado este mes" Value="@GsmFormat.Money((decimal)d.Revenue.CollectedThisMonth)" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <StatCard Label="Cobrado mes anterior" Value="@GsmFormat.Money((decimal)d.Revenue.CollectedLastMonth)" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            @* Contratado menos cobrado este mes. Rojo solo si hay cartera pendiente. *@
            <StatCard Label="Cartera pendiente" Value="@GsmFormat.Money((decimal)d.Revenue.Pending)"
                      Accent="@(d.Revenue.Pending > 0 ? Color.Error : Color.Default)" />
        </MudItem>
    </MudGrid>

    <AttentionPanel Block="d.Attention" />
    <StartupPanel Block="d.Startup" />
    <LimitsPanel Block="d.Limits" />

    <MudText Typo="Typo.h6" Class="mb-2">Cartera por estado</MudText>
    <div class="d-flex flex-wrap mb-6" style="gap:0.5rem">
        @foreach (var (status, count) in d.Portfolio.CountByStatus)
        {
            <MudChip T="string" Color="@SuperAdminLabels.StatusColor(status)" Variant="Variant.Text" Class="gsm-mono">
                @SuperAdminLabels.StatusLabel(status).ToUpperInvariant(): @count
            </MudChip>
        }
    </div>

    <MudText Typo="Typo.h6" Class="mb-2">Uso por gym</MudText>
    <MudTable Items="d.GymUsage" Hover="true" Dense="true" Elevation="0">
        <HeaderContent>
            <MudTh>Gym</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Miembros (límite)</MudTh>
            <MudTh title="Personas distintas que entraron en el mes.">Personas que entraron</MudTh>
            <MudTh>Ingresos del mes</MudTh>
            <MudTh>Última visita</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Gym">
                <MudLink OnClick="@(() => Navigation.NavigateTo($"/admin/gyms/{context.GymId}"))" Underline="Underline.None">
                    @context.Name
                </MudLink>
            </MudTd>
            <MudTd DataLabel="Estado">
                <MudChip T="string" Color="@SuperAdminLabels.StatusColor(context.EffectiveStatus)" Variant="Variant.Text" Size="Size.Small" Class="gsm-mono">
                    @SuperAdminLabels.StatusLabel(context.EffectiveStatus).ToUpperInvariant()
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Miembros (límite)" Class="gsm-mono">
                @(context.CountedMembers is { } counted ? SuperAdminLabels.MemberUsage(counted, context.MemberLimit) : context.ActiveMembers.ToString())
            </MudTd>
            <MudTd DataLabel="Personas que entraron">@context.CheckInsThisMonth</MudTd>
            <MudTd DataLabel="Ingresos del mes" Class="gsm-mono">@GsmFormat.Money((decimal)context.MemberRevenueThisMonth)</MudTd>
            <MudTd DataLabel="Última visita">
                @(context.LastCheckIn is { } d2 ? GsmFormat.Day(d2) : "—")
                @if (context.IsInactive)
                {
                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Text" Size="Size.Small" Class="gsm-mono ml-1" data-testid="inactive-chip">@InactiveLabel(context.DaysSinceLastCheckIn)</MudChip>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>

    <div class="mt-6">
        <MonthlyMetricsPanel />
    </div>

    @* Plataforma: totales. *@
    <MudGrid Class="mt-6" data-testid="platform-block">
        <MudItem xs="12" sm="4">
            <StatCard Label="Gyms" Value="@d.Platform.GymCount.ToString()" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <StatCard Label="Miembros activos" Value="@d.Platform.ActiveMembers.ToString()" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <StatCard Label="Personas que entraron en el mes" Value="@d.Platform.CheckInsThisMonth.ToString()" />
        </MudItem>
    </MudGrid>
}

@code {
    /// <summary>"Sin entradas hace 9 días" / "Sin entradas todavía" (7 días sin entradas, Dashboards §3).</summary>
    public static string InactiveLabel(int? daysSince)
        => daysSince is { } d ? $"Sin entradas hace {d} días" : "Sin entradas";

    private AdminDashboardResponse? _dashboard;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _dashboard = await DashboardClient.DashboardAsync();
        }
        catch (GsmApiException ex)
        {
            Snackbar.Add(ApiError.FromException(ex).DisplayMessage, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}

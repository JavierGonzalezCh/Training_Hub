@inject NavigationManager Navigation

@* "Requiere acción" (Dashboards §3). Si el bloque no llegó (su lectura falló) no se muestra nada. *@
@if (Block is { } b)
{
    <MudText Typo="Typo.h6" Class="mb-2">Requiere acción</MudText>
    <MudGrid Class="mb-6" data-testid="attention-panel">
        <MudItem xs="12" md="6">
            @Section("Pruebas terminadas sin pago", "trial-ended", b.TrialEnded, "TrialEnded", true)
        </MudItem>
        <MudItem xs="12" md="6">
            @Section("En mora", "overdue", b.Overdue, "Overdue", true)
        </MudItem>
        <MudItem xs="12" md="6">
            @Section("Por inhabilitarse (3 días o menos)", "about-to-disable", b.AboutToDisable, null, true)
        </MudItem>
        <MudItem xs="12" md="6">
            @Section("Vencen en 15 días", "expiring", b.ExpiringSoon, "Active", false)
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter]
    public AdminAttentionBlock? Block { get; set; }

    private RenderFragment Section(string title, string key, AttentionList list, string? status, bool byDisable) => @<MudPaper Outlined="true" Class="pa-3" data-testid="@($"attention-{key}")">
        <div class="d-flex align-center mb-2">
            <MudText Typo="Typo.subtitle1">@title</MudText>
            <MudSpacer />
            <MudChip T="string" Size="Size.Small" Color="@(list.Total > 0 ? Color.Warning : Color.Default)" Variant="Variant.Text" data-testid="@($"attention-{key}-total")">@list.Total</MudChip>
        </div>
        @if (list.Total == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">Nada pendiente.</MudText>
        }
        else
        {
            @foreach (var row in list.Items)
            {
                <div class="d-flex align-center" data-testid="attention-row">
                    <MudLink OnClick="@(() => Navigation.NavigateTo($"/admin/gyms/{row.GymId}"))" Underline="Underline.None">@row.Name</MudLink>
                    <MudSpacer />
                    <MudText Typo="Typo.body2" Class="gsm-mono">@DaysLabel(row, byDisable)</MudText>
                </div>
            }

            @if (status is not null)
            {
                <MudLink Class="mt-2" Typo="Typo.body2" OnClick="@(() => Navigation.NavigateTo($"/admin/gyms?status={status}"))" data-testid="@($"attention-{key}-all")">Ver todos</MudLink>
            }
        }
    </MudPaper>;

    /// <summary>"Se inhabilita en 2 días" / "vence en 5 días". Hoy y mañana se dicen con palabras.</summary>
    public static string DaysLabel(AttentionGymRow row, bool byDisable)
    {
        var days = byDisable ? row.DaysUntilDisabled : row.DaysUntilExpiry;
        var verb = byDisable ? "se inhabilita" : "vence";
        return days switch
        {
            null => "—",
            <= 0 => $"{verb} hoy",
            1 => $"{verb} mañana",
            var d => $"{verb} en {d} días",
        };
    }
}

@page "/forgot-password"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject SessionService Session
@inject NavigationManager Navigation

<PageTitle>Recuperar contraseña — GSM</PageTitle>

<div class="gsm-wordmark mb-6" style="font-size:1.6rem">GS<span class="accent">M</span></div>

@if (_sent)
{
    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-4">
        Si el email existe, te hemos enviado un código para restablecer la contraseña.
    </MudAlert>
    <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary"
               OnClick="@(() => Navigation.NavigateTo($"/reset-password?email={Uri.EscapeDataString(_email)}"))">
        Ya tengo el código
    </MudButton>
}
else
{
    <MudText Typo="Typo.body2" Class="mb-4" Color="Color.Secondary">
        Escribe tu email y te enviaremos un código para restablecer la contraseña.
    </MudText>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
    }

    <MudTextField T="string" @bind-Value="_email" Label="Email" InputType="InputType.Email" Class="mb-4" />
    <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync" Disabled="_submitting">
        @(_submitting ? "Enviando..." : "Enviar código")
    </MudButton>
}

<div class="d-flex justify-center mt-4">
    <MudLink Href="/login" Typo="Typo.body2" Color="Color.Secondary">Volver a iniciar sesión</MudLink>
</div>

@code {
    private string _email = string.Empty;
    private bool _submitting;
    private bool _sent;
    private string? _error;

    private async Task SubmitAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_email))
        {
            _error = "El email es obligatorio.";
            return;
        }

        _submitting = true;
        try
        {
            await Session.ForgotPasswordAsync(_email);
            _sent = true;
        }
        catch (ApiErrorException ex)
        {
            _error = ex.Error.DisplayMessage;
        }
        finally
        {
            _submitting = false;
        }
    }
}

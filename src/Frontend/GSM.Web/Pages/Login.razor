@page "/login"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject SessionService Session
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión — GSM</PageTitle>

@* La marca la pone AuthLayout. Aquí solo el título de la tarjeta. *@
<MudText Typo="Typo.h6" Class="mb-6">Iniciar sesión</MudText>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
}

<MudForm @ref="_form" Model="_model">
    @* Immediate: sin él el valor solo se propaga al perder el foco, así que enviar con
       Enter desde el propio campo mandaría el modelo sin el último texto tecleado.
       autocomplete: sin estos valores ni el navegador ni un gestor de contraseñas
       rellenan el formulario (WCAG 2.2 SC 1.3.5). *@
    <MudTextField T="string" @bind-Value="_model.Email" Label="Email" Required="true"
                  RequiredError="El email es obligatorio." InputType="InputType.Email" Class="mb-3"
                  Immediate="true" autocomplete="username" OnKeyDown="HandleKeyDownAsync" />
    <MudTextField T="string" @bind-Value="_model.Password" Label="Contraseña" Required="true"
                  RequiredError="La contraseña es obligatoria." InputType="InputType.Password" Class="mb-2"
                  Immediate="true" autocomplete="current-password" OnKeyDown="HandleKeyDownAsync" />

    <div class="d-flex justify-end mb-4">
        <MudLink Href="/forgot-password" Typo="Typo.body2" Color="Color.Secondary">¿Olvidaste tu contraseña?</MudLink>
    </div>

    <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary"
               OnClick="SubmitAsync" Disabled="_submitting">
        @(_submitting ? "Entrando..." : "Entrar")
    </MudButton>
</MudForm>

@code {
    // Ruta local a la que volver tras entrar (p. ej. el enlace del QR del gym). Cualquier otra cosa se ignora.
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private readonly LoginModel _model = new();
    private MudForm _form = null!;
    private bool _submitting;
    private string? _error;

    // MudForm renderiza un <button type="submit" disabled hidden> para suprimir el envío
    // implícito del navegador, así que Enter no hace nada por su cuenta: hay que atarlo.
    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter" && !_submitting)
        {
            await SubmitAsync();
        }
    }

    private async Task SubmitAsync()
    {
        _error = null;
        await _form.Validate();
        if (!_form.IsValid)
        {
            return;
        }

        _submitting = true;
        try
        {
            var me = await Session.LoginAsync(_model.Email, _model.Password);
            Navigation.NavigateTo(GSM.UI.Shared.Auth.ReturnUrl.Sanitize(ReturnUrl) ?? GsmRoles.HomeFor(me.Role), replace: true);
        }
        catch (ApiErrorException ex)
        {
            _error = ex.Error switch
            {
                { IsUnauthorized: true } => "Credenciales inválidas.",
                { IsForbidden: true } => ex.Error.DisplayMessage,
                { IsRateLimited: true } => ex.Error.DisplayMessage,
                _ => ex.Error.DisplayMessage,
            };
        }
        finally
        {
            _submitting = false;
        }
    }

    private sealed class LoginModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}

@page "/login"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject SessionService Session
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión — TrainingHub OS</PageTitle>

@* La marca la pone AuthLayout. Aquí solo el título de la tarjeta. *@
@if (_selection is not null)
{
    <MudText HtmlTag="h2" Typo="Typo.h6" Class="mb-2">¿A qué gimnasio quieres entrar?</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">Tu cuenta tiene acceso a varios.</MudText>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
    }

    <GymAccessPicker Accesses="_selection.Accesses" Busy="_submitting" OnSelect="SelectAsync" />
    <MudButton Variant="Variant.Text" Class="mt-4" OnClick="BackToLogin">Usar otra cuenta</MudButton>
}
else
{
<MudText HtmlTag="h2" Typo="Typo.h6" Class="mb-6">Iniciar sesión</MudText>

@if (Expired == "1")
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4" data-testid="session-ended">Tu sesión terminó. Vuelve a entrar.</MudAlert>
}

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_error</MudAlert>
}

<MudForm @ref="_form" Model="_model">
    @* Immediate: sin él el valor solo se propaga al perder el foco, así que enviar con
       Enter desde el propio campo mandaría el modelo sin el último texto tecleado.
       autocomplete: sin estos valores ni el navegador ni un gestor de contraseñas
       rellenan el formulario (WCAG 2.2 SC 1.3.5). *@
    <MudTextField T="string" @bind-Value="_model.Email" Label="Correo o celular" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Person" Required="true"
                  RequiredError="Escribe tu correo o tu celular." InputType="InputType.Text" Class="mb-3"
                  HelperText="El celular, con sus 10 dígitos (sin +57)."
                  Immediate="true" autocomplete="username" OnKeyDown="HandleKeyDownAsync" />
    <PasswordField @bind-Value="_model.Password" Label="Contraseña" Variant="Variant.Outlined" Required="true"
                  RequiredError="La contraseña es obligatoria."  Class="mb-2"
                  Immediate="true" autocomplete="current-password" OnKeyDown="HandleKeyDownAsync" />

    <div class="d-flex justify-end mb-4">
        <MudLink Href="/forgot-password" Typo="Typo.body2" Color="Color.Secondary">¿Olvidaste tu contraseña?</MudLink>
    </div>

    <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary"
               OnClick="SubmitAsync" Disabled="_submitting">
        @(_submitting ? "Entrando..." : "Entrar")
    </MudButton>
</MudForm>
}

@code {
    // Ruta local a la que volver tras entrar (p. ej. el enlace del QR del gym). Cualquier otra cosa se ignora.
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    // E5: la sesión terminó (la renovación falló); el watcher del router trae aquí con este marcador.
    [SupplyParameterFromQuery(Name = "expired")]
    public string? Expired { get; set; }

    // Los enlaces de invitación para quien ya tiene cuenta llegan con el email precargado.
    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(Email))
        {
            _model.Email = Email;
        }
    }

    private readonly LoginModel _model = new();
    private MudForm _form = null!;
    private bool _submitting;
    private string? _error;
    private GymSelection? _selection;

    // MudForm renderiza un <button type="submit" disabled hidden> para suprimir el envío
    // implícito del navegador, así que Enter no hace nada por su cuenta: hay que atarlo.
    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter" && !_submitting)
        {
            await SubmitAsync();
        }
    }

    private async Task SubmitAsync()
    {
        _error = null;
        await _form.Validate();
        if (!_form.IsValid)
        {
            return;
        }

        _submitting = true;
        try
        {
            var outcome = await Session.LoginAsync(_model.Email, _model.Password);
            if (outcome.Selection is { } selection)
            {
                // Varios gyms: la persona elige a cuál entrar (el último usado, primero).
                _selection = selection;
                return;
            }

            await EnterAsync(outcome.Me!);
        }
        catch (ApiErrorException ex)
        {
            _error = Describe(ex);
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task SelectAsync(GymAccessOption access)
    {
        _error = null;
        _submitting = true;
        try
        {
            await EnterAsync(await Session.SelectGymAsync(_selection!, access.AccessId));
        }
        catch (ApiErrorException ex)
        {
            _error = Describe(ex);
        }
        finally
        {
            _submitting = false;
        }
    }

    private void BackToLogin()
    {
        _selection = null;
        _error = null;
        _model.Password = string.Empty;
    }

    private async Task EnterAsync(MeResponse me)
        => Navigation.NavigateTo(await Session.HomeAfterLoginAsync(me, ReturnUrl), replace: true);

    private static string Describe(ApiErrorException ex) => SessionService.LoginErrorMessage(ex, "Credenciales inválidas.");

    private sealed class LoginModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}

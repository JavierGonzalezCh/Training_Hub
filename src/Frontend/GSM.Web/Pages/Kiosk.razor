@page "/kiosk"
@layout KioskLayout
@using GSM.Client.Http
@* A3: solo lo abre la cuenta de dispositivo (rol kiosk). La página no usa [Authorize]: el access token del
   kiosco vence cada 15 minutos y el provider lo vería como anónimo; la sesión se lee del almacén y el
   AuthenticatedHttpHandler la renueva. Sin sesión de dispositivo lleva al emparejamiento; con una sesión de
   personal muestra un mensaje en vez de abrir el kiosco. *@
@attribute [AllowAnonymous]
@implements IAsyncDisposable
@inject ITokenStore Tokens
@inject IAttendanceClient Attendance
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Kiosco — GSM</PageTitle>

@if (_staffSession)
{
    <section class="gsm-kiosk gsm-kiosk--centered" data-testid="kiosk-staff-message">
        <MudIcon Icon="@Icons.Material.Outlined.QrCode2" Class="gsm-empty-icon" />
        <h1 class="gsm-kiosk__title">Este kiosco no se abre con una sesión de personal</h1>
        <p class="gsm-kiosk__hint">
            El equipo de la entrada usa una cuenta de dispositivo. El dueño la crea en Configuración → Kioscos
            y se empareja una vez con un código de 8 caracteres.
        </p>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/settings">Configurar kiosco</MudButton>
    </section>
}
else if (!_ready)
{
    <section class="gsm-kiosk gsm-kiosk--centered">
        <MudProgressCircular Indeterminate="true" />
    </section>
}
else if (_disabled)
{
    <section class="gsm-kiosk gsm-kiosk--centered" data-testid="kiosk-disabled">
        <MudIcon Icon="@Icons.Material.Outlined.QrCodeScanner" Class="gsm-empty-icon" />
        <h1 class="gsm-kiosk__title">El kiosco está desactivado</h1>
        <p class="gsm-kiosk__hint">Pídele al dueño que active el check-in con QR o la entrada con documento en Configuración para que los miembros puedan registrar su entrada.</p>
    </section>
}
else
{
    <section class="gsm-kiosk">
        <header class="gsm-kiosk__top">
            <div>
                @if (_branding is not null)
                {
                    <div class="gsm-kiosk__brand" data-testid="kiosk-brand">
                        @if (!string.IsNullOrEmpty(_branding.LogoUrl))
                        {
                            <img class="gsm-kiosk__logo" src="@_branding.LogoUrl" alt="" data-testid="kiosk-brand-logo" style="max-height:56px;max-width:160px;object-fit:contain;margin-right:12px;" />
                        }
                        <span class="gsm-kiosk__gym" data-testid="kiosk-brand-name" style="font-weight:700;font-size:1.25rem;">@_branding.Name</span>
                    </div>
                }
                <h1 class="gsm-kiosk__title">@(QrOff ? "Digita tu documento para entrar" : "Escanea para entrar")</h1>
            </div>
            <div class="gsm-kiosk__clock" aria-hidden="true">@GsmFormat.Time(_now)</div>
        </header>

        <div class="gsm-kiosk__main">
            @if (!QrOff)
            {
            <div class="gsm-kiosk__qr-card">
                @if (_code is not null)
                {
                    <QrCodeSvg Value="@LinkFor(_code.Code)" SizePx="@QrSize" />
                    @if (_code.ExpiresAtUtc is { } expires)
                    {
                        var left = Math.Max(0, (int)Math.Ceiling((expires - _now).TotalSeconds));
                        <div class="gsm-kiosk__timer" role="timer" aria-label="El código cambia en @left segundos">
                            <span class="gsm-kiosk__timer-track">
                                <span class="gsm-kiosk__timer-fill" style="width:@((left * 100 / 30).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span>
                            </span>
                            <span class="gsm-kiosk__timer-label">Cambia en @(left)s</span>
                        </div>
                    }
                }
                else
                {
                    <MudProgressCircular Indeterminate="true" />
                }
            </div>
            }

            @* Sin nombres: la entrada es pública y un rechazo a la vista expone al miembro (Memberships §5.3). *@
            <aside class="gsm-kiosk__activity">
                <h2 class="gsm-panel__title">Bienvenido</h2>
                @if (!QrOff)
                {
                    <p class="gsm-kiosk__hint">Escanea el código con la cámara de tu teléfono o con la app del gimnasio.</p>
                }
                <p class="gsm-kiosk__hint">¿Problemas para ingresar? Acércate a recepción.</p>

                @if (_code?.ByDocument == true)
                {
                    @* A4: entrada con documento. La pantalla es pública: solo nombre de pila y foto al entrar, un mismo
                       mensaje ante cualquier rechazo y el número digitado va enmascarado. *@
                    <section class="gsm-kiosk-doc" data-testid="kiosk-doc">
                        <h2 class="gsm-panel__title">@(QrOff ? "Digita tu documento" : "¿No tienes la app? Digita tu documento")</h2>

                        @if (_welcome is not null)
                        {
                            <div class="gsm-kiosk-doc__welcome" role="status" data-testid="kiosk-doc-welcome">
                                @if (!string.IsNullOrEmpty(_welcome.PhotoUrl))
                                {
                                    <img class="gsm-kiosk-doc__photo" src="@_welcome.PhotoUrl" alt="" />
                                }
                                <div class="gsm-kiosk-doc__name">Bienvenido/a, @_welcome.FirstName</div>
                                @if (_welcome.ExpiringSoon)
                                {
                                    <div class="gsm-kiosk__hint" data-testid="kiosk-doc-expiring">Tu plan vence pronto, pasa por recepción.</div>
                                }
                            </div>
                        }
                        else
                        {
                            var locked = IsLocked;
                            <div class="gsm-kiosk-doc__display gsm-mono" aria-live="polite" data-testid="kiosk-doc-display">@(new string('•', _digits.Length))</div>
                            @if (locked)
                            {
                                <p class="gsm-kiosk__denied" role="alert" data-testid="kiosk-doc-locked">
                                    Demasiados intentos. Intenta de nuevo en @LockSecondsLeft s o acércate a recepción.
                                </p>
                            }
                            else if (_rejected)
                            {
                                <p class="gsm-kiosk__denied" role="alert" data-testid="kiosk-doc-rejected">No pudimos registrar tu entrada. Comunícate con un asesor.</p>
                            }

                            <div class="gsm-kiosk-doc__keys">
                                @foreach (var key in Keys)
                                {
                                    var k = key;
                                    <button type="button" class="gsm-kiosk-doc__key" data-testid="@($"kiosk-key-{k}")"
                                            disabled="@(locked || _busy)" @onclick="@(() => Press(k))">@k</button>
                                }
                                <button type="button" class="gsm-kiosk-doc__key" data-testid="kiosk-key-clear"
                                        disabled="@(locked || _busy || _digits.Length == 0)" @onclick="Backspace" aria-label="Borrar">⌫</button>
                                <button type="button" class="gsm-kiosk-doc__key" data-testid="kiosk-key-0"
                                        disabled="@(locked || _busy)" @onclick="@(() => Press("0"))">0</button>
                                <button type="button" class="gsm-kiosk-doc__key gsm-kiosk-doc__key--enter" data-testid="kiosk-key-enter"
                                        disabled="@(locked || _busy || _digits.Length < MinDigits)" @onclick="SubmitAsync">Entrar</button>
                            </div>
                        }
                    </section>
                }
            </aside>
        </div>

        <footer class="gsm-kiosk__bar">
            <span class="gsm-kiosk__spacer"></span>
            @if (!QrOff && _code?.Mode == "Static")
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="PrintAsync" StartIcon="@Icons.Material.Outlined.Print">Imprimir cartel</MudButton>
            }
            <MudButton Variant="Variant.Outlined" OnClick="FullscreenAsync" StartIcon="@Icons.Material.Outlined.Fullscreen">Pantalla completa</MudButton>
        </footer>
    </section>

    @if (!QrOff && _code?.Mode == "Static")
    {
        @* Cartel: solo se ve al imprimir (ver @media print en gsm.css). *@
        <div class="gsm-poster" aria-hidden="true">
            <QrCodeSvg Value="@LinkFor(_code.Code)" SizePx="520" />
            <div class="gsm-poster__text">Escanea con la cámara para registrar tu entrada</div>
        </div>
    }
}

@code {
    private const int QrSize = 460;

    private readonly CancellationTokenSource _cts = new();
    private KioskCodeResponse? _code;
    private PublicGymBrandingResponse? _branding;
    private DateTimeOffset _now = DateTimeOffset.UtcNow;
    private DateTimeOffset _nextCodeFetch = DateTimeOffset.MinValue;
    private bool _disabled;
    private bool _staffSession;
    private bool _ready;
    private bool _revoked;
    private Task? _loop;

    // A4: entrada con documento.
    private static readonly string[] Keys = ["1", "2", "3", "4", "5", "6", "7", "8", "9"];
    private const int MinDigits = 4;
    private const int MaxDigits = 20;
    private string _digits = string.Empty;
    private bool _busy;
    private bool _rejected;
    private KioskDocumentEntryResponse? _welcome;
    private DateTimeOffset _welcomeUntil;
    private DateTimeOffset? _lockedUntil;

    // A4-2: con el QR apagado y solo el documento activo, el kiosco muestra únicamente el teclado.
    private bool QrOff => _code?.QrDisabled == true;

    private bool IsLocked => _lockedUntil is { } until && until > _now;

    private int LockSecondsLeft => _lockedUntil is { } until ? Math.Max(1, (int)Math.Ceiling((until - _now).TotalSeconds)) : 0;

    private void Press(string digit)
    {
        if (_digits.Length < MaxDigits)
        {
            _digits += digit;
            _rejected = false;
        }
    }

    private void Backspace()
    {
        if (_digits.Length > 0)
        {
            _digits = _digits[..^1];
        }
    }

    private async Task SubmitAsync()
    {
        if (_busy || IsLocked || _digits.Length < MinDigits)
        {
            return;
        }

        _busy = true;
        _rejected = false;
        var document = _digits;
        _digits = string.Empty;
        try
        {
            _welcome = await Attendance.KioskDocumentEntryAsync(new KioskDocumentEntryRequest { Document = document }, _cts.Token);
            _welcomeUntil = DateTimeOffset.UtcNow.AddSeconds(4);
        }
        catch (GsmApiException ex) when (ex.StatusCode == 429)
        {
            _lockedUntil = DateTimeOffset.UtcNow.AddMinutes(1);
            _now = DateTimeOffset.UtcNow;
        }
        catch (GsmApiException ex) when (ex.StatusCode == 401)
        {
            _revoked = true;
            Navigation.NavigateTo("/kiosk/emparejar?revocado=1", replace: true);
        }
        catch (GsmApiException)
        {
            // Cualquier otro rechazo (409 incluido) se muestra igual: sin decir si el documento existe ni el motivo.
            _rejected = true;
        }
        catch (HttpRequestException)
        {
            _rejected = true;
        }
        finally
        {
            _busy = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var payload = JwtPayload.TryRead((await Tokens.GetAsync())?.AccessToken);
        if (payload is null)
        {
            Navigation.NavigateTo("/kiosk/emparejar", replace: true);
            return;
        }

        if (payload.Role != GsmRoles.Kiosk)
        {
            _staffSession = true;
            return;
        }

        await RefreshCodeAsync();
        await LoadBrandingAsync();
        _ready = true;
        if (_disabled || _revoked)
        {
            return;
        }

        _loop = RunAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _ready && !_disabled)
        {
            try
            {
                // Que la pantalla no se apague mientras el kiosco está abierto. Puede no estar soportado.
                await JS.InvokeVoidAsync("navigator.wakeLock.request", "screen");
            }
            catch (Exception)
            {
            }
        }
    }

    // Un solo reloj de 1 s: refresca el contador y pide el código nuevo cuando caduca. Se detiene con el token al salir de la página.
    private async Task RunAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                _now = DateTimeOffset.UtcNow;
                if (_welcome is not null && _now >= _welcomeUntil)
                {
                    _welcome = null;
                }


                // El código anterior sigue valiendo una ventana más: basta pedir el nuevo cuando caduca el actual.
                if (_code?.ExpiresAtUtc is { } expires && _now >= expires && _now >= _nextCodeFetch)
                {
                    await RefreshCodeAsync();
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    // A3-3: nombre y logo del gym arriba del QR. Si falla, el kiosco sigue sin la marca.
    private async Task LoadBrandingAsync()
    {
        try
        {
            _branding = await Attendance.KioskBrandingAsync(_cts.Token);
        }
        catch (GsmApiException)
        {
        }
        catch (HttpRequestException)
        {
        }
    }

    private async Task RefreshCodeAsync()
    {
        // Si el reloj del equipo va adelantado, el servidor devolvería el mismo código: no insistir cada segundo.
        _nextCodeFetch = DateTimeOffset.UtcNow.AddSeconds(2);
        try
        {
            _code = await Attendance.KioskCodeAsync(_cts.Token);
        }
        catch (GsmApiException ex) when (ex.StatusCode == 401)
        {
            // El handler ya intentó renovar y el servidor no reconoce al dispositivo (el Owner lo revocó): el
            // almacén queda limpio y el equipo vuelve a pedir un código.
            _revoked = true;
            Navigation.NavigateTo("/kiosk/emparejar?revocado=1", replace: true);
        }
        catch (GsmApiException ex) when (ex.StatusCode == 403)
        {
            _disabled = true;
        }
        catch (GsmApiException)
        {
            // Un fallo puntual: se reintenta en el siguiente tick.
        }
        catch (HttpRequestException)
        {
            // Sin red un momento: el kiosco conserva su sesión y reintenta.
        }
    }

    // El enlace que lleva el QR: abre la app del miembro y registra la entrada.
    private string LinkFor(string code) => $"{Navigation.BaseUri}app/checkin?t={Uri.EscapeDataString(code)}";

    private async Task FullscreenAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("document.documentElement.requestFullscreen");
        }
        catch (Exception)
        {
        }
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("window.print");

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        if (_loop is not null)
        {
            try
            {
                await _loop;
            }
            catch (Exception)
            {
            }
        }

        _cts.Dispose();
    }
}

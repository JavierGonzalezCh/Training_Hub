<MudDialog>
    <DialogContent>
        <div class="d-flex flex-column align-center">
            <QrCodeSvg Value="@QrCode" SizePx="240" />
            <MudText Typo="Typo.caption" Class="gsm-mono mt-3" Color="Color.Secondary">@QrCode</MudText>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Close())">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired]
    public string QrCode { get; set; } = string.Empty;
}

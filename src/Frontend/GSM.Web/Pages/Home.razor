@page "/"
@attribute [Authorize(Roles = GsmRoles.Owner + "," + GsmRoles.Staff)]
@implements IDisposable
@inject GymContext GymContext

<PageTitle>Dashboard — GSM</PageTitle>

<MudText Typo="Typo.h4" Class="mb-1">Dashboard</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">
    @(GymContext.Gym?.Name ?? "—") · sesión de @(GymContext.Role ?? "—")
</MudText>

<MudGrid>
    <MudItem xs="12" sm="6" md="3">
        <StatCard Label="Miembros activos" Value="—" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatCard Label="En sala ahora" Value="—" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatCard Label="Pagos vencidos" Value="—" Accent="Color.Error" />
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <StatCard Label="Ingresos del mes" Value="—" Accent="Color.Secondary" />
    </MudItem>
</MudGrid>

<MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Class="mt-8">
    El panel se construye por etapas (ver <span class="gsm-mono">docs/FRONTEND-BUILD-PLAN.md</span>).
    Esta pantalla se completa en F5 con datos reales.
</MudAlert>

@code {
    protected override void OnInitialized() => GymContext.Changed += StateHasChanged;

    public void Dispose() => GymContext.Changed -= StateHasChanged;
}

@page "/"
@using GSM.Client.Generated
@inject IHealthClient Health

<PageTitle>GSM</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">GSM — panel</MudText>
<MudText Class="mb-4">Esqueleto F0. Comprobación de conectividad con la API.</MudText>

@if (_state == State.Checking)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_state == State.Ok)
{
    <MudAlert Severity="Severity.Success">La API responde: @_detail</MudAlert>
}
else
{
    <MudAlert Severity="Severity.Error">No se ha podido contactar con la API: @_detail</MudAlert>
}

@code {
    private enum State { Checking, Ok, Failed }

    private State _state = State.Checking;
    private string? _detail;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Health.HealthAsync();
            _detail = "/health 200";
            _state = State.Ok;
        }
        catch (Exception ex)
        {
            _detail = ex.Message;
            _state = State.Failed;
        }
    }
}

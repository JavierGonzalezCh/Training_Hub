@* Layout mínimo para las áreas que aún no tienen shell propio (/admin hasta F8, /app hasta F7):
   solo topbar y logout, sin el sidebar del panel del gym. *@
@inherits LayoutComponentBase
@inject SessionService Session
@inject NavigationManager Navigation

<MudThemeProvider Theme="@GsmTheme.Build()" IsDarkMode="true" />
<MudPopoverProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0">
        <span class="gsm-wordmark" style="font-size:1.4rem">GS<span class="accent">M</span></span>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="LogoutAsync" title="Cerrar sesión" />
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private async Task LogoutAsync()
    {
        await Session.LogoutAsync();
        Navigation.NavigateTo("/login", replace: true);
    }
}

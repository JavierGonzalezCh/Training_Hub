@inherits LayoutComponentBase

@* Layout del kiosco: pantalla completa, sin menú, sin barra superior y sin enlaces al panel. El equipo de la
   entrada solo tiene una sesión de dispositivo (rol kiosk): no hay /api/auth/me ni gym que cargar, así que el
   tema es el de la marca. Lo que se ve a metros de distancia manda. *@
<GsmThemeProvider Gym="null" />
<MudPopoverProvider />
<MudDialogProvider CloseOnEscapeKey="true" />
<MudSnackbarProvider />

<div class="gsm-kiosk-shell">
    @Body
</div>

@inherits LayoutComponentBase
@inject GymContext GymContext
@inject SessionService Session
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState

@* Layout del kiosco: pantalla completa, sin menú ni barra superior. Lo que se ve a metros de
   distancia manda; la navegación vuelve al panel con un enlace discreto. *@
<GsmThemeProvider Gym="@GymContext.Gym" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="gsm-kiosk-shell">
    @Body
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated != true || GymContext.IsLoaded)
        {
            return;
        }

        try
        {
            await Session.BootstrapAsync();
        }
        catch (ApiErrorException ex) when (ex.Error.IsUnauthorized)
        {
            Navigation.NavigateTo("/login", replace: true);
        }
    }
}

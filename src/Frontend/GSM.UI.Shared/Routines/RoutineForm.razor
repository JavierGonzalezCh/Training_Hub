@using GSM.UI.Shared.Formatting
@* Formulario de rutina (días y ejercicios). Lo usan el editor del staff y el autoservicio del miembro. *@
@inject IExercisesClient ExercisesApi

<MudGrid Class="mb-4">
    <MudItem xs="12" sm="6">
        <MudTextField T="string" @bind-Value="Draft.Name" Label="Nombre de la rutina" Required="true" />
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudTextField T="string" @bind-Value="Draft.Notes" Label="Notas" />
    </MudItem>
    <MudItem xs="12" sm="6">
        <label class="gsm-native-field">
            <span>Calendario</span>
            <select data-testid="schedule-mode" value="@Draft.ScheduleMode" @onchange="@(e => OnModeChanged(e.Value?.ToString() ?? RoutineDraft.RotatingMode))">
                <option value="@RoutineDraft.RotatingMode" selected="@(!Draft.IsWeekly)">Rotativa: Día 1, Día 2… se repite en ciclo</option>
                <option value="@RoutineDraft.WeeklyMode" selected="@Draft.IsWeekly">Semanal: cada día en un día de la semana</option>
            </select>
        </label>
    </MudItem>
    <MudItem xs="12" sm="6" Class="d-flex align-center">
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            @(Draft.IsWeekly
                ? "El día de la semana sin entrenamiento es descanso."
                : "El descanso es un día más del ciclo.")
        </MudText>
    </MudItem>
</MudGrid>

@if (Draft.ModeChanged)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">
        Cambiar el calendario crea una rutina nueva y da de baja la actual. Sus registros de entrenamiento se conservan.
    </MudAlert>
}

@for (var dayIndex = 0; dayIndex < Draft.Days.Count; dayIndex++)
{
    var day = Draft.Days[dayIndex];
    var index = dayIndex;
    <MudPaper Class="pa-4 mb-4" Elevation="0" Style="border:1px solid var(--gsm-border)">
        <div class="d-flex align-center flex-wrap mb-3" style="gap:0.75rem">
            <MudText Typo="Typo.overline" Class="gsm-mono" Color="Color.Secondary">DÍA @(index + 1)</MudText>
            @if (Draft.IsWeekly)
            {
                <label class="gsm-native-field">
                    <span>Día de la semana</span>
                    <select data-testid="@($"weekday-{index}")" @onchange="@(e => SetWeekday(day, e.Value?.ToString() ?? string.Empty))">
                        @if (day.DayOfWeek is null)
                        {
                            <option value="" selected>Elige…</option>
                        }
                        @foreach (var (value, label) in RoutineLabels.IsoWeekdays)
                        {
                            <option value="@value" selected="@(day.DayOfWeek == value)" disabled="@(!Draft.FreeWeekdays(day).Contains(value))">@label</option>
                        }
                    </select>
                </label>
            }
            @* Sin nombre, las zonas que trabaja el día sirven de nombre sugerido ("Tren superior · Core"). *@
            <MudTextField T="string" @bind-Value="day.Name" Label="@($"Nombre del día {index + 1}")" Placeholder="@(day.SuggestedName ?? "p. ej. Pierna")"
                          Style="max-width:260px" data-testid="@($"day-name-{index}")" />
            @if (day.SuggestedName is { } groups)
            {
                <MudChip T="string" Variant="Variant.Text" Size="Size.Small" Class="gsm-mono" data-testid="@($"day-groups-{index}")">@groups</MudChip>
            }
            @if (!Draft.IsWeekly)
            {
                <MudSwitch T="bool" @bind-Value="day.IsRest" Label="Marcar como día de descanso" Color="Color.Primary" data-testid="@($"day-rest-{index}")" />
            }
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Disabled="index == 0" OnClick="@(() => MoveDay(index, -1))"
                           aria-label="@($"Subir el día {index + 1}")" title="Subir" />
            <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Disabled="index == Draft.Days.Count - 1" OnClick="@(() => MoveDay(index, 1))"
                           aria-label="@($"Bajar el día {index + 1}")" title="Bajar" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Draft.Days.RemoveAt(index))"
                           aria-label="@($"Quitar el día {index + 1}")" title="Quitar día" />
        </div>

        @if (Draft.IsWeekly || !day.IsRest)
        {
            @foreach (var exercise in day.Exercises)
            {
                var lineIndex = day.Exercises.IndexOf(exercise);
                var linked = day.IsLinkedWithPrevious(exercise);
                var fields = exercise.Fields;
                <div class="gsm-routine-line mb-3 pl-3" data-testid="@($"line-{index}-{lineIndex}")"
                     style="@(exercise.Group is not null ? "border-left:3px solid var(--mud-palette-primary)" : "border-left:3px solid transparent")">
                    <MudGrid Class="mb-1">
                        <MudItem xs="12" sm="5">
                            <MudAutocomplete OpenOnFocus="false" T="ExerciseResponse" Value="exercise.Exercise" ValueChanged="@(e => exercise.Select(e))"
                                              SearchFunc="SearchExercisesAsync" ToStringFunc="@(e => e?.Name ?? string.Empty)"
                                              Label="Ejercicio" Placeholder="Busca por nombre" Dense="true" />
                        </MudItem>
                        <MudItem xs="6" sm="2">
                            <MudNumericField T="int?" @bind-Value="exercise.RestSeconds" Label="@(exercise.Group is not null ? "Descanso por vuelta (s)" : "Descanso (s)")" />
                        </MudItem>
                        <MudItem xs="12" sm="4" Class="d-flex align-center">
                            @if (lineIndex > 0)
                            {
                                <MudButton Variant="@(linked ? Variant.Filled : Variant.Outlined)" Size="Size.Small" Color="Color.Primary"
                                           data-testid="@($"link-{index}-{lineIndex}")"
                                           OnClick="@(() => day.ToggleLinkWithPrevious(exercise))">
                                    @(linked ? "En superserie con el anterior" : "Unir con el anterior")
                                </MudButton>
                            }
                        </MudItem>
                        @if (exercise.Exercise is not null)
                        {
                            <MudItem xs="12" Class="pt-0">
                                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.SwapHoriz"
                                           data-testid="@($"change-{index}-{lineIndex}")"
                                           OnClick="@(() => TogglePicker(exercise))">Cambiar por…</MudButton>
                                @if (_picking.Contains(exercise))
                                {
                                    <AlternativePicker ExerciseId="exercise.Exercise.Id" TestIdPrefix="@($"line-{index}-{lineIndex}-")"
                                                       OnPick="@(alt => ReplaceAsync(exercise, alt))" />
                                }
                            </MudItem>
                        }
                        <MudItem xs="6" sm="1" Class="d-flex justify-end">
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => day.Exercises.Remove(exercise))"
                                           aria-label="@($"Quitar {exercise.Exercise?.Name ?? "el ejercicio"} del día {index + 1}")" title="Quitar ejercicio" />
                        </MudItem>
                    </MudGrid>

                    @if (exercise.EquipmentWarning is { } warning)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2" data-testid="@($"equipment-warning-{index}-{lineIndex}")">
                            @warning
                        </MudAlert>
                    }

                    @if (exercise.Exercise is not null)
                    {
                        @for (var setIndex = 0; setIndex < exercise.Sets.Count; setIndex++)
                        {
                            var set = exercise.Sets[setIndex];
                            var number = setIndex;
                            <div class="d-flex align-center flex-wrap mb-1" style="gap:0.5rem" data-testid="@($"set-{index}-{lineIndex}-{number}")">
                                <MudText Typo="Typo.caption" Class="gsm-mono" Style="width:3.5rem">Serie @(number + 1)</MudText>
                                @if (fields.Reps && !set.IsFailure)
                                {
                                    <MudNumericField T="int?" @bind-Value="set.RepsMin" Label="Reps mín." Style="width:6rem" Margin="Margin.Dense" />
                                    <MudNumericField T="int?" @bind-Value="set.RepsMax" Label="Reps máx." Style="width:6rem" Margin="Margin.Dense" />
                                }
                                @if (fields.Weight)
                                {
                                    <MudNumericField T="decimal?" @bind-Value="set.WeightKg" Label="Kg" Style="width:5.5rem" Margin="Margin.Dense" />
                                }
                                @if (fields.Time)
                                {
                                    <MudNumericField T="int?" @bind-Value="set.DurationSeconds" Label="Tiempo (s)" Style="width:6.5rem" Margin="Margin.Dense" />
                                }
                                @if (fields.Distance)
                                {
                                    <MudNumericField T="int?" @bind-Value="set.DistanceM" Label="Distancia (m)" Style="width:7rem" Margin="Margin.Dense" />
                                }
                                @if (ShowRir)
                                {
                                    <MudNumericField T="int?" @bind-Value="set.Rir" Label="RIR" Min="0" Max="10" Style="width:4.5rem" Margin="Margin.Dense" />
                                }
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Disabled="exercise.Sets.Count <= 1"
                                               aria-label="@($"Quitar la serie {number + 1}")" OnClick="@(() => exercise.Sets.RemoveAt(number))" />
                            </div>
                        }
                        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                                   data-testid="@($"add-set-{index}-{lineIndex}")" OnClick="@(() => exercise.AddSet())">
                            Añadir serie
                        </MudButton>
                        @if (exercise.Exercise.IsUnilateral == true)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2">Las repeticiones son por lado.</MudText>
                        }
                    }
                </div>
            }
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small"
                       OnClick="@(() => day.Exercises.Add(new DraftExercise()))">
                Añadir ejercicio
            </MudButton>
        }
    </MudPaper>
}

<MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" Class="mb-6" Disabled="!Draft.CanAddDay" OnClick="@(() => Draft.AddDay())">
    Añadir día
</MudButton>

@code {
    /// <summary>Campo RIR por serie: lo usa el entrenador en el panel; la app del miembro no lo muestra.</summary>
    [Parameter] public bool ShowRir { get; set; } = true;

    [Parameter, EditorRequired]
    public RoutineDraft Draft { get; set; } = default!;

    // Líneas con la lista de alternativas abierta ("Cambiar por…").
    private readonly HashSet<DraftExercise> _picking = [];

    private void TogglePicker(DraftExercise line)
    {
        if (!_picking.Remove(line))
        {
            _picking.Add(line);
        }
    }

    private Task ReplaceAsync(DraftExercise line, ExerciseAlternativeResponse alternative)
    {
        line.ReplaceWith(alternative);
        _picking.Remove(line);
        return Task.CompletedTask;
    }

    private void OnModeChanged(string mode) => Draft.SetMode(mode);

    private static void SetWeekday(DraftDay day, string value)
        => day.DayOfWeek = int.TryParse(value, out var weekday) ? weekday : null;

    private void MoveDay(int index, int delta)
    {
        var target = index + delta;
        (Draft.Days[index], Draft.Days[target]) = (Draft.Days[target], Draft.Days[index]);
    }

    private async Task<IEnumerable<ExerciseResponse>> SearchExercisesAsync(string search, CancellationToken cancellationToken)
        => await ExercisesApi.ExercisesAllAsync(
            string.IsNullOrWhiteSpace(search) ? null : search, null, null, false, cancellationToken: cancellationToken);
}

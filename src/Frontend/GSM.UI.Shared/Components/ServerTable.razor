@typeparam TItem
@* Componente único para todos los listados paginados en servidor (ver CLAUDE.md / reglas
   transversales del cliente). Envuelve MudTable con su ServerData sobre la forma común
   ServerTablePage&lt;T&gt;.

   Adaptable: por debajo de 960 px (celular) cada fila pasa a tarjeta. Con CardTemplate la tarjeta
   es la que define la pantalla; sin ella, MudTable apila las celdas de cada fila con su DataLabel
   (una tarjeta genérica con las columnas), así que toda tabla con DataLabel se adapta sola. *@
@implements IDisposable
@inject IServiceProvider Services

<MudTable T="TItem" @ref="_table" ServerData="ReloadAsync" Hover="true" Dense="Dense" Elevation="0"
          Loading="_loading" Class="@TableClass" Breakpoint="Breakpoint.Sm">
    <ToolBarContent>@ToolBarContent</ToolBarContent>
    <HeaderContent>
        @if (!CardMode)
        {
            @HeaderContent
        }
    </HeaderContent>
    <RowTemplate>
        @if (CardMode)
        {
            <MudTd Class="gsm-card-cell"><div class="gsm-card" data-testid="server-table-card">@CardTemplate!(context)</div></MudTd>
        }
        else
        {
            @RowTemplate(context)
        }
    </RowTemplate>
    <NoRecordsContent>
        @if (NoRecordsContent is not null)
        {
            @NoRecordsContent
        }
        else
        {
            <MudText Color="Color.Secondary">Sin resultados.</MudText>
        }
    </NoRecordsContent>
    <LoadingContent>
        <MudText Color="Color.Secondary">Cargando…</MudText>
    </LoadingContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="new[] { 10, 20, 50 }" RowsPerPageString="Filas por página:" InfoFormat="{first_item}-{last_item} de {all_items}" />
    </PagerContent>
</MudTable>

@code {
    private MudTable<TItem>? _table;
    private bool _loading;

    // El estado del ancho es opcional: un host (o test) que no lo registre ve siempre la tabla.
    private ViewportState? Viewport => Services.GetService(typeof(ViewportState)) as ViewportState;

    private bool CardMode => CardTemplate is not null && Viewport?.IsNarrow == true;

    // "gsm-table" va siempre: su regla apila los filtros de la barra en el celular; sin ella se desbordaban
    // (Asistencia, Pagos, Clases). Una página que ya la pasa no la duplica.
    private string? TableClass
    {
        get
        {
            var classes = (Class ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries).ToList();
            if (!classes.Contains("gsm-table"))
            {
                classes.Add("gsm-table");
            }

            if (CardMode)
            {
                classes.Add("gsm-table--cards");
            }

            return string.Join(' ', classes);
        }
    }

    protected override void OnInitialized()
    {
        if (Viewport is { } viewport)
        {
            viewport.Changed += OnViewportChanged;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (Viewport is { } viewport)
            {
                await viewport.EnsureStartedAsync();
            }
        }
    }

    private void OnViewportChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (Viewport is { } viewport)
        {
            viewport.Changed -= OnViewportChanged;
        }
    }

    [Parameter, EditorRequired]
    public Func<int, int, CancellationToken, Task<ServerTablePage<TItem>>> Load { get; set; } = null!;

    [Parameter, EditorRequired]
    public RenderFragment HeaderContent { get; set; } = null!;

    [Parameter, EditorRequired]
    public RenderFragment<TItem> RowTemplate { get; set; } = null!;

    /// <summary>Tarjeta de cada fila en pantallas angostas; sin ella se apilan las celdas con su DataLabel.</summary>
    [Parameter]
    public RenderFragment<TItem>? CardTemplate { get; set; }

    [Parameter]
    public RenderFragment? ToolBarContent { get; set; }

    [Parameter]
    public RenderFragment? NoRecordsContent { get; set; }

    [Parameter]
    public bool Dense { get; set; } = true;

    [Parameter]
    public string? Class { get; set; }

    /// <summary>Vuelve a pedir la página actual al servidor (tras cambiar un filtro externo).</summary>
    public Task RefreshAsync() => _table?.ReloadServerData() ?? Task.CompletedTask;

    private async Task<TableData<TItem>> ReloadAsync(TableState state, CancellationToken cancellationToken)
    {
        _loading = true;
        try
        {
            // MudTable pagina desde 0; la API, desde 1.
            var page = await Load(state.Page + 1, state.PageSize, cancellationToken);
            return new TableData<TItem> { Items = page.Items, TotalItems = page.TotalItems };
        }
        finally
        {
            _loading = false;
        }
    }
}

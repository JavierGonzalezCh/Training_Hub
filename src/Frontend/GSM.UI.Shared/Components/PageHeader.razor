@* Cabecera de página: antetítulo (contexto), título, una frase operativa y las acciones.
   Sustituye al par h4 + body2 suelto de cada página para que la jerarquía sea la misma en
   todo el panel y el tema pueda darle carácter (Anton en Forja, Barlow Condensed en Pista,
   Bodoni en Estudio). *@
<header class="gsm-page-header @Class">
    <div class="gsm-page-header__text">
        @if (!string.IsNullOrEmpty(Eyebrow))
        {
            <div class="gsm-eyebrow">@Eyebrow</div>
        }
        <h1 class="gsm-page-title">@Title</h1>
        @if (Subtitle is not null)
        {
            <p class="gsm-page-subtitle">@Subtitle</p>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="gsm-page-header__actions">@Actions</div>
    }
</header>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Eyebrow { get; set; }

    [Parameter]
    public RenderFragment? Subtitle { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public string? Class { get; set; }
}

@* Cambiar la contraseña con la sesión iniciada (Identity §11). Lo comparten el panel y la app del miembro.
   El servidor pide la actual, cierra las otras sesiones de la persona y deja abierta esta. *@
@inject SessionService Session

@if (_done)
{
    <MudAlert Severity="Severity.Success" Dense="true" Class="mb-4" data-testid="change-password-done">
        Contraseña actualizada. Cerramos tus otras sesiones; esta sigue abierta.
    </MudAlert>
}

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4" data-testid="change-password-error">@_error</MudAlert>
}

<PasswordField @bind-Value="_current" Label="Contraseña actual" 
              Immediate="true" Class="mb-3" autocomplete="current-password" />
<PasswordField @bind-Value="_new" Label="Contraseña nueva" 
              Immediate="true" Class="mb-3" autocomplete="new-password"
              HelperText="Mínimo 10 caracteres, con mayúscula, minúscula y número." />
<PasswordField @bind-Value="_confirm" Label="Repite la contraseña nueva" 
              Immediate="true" Class="mb-4" autocomplete="new-password" />

<MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="SubmitAsync" Disabled="_submitting">
    @(_submitting ? "Guardando..." : "Cambiar contraseña")
</MudButton>

@code {
    private string _current = string.Empty;
    private string _new = string.Empty;
    private string _confirm = string.Empty;
    private bool _submitting;
    private bool _done;
    private string? _error;

    private async Task SubmitAsync()
    {
        _error = null;
        _done = false;

        if (string.IsNullOrWhiteSpace(_current) || string.IsNullOrWhiteSpace(_new))
        {
            _error = "Escribe tu contraseña actual y la nueva.";
            return;
        }

        if (_new.Length < 10)
        {
            _error = "La contraseña nueva debe tener al menos 10 caracteres.";
            return;
        }

        if (_new != _confirm)
        {
            _error = "Las contraseñas nuevas no coinciden.";
            return;
        }

        _submitting = true;
        try
        {
            await Session.ChangePasswordAsync(_current, _new);
            _done = true;
            _current = _new = _confirm = string.Empty;
        }
        catch (ApiErrorException ex)
        {
            // 422: la actual es incorrecta o la nueva no cumple la política.
            _error = ex.Error.DisplayMessage;
        }
        finally
        {
            _submitting = false;
        }
    }
}

@* Barra fija cuando el token trae impersonating=true (ver CLAUDE.md): lectura o escritura, con la
   cuenta atrás de los 15 minutos y un botón para terminar la sesión. *@
@implements IAsyncDisposable
@inject AuthenticationStateProvider AuthState
@inject ITokenStore TokenStore
@inject ImpersonationService Impersonation
@inject GymContext GymCtx

@if (_visible)
{
    <div class="gsm-impersonation-bar">
        <MudIcon Icon="@Icons.Material.Filled.VisibilityOff" Size="Size.Small" Class="mr-2" />
        <span>Viendo como SuperAdmin — @(_write ? "escritura" : "solo lectura") @(_remaining is { } r ? $"· queda {r:mm\\:ss}" : "")</span>
        @if (GymCtx.Gym is { } gym)
        {
            @* Soporte entiende así por qué un gym no tiene Recepción o QR: depende de su tipo de negocio. *@
            <span class="ml-2" data-testid="impersonation-gym-type">· @gym.Name (@GymTypeLabels.Label(gym.Type))</span>
        }
        <MudSpacer />
        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Inherit" OnClick="EndAsync">Finalizar</MudButton>
    </div>
}

@code {
    private bool _visible;
    private bool _write;
    private DateTimeOffset? _expiresAt;
    private TimeSpan? _remaining;
    private PeriodicTimer? _timer;
    private Task? _ticking;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _visible = state.User.IsImpersonating();
        _write = state.User.IsImpersonationWrite();
        if (!_visible)
        {
            return;
        }

        var tokens = await TokenStore.GetAsync();
        _expiresAt = JwtPayload.TryRead(tokens?.AccessToken)?.ExpiresAt;

        _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ticking = TickAsync();
    }

    private async Task TickAsync()
    {
        while (_timer is not null && await _timer.WaitForNextTickAsync())
        {
            _remaining = _expiresAt is { } exp ? exp - DateTimeOffset.UtcNow : null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task EndAsync() => Impersonation.EndAsync();

    public async ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        _timer = null;
        if (_ticking is not null)
        {
            try
            {
                await _ticking;
            }
            catch
            {
                // el bucle sale limpio al hacer Dispose() del timer.
            }
        }
    }
}

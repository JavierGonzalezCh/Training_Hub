            ("TO", "Tonga", "+676"), ("TT", "Trinidad y Tobago", "+1868"), ("TN", "Túnez", "+216"), ("TM", "Turkmenistán", "+993"),
            ("TR", "Turquía", "+90"), ("TV", "Tuvalu", "+688"), ("UA", "Ucrania", "+380"), ("UG", "Uganda", "+256"),
            ("UY", "Uruguay", "+598"), ("UZ", "Uzbekistán", "+998"), ("VU", "Vanuatu", "+678"), ("VE", "Venezuela", "+58"),
            ("VN", "Vietnam", "+84"), ("YE", "Yemen", "+967"), ("DJ", "Yibuti", "+253"), ("ZM", "Zambia", "+260"),
            ("ZW", "Zimbabue", "+263"),

            ("GR", "Grecia", "+30"), ("GT", "Guatemala", "+502"), ("GN", "Guinea", "+224"), ("GQ", "Guinea Ecuatorial", "+240"),
            ("GW", "Guinea-Bisáu", "+245"), ("GY", "Guyana", "+592"), ("HT", "Haití", "+509"), ("HN", "Honduras", "+504"),
            ("HU", "Hungría", "+36"), ("IN", "India", "+91"), ("ID", "Indonesia", "+62"), ("IQ", "Irak", "+964"),

            ("SG", "Singapur", "+65"), ("SY", "Siria", "+963"), ("SO", "Somalia", "+252"), ("LK", "Sri Lanka", "+94"),
            ("ZA", "Sudáfrica", "+27"), ("SD", "Sudán", "+249"), ("SS", "Sudán del Sur", "+211"), ("SE", "Suecia", "+46"),

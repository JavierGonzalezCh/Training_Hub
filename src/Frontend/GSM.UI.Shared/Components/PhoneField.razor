            ("KH", "Camboya", "+855"), ("CM", "Camerún", "+237"), ("CA", "Canadá", "+1"), ("QA", "Catar", "+974"),
            ("TD", "Chad", "+235"), ("CL", "Chile", "+56"), ("CN", "China", "+86"), ("CY", "Chipre", "+357"),
            ("VA", "Ciudad del Vaticano", "+379"), ("CO", "Colombia", "+57"), ("KM", "Comoras", "+269"), ("KP", "Corea del Norte", "+850"),
            ("KR", "Corea del Sur", "+82"), ("CI", "Costa de Marfil", "+225"), ("CR", "Costa Rica", "+506"), ("HR", "Croacia", "+385"),
            ("CU", "Cuba", "+53"), ("DK", "Dinamarca", "+45"), ("DM", "Dominica", "+1767"), ("EC", "Ecuador", "+593"),
            ("EG", "Egipto", "+20"), ("SV", "El Salvador", "+503"), ("AE", "Emiratos Árabes Unidos", "+971"), ("ER", "Eritrea", "+291"),
            ("SK", "Eslovaquia", "+421"), ("SI", "Eslovenia", "+386"), ("ES", "España", "+34"), ("US", "Estados Unidos", "+1"),

            ("KG", "Kirguistán", "+996"), ("KI", "Kiribati", "+686"), ("KW", "Kuwait", "+965"), ("LA", "Laos", "+856"),
            ("LS", "Lesoto", "+266"), ("LV", "Letonia", "+371"), ("LB", "Líbano", "+961"), ("LR", "Liberia", "+231"),
            ("LY", "Libia", "+218"), ("LI", "Liechtenstein", "+423"), ("LT", "Lituania", "+370"), ("LU", "Luxemburgo", "+352"),
            ("MK", "Macedonia del Norte", "+389"), ("MG", "Madagascar", "+261"), ("MY", "Malasia", "+60"), ("MW", "Malaui", "+265"),

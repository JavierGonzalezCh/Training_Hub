@* M2: celular con selector de indicativo (Colombia +57 por defecto). El valor que sale es E.164 (+573001234567) o vacío.
   Validación: +57 exige 10 dígitos que empiezan por 3; otro indicativo, de 6 a 14 dígitos. *@
<div class="gsm-phone-field @Class" data-testid="@TestId">
    <MudSelect T="string" Value="_iso" ValueChanged="OnIsoChangedAsync" Label="País" data-testid="phone-code" Disabled="Disabled"
               ToStringFunc="@(iso => iso == OtherIso ? "Otro" : Short(World.First(c => c.Iso == iso)))">
        @foreach (var country in World)
        {
            <MudSelectItem Value="@country.Iso">@Flag(country.Iso) @country.Name · @country.Iso @country.Code</MudSelectItem>
        }
        <MudSelectItem Value="@OtherIso">Otro (escribir con +)</MudSelectItem>
    </MudSelect>
    <MudTextField T="string" Value="_digits" ValueChanged="OnDigitsChangedAsync" Label="@Label" Immediate="true"
                  InputMode="InputMode.tel" Required="Required" RequiredError="@RequiredError" Disabled="Disabled"
                  HelperText="@HelperText" Error="@(Error || _localError is not null)" ErrorText="@(_localError ?? ErrorText)"
                  autocomplete="tel-national" data-testid="phone-number" />
</div>

@code {
    public const string DefaultCode = "+57";

    /// <summary>
    /// Todos los países con su abreviatura ISO, nombre e indicativo. Colombia va primero y es el valor por defecto; el resto
    /// en orden alfabético. La bandera sale de la abreviatura (indicadores regionales).
    /// </summary>
    public static readonly (string Iso, string Name, string Code)[] World = BuildWorld();

    public static string Flag(string iso) => string.Concat(iso.Select(c => char.ConvertFromUtf32(0x1F1E6 + (char.ToUpperInvariant(c) - 'A'))));

    /// <summary>Texto corto del selector: bandera, abreviatura e indicativo.</summary>
    public static string Short((string Iso, string Name, string Code) c) => $"{Flag(c.Iso)} {c.Iso} {c.Code}";

    private static (string Iso, string Name, string Code)[] BuildWorld()

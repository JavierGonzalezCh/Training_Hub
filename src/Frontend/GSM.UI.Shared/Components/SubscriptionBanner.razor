@inject GymContext GymContext

@if (GymContext.SubscriptionState == SubscriptionState.Overdue)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="gsm-banner" Icon="@Icons.Material.Filled.WarningAmber">
        Pago pendiente.
        @if (GymContext.Subscription?.DaysUntilDisabled is { } days)
        {
            <span>&nbsp;En @days día@(days == 1 ? "" : "s") el gimnasio pasa a solo lectura.</span>
        }
    </MudAlert>
}
else if (GymContext.SubscriptionState == SubscriptionState.TrialEnded)
{
    <MudAlert Severity="Severity.Warning" Dense="true" Class="gsm-banner" Icon="@Icons.Material.Filled.HourglassBottom" data-testid="trial-ended-banner">
        Tu prueba terminó. Confirma tu pago para seguir usando TrainingHub.
        @if (GymContext.Subscription?.DaysUntilDisabled is { } days)
        {
            <span>&nbsp;@(days == 0 ? "Hoy es el último día de acceso completo." : $"Te quedan {days} día{(days == 1 ? "" : "s")} de acceso completo.")</span>
        }
    </MudAlert>
}
else if (GymContext.SubscriptionState == SubscriptionState.Disabled)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="gsm-banner" Icon="@Icons.Material.Filled.Lock">
        Suscripción vencida — el gimnasio está en <strong>solo lectura</strong>. Contacta con soporte para reactivarla.
    </MudAlert>
}

@implements IDisposable

@code {
    protected override void OnInitialized() => GymContext.Changed += StateHasChanged;

    public void Dispose() => GymContext.Changed -= StateHasChanged;
}

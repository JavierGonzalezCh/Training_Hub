{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Jwt": {
    "Issuer": "gsm-api",
    "Audience": "gsm-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}

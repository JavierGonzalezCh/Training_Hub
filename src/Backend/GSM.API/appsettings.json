{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Jwt": {
    "Issuer": "gsm-api",
    "Audience": "gsm-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 90
  },
  "Checkin": {
    "SigningKey": ""
  },
  "Communications": {
    "UnsubscribeSigningKey": "",
    "PublicApiBaseUrl": ""
  },
  "Identity": {
    "PublicWebBaseUrl": ""
  },
  "Jobs": {
    "Secret": ""
  },
  "Clock": {
    "TimeZone": "America/Bogota"
  },
  "Storage": {
    "R2": {
      "AccountId": "",
      "AccessKeyId": "",
      "SecretAccessKey": "",
      "Bucket": "",
      "PublicBaseUrl": ""
    }
  },
  "Email": {
    "Resend": {
      "ApiKey": "",
      "FromAddress": ""
    }
  },
  "Notifications": {
    "Fcm": {
      "ProjectId": "",
      "ServiceAccountJson": "",
      "Web": {
        "ApiKey": "",
        "AppId": "",
        "MessagingSenderId": "",
        "VapidKey": ""
      }
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
